<style>
  .site-footer {
    background-color: var(--color-navy-dark);
    color: rgba(255,255,255,0.7);
    margin-top: 0;
  }

  .footer-main {
    padding: 3.5rem 0 2.5rem;
    border-top: 1px solid rgba(201,160,23,0.3);
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .footer-inner { grid-template-columns: 2fr 1fr 1.2fr 1.2fr; gap: 3rem; }
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .footer-logo-icon {
    width: 28px;
    height: 34px;
    flex-shrink: 0;
  }
  .footer-logo-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: white;
  }
  .footer-logo-tag {
    font-family: var(--font-body);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    text-transform: uppercase;
    margin-top: 2px;
  }
  .footer-brand-desc {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.55);
    margin-bottom: 1.25rem;
  }
  .footer-social {
    display: flex;
    gap: 0.75rem;
  }
  .footer-social-link {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(201,160,23,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.5);
    transition: color 0.2s, border-color 0.2s;
  }
  .footer-social-link:hover {
    color: var(--color-gold);
    border-color: var(--color-gold);
  }

  /* Columns */
  .footer-col-title {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-links a {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--color-gold); }

  /* Contact */
  .footer-contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .footer-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.55);
  }
  .footer-contact-list li svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-gold);
  }
  .footer-contact-list a {
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-contact-list a:hover { color: var(--color-gold); }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 1rem 0;
  }
  .footer-bottom-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
  }
  @media (min-width: 768px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .footer-copyright {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.35);
  }
  .footer-legal {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.35);
  }
  .footer-legal a {
    color: rgba(255,255,255,0.35);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-legal a:hover { color: var(--color-gold); }
  .footer-legal span { opacity: 0.4; }
</style>
