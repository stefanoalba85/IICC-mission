---
const quickLinks = [
  { label: 'Home',            href: '/' },
  { label: 'About Us',        href: '/about' },
  { label: 'Our Mission',     href: '/our-mission' },
  { label: 'Leadership',      href: '/our-people' },
  { label: 'Our Programs',    href: '/our-services' },
  { label: 'Get Involved',    href: '/get-involved' },
  { label: 'Contact',         href: '/contact' },
];

const getInvolved = [
  { icon: '♥', label: 'Donate',               href: '/donate' },
  { icon: '👥', label: 'Volunteer',            href: '/get-involved#volunteer' },
  { icon: '📰', label: 'News & Resources',     href: '/news' },
  { icon: '🤝', label: 'Partner With Us',      href: '/get-involved#partner' },
  { icon: '💙', label: 'Become a Hope Partner',href: '/get-involved#hope-partner' },
  { icon: '📬', label: 'Subscribe',            href: '/get-involved#subscribe' },
];
---

<footer class="ftr">
  <div class="ftr__main">
    <div class="wrap">
      <div class="ftr__grid">

        <!-- Brand -->
        <div class="ftr__brand">
          <a href="/" class="ftr__logo-link">
            <img src="/IICC_Logo.png" alt="IICC Mission" class="ftr__logo" />
          </a>
          <p class="ftr__desc">
            Accompanying individuals and families in their journey toward healing, empowerment and a restored future.
          </p>
        </div>

        <!-- Quick Links -->
        <div class="ftr__col">
          <h4 class="ftr__col-title">Quick Links</h4>
          <ul class="ftr__links">
            {quickLinks.map(l => (
              <li><a href={l.href} class="ftr__link">{l.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Get Involved -->
        <div class="ftr__col">
          <h4 class="ftr__col-title">Get Involved</h4>
          <ul class="ftr__links">
            {getInvolved.map(l => (
              <li>
                <a href={l.href} class="ftr__link ftr__link--icon">
                  <span class="ftr__link-icon" aria-hidden="true">{l.icon}</span>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Follow Us + Contact -->
        <div class="ftr__col">
          <h4 class="ftr__col-title">Follow Us</h4>
          <div class="ftr__social">
            <a href="#" aria-label="Facebook" class="ftr__social-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="#" aria-label="Instagram" class="ftr__social-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="#" aria-label="YouTube" class="ftr__social-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
            </a>
            <a href="#" aria-label="LinkedIn" class="ftr__social-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          </div>

          <div class="ftr__contact">
            <h4 class="ftr__col-title" style="margin-top:1.5rem;">Contact Us</h4>
            <ul class="ftr__contact-list">
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                PO Box 273, Cheltenham VIC 3192 Australia
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.59 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <a href="tel:+61411209066">+61 411 209 066</a>
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <a href="mailto:info@iiccmission.org">info@iiccmission.org</a>
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <a href="https://www.iiccmission.org">www.iiccmission.org</a>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="ftr__bar">
    <div class="wrap ftr__bar-inner">
      <p>© 2024 IICC Mission &nbsp;|&nbsp; All Rights Reserved</p>
      <nav class="ftr__legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-use">Terms &amp; Conditions</a>
      </nav>
      <svg width="16" height="14" viewBox="0 0 24 21" fill="none" aria-hidden="true">
        <path d="M12 20c-5.2-5.1-10-9.5-10-13.3C2 3.5 4.8 2 7 2c1.2 0 3.8.46 5.25 4.1C13.7 2.46 16.3 2 17.5 2c2.2 0 4.5 1.5 4.5 4.77 0 3.75-4.73 7.95-10 13.23z" fill="#E07B00"/>
      </svg>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--color-navy-dark); border-top: 1px solid rgba(224,123,0,0.15); }

  .ftr__main { padding-block: 4rem 3rem; }

  .ftr__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 640px) { .ftr__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .ftr__grid { grid-template-columns: 1.8fr 1fr 1fr 1.4fr; gap: 3rem; } }

  /* Brand */
  .ftr__brand { display: flex; flex-direction: column; gap: 1rem; }
  .ftr__logo-link { display: inline-flex; }
  .ftr__logo { height: 72px; width: auto; }
  .ftr__desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
  }

  /* Columns */
  .ftr__col { display: flex; flex-direction: column; gap: 0.875rem; }
  .ftr__col-title {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-amber);
    margin: 0;
  }
  .ftr__links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .ftr__link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.6);
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ftr__link:hover { color: var(--color-amber); }
  .ftr__link-icon { font-size: 0.75rem; line-height: 1; }

  /* Social */
  .ftr__social { display: flex; gap: 0.625rem; flex-wrap: wrap; }
  .ftr__social-link {
    width: 2rem; height: 2rem;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.15);
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.55);
    transition: border-color 0.2s, color 0.2s;
  }
  .ftr__social-link:hover { border-color: var(--color-amber); color: var(--color-amber); }

  /* Contact */
  .ftr__contact-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .ftr__contact-list li {
    display: flex; align-items: flex-start; gap: 0.5rem;
    font-family: var(--font-body); font-size: 0.8125rem;
    color: rgba(255,255,255,0.55); line-height: 1.5;
  }
  .ftr__contact-list svg { flex-shrink: 0; margin-top: 0.15em; color: var(--color-amber); }
  .ftr__contact-list a { color: rgba(255,255,255,0.55); transition: color 0.2s; }
  .ftr__contact-list a:hover { color: var(--color-amber); }

  /* Bottom bar */
  .ftr__bar {
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-block: 1rem;
  }
  .ftr__bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .ftr__bar-inner p,
  .ftr__bar-inner a {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
  }
  .ftr__bar-inner a:hover { color: var(--color-amber); }
  .ftr__legal { display: flex; gap: 1.5rem; }
</style>
