---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <div class="site-footer__logo">
        <img src="/IICC_Badge.png" alt="IICC Mission logo" />
        <span>
          <strong>IICC MISSION</strong>
          <small>Faith. Hope. Justice. Restoration.</small>
        </span>
      </div>
      <p class="site-footer__tagline">Accompanying. Empowering. Restoring Hope.</p>
      <p class="site-footer__desc">
        A Catholic global mission sharing Christ's love, mercy and hope with incarcerated
        individuals, people in Immigration Detention, their families and all who are
        experiencing hardship.
      </p>
      <div class="site-footer__social">
        <a href="https://facebook.com" aria-label="Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V5h-3c-2.2 0-4 1.8-4 4v2H7v4h3v7h4v-7h3l1-4h-4V9c0-.6.4-1 1-1Z"/></svg></a>
        <a href="https://instagram.com" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c2.7 0 3 0 4 .1 1 .1 1.7.2 2.3.5.6.3 1.1.6 1.6 1.1.5.5.8 1 1.1 1.6.3.6.4 1.3.5 2.3.1 1 .1 1.3.1 4s0 3-.1 4c-.1 1-.2 1.7-.5 2.3a4.6 4.6 0 0 1-2.7 2.7c-.6.3-1.3.4-2.3.5-1 .1-1.3.1-4 .1s-3 0-4-.1c-1-.1-1.7-.2-2.3-.5a4.6 4.6 0 0 1-2.7-2.7c-.3-.6-.4-1.3-.5-2.3-.1-1-.1-1.3-.1-4s0-3 .1-4c.1-1 .2-1.7.5-2.3a4.6 4.6 0 0 1 2.7-2.7c.6-.3 1.3-.4 2.3-.5 1-.1 1.3-.1 4-.1ZM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z"/></svg></a>
        <a href="https://x.com" aria-label="X"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.6L23 22h-6.9l-5.4-6.6L4.6 22H1.5l8.1-9.2L1 2h7l4.9 6 6-6Z"/></svg></a>
        <a href="https://youtube.com" aria-label="YouTube"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.5-.4-5a2.9 2.9 0 0 0-2-2C18.9 4.5 12 4.5 12 4.5s-6.9 0-8.6.5a2.9 2.9 0 0 0-2 2C1 8.5 1 12 1 12s0 3.5.4 5a2.9 2.9 0 0 0 2 2c1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5a2.9 2.9 0 0 0 2-2c.4-1.5.4-5 .4-5ZM9.8 15.3V8.7l5.8 3.3-5.8 3.3Z"/></svg></a>
      </div>
    </div>

    <div class="site-footer__col">
      <span class="site-footer__heading">Quick Links</span>
      <a href="/">Home</a>
      <a href="/about-us">About Us</a>
      <a href="/our-services/who-we-serve">Our Services</a>
      <a href="/get-involved">Get Involved</a>
      <a href="/donate">Donate</a>
      <a href="/contact">Contact Us</a>
    </div>

    <div class="site-footer__col">
      <span class="site-footer__heading">Our Ministries</span>
      <a href="/our-services/prison-ministry">Prison Ministry</a>
      <a href="/our-services/immigration-detention">Immigration Detention Ministry</a>
      <a href="/our-services/mental-health">Mental Health &amp; Wellbeing</a>
      <a href="/our-services/advocacy">Advocacy &amp; Human Rights</a>
      <a href="/programs/hope-companion">Hope Companion Program</a>
    </div>

    <div class="site-footer__col">
      <span class="site-footer__heading">Head Office</span>
      <div class="site-footer__contact-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.3 7 13 7 13s7-7.7 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg>
        <span>Via delle Milizie 34<br />Rome, Italy 00192</span>
      </div>
      <div class="site-footer__contact-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M2 4h20v16H2V4Zm2.4 2 7.6 6 7.6-6H4.4Zm15.6 2.2-7.6 6-7.6-6V18h15.2V8.2Z"/></svg>
        <span>info@iiccmission.org</span>
      </div>
      <div class="site-footer__contact-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.7 3.6 4.9 6.3 6.3l2.1-2.1c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 2 4c0-.6.4-1 1-1h3.6c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1l-2.1 2.1Z"/></svg>
        <span>+39 349 303 6235</span>
      </div>
      <div class="site-footer__contact-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm7.9 9h-3.4c-.1-2-.5-3.9-1.2-5.4A8 8 0 0 1 19.9 11ZM12 4c.8 1 1.6 3.2 1.8 5H10.2c.2-1.8 1-4 1.8-5Zm-3.3.6C8 6.1 7.6 8 7.5 10H4.1a8 8 0 0 1 4.6-5.4ZM4.1 13h3.4c.1 2 .5 3.9 1.2 5.4A8 8 0 0 1 4.1 13ZM12 20c-.8-1-1.6-3.2-1.8-5h3.6c-.2 1.8-1 4-1.8 5Zm3.3-.6c.7-1.5 1.1-3.4 1.2-5.4h3.4a8 8 0 0 1-4.6 5.4Z"/></svg>
        <span>www.iiccmission.org</span>
      </div>
    </div>
  </div>

  <div class="wrap site-footer__bottom">
    <span>© {year} IICC Mission. All Rights Reserved.</span>
    <nav class="site-footer__legal" aria-label="Legale">
      <a href="/faq">FAQ</a>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms-conditions">Terms &amp; Conditions</a>
      <a href="/accessibility-statement">Accessibility Statement</a>
