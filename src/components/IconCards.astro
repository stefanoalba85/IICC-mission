---
import Icon from './Icon.astro';
interface Props { title: string; items: { icon: string; title: string; text: string }[]; }
const p = Astro.props;
---
<section class="wrap" style="padding-block:1.25rem 1rem;">
  <h2 class="camp-h">{p.title}</h2>
  <div style={`display:grid; grid-template-columns:repeat(${p.items.length},1fr); gap:0.75rem; margin-top:0.9rem;`} class="camp-grid">
    {p.items.map(i => <div style="background:#f7f6f3; border-radius:4px; padding:1.1rem 0.75rem; text-align:center; display:flex; flex-direction:column; align-items:center; gap:0.5rem;"><span style="color:var(--color-navy);"><Icon name={i.icon} size={46} /></span><strong style="font-family:var(--font-heading); color:var(--color-navy); font-weight:400; font-size:1rem;">{i.title}</strong><span style="font-family:var(--font-heading); color:var(--color-text); font-size:0.8125rem; line-height:1.45;">{i.text}</span></div>)}
  </div>
</section>
