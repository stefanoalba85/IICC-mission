---
import Icon from './Icon.astro';

type Row = { icon?: string; photo?: string; title?: string; text: string };
interface Props {
  dir: string;
  kicker?: string;
  title: string;
  titleAccent: string;
  subtitle: string;
  intro: string[];
  heroQuote: string;
  heroQuoteRef: string;
  heroAlt: string;
  bandTitle: string;
  bandIntro: string;
  band: Row[];
  leftTitle: string;
  left: Row[];
  centerQuote?: string;
  centerRef?: string;
  rightTitle: string;
  right: Row[];
  box: string[];
  boxAccent: string;
  stripTitle?: string;
  strip: { title: string; text: string }[];
  supportTitle: string;
  supportText: string;
  supportCta?: string;
  supportHref?: string;
  boxUnderCenter?: boolean;
  features?: { title: string; text: string }[];
  stripLight?: boolean;
  stripNumbered?: boolean;
  supportIcon?: string;
}
const p = Astro.props;
const img = (n: string) => `/images/prison-ministry/${p.dir}/${n}.jpg`;
---
<style>
  .pm { background: #f6f4ef; }
  .pm-hero { position: relative; display: grid; grid-template-columns: 1fr 1fr; min-height: 440px; overflow: hidden; background: #f6f4ef; }
  .pm-hero__text { padding: 2.25rem 1.5rem 2rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem)); display: flex; flex-direction: column; gap: 0.9rem; position: relative; z-index: 2; }
  .pm-hero__brand { display: flex; gap: 1.5rem; align-items: center; }
  .pm-hero__brand img { width: 190px; flex-shrink: 0; }
  .pm-kicker { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.375rem; }
  .pm-title { font-family: var(--font-heading); text-transform: uppercase; color: var(--color-navy); font-size: clamp(2.25rem, 4.2vw, 3.6rem); line-height: 1; }
  .pm-title span { color: #b8892b; display: block; }
  .pm-sub { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.25rem; line-height: 1.3; margin-top: 0.5rem; }
  .pm-hero__intro p { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.1875rem; line-height: 1.5; }
  .pm-hero__photo { position: relative; }
  .pm-hero__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 20%); mask-image: linear-gradient(90deg, transparent, #000 20%); }
  .pm-hero__photo::after { content: ''; position: absolute; inset: 0 0 0 45%; background: linear-gradient(90deg, transparent, rgba(18,26,56,0.75) 45%, rgba(18,26,56,0.95)); }
  .pm-hero__quote { position: absolute; right: max(1.5rem, calc((100vw - 1200px) / 2)); bottom: 2rem; text-shadow: 0 1px 4px rgba(0,0,0,0.5); z-index: 2; width: 180px; color: #fff; font-family: var(--font-heading); font-size: 1.25rem; line-height: 1.35; text-align: right; }
  .pm-hero__quote::before { content: '\201C'; display: block; color: #b8892b; font-size: 3rem; line-height: 0.6; }
  .pm-hero__quote cite { display: block; color: #d9a540; font-style: normal; font-size: 1rem; margin-top: 0.35rem; }
  .pm-band { background: var(--color-navy-dark); color: #fff; text-align: center; padding-block: 1.25rem 1.75rem; border-top: 1px solid #b8892b; }
  .pm-band h2 { display: flex; justify-content: center; align-items: center; gap: 1rem; font-family: var(--font-heading); color: #d9a540; text-transform: uppercase; font-size: 1.75rem; }
  .pm-band h2::before, .pm-band h2::after { content: ''; width: 8rem; height: 1px; background: #b8892b; }
  .pm-band > .wrap > p { font-family: var(--font-heading); font-size: 1.125rem; line-height: 1.45; max-width: 760px; margin: 0.5rem auto 1.25rem; }
  .pm-band__grid { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; }
  .pm-band__grid > div { border-right: 1px solid rgba(184,137,43,0.4); padding-inline: 0.75rem; display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
  .pm-band__grid > div:last-child { border-right: none; }
  .pm-band__grid i { width: 6rem; height: 6rem; border-radius: 50%; border: 1.5px solid #b8892b; display: flex; align-items: center; justify-content: center; color: #fff; margin-bottom: 0.4rem; }
  .pm-band__grid h3 { font-family: var(--font-heading); text-transform: uppercase; font-size: 1.125rem; font-weight: 400; }
  .pm-band__grid p { font-family: var(--font-heading); font-size: 1.0625rem; line-height: 1.35; color: rgba(255,255,255,0.9); }
  .pm-three { display: grid; grid-template-columns: 1fr 0.9fr 1fr; gap: 1.75rem; padding-block: 1.5rem; }
  .pm-h { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.375rem; border-bottom: 2px solid #d9a540; display: inline-block; padding-bottom: 0.25rem; margin-bottom: 0.9rem; }
  .pm-rows { display: flex; flex-direction: column; gap: 0.9rem; }
  .pm-row { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.875rem; align-items: start; }
  .pm-row i { width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--color-navy-dark); color: #d9a540; display: flex; align-items: center; justify-content: center; }
  .pm-row h3 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.0625rem; font-weight: 400; }
  .pm-row p { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.0625rem; line-height: 1.35; }
  .pm-center { background: var(--color-navy-dark); color: #fff; display: flex; flex-direction: column; }
  .pm-center--photo { height: 100%; }
  .pm-center--photo img { aspect-ratio: auto; height: 100%; -webkit-mask-image: none; mask-image: none; }
  .pm-center img { width: 100%; aspect-ratio: 294 / 245; object-fit: cover; -webkit-mask-image: linear-gradient(#000 75%, transparent); mask-image: linear-gradient(#000 75%, transparent); }
  .pm-center blockquote { margin: -2rem 0 0; position: relative; padding: 0 1.5rem 1.5rem 3rem; font-family: var(--font-heading); font-size: 1.25rem; line-height: 1.4; }
  .pm-center blockquote::before { content: '\201C'; position: absolute; left: 1rem; top: -0.25rem; color: #d9a540; font-size: 3rem; line-height: 1; }
  .pm-center cite { display: block; font-style: italic; color: #d9a540; font-size: 1rem; margin-top: 0.75rem; text-align: center; }
  .pm-box { border: 1px solid #c9a96a; border-radius: 8px; padding: 1rem 1.25rem; margin-top: 1rem; display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; align-items: start; }
  .pm-box i { width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1.5px solid #b8892b; color: var(--color-navy); display: flex; align-items: center; justify-content: center; }
  .pm-box p { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1rem; line-height: 1.3; }
  .pm-box p.accent { color: #b8892b; font-size: 1.0625rem; margin-top: 0.4rem; grid-column: 1 / -1; text-align: center; }
  .pm-strip { background: var(--color-navy-dark); color: #fff; padding-block: 0.75rem 1.25rem; }
  .pm-strip h2 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; text-align: center; font-size: 1.375rem; background: #f6f4ef; margin-top: -0.75rem; padding-block: 0.5rem 0.75rem; }
  .pm-strip__grid { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0.5rem; }
  .pm-strip__grid div { text-align: center; }
  .pm-strip__grid img { width: 100%; aspect-ratio: 185 / 122; object-fit: cover; }
  .pm-strip__grid h3 { font-family: var(--font-heading); color: #d9a540; text-transform: uppercase; font-size: 0.9375rem; font-weight: 400; margin-top: 0.5rem; }
  .pm-strip__grid p { font-family: var(--font-heading); font-size: 0.875rem; line-height: 1.35; }
  .pm-support { background: var(--color-navy-dark); color: #fff; border-top: 1px solid rgba(184,137,43,0.5); }
  .pm-features { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; padding-top: 0.75rem; }
  .pm-features div { border: 1px solid rgba(27,39,81,0.15); background: #fff; }
  .pm-features img { width: 100%; aspect-ratio: 240 / 150; object-fit: cover; }
  .pm-features h3 { background: var(--color-navy-dark); color: #d9a540; font-family: var(--font-heading); text-transform: uppercase; font-size: 0.875rem; font-weight: 400; text-align: center; padding: 0.3rem; }
  .pm-features p { font-family: var(--font-heading); color: var(--color-navy); font-size: 0.9375rem; line-height: 1.35; padding: 0.5rem 1rem 0.75rem; }
  @media (max-width: 900px) { .pm-features { grid-template-columns: 1fr 1fr; } }
  .pm-row--photo { grid-template-columns: 8rem 1fr; border-bottom: 1px solid rgba(184,137,43,0.4); padding-bottom: 0.6rem; }
  .pm-row--photo img { width: 100%; aspect-ratio: 128 / 92; object-fit: cover; }
  .pm-strip--light { background: #f6f4ef; color: var(--color-navy); }
  .pm-strip--light h2 { background: none; }
  .pm-strip--light .pm-strip__grid div { text-align: left; }
  .pm-strip--light .pm-strip__grid h3 { color: var(--color-navy); display: flex; gap: 0.4rem; align-items: center; }
  .pm-strip--light .pm-strip__grid h3 b { width: 1.5rem; height: 1.5rem; border-radius: 50%; background: #c9962a; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; flex-shrink: 0; }
  .pm-support .wrap { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1.25rem; align-items: center; padding-block: 1rem; }
  .pm-support h2 { font-family: var(--font-heading); font-weight: 400; font-size: 1.375rem; }
  .pm-support p { font-family: var(--font-heading); color: rgba(255,255,255,0.85); }
  .pm-support a { background: #c9962a; color: var(--color-navy-dark); border-radius: 999px; padding: 0.6rem 1.5rem; font-family: var(--font-heading); text-transform: uppercase; font-size: 0.9375rem; }
  @media (max-width: 900px) {
    .pm-hero, .pm-three, .pm-support .wrap { grid-template-columns: 1fr; }
    .pm-hero__photo { min-height: 320px; }
    .pm-hero__brand img { width: 100px; }
    .pm-band__grid, .pm-strip__grid { grid-auto-flow: row; grid-template-columns: 1fr 1fr; row-gap: 1.25rem; }
    .pm-band__grid > div { border-right: none; min-width: 0; }
  }
  @media (max-width: 520px) { .pm-band__grid { grid-template-columns: 1fr; } .pm-band__grid i { width: 4.5rem; height: 4.5rem; } }
  @media (max-width: 900px) {
    .pm-hero__quote { position: static; width: auto; background: var(--color-navy-dark); padding: 1.25rem 1.5rem; text-shadow: none; }
    .pm-hero__photo::after { display: none; }
  }
  @media (max-width: 600px) {
    .pm-hero__brand { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .pm-hero__brand img { width: 84px; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .pm-band__grid { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 1.25rem; }
    .pm-band__grid > div { border-right: none; }
  }
</style>

<div class="pm">
  <section class="pm-hero">
    <div class="pm-hero__text">
      <div class="pm-hero__brand">
        <img src="/IICC_Logo_main.png" alt="IICC Mission" />
        <div>
          {p.kicker && <p class="pm-kicker" set:html={p.kicker} />}
          <h1 class="pm-title">{p.title && <Fragment set:html={p.title} />}<span set:html={p.titleAccent} /></h1>
          <p class="pm-sub">{p.subtitle}</p>
        </div>
      </div>
      <span class="heart-rule" style="max-width:none; margin-block:0.25rem;">♡</span>
      <div class="pm-hero__intro">{p.intro.map(t => <p>{t}</p>)}</div>
    </div>
    <div class="pm-hero__photo"><img src={img('hero')} alt={p.heroAlt} /></div>
    <p class="pm-hero__quote">{p.heroQuote}<cite>– {p.heroQuoteRef}</cite></p>
  </section>

  <section class="pm-band">
    <div class="wrap">
      <h2>{p.bandTitle}</h2>
      <p>{p.bandIntro}</p>
      <div class="pm-band__grid">
        {p.band.map(b => <div><i><Icon name={b.icon} size={50} /></i><h3>{b.title}</h3><p>{b.text}</p></div>)}
      </div>
    </div>
  </section>

  {p.features && (
    <section class="wrap pm-features">
      {p.features.map((f, i) => <div><img src={img(`f${i + 1}`)} alt="" /><h3>{f.title}</h3><p>{f.text}</p></div>)}
    </section>
  )}

  <section class="wrap pm-three">
    <div>
      <h2 class="pm-h">{p.leftTitle}</h2>
      <div class="pm-rows">{p.left.map(r => <div class="pm-row"><i><Icon name={r.icon ?? 'check'} size={26} /></i><div>{r.title && <h3>{r.title}</h3>}<p>{r.text}</p></div></div>)}</div>
    </div>
    <div>
      <figure class={`pm-center ${p.centerQuote ? '' : 'pm-center--photo'}`} style="margin:0;">
        <img src={img('center')} alt="" />
        {p.centerQuote && <blockquote>{p.centerQuote}<cite>– {p.centerRef}</cite></blockquote>}
      </figure>
      {p.boxUnderCenter && <div class="pm-box"><i><Icon name="heart" size={18} /></i><div>{p.box.map(b => <p>{b}</p>)}</div><p class="accent">{p.boxAccent}</p></div>}
    </div>
    <div>
      <h2 class="pm-h">{p.rightTitle}</h2>
      <div class="pm-rows">{p.right.map(r => r.photo ? <div class="pm-row pm-row--photo"><img src={img(r.photo)} alt="" /><div>{r.title && <h3>{r.title}</h3>}<p>{r.text}</p></div></div> : <div class="pm-row"><i><Icon name={r.icon ?? 'check'} size={26} /></i><div>{r.title && <h3>{r.title}</h3>}<p>{r.text}</p></div></div>)}</div>
      {!p.boxUnderCenter && <div class="pm-box"><i><Icon name="heart" size={18} /></i><div>{p.box.map(b => <p>{b}</p>)}</div><p class="accent">{p.boxAccent}</p></div>}
    </div>
  </section>

  <section class={`pm-strip ${p.stripLight ? 'pm-strip--light' : ''}`}>
    {p.stripTitle && <h2>{p.stripTitle}</h2>}
    <div class="wrap pm-strip__grid">
      {p.strip.map((s, i) => <div><img src={img(`s${i + 1}`)} alt="" /><h3>{p.stripNumbered && <b>{i + 1}</b>}{s.title}</h3><p>{s.text}</p></div>)}
    </div>
  </section>

  <section class="pm-support">
    <div class="wrap">
      <span style="color:#d9a540;"><Icon name={p.supportIcon ?? 'heart'} size={40} /></span>
      <div><h2>{p.supportTitle}</h2><p>{p.supportText}</p></div>
      <a href={p.supportHref ?? '/donate'}>{p.supportCta ?? 'Become Part of This Mission'} ›</a>
    </div>
  </section>
</div>
