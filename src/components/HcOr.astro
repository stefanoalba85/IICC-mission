---
import Icon from './Icon.astro';
interface Props { leftTitle: string; leftText: string; leftCta?: string; leftHref?: string; rightTitle: string; rightText: string; }
const p = Astro.props;
---
<section class="wrap" style="padding-block:1rem;">
  <div style="position:relative; display:grid; grid-template-columns:1fr 1fr; gap:0.25rem;" class="camp-grid hc-or">
    <div style="background:var(--color-navy-dark); color:#fff; padding:1.5rem; display:grid; grid-template-columns:5.5rem 1fr; gap:1.25rem; align-items:center;"><span style="width:5.5rem; height:5.5rem; border-radius:50%; border:1.5px solid #c9962a; display:flex; align-items:center; justify-content:center;"><Icon name="people-group" size={44} /></span><div><h2 style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400; font-size:1.25rem;" set:html={p.leftTitle} /><p style="font-size:0.9375rem; line-height:1.5; margin-block:0.5rem 0.9rem;">{p.leftText}</p><a href={p.leftHref ?? "/programs/hope-companion/become-a-companion"} class="btn btn--amber">{p.leftCta ?? 'Apply Now'} →</a></div></div>
    <div style="background:#b97a14; color:#fff; padding:1.5rem 1.5rem 1.5rem 2.75rem; display:grid; grid-template-columns:5.5rem 1fr; gap:1.25rem; align-items:center;"><span style="width:5.5rem; height:5.5rem; border-radius:50%; border:1.5px solid #fff; display:flex; align-items:center; justify-content:center;"><Icon name="hand-holding-heart" size={44} /></span><div><h2 style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400; font-size:1.25rem;" set:html={p.rightTitle} /><p style="font-size:0.9375rem; line-height:1.5; margin-block:0.5rem 0.9rem;">{p.rightText}</p><a href="/donate" class="btn btn--navy">Donate Now →</a></div></div>
    <span class="hc-or__badge" style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:3.25rem; height:3.25rem; border-radius:50%; background:#fff; color:var(--color-navy); font-family:var(--font-heading); font-weight:700; display:flex; align-items:center; justify-content:center;">OR</span>
  </div>
</section>
