---
interface CTAButton {
  label: string;
  href: string;
  primary?: boolean;
}

interface Props {
  eyebrow?: string;
  headline: string;
  subtext?: string;
  buttons: CTAButton[];
  dark?: boolean;
}

const { eyebrow, headline, subtext, buttons, dark = false } = Astro.props;
---

<section class={`cta-section ${dark ? 'cta-section--dark' : 'cta-section--light'}`}>
  <div class="cta-inner">
    {eyebrow && <p class="cta-eyebrow">{eyebrow}</p>}
    <h2 class="cta-headline">{headline}</h2>
    {subtext && <p class="cta-subtext">{subtext}</p>}
    <div class="cta-buttons">
      {buttons.map((btn) => (
        <a href={btn.href} class={btn.primary ? 'btn-primary' : 'btn-outline'}>
          {btn.label} →
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .cta-section--dark {
    background-color: var(--color-navy-dark);
    border-top: 1px solid rgba(201,160,23,0.2);
  }
  .cta-section--light {
    background-color: var(--color-offwhite);
  }
  .cta-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .cta-eyebrow {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
  }
  .cta-headline {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.25;
    margin-bottom: 1rem;
  }
  .cta-section--dark .cta-headline {
    color: white;
  }
  .cta-section--light .cta-headline {
    color: var(--color-navy);
  }
  .cta-subtext {
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 2rem;
    color: inherit;
    opacity: 0.75;
  }
  .cta-section--dark .cta-subtext {
    color: rgba(255,255,255,0.7);
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  .cta-section--dark .btn-outline {
    color: rgba(255,255,255,0.85);
    border-color: rgba(255,255,255,0.4);
  }
  .cta-section--dark .btn-outline:hover {
    background-color: rgba(255,255,255,0.1);
    border-color: white;
    color: white;
  }
</style>
