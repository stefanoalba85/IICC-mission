---
interface Props { quote: string; cite?: string; left?: string; right?: string; }
const p = Astro.props;
---
<section style="position:relative; background:linear-gradient(180deg,#f9e2c2,#f3cf9f); overflow:hidden;">
  {p.left && <img src={p.left} alt="" style="position:absolute; left:0; top:0; height:100%; width:30%; object-fit:cover; -webkit-mask-image:linear-gradient(90deg,#000 55%,transparent); mask-image:linear-gradient(90deg,#000 55%,transparent);" />}
  {p.right && <img src={p.right} alt="" style="position:absolute; right:0; top:0; height:100%; width:42%; object-fit:cover; -webkit-mask-image:linear-gradient(90deg,transparent,#000 40%); mask-image:linear-gradient(90deg,transparent,#000 40%);" />}
  <div class="wrap" style="position:relative; padding-block:1.5rem; min-height:130px; display:flex; align-items:center;">
    <blockquote style={`margin:0 ${p.left ? 'auto' : '0'}; max-width:28rem; display:grid; grid-template-columns:3rem 1fr; gap:0.5rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:1.3125rem; line-height:1.3;`}>
      <span style="color:#d4932a; font-size:4rem; line-height:0.8; font-style:normal;">&ldquo;</span>
      <div>{p.quote}{p.cite && <cite style="display:block; font-style:normal; font-size:0.9375rem; margin-top:0.3rem;">— {p.cite}</cite>}<span style="display:block; text-align:center; color:#d4932a; font-style:normal;">— ♥ —</span></div>
    </blockquote>
  </div>
</section>
