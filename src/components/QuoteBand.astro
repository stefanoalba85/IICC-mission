---
interface Props {
  quote: string;
  reference?: string;
  italic?: boolean;
  dark?: boolean;
}
const { quote, reference, italic = true, dark = true } = Astro.props;
---

<section class={`quote-band ${dark ? 'quote-band--dark' : 'quote-band--light'}`}>
  <div class="quote-band-inner">
    <div class="quote-mark">&ldquo;</div>
    <blockquote class={`quote-text ${italic ? 'italic' : ''}`}>
      {quote}
    </blockquote>
    {reference && (
      <cite class="quote-ref">— {reference}</cite>
    )}
  </div>
</section>

<style>
  .quote-band {
    padding: 3.5rem 1.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .quote-band--dark {
    background-color: var(--color-navy);
  }
  .quote-band--light {
    background-color: var(--color-offwhite);
  }
  .quote-band-inner {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
  }
  .quote-mark {
    font-family: var(--font-heading);
    font-size: 5rem;
    line-height: 1;
    color: var(--color-gold);
    opacity: 0.35;
    position: absolute;
    top: -1rem;
    left: -1rem;
    font-style: italic;
    pointer-events: none;
    user-select: none;
  }
  .quote-text {
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.65;
    margin: 0 0 1rem;
    padding: 0 2rem;
    position: relative;
  }
  .quote-band--dark .quote-text {
    color: rgba(255,255,255,0.9);
  }
  .quote-band--light .quote-text {
    color: var(--color-navy);
  }
  .quote-text.italic {
    font-style: italic;
  }
  .quote-ref {
    display: block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-style: normal;
    letter-spacing: 0.12em;
    font-weight: 600;
  }
  .quote-band--dark .quote-ref {
    color: var(--color-gold);
  }
  .quote-band--light .quote-ref {
    color: var(--color-gold-dark);
  }
</style>
