---
interface Props { img: string; text: string; }
const p = Astro.props;
---
<div style="position:relative; border-radius:6px; overflow:hidden; min-height:250px; background:var(--color-navy-dark);">
  <img src={p.img} alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:right bottom;" />
  <div style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(18,26,56,0.85) 0%, rgba(18,26,56,0.35) 55%, transparent 80%);"></div>
  <p style="position:relative; padding:1.25rem 1.25rem 0; color:#fff; font-family:var(--font-heading); font-style:italic; font-size:1.25rem; line-height:1.3; max-width:15rem;">{p.text}<span style="display:block; color:#e2a93b; font-style:normal; margin-top:0.5rem;">— ♡ —</span></p>
</div>
