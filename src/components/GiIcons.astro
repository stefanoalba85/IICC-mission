---
import Icon from './Icon.astro';
interface Props { items: { icon: string; title: string; text: string }[]; dark?: boolean; }
const p = Astro.props;
---
<section style={`background:${p.dark ? 'var(--color-navy-dark)' : '#fbf6ec'}; color:${p.dark ? '#fff' : 'var(--color-navy)'};`}>
  <div class="wrap camp-grid" style={`display:grid; grid-template-columns:repeat(${p.items.length},1fr); padding-block:1.25rem;`}>
    {p.items.map((i, k) => <div style={`text-align:center; ${k ? 'border-left:1px solid rgba(201,150,42,0.4);' : ''} padding-inline:0.75rem; display:flex; flex-direction:column; align-items:center; gap:0.35rem;`}><span style={`width:4.25rem; height:4.25rem; border-radius:50%; ${p.dark ? 'border:2px solid #d9862a; color:#d9862a;' : 'background:var(--color-navy-dark); color:#d9a540;'} display:flex; align-items:center; justify-content:center;`}><Icon name={i.icon} size={30} /></span><strong style="font-family:var(--font-heading); text-transform:uppercase; font-weight:700; font-size:1rem; line-height:1.2;">{i.title}</strong><span style="font-family:var(--font-heading); font-size:0.9375rem; line-height:1.35;">{i.text}</span></div>)}
  </div>
</section>
