---
import Icon from './Icon.astro';
interface Props { title: string; text: string; cta: string; href?: string; }
const p = Astro.props;
---
<section style="background:var(--color-navy-dark); color:#fff;">
  <div class="m-cta wrap" style="display:grid; grid-template-columns:4rem 1fr auto; gap:1.25rem; align-items:center; padding-block:1.1rem;">
    <span style="color:#d9a540;"><Icon name="heart" size={50} /></span>
    <div><h2 style="font-family:var(--font-heading); text-transform:uppercase; font-size:1.25rem; font-weight:400;">{p.title}</h2><p style="font-family:var(--font-heading); font-size:1.0625rem; margin-top:0.2rem;">{p.text}</p></div>
    <a href={p.href ?? '/get-involved'} class="btn btn--amber" style="font-family:var(--font-heading); font-size:1rem; padding:0.8rem 1.5rem;">{p.cta} →</a>
  </div>
</section>
