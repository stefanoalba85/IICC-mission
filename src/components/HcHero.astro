---
interface Props { title: string; sub: string; text: string[]; accent?: string; img: string; alt: string; quote?: string; quoteRef?: string; buttons?: { label: string; href: string; outline?: boolean }[]; kicker?: string; }
const p = Astro.props;
---
<style>
  .hc { display: grid; grid-template-columns: 0.85fr 1.15fr; min-height: 420px; position: relative; overflow: hidden; background: #fff; }
  .hc__text { padding: 1.75rem 1.5rem 1.75rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem)); display: flex; flex-direction: column; gap: 0.6rem; }
  .hc__kick { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 0.875rem; display: flex; align-items: center; gap: 0.75rem; }
  .hc__kick::after { content: ''; width: 3rem; height: 1px; background: #c9962a; }
  .hc h1 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.02; }
  .hc h1 :global(span) { color: #b8892b; }
  .hc__sub { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.3125rem; line-height: 1.3; }
  .hc__text p.t { font-size: 0.9375rem; line-height: 1.55; color: var(--color-navy); }
  .hc__acc { font-family: var(--font-heading); color: #b8892b; font-size: 1.0625rem; line-height: 1.4; }
  .hc__photo { position: relative; }
  .hc__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%); mask-image: linear-gradient(90deg, transparent, #000 18%); }
  .hc__q { position: absolute; right: max(1rem, calc((100vw - 1200px) / 2)); top: 1.75rem; width: 175px; background: rgba(18,26,56,0.95); border: 1.5px solid #c9962a; border-radius: 6px; padding: 1.1rem 1rem; color: #fff; font-family: var(--font-heading); font-size: 1.0625rem; line-height: 1.4; z-index: 2; }
  .hc__q::before { content: '\201C'; display: block; color: #d9a540; font-size: 3rem; line-height: 0.6; margin-bottom: 0.25rem; }
  .hc__q cite { display: block; color: #d9a540; font-style: normal; margin-top: 0.5rem; }
  @media (max-width: 900px) { .hc { grid-template-columns: 1fr; } .hc__photo { min-height: 300px; } .hc__q { position: static; width: auto; margin: 1rem; } }
</style>
<section class="hc">
  <div class="hc__text">
    <p class="hc__kick">{p.kicker ?? 'Hope Companion Program'}</p>
    <h1 set:html={p.title} />
    <p class="hc__sub" set:html={p.sub} />
    {p.text.map(t => <p class="t">{t}</p>)}
    {p.accent && <p class="hc__acc" set:html={p.accent} />}
    {p.buttons && <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:0.25rem;">{p.buttons.map(b => <a href={b.href} class={b.outline ? 'btn btn--outline' : 'btn btn--navy'}>{b.label} →</a>)}</div>}
  </div>
  <div class="hc__photo"><img src={p.img} alt={p.alt} /></div>
  {p.quote && <p class="hc__q">{p.quote}<cite>– {p.quoteRef}</cite></p>}
</section>
