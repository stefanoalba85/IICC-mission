---
interface Props { items: [string, string][]; }
---
<section class="wrap" style="padding-bottom:1rem;">
  <h2 class="camp-h">Journeys of Hope</h2>
  <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:0.75rem; margin-top:0.6rem;" class="camp-grid">
    {Astro.props.items.map(([q, by]) => <blockquote style="margin:0; border:1px solid #d8d8e2; border-radius:6px; padding:1rem 1rem 1rem 2.5rem; position:relative; font-family:var(--font-heading); color:var(--color-navy); font-size:0.9375rem; line-height:1.45;"><span style="position:absolute; left:0.75rem; top:0.5rem; color:#8890a8; font-size:2.25rem; line-height:1;">&ldquo;</span>{q}<cite style="display:block; color:#b8892b; font-style:normal; margin-top:0.5rem;">– {by}</cite></blockquote>)}
  </div>
</section>
