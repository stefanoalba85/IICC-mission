---
interface Props { kicker: string; title: string; sub?: string; text: string; img: string; alt: string; quote: string; quoteRef?: string; cta?: string; href?: string; dark?: boolean; }
const p = Astro.props;
---
<section class="gih">
  <div class="gih__main">
  <img class="gih__logo" src="/IICC_Logo_main.png" alt="IICC Mission" />
  <div class="gih__text">
    <p style="font-family:var(--font-heading); color:#c9741f; text-transform:uppercase; font-size:1.125rem; display:flex; align-items:center; gap:0.75rem;"><span style="width:2.5rem; height:1px; background:#c9741f;"></span>{p.kicker}<span style="width:2.5rem; height:1px; background:#c9741f;"></span></p>
    <h1 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:clamp(2rem,4.2vw,3.25rem); line-height:1;" set:html={p.title} />
    {p.sub && <p style="font-family:var(--font-heading); color:var(--color-navy); font-size:1.3125rem; line-height:1.3;" set:html={p.sub} />}
    <p style="font-family:var(--font-heading); color:var(--color-navy); font-size:1rem; line-height:1.5;">{p.text}</p>
    {p.cta && <a href={p.href ?? '/donate'} class="btn btn--amber" style="align-self:flex-start; font-size:1rem; padding:0.8rem 1.6rem;">{p.cta} →</a>}
  </div>
  </div>
  <div style="position:relative; min-height:300px;"><img src={p.img} alt={p.alt} style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; -webkit-mask-image:linear-gradient(90deg,transparent,#000 22%); mask-image:linear-gradient(90deg,transparent,#000 22%);" /></div>
  <p class="hero-quote" style="position:absolute; right:max(1rem, calc((100vw - 1200px) / 2)); top:50%; transform:translateY(-50%); width:190px; background:rgba(18,26,56,0.95); border:1.5px solid #c9962a; padding:1.25rem 1rem; color:#fff; font-family:var(--font-heading); font-style:italic; font-size:1.0625rem; line-height:1.45;"><span style="display:block; color:#d9862a; font-size:3rem; line-height:0.6; font-style:normal;">&ldquo;</span>{p.quote}{p.quoteRef && <span style="display:block; color:#d9862a; font-style:normal; margin-top:0.5rem;">— {p.quoteRef}</span>}<span style="display:block; text-align:center; color:#d9862a; margin-top:0.5rem; font-style:normal;">♡</span></p>
</section>

<style>
  /* Logo + text form one block aligned with the site container, so the logo can never overlap the text at any width. */
  .gih { position: relative; display: grid; grid-template-columns: 1.7fr 1.3fr; min-height: 400px; background: #fbf9f4; overflow: hidden; }
  .gih__main { display: grid; grid-template-columns: clamp(130px, 13vw, 190px) minmax(0, 1fr); gap: 1.5rem; align-items: center; padding: 1.75rem 1rem 1.75rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem)); }
  .gih__logo { width: 100%; }
  .gih__text { display: flex; flex-direction: column; gap: 0.6rem; text-align: left; }
  @media (max-width: 900px) {
    .gih { grid-template-columns: 1fr; }
    .gih__main { grid-template-columns: 1fr; gap: 0; padding: 0; }
    .gih__logo { max-width: 120px; margin: 1.25rem 0 0 1.5rem; }
    .gih__text { padding: 1.75rem 1rem; }
  }
</style>
