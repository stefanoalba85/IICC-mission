---
import * as fa from '@fortawesome/free-solid-svg-icons';
import type { IconDefinition } from '@fortawesome/free-solid-svg-icons';

// Project aliases; any other Font Awesome solid icon can be used by its kebab name (e.g. "brain", "gavel").
const alias: Record<string, string> = {
  pray: 'hands-praying', people: 'people-group', person: 'user', scales: 'scale-balanced', heartHand: 'hand-holding-heart',
  sunRoad: 'mountain-sun', home: 'house', bars: 'building-lock', megaphone: 'bullhorn', calendar: 'calendar-days',
  mail: 'envelope', pin: 'location-dot', ear: 'ear-listen', signpost: 'signs-post', shield: 'shield-halved',
  bread: 'bread-slice', medal: 'award', video: 'clapperboard', book: 'book-open',
};

interface Props { name: string; size?: number; stroke?: number; class?: string; fill?: boolean; }
const { name, size = 24, class: cls } = Astro.props;
const key = 'fa' + (alias[name] ?? name).split('-').map(s => s[0].toUpperCase() + s.slice(1)).join('');
const def = (fa as unknown as Record<string, IconDefinition>)[key];
if (!def) throw new Error(`Unknown icon "${name}" (${key})`);
const [w, h, , , path] = def.icon;
const d = Array.isArray(path) ? path.join(' ') : path;
const box = Math.max(w, h);
---
<svg class={cls} width={size} height={size} viewBox={`${(w - box) / 2} ${(h - box) / 2} ${box} ${box}`} fill="currentColor" aria-hidden="true"><path d={d} /></svg>
