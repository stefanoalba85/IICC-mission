---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; buttons?: { label: string; icon?: string; kind?: 'amber' | 'white' | 'green'; href?: string }[]; light?: boolean; }
const p = Astro.props;
const st = (k?: string) => k === 'white' ? 'background:#fff; color:var(--color-navy); border:1px solid #fff;' : k === 'green' ? 'background:#2f6b2a; color:#fff;' : 'background:#c9741f; color:#fff;';
---
<div style={`${p.light ? 'background:#f7f3ec; color:var(--color-navy);' : 'background:var(--color-navy-dark); color:#fff;'} border-radius:6px; padding:1.25rem; display:flex; flex-direction:column; gap:0.6rem; text-align:center; height:100%; justify-content:center;`}>
  {p.title && <h2 style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400; font-size:1.1875rem;">{p.title}</h2>}
  {p.title && <span style="color:#d9862a;">♡</span>}
  {p.text && <p style="font-family:var(--font-heading); font-size:0.9375rem; line-height:1.45;">{p.text}</p>}
  <slot />
  {p.buttons?.map(b => <a href={b.href ?? (b.kind === 'green' ? 'https://www.gofundme.com' : '/donate')} style={`${st(b.kind)} border-radius:3px; padding:0.6rem 1rem; font-family:var(--font-heading); text-transform:uppercase; font-size:0.875rem; display:flex; justify-content:center; align-items:center; gap:0.6rem;`}>{b.icon && <Icon name={b.icon} size={16} />}{b.label} →</a>)}
</div>
