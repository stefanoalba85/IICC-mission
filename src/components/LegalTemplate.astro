---
import Icon from './Icon.astro';
interface Tab { icon: string; label: string; href: string; }
interface Props {
  kicker: string; title: string; titleGold: string; text: string[]; img: string; alt: string; quote: string;
  tabs: Tab[]; links?: string[]; activeLink?: string;
}
const p = Astro.props;
const linkMap: Record<string, string> = {
  'Our Mission': '/about-us/our-mission', 'Our Services': '/our-services/who-we-serve', 'Our Programs': '/programs/hope-companion',
  'Get Involved': '/get-involved', 'Donate': '/donate', 'Volunteer': '/get-involved/volunteer-program', 'Partnerships': '/partnerships',
  'Partnership Opportunities': '/partnerships/churches-parish-partners', 'Rome Headquarters': '/partnerships/rome-headquarters',
  'News & Events': '/news', 'Legal & Governance': '/terms-conditions', 'Privacy Policy': '/privacy-policy',
  'Terms & Conditions': '/terms-conditions', 'Accessibility Statement': '/accessibility-statement', 'Contact Us': '/contact',
};
const links = p.links ?? ['Our Mission', 'Our Services', 'Our Programs', 'Get Involved', 'Donate', 'Volunteer', 'Partnerships', 'Legal & Governance', 'Privacy Policy', 'Terms & Conditions', 'Accessibility Statement', 'Contact Us'];
---
<style>
  .lg-hero { position: relative; background: var(--color-navy-dark); color: #fff; min-height: 400px; overflow: hidden; }
  .lg-hero > img { position: absolute; top: 0; right: 0; width: 72%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 35%); mask-image: linear-gradient(90deg, transparent, #000 35%); }
  .lg-hero__in { position: relative; display: grid; grid-template-columns: 1fr 200px; gap: 2rem; align-items: center; padding-block: 2.5rem; min-height: 400px; }
  .lg-hero__txt { max-width: 410px; display: flex; flex-direction: column; gap: 0.8rem; }
  .lg-kick { font-family: var(--font-heading); color: #e2a93b; text-transform: uppercase; font-size: 1rem; display: flex; align-items: center; gap: 0.75rem; }
  .lg-kick::after { content: ''; width: 6rem; height: 1px; background: #e2a93b; }
  .lg-hero h1 { font-family: var(--font-heading); text-transform: uppercase; font-size: clamp(2.1rem, 4.4vw, 3.25rem); line-height: 1.02; text-shadow: 0 2px 10px rgba(0,0,0,0.4); }
  .lg-hero h1 span { color: #e2a93b; display: block; }
  .lg-hero__txt p { font-family: var(--font-heading); font-size: 1.0625rem; line-height: 1.45; text-shadow: 0 1px 6px rgba(0,0,0,0.5); }
  .lg-hero__txt p + p { font-size: 0.9375rem; border-top: 1px solid rgba(226,169,59,0.5); padding-top: 0.75rem; }
  .lg-quote { background: rgba(18,26,56,0.95); border: 1.5px solid #c9962a; border-radius: 4px; padding: 1.25rem 1.1rem; font-family: var(--font-heading); font-style: italic; font-size: 1.1875rem; line-height: 1.4; }
  .lg-quote::before { content: '\201C'; display: block; color: #e2a93b; font-size: 3.5rem; line-height: 0.6; font-style: normal; margin-bottom: 0.4rem; }
  .lg-quote::after { content: '♡'; display: block; text-align: center; color: #e2a93b; font-style: normal; margin-top: 0.6rem; }
  .lg-tabs { border-bottom: 1px solid rgba(27,39,81,0.1); background: #fff; }
  .lg-tabs .wrap { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; }
  .lg-tabs a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; text-align: center; padding: 1rem 0.4rem; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; color: var(--color-navy); line-height: 1.25; border-left: 1px solid rgba(27,39,81,0.08); }
  .lg-tabs a:first-child { border-left: none; background: #fbefdc; color: var(--color-navy); border-bottom: 3px solid #e2a93b; }
  .lg-tabs a:first-child :global(svg) { color: #c9741f; }
  .lg-tabs a:hover { background: #fbf6ec; }
  .lg-body { display: grid; grid-template-columns: 1fr 280px; gap: 2rem; padding-block: 1.75rem 2rem; align-items: start; }
  .lg-main { min-width: 0; }
  .lg-main :global(h2) { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.5rem; display: flex; align-items: center; gap: 1rem; margin-top: 1.4rem; scroll-margin-top: 6rem; }
  .lg-main :global(h2:first-child) { margin-top: 0; }
  .lg-main :global(h2)::after { content: ''; flex: 1; max-width: 18rem; height: 1px; background: #e2a93b; }
  .lg-main :global(p) { font-family: var(--font-heading); color: var(--color-navy); font-size: 0.9375rem; line-height: 1.55; margin-top: 0.4rem; padding-left: 1.6rem; }
  .lg-main :global(ul.lg-check) { list-style: none; margin: 0.4rem 0 0; padding-left: 1.6rem; }
  .lg-main :global(ul.lg-check li) { display: flex; gap: 0.6rem; align-items: center; font-family: var(--font-heading); color: var(--color-navy); font-size: 0.9375rem; padding-block: 0.12rem; }
  .lg-main :global(ul.lg-check li)::before { content: '✓'; flex-shrink: 0; width: 1.05rem; height: 1.05rem; border-radius: 50%; background: #d4932a; color: #fff; font-size: 0.6875rem; display: flex; align-items: center; justify-content: center; font-family: var(--font-body); }
  .lg-main :global(.lg-icons) { display: grid; grid-template-columns: repeat(6, 1fr); margin: 0.9rem 0 0.4rem 1.6rem; }
  .lg-main :global(.lg-icons span) { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; text-align: center; font-family: var(--font-heading); color: var(--color-navy); font-size: 0.8125rem; line-height: 1.3; padding-inline: 0.3rem; border-left: 1px solid rgba(27,39,81,0.12); }
  .lg-main :global(.lg-icons span:first-child) { border-left: none; }
  .lg-side { display: flex; flex-direction: column; gap: 1rem; }
  :global(.lg-box) { background: #f8f6f1; border: 1px solid rgba(27,39,81,0.06); border-radius: 4px; padding: 1rem; }
  :global(.lg-box h3) { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.0625rem; display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.6rem; }
  .lg-links { list-style: none; padding: 0.25rem 0.6rem; margin: 0; background: #fff; }
  .lg-links a { display: flex; justify-content: space-between; padding: 0.38rem 0.25rem; font-family: var(--font-heading); color: var(--color-navy); font-size: 0.875rem; border-bottom: 1px solid rgba(27,39,81,0.08); }
  .lg-links li:last-child a { border-bottom: none; }
  .lg-links a.on { background: #fbefdc; }
  .lg-links a::after { content: '›'; font-size: 1.1rem; line-height: 1; }
  @media (max-width: 960px) {
    .lg-hero > img { width: 100%; opacity: 0.25; -webkit-mask-image: none; mask-image: none; }
    .lg-hero__in { grid-template-columns: 1fr; }
    .lg-tabs .wrap { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); }
    .lg-body { grid-template-columns: 1fr; }
    .lg-main :global(.lg-icons) { grid-template-columns: repeat(3, 1fr); row-gap: 1rem; }
  }
</style>

<section class="lg-hero">
  <img src={p.img} alt={p.alt} />
  <div class="wrap lg-hero__in">
    <div class="lg-hero__txt">
      <div class="lg-kick">{p.kicker}</div>
      <h1>{p.title}<span>{p.titleGold}</span></h1>
      {p.text.map(t => <p>{t}</p>)}
    </div>
    <blockquote class="lg-quote">{p.quote}</blockquote>
  </div>
</section>

<nav class="lg-tabs" aria-label="On this page">
  <div class="wrap">
    {p.tabs.map(t => <a href={t.href}><Icon name={t.icon} size={30} />{t.label}</a>)}
  </div>
</nav>

<div class="wrap lg-body">
  <div class="lg-main"><slot /></div>
  <aside class="lg-side">
    <slot name="sidetop" />
    <div class="lg-box">
      <h3><Icon name="link" size={20} /> Quick Links</h3>
      <ul class="lg-links">
        {links.map(l => <li><a href={linkMap[l] ?? '/'} class={l === p.activeLink ? 'on' : undefined}>{l}</a></li>)}
      </ul>
    </div>
    <slot name="side" />
  </aside>
</div>
<slot name="after" />
