---
interface Props { title: string; sub: string; text: string[]; img: string; alt: string; cta?: string; ctaHref?: string; cta2?: string; cta2Href?: string; quote?: string; quoteRef?: string; kicker?: string; logo?: boolean; }
const p = Astro.props;
const logo = p.logo !== false;
---
<style>
  .rh { display: grid; grid-template-columns: 1fr 1.05fr; min-height: 380px; background: #fff; position: relative; overflow: hidden; }
  .rh__text { padding: 1.75rem 1.5rem 1.75rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem)); display: grid; grid-template-columns: auto 1fr; gap: 1.5rem; align-items: start; }
  .rh__text > img { width: 150px; }
  .rh__body { display: flex; flex-direction: column; gap: 0.7rem; }
  .rh__kick { font-family: var(--font-body); font-weight: 700; color: #c9741f; text-transform: uppercase; font-size: 0.9375rem; letter-spacing: 0.03em; }
  .rh h1 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.02; }
  .rh__sub { font-family: var(--font-heading); color: #c9741f; font-size: 1.3125rem; line-height: 1.3; }
  .rh__body p.t { font-size: 0.9375rem; line-height: 1.6; color: var(--color-navy); }
  .rh__photo { position: relative; }
  .rh__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%); mask-image: linear-gradient(90deg, transparent, #000 18%); }
  .rh__q { position: absolute; right: max(1rem, calc((100vw - 1200px) / 2)); top: 50%; transform: translateY(-50%); width: 200px; background: rgba(18,26,56,0.95); border-radius: 6px; padding: 1.25rem 1.1rem; color: #fff; font-family: var(--font-heading); font-size: 1.125rem; line-height: 1.4; z-index: 2; }
  .rh__q::before { content: '\201C'; display: block; color: #d9862a; font-size: 3rem; line-height: 0.6; margin-bottom: 0.3rem; }
  .rh__q cite { display: block; font-style: normal; font-size: 0.9375rem; margin-top: 0.5rem; }
  @media (max-width: 900px) { .rh { grid-template-columns: 1fr; } .rh__photo { min-height: 280px; } .rh__text { grid-template-columns: 1fr; } .rh__text > img { width: 100px; } .rh__q { position: static; transform: none; width: auto; margin: 1rem; } }
</style>
<section class="rh">
  <div class="rh__text">
    {logo && <img src="/IICC_Logo_main.png" alt="IICC Mission" />}
    <div class="rh__body">
      {p.kicker && <p class="rh__kick">{p.kicker}</p>}
      <h1 set:html={p.title} />
      <p class="rh__sub" set:html={p.sub} />
      {p.text.map(t => <p class="t">{t}</p>)}
      <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
        {p.cta && <a href={p.ctaHref ?? '#cats'} class="btn btn--amber">{p.cta} →</a>}
        {p.cta2 && <a href={p.cta2Href ?? '/get-involved'} class="btn btn--outline">{p.cta2} →</a>}
      </div>
    </div>
  </div>
  <div class="rh__photo"><img src={p.img} alt={p.alt} /></div>
  {p.quote && <p class="rh__q">{p.quote}<cite>— {p.quoteRef}</cite></p>}
</section>
