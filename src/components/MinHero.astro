---
interface Props { kicker?: string; title: string; subtitle: string; intro: string[]; img: string; alt: string; quote?: string; quoteRef?: string; boxed?: boolean; tagline?: string; }
const p = Astro.props;
---
<style>
  .mh { display: grid; grid-template-columns: 1fr 1fr; min-height: 400px; position: relative; overflow: hidden; background: #f6f4ef; }
  .mh__text { padding: 1.75rem 1.5rem 1.75rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem)); display: flex; flex-direction: column; gap: 0.8rem; }
  .mh__brand { display: grid; grid-template-columns: 10rem 1fr; gap: 1.5rem; align-items: center; }
  .mh__brand img { width: 100%; }
  .mh__kicker { font-family: var(--font-heading); color: #b8892b; text-transform: uppercase; font-size: 1rem; }
  .mh h1 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: clamp(1.75rem, 3.4vw, 2.6rem); line-height: 1.05; }
  .mh h1 :global(span) { color: #b8892b; }
  .mh__sub { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.1875rem; line-height: 1.3; margin-top: 0.5rem; }
  .mh__intro p { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.0625rem; line-height: 1.5; margin-bottom: 0.4rem; }
  .mh__photo { position: relative; }
  .mh__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%); mask-image: linear-gradient(90deg, transparent, #000 18%); }
  .mh__photo::after { content: ''; position: absolute; inset: 0 0 0 55%; background: linear-gradient(90deg, transparent, rgba(18,26,56,0.9) 45%); }
  .mh__quote { position: absolute; right: max(1.5rem, calc((100vw - 1200px) / 2)); bottom: 2rem; width: 175px; z-index: 2; color: #fff; font-family: var(--font-heading); font-size: 1.125rem; line-height: 1.4; }
  .mh__quote::before { content: '\201C'; display: block; color: #d9a540; font-size: 3rem; line-height: 0.6; }
  .mh__quote cite { display: block; color: #d9a540; font-style: normal; margin-top: 0.4rem; }
  .mh--boxed .mh__photo::after { display: none; }
  .mh--boxed .mh__quote { top: 50%; bottom: auto; transform: translateY(-50%); width: 190px; background: rgba(18,26,56,0.94); border: 1.5px solid #c9962a; border-radius: 6px; padding: 1.25rem 1rem; }
  .mh__tag { font-family: var(--font-heading); font-style: italic; color: var(--color-navy); font-size: 1.125rem; text-align: center; }
  @media (max-width: 900px) { .mh { grid-template-columns: 1fr; } .mh__photo { min-height: 300px; } .mh__photo::after { display: none; } .mh__brand { grid-template-columns: 6rem 1fr; } .mh__quote, .mh--boxed .mh__quote { position: static; transform: none; width: auto; margin: 0; border: none; border-radius: 0; background: var(--color-navy-dark); padding: 1.25rem 1.5rem; } }
  @media (max-width: 600px) { .mh__brand { grid-template-columns: 1fr; gap: 0.75rem; } .mh__brand img { width: 84px; } }
</style>
<section class={`mh ${p.boxed || !p.quote ? 'mh--boxed' : ''}`}>
  <div class="mh__text">
    <div class="mh__brand">
      <img src="/IICC_Logo_main.png" alt="IICC Mission" />
      <div>
        {p.kicker && <p class="mh__kicker">{p.kicker}</p>}
        <h1 set:html={p.title} />
        <p class="mh__sub" set:html={p.subtitle} />
      </div>
    </div>
    {!p.tagline && <span class="heart-rule" style="max-width:none;">♡</span>}
    <div class="mh__intro">{p.intro.map(t => <p set:html={t} />)}</div>
    {p.tagline && <><span class="heart-rule" style="max-width:none;">♡</span><p class="mh__tag">{p.tagline}</p></>}
  </div>
  <div class="mh__photo"><img src={p.img} alt={p.alt} /></div>
  {p.quote && <p class="mh__quote">{p.quote}<cite>– {p.quoteRef}</cite></p>}
</section>
