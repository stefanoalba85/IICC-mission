---
interface Props { src: string; alt?: string; quote: string; by?: string; }
const p = Astro.props;
---
<figure style="position:relative; margin:0; background:var(--color-navy-dark); overflow:hidden; min-height:260px; height:100%;">
  <img src={p.src} alt={p.alt ?? ''} style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" />
  <div style="position:absolute; inset:auto 0 0 0; height:65%; background:linear-gradient(transparent, rgba(18,26,56,0.95));"></div>
  <blockquote style="position:absolute; inset:auto 0 0 0; margin:0; padding:1rem 1.25rem 1rem 3.25rem; color:#fff; font-family:var(--font-heading); font-size:1.25rem; line-height:1.35;">
    <span style="position:absolute; left:0.9rem; top:0.5rem; color:#d9a540; font-size:3rem; line-height:1;">&ldquo;</span>
    <Fragment set:html={p.quote} />
    {p.by && <cite style="display:block; font-style:normal; color:#d9a540; font-size:0.9375rem; margin-top:0.3rem;">— {p.by}</cite>}
  </blockquote>
</figure>
