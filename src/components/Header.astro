---
interface Props { currentPath: string; }
const { currentPath } = Astro.props;

const programs = [
  { label: 'Prison Ministry',                 href: '/our-services/prison-ministry' },
  { label: 'Immigration Detention Ministry',  href: '/our-services/immigration-detention' },
  { label: 'Spiritual & Pastoral Care',       href: '/our-services/spiritual-pastoral-care' },
  { label: 'Legal Assistance & Advocacy',     href: '/advocacy' },
  { label: 'Humanitarian Support',            href: '/our-services/humanitarian-support' },
  { label: 'Hope Media Channel',              href: '/hope-media' },
  { label: 'Hope Companion Program',          href: '/get-involved#companion' },
  { label: 'Restoration Bakery',              href: '/bakery' },
];

const nav = [
  { label: 'Home',            href: '/' },
  { label: 'About Us',        href: '/about' },
  { label: 'Our Mission',     href: '/our-mission' },
  { label: 'Leadership',      href: '/our-people' },
  { label: 'Our Programs',    href: '/our-services', sub: programs },
  { label: 'Get Involved',    href: '/get-involved' },
  { label: 'Events',          href: '/events' },
  { label: 'News & Resources',href: '/news' },
  { label: 'Contact',         href: '/contact' },
];

function active(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="hdr" id="hdr">
  <div class="hdr__inner">

    <!-- Logo -->
    <a href="/" class="hdr__logo" aria-label="IICC Mission — Home">
      <img src="/IICC_Logo.png" alt="IICC Mission" class="hdr__logo-img" />
    </a>

    <!-- Desktop nav -->
    <nav class="hdr__nav" aria-label="Primary">
      <ul class="hdr__list">
        {nav.map(item => (
          <li class={`hdr__item${item.sub ? ' hdr__item--drop' : ''}`}>
            <a href={item.href} class={`hdr__link${active(item.href) ? ' hdr__link--active' : ''}`}>
              {item.label}
              {item.sub && (
                <svg width="9" height="5" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              )}
            </a>
            {item.sub && (
              <div class="hdr__drop">
                {item.sub.map(s => (
                  <a href={s.href} class="hdr__drop-link">{s.label}</a>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Donate + hamburger -->
    <div class="hdr__actions">
      <a href="/donate" class="hdr__donate">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/>
        </svg>
        DONATE
      </a>
      <button class="hdr__burger" id="burger" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile overlay -->
<div class="mob" id="mob" aria-hidden="true">
  <div class="mob__panel">
    <div class="mob__top">
      <a href="/" class="mob__logo">
        <img src="/IICC_Logo.png" alt="IICC Mission" style="height:52px;width:auto;" />
      </a>
      <button class="mob__close" id="mob-close" aria-label="Close menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <nav>
      <ul class="mob__list">
        {nav.map(item => (
          <li>
            <a href={item.href} class={`mob__link${active(item.href) ? ' mob__link--active' : ''}`}>
              {item.label}
            </a>
            {item.sub && (
              <ul class="mob__sub">
                {item.sub.map(s => (
                  <li><a href={s.href} class="mob__sub-link">{s.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="mob__foot">
      <a href="/donate" class="btn btn--amber" style="width:100%;justify-content:center;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/>
        </svg>
        DONATE NOW
      </a>
    </div>
  </div>
</div>

<style>
  /* ── Header bar ─────────────────────── */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    box-shadow: 0 1px 0 rgba(27,39,81,0.07), 0 2px 16px rgba(27,39,81,0.05);
  }
  .hdr__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding: 0.375rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* Logo */
  .hdr__logo { display: flex; align-items: center; flex-shrink: 0; }
  .hdr__logo-img { height: 52px; width: auto; display: block; }

  /* Nav */
  .hdr__nav { flex: 1; display: none; }
  @media (min-width: 1080px) { .hdr__nav { display: block; } }
  .hdr__list {
    list-style: none; padding: 0; margin: 0;
    display: flex; align-items: center; justify-content: flex-end;
    gap: 0;
  }
  .hdr__item { position: relative; }
  .hdr__link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-navy);
    padding: 0.45rem 0.5rem;
    white-space: nowrap;
    transition: color 0.2s;
    position: relative;
  }
  .hdr__link::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0.5rem; right: 0.5rem;
    height: 2px;
    background: var(--color-amber);
    transform: scaleX(0);
    transition: transform 0.2s;
    transform-origin: left;
  }
  .hdr__link:hover,
  .hdr__link--active { color: var(--color-amber); }
  .hdr__link:hover::after,
  .hdr__link--active::after { transform: scaleX(1); }

  /* Dropdown */
  .hdr__item--drop:hover .hdr__drop { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .hdr__drop {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    min-width: 240px;
    background: var(--color-navy-dark);
    border-top: 2px solid var(--color-amber);
    border: 1px solid rgba(224,123,0,0.15);
    border-top: 2px solid var(--color-amber);
    box-shadow: 0 12px 32px rgba(0,0,0,0.22);
    border-radius: 0 0 2px 2px;
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    z-index: 200;
  }
  .hdr__drop-link {
    display: block;
    padding: 0.5rem 1.125rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.82);
    transition: color 0.15s, background 0.15s;
  }
  .hdr__drop-link:hover { color: var(--color-amber); background: rgba(224,123,0,0.07); }

  /* Donate + burger */
  .hdr__actions { display: flex; align-items: center; gap: 0.75rem; margin-left: auto; flex-shrink: 0; }
  .hdr__donate {
    display: none;
    align-items: center;
    gap: 0.375rem;
    background: var(--color-amber);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    border-radius: 2px;
    white-space: nowrap;
    transition: background 0.2s;
  }
  @media (min-width: 1080px) { .hdr__donate { display: inline-flex; } }
  .hdr__donate:hover { background: var(--color-amber-dark); }

  .hdr__burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 4px;
  }
  @media (min-width: 1080px) { .hdr__burger { display: none; } }
  .hdr__burger span {
    display: block;
    width: 22px; height: 2px;
    background: var(--color-navy);
    border-radius: 1px;
    transition: transform 0.25s, opacity 0.25s;
  }
  .hdr__burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hdr__burger.is-open span:nth-child(2) { opacity: 0; }
  .hdr__burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Mobile overlay ─────────────────── */
  .mob {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }
  .mob__panel {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: min(360px, 100vw);
    background: var(--color-navy-dark);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
    display: flex;
    flex-direction: column;
    padding: 1rem 1.5rem 2rem;
    overflow-y: auto;
    pointer-events: auto;
  }
  .mob.is-open { pointer-events: auto; }
  .mob.is-open .mob__panel { transform: translateX(0); }
  .mob__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .mob.is-open .mob__backdrop { opacity: 1; }

  .mob__top {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(224,123,0,0.2);
    margin-bottom: 1.25rem;
  }
  .mob__logo { display: flex; align-items: center; }
  .mob__close { background: none; border: none; color: #fff; padding: 4px; }

  .mob__list { list-style: none; padding: 0; margin: 0; flex: 1; }
  .mob__link {
    display: block; padding: 0.75rem 0;
    font-family: var(--font-body); font-size: 0.9375rem; font-weight: 600;
    letter-spacing: 0.04em; color: rgba(255,255,255,0.85);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: color 0.2s;
  }
  .mob__link:hover, .mob__link--active { color: var(--color-amber); }

  .mob__sub { list-style: none; padding: 0.25rem 0 0.5rem 1rem; margin: 0; border-left: 2px solid rgba(224,123,0,0.3); }
  .mob__sub-link {
    display: block; padding: 0.4rem 0;
    font-size: 0.8125rem; color: rgba(255,255,255,0.6);
    transition: color 0.2s;
  }
  .mob__sub-link:hover { color: var(--color-amber); }

  .mob__foot { margin-top: 2rem; }
</style>

<script>
  const burger = document.getElementById('burger');
  const mob = document.getElementById('mob');
  const mobClose = document.getElementById('mob-close');

  function open() {
    mob?.classList.add('is-open');
    burger?.classList.add('is-open');
    burger?.setAttribute('aria-expanded', 'true');
    mob?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    mob?.classList.remove('is-open');
    burger?.classList.remove('is-open');
    burger?.setAttribute('aria-expanded', 'false');
    mob?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  burger?.addEventListener('click', open);
  mobClose?.addEventListener('click', close);
  mob?.addEventListener('click', e => { if (e.target === mob) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
</script>
