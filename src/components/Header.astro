---
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  { label: 'Our Story', href: '/our-story' },
  { label: 'Our People', href: '/our-people' },
  {
    label: 'Our Services',
    href: '/our-services',
    dropdown: [
      { label: 'Prison Ministry', href: '/our-services#prison' },
      { label: 'Immigration Detention Ministry', href: '/our-services/immigration-detention' },
      { label: 'Family Support', href: '/our-services#family' },
      { label: 'Mental Health & Wellbeing', href: '/our-services#mental-health' },
      { label: 'Community Outreach', href: '/our-services#community' },
    ],
  },
  { label: 'Neocatechumenal Way', href: '/neocatechumenal-way' },
  { label: 'Global Network', href: '/global-network' },
  { label: 'Get Involved', href: '/get-involved' },
  { label: 'Hope Media', href: '/hope-media' },
  { label: 'Sponsors & Supporters', href: '/sponsors-supporters' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header">
  <!-- Top bar: Prayer requests + social -->
  <div class="header-topbar">
    <div class="header-topbar-inner">
      <a href="/faith-hope#prayer" class="topbar-prayer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
        Prayer Requests
      </a>
      <div class="topbar-right">
        <div class="topbar-social">
          <a href="#" aria-label="Facebook" class="topbar-social-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="topbar-social-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="#" aria-label="YouTube" class="topbar-social-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="topbar-social-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
        <a href="/donate" class="btn-donate-topbar">DONATE NOW</a>
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <div class="header-main">
    <div class="header-main-inner">
      <!-- Logo -->
      <a href="/" class="header-logo">
        <div class="logo-badge">
          <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Outer gold ring -->
            <circle cx="28" cy="28" r="27" fill="#1B2751" stroke="#C9A017" stroke-width="1.5"/>
            <!-- Inner thin ring -->
            <circle cx="28" cy="28" r="23" fill="none" stroke="#C9A017" stroke-width="0.5" stroke-dasharray="2 1.5"/>
            <!-- Latin cross -->
            <line x1="28" y1="6" x2="28" y2="30" stroke="#C9A017" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="18" y1="14" x2="38" y2="14" stroke="#C9A017" stroke-width="2.5" stroke-linecap="round"/>
            <!-- Figure center (priest/person, arms wide) -->
            <circle cx="28" cy="36" r="2.2" fill="#C9A017"/>
            <path d="M21 44 Q24 38 28 36 Q32 38 35 44" fill="none" stroke="#C9A017" stroke-width="1.8" stroke-linecap="round"/>
            <!-- Arms raised wide -->
            <path d="M22 42 L16 36" stroke="#C9A017" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M34 42 L40 36" stroke="#C9A017" stroke-width="1.6" stroke-linecap="round"/>
            <!-- Figure left -->
            <circle cx="16" cy="38" r="1.6" fill="#C9A017" opacity="0.75"/>
            <path d="M12 47 Q14 42 16 40" fill="none" stroke="#C9A017" stroke-width="1.4" stroke-linecap="round" opacity="0.75"/>
            <path d="M14.5 45 L10 40" stroke="#C9A017" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
            <path d="M17.5 45 L20 39" stroke="#C9A017" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
            <!-- Figure right -->
            <circle cx="40" cy="38" r="1.6" fill="#C9A017" opacity="0.75"/>
            <path d="M44 47 Q42 42 40 40" fill="none" stroke="#C9A017" stroke-width="1.4" stroke-linecap="round" opacity="0.75"/>
            <path d="M41.5 45 L46 40" stroke="#C9A017" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
            <path d="M38.5 45 L36 39" stroke="#C9A017" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
          </svg>
        </div>
        <div class="logo-text">
          <span class="logo-iicc">IICC</span>
          <span class="logo-mission">MISSION</span>
          <span class="logo-tagline">Faith. Hope. Justice. Restoration.</span>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="desktop-nav" aria-label="Main navigation">
        <ul class="desktop-nav-list">
          {navItems.map((item) => (
            <li class={`desktop-nav-item ${item.dropdown ? 'has-dropdown' : ''}`}>
              {item.dropdown ? (
                <>
                  <a href={item.href} class={`nav-link ${isActive(item.href) ? 'active' : ''}`}>
                    {item.label}
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" style="margin-left:3px;opacity:0.7"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  </a>
                  <div class="dropdown-menu">
                    {item.dropdown.map((sub) => (
                      <a href={sub.href} class="dropdown-item">{sub.label}</a>
                    ))}
                  </div>
                </>
              ) : (
                <a href={item.href} class={`nav-link ${isActive(item.href) ? 'active' : ''}`}>
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <!-- Hamburger -->
      <div class="header-actions">
        <button class="hamburger" id="hamburger-btn" aria-label="Open menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu overlay -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <div class="mobile-menu-header">
        <a href="/" class="header-logo" style="filter:none">
          <div class="logo-badge">
            <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="28" cy="28" r="27" fill="#1B2751" stroke="#C9A017" stroke-width="1.5"/>
              <circle cx="28" cy="28" r="23" fill="none" stroke="#C9A017" stroke-width="0.5" stroke-dasharray="2 1.5"/>
              <line x1="28" y1="6" x2="28" y2="30" stroke="#C9A017" stroke-width="2.5" stroke-linecap="round"/>
              <line x1="18" y1="14" x2="38" y2="14" stroke="#C9A017" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="28" cy="36" r="2.2" fill="#C9A017"/>
              <path d="M21 44 Q24 38 28 36 Q32 38 35 44" fill="none" stroke="#C9A017" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M22 42 L16 36" stroke="#C9A017" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M34 42 L40 36" stroke="#C9A017" stroke-width="1.6" stroke-linecap="round"/>
              <circle cx="16" cy="38" r="1.6" fill="#C9A017" opacity="0.75"/>
              <path d="M12 47 Q14 42 16 40" fill="none" stroke="#C9A017" stroke-width="1.4" stroke-linecap="round" opacity="0.75"/>
              <path d="M14.5 45 L10 40" stroke="#C9A017" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
              <path d="M17.5 45 L20 39" stroke="#C9A017" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
              <circle cx="40" cy="38" r="1.6" fill="#C9A017" opacity="0.75"/>
              <path d="M44 47 Q42 42 40 40" fill="none" stroke="#C9A017" stroke-width="1.4" stroke-linecap="round" opacity="0.75"/>
              <path d="M41.5 45 L46 40" stroke="#C9A017" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
              <path d="M38.5 45 L36 39" stroke="#C9A017" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
            </svg>
          </div>
          <div class="logo-text">
            <span class="logo-iicc">IICC</span>
            <span class="logo-mission">MISSION</span>
            <span class="logo-tagline">Faith. Hope. Justice. Restoration.</span>
          </div>
        </a>
        <button class="mobile-close" id="mobile-close-btn" aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <nav>
        <ul class="mobile-nav-list">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class={`mobile-nav-link ${isActive(item.href) ? 'active' : ''}`}>
                {item.label}
              </a>
              {item.dropdown && (
                <ul class="mobile-subnav">
                  {item.dropdown.map((sub) => (
                    <li><a href={sub.href} class="mobile-subnav-link">{sub.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="mobile-menu-footer">
        <a href="/donate" class="btn-primary" style="width:100%;justify-content:center">DONATE NOW</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-navy-dark);
    box-shadow: 0 2px 20px rgba(0,0,0,0.3);
  }

  /* Top bar */
  .header-topbar {
    background-color: rgba(18,26,56,0.95);
    border-bottom: 1px solid rgba(201,160,23,0.2);
    padding: 0.25rem 0;
  }
  .header-topbar-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .topbar-prayer {
    color: rgba(255,255,255,0.7);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s;
    font-family: var(--font-body);
  }
  .topbar-prayer:hover { color: var(--color-gold); }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .topbar-social {
    display: flex;
    gap: 0.875rem;
    align-items: center;
  }
  .topbar-social-link {
    color: rgba(255,255,255,0.55);
    transition: color 0.2s;
    display: flex;
    align-items: center;
  }
  .topbar-social-link:hover { color: var(--color-gold); }
  .btn-donate-topbar {
    background-color: var(--color-amber);
    color: white;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 2px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s;
  }
  .btn-donate-topbar:hover { background-color: var(--color-amber-dark); }

  /* Main nav row */
  .header-main {
    padding: 0;
  }
  .header-main-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.3rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-badge {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
  }
  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo-iicc {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: white;
    line-height: 1.05;
    white-space: nowrap;
  }
  .logo-mission {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.35em;
    color: white;
    line-height: 1.3;
    white-space: nowrap;
  }
  .logo-tagline {
    font-family: var(--font-body);
    font-size: 0.4375rem;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    margin-top: 2px;
    white-space: nowrap;
  }

  /* Desktop nav */
  .desktop-nav {
    flex: 1;
    display: none;
  }
  @media (min-width: 1100px) {
    .desktop-nav { display: block; }
  }
  .desktop-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    align-items: center;
    justify-content: flex-end;
  }
  .desktop-nav-item {
    position: relative;
  }
  /* Nav links — single row */
  .desktop-nav-item .nav-link {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.5rem;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }
  .desktop-nav-item.has-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Dropdown */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    background-color: var(--color-navy-dark);
    border: 1px solid rgba(201,160,23,0.25);
    border-top: 2px solid var(--color-gold);
    min-width: 220px;
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    z-index: 200;
  }
  .dropdown-item {
    display: block;
    padding: 0.5rem 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.8);
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
  }
  .dropdown-item:hover {
    color: var(--color-gold);
    background-color: rgba(201,160,23,0.08);
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    margin-left: auto;
  }

  /* Hamburger */
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  @media (min-width: 1100px) {
    .hamburger { display: none; }
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background-color: white;
    border-radius: 1px;
    transition: transform 0.25s, opacity 0.25s;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    background-color: var(--color-navy-dark);
    z-index: 200;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
  }
  .mobile-menu.open {
    transform: translateX(0);
  }
  .mobile-menu-inner {
    padding: 1rem 1.5rem 2rem;
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(201,160,23,0.2);
  }
  .mobile-close {
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 4px;
  }
  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;
  }
  .mobile-nav-link {
    display: block;
    padding: 0.875rem 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    transition: color 0.2s;
  }
  .mobile-nav-link:hover, .mobile-nav-link.active {
    color: var(--color-gold);
  }
  .mobile-subnav {
    list-style: none;
    padding: 0 0 0 1rem;
    margin: 0;
    border-left: 2px solid rgba(201,160,23,0.3);
  }
  .mobile-subnav-link {
    display: block;
    padding: 0.5rem 0;
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mobile-subnav-link:hover { color: var(--color-gold); }
  .mobile-menu-footer {
    margin-top: 2rem;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function openMenu() {
    mobileMenu?.classList.add('open');
    hamburgerBtn?.classList.add('open');
    hamburgerBtn?.setAttribute('aria-expanded', 'true');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.remove('open');
    hamburgerBtn?.classList.remove('open');
    hamburgerBtn?.setAttribute('aria-expanded', 'false');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  hamburgerBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  mobileMenu?.addEventListener('click', (e) => {
    if (e.target === mobileMenu) closeMenu();
  });
</script>
