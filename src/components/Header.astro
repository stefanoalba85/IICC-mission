---
import { menus } from '../lib/nav';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <input type="checkbox" id="nav-toggle" class="nav-toggle" />
  <label for="nav-toggle" class="nav-backdrop" aria-hidden="true"></label>
  <div class="site-header__bar wrap">
    <a href="/" class="site-header__brand">
      <img src="/IICC_Badge.png" alt="IICC Mission logo" class="site-header__logo" />
      <span class="site-header__wordmark">
        <strong>IICC</strong>
        <em>Mission</em>
        <small>Faith. Hope. Justice. Restoration.</small>
      </span>
    </a>

    <label for="nav-toggle" class="site-header__burger" aria-label="Open menu">
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none"><path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="2"/></svg>
    </label>

    <nav class="mega-nav" aria-label="Main menu">
      <label for="nav-toggle" class="mega-nav__close" aria-label="Close menu">&times;</label>
      <ul class="mega-nav__list">
        <li class="mega-nav__item">
          <a href="/" class="mega-nav__link" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
        </li>
        {menus.map(m => (
          <li class="mega-nav__item">
            <details class="mega-nav__item--dropdown" name="mega-nav">
              <summary class="mega-nav__link">
                {m.label}
                <svg class="mega-nav__caret" viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6"/></svg>
              </summary>
              <div class:list={['mega-nav__panel', { 'mega-nav__panel--wide': m.wide, 'mega-nav__panel--right': m.alignRight }]}>
                {m.columns.map(c => (
                  <div class="mega-nav__col">
                    <span class="mega-nav__col-title">{c.href ? <a href={c.href}>{c.title}</a> : c.title}</span>
                    {c.links.map(k => <a href={k.href} aria-current={currentPath.replace(/\/$/, '') === k.href ? 'page' : undefined}>{k.label}</a>)}
                  </div>
                ))}
              </div>
            </details>
          </li>
        ))}
        <li class="mega-nav__item">
          <a href="/news" class="mega-nav__link" aria-current={isActive('/news') ? 'page' : undefined}>News &amp; Events</a>
        </li>
        <li class="mega-nav__item">
          <a href="/contact" class="mega-nav__link" aria-current={isActive('/contact') ? 'page' : undefined}>Contact Us</a>
        </li>
    </nav>

    <a href="/donate" class="btn btn--amber site-header__donate">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.6-10-9.3C.3 8.4 2 4.8 5.6 4.1c2-.4 4 .5 5 2.1a4.8 4.8 0 0 1 5-2.1c3.6.7 5.3 4.3 3.6 7.6C19.5 16.4 12 21 12 21Z"/></svg>
      Donate
    </a>
  </div>
</header>

<script>
  // Only one submenu open at a time. Modern browsers already do this through the shared
  // `name` on <details>; this covers browsers without support for exclusive <details>.
  const menus = document.querySelectorAll<HTMLDetailsElement>('.mega-nav__item--dropdown');
  menus.forEach(d => d.addEventListener('toggle', () => {
    if (d.open) menus.forEach(o => { if (o !== d) o.open = false; });
  }));
</script>
