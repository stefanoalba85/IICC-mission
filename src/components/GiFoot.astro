---
interface Props { left: string; text: string; right: string; quote?: string; leftImg?: string; }
const p = Astro.props;
---
<section style="display:grid; grid-template-columns:0.6fr 1.6fr 0.9fr; background:#fbf6ec; align-items:stretch;" class="camp-grid">
  <img src={p.left} alt="" style="width:100%; height:100%; object-fit:cover; min-height:180px;" />
  <div style="padding:1.25rem 1.5rem; display:flex; flex-direction:column; justify-content:center;"><slot /></div>
  <div style="position:relative; background:var(--color-navy-dark); overflow:hidden;"><img src={p.right} alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.75;" /><p style="position:relative; padding:1.25rem; color:#fff; font-family:var(--font-heading); text-transform:uppercase; font-size:1.375rem; line-height:1.2; text-shadow:0 2px 6px rgba(0,0,0,0.6);" set:html={p.text} /></div>
</section>
