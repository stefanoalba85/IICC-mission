---
import Icon from './Icon.astro';
interface Props { label: string; items: { icon: string; num: string; text: string }[]; dark?: boolean; }
const p = Astro.props;
---
<section class="wrap" style="padding-block:0.5rem 1rem;">
  <div style={`display:grid; grid-template-columns:1.1fr repeat(${p.items.length},1fr); align-items:center; background:${p.dark ? 'var(--color-navy-dark)' : '#f7f6f3'}; color:${p.dark ? '#fff' : 'var(--color-navy)'}; border-radius:4px; padding:1rem;`} class="camp-stats">
    <h2 style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400; font-size:1.0625rem; line-height:1.3;" set:html={p.label} />
    {p.items.map(i => <div style="display:grid; grid-template-columns:2.75rem 1fr; gap:0.6rem; align-items:center; border-left:1px solid rgba(201,150,42,0.35); padding-inline:0.6rem;"><span style="color:#c9741f;"><Icon name={i.icon} size={36} /></span><div><strong style="display:block; font-family:var(--font-heading); color:#c9741f; font-weight:400; font-size:1.25rem; line-height:1.1;">{i.num}</strong><span style="font-size:0.75rem; line-height:1.35;">{i.text}</span></div></div>)}
  </div>
</section>
