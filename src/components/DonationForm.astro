---
import Icon from './Icon.astro';
import { donations as d } from '../lib/donations';

const cfg = JSON.stringify({ paypal: d.paypal.business, stripeOne: d.stripe.oneTime, stripeMonthly: d.stripe.monthly, currency: d.currency });
const hasBank = Boolean(d.bank.iban);
---
<section class="dn" id="donate">
  <div class="wrap dn__grid">
    <form class="dn-form" data-config={cfg} novalidate>
      <h2 class="dn-form__title">Make Your Donation</h2>
      <span class="dn-form__heart" aria-hidden="true">♥</span>

      <fieldset class="dn-step">
        <legend>1. How often would you like to give?</legend>
        <div class="dn-freq">
          <input type="radio" name="freq" id="dn-once" value="once" checked />
          <label for="dn-once">One-time</label>
          <input type="radio" name="freq" id="dn-monthly" value="monthly" />
          <label for="dn-monthly"><Icon name="rotate" size={13} /> Monthly</label>
        </div>
      </fieldset>

      <fieldset class="dn-step">
        <legend>2. Choose an amount</legend>
        <div class="dn-amounts">
          {d.amounts.map(a => (
            <>
              <input type="radio" name="amount" id={`dn-a${a}`} value={a} checked={a === d.defaultAmount} />
              <label for={`dn-a${a}`}>€{a}</label>
            </>
          ))}
          <label class="dn-custom">
            <span aria-hidden="true">€</span>
            <input type="number" name="custom" min="1" step="1" inputmode="numeric" placeholder="Other amount" aria-label="Other amount in euro" />
          </label>
        </div>
        <p class="dn-error" hidden>Please choose or enter an amount of at least €1.</p>
      </fieldset>

      <fieldset class="dn-step">
        <legend>3. Choose how to pay</legend>
        <div class="dn-methods">
          <input type="radio" name="method" id="dn-m-card" value="card" checked />
          <label for="dn-m-card"><span class="dn-brands"><Icon name="cc-visa" size={26} /><Icon name="cc-mastercard" size={26} /></span>Credit / Debit Card</label>
          <input type="radio" name="method" id="dn-m-paypal" value="paypal" />
          <label for="dn-m-paypal"><span class="dn-brands"><Icon name="paypal" size={22} /></span>PayPal</label>
          <input type="radio" name="method" id="dn-m-bank" value="bank" />
          <label for="dn-m-bank"><span class="dn-brands"><Icon name="building-columns" size={22} /></span>Bank Transfer</label>
          <input type="radio" name="method" id="dn-m-gfm" value="gofundme" />
          <label for="dn-m-gfm"><span class="dn-brands"><Icon name="hand-holding-heart" size={22} /></span>GoFundMe</label>
        </div>

        <div class="dn-panel dn-panel--online">
          <p class="dn-note dn-note--card">Pay securely with Visa or Mastercard. No PayPal account is needed.</p>
          <p class="dn-note dn-note--paypal">You will be taken to PayPal to complete your donation securely.</p>
          <button type="submit" class="btn btn--amber dn-submit"><Icon name="heart" size={15} /> <span class="dn-submit__label">Donate €{d.defaultAmount} now</span></button>
          <p class="dn-soon" role="status" hidden>Online donations are being activated and will be available very soon. In the meantime you can give by bank transfer or <a href="/contact">contact us</a>.</p>
        </div>

        <div class="dn-panel dn-panel--bank">
          {hasBank ? (
            <dl class="dn-bank">
              <dt>Account holder</dt><dd>{d.bank.holder}</dd>
              <dt>IBAN</dt><dd><code>{d.bank.iban}</code> <button type="button" class="dn-copy" data-copy={d.bank.iban.replace(/\s+/g, '')}>Copy</button></dd>
              {d.bank.bic && <><dt>BIC / SWIFT</dt><dd><code>{d.bank.bic}</code></dd></>}
              {d.bank.bankName && <><dt>Bank</dt><dd>{d.bank.bankName}</dd></>}
              <dt>Reference</dt><dd>{d.bank.reference}</dd>
            </dl>
          ) : (
            <p class="dn-note">Our bank details will be published here shortly. To give by bank transfer now, please <a href="/contact">contact us</a> and we will send them to you.</p>
          )}
          {hasBank && <p class="dn-note">For a monthly gift by bank transfer, you can set up a standing order with your bank using these details.</p>}
        </div>

        <div class="dn-panel dn-panel--gofundme">
          <p class="dn-note">Support a specific project through one of our GoFundMe campaigns.</p>
          {d.gofundme.length > 0 ? (
            <ul class="dn-campaigns">
              {d.gofundme.map(c => <li><a href={c.url} target="_blank" rel="noopener"><strong>{c.title}</strong>{c.text && <span>{c.text}</span>}<span class="dn-campaigns__go">Open campaign ↗</span></a></li>)}
            </ul>
          ) : (
            <p class="dn-note"><em>Our active campaigns will be listed here soon.</em></p>
          )}
        </div>
      </fieldset>

      <p class="dn-secure"><Icon name="lock" size={14} /> Payments are processed by secure, certified platforms. IICC Mission never sees or stores your card details.</p>
    </form>

    <aside class="dn-aside">
      <h3>Giving with Confidence</h3>
      <ul>
        <li><Icon name="shield-halved" size={22} /><span><strong>Safe &amp; secure</strong>Card and PayPal payments are handled entirely by PayPal or Stripe.</span></li>
        <li><Icon name="rotate" size={22} /><span><strong>Monthly, your way</strong>Change or cancel your monthly gift at any time.</span></li>
        <li><Icon name="envelope" size={22} /><span><strong>Confirmation</strong>You receive an email confirmation of every donation.</span></li>
        <li><Icon name="heart" size={22} /><span><strong>Real impact</strong>Every gift supports people in prison, detention and their families.</span></li>
      </ul>
      <p class="dn-aside__q">Questions about donating? Write to <a href="mailto:info@iiccmission.org">info@iiccmission.org</a></p>
    </aside>
  </div>
</section>

<style>
  .dn { background: #fbf6ec; padding-block: 2rem; }
  .dn__grid { display: grid; grid-template-columns: 1.55fr 1fr; gap: 1.5rem; align-items: start; }
  .dn-form { background: #fff; border-radius: 6px; box-shadow: 0 6px 20px rgba(18,26,56,0.1); padding: 1.5rem 1.75rem; border-top: 4px solid #c9741f; }
  .dn-form__title { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.5rem; text-align: center; }
  .dn-form__heart { display: block; text-align: center; color: #c9741f; font-size: 0.8rem; margin-bottom: 0.5rem; }
  .dn-step { border: none; padding: 0; margin: 1.1rem 0 0; }
  .dn-step legend { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.0625rem; margin-bottom: 0.6rem; }
  .dn-form input[type="radio"] { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .dn-freq { display: grid; grid-template-columns: 1fr 1fr; border: 1.5px solid var(--color-navy); border-radius: 4px; overflow: hidden; }
  .dn-freq label { display: flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.7rem; font-weight: 700; text-transform: uppercase; font-size: 0.8125rem; letter-spacing: 0.06em; color: var(--color-navy); cursor: pointer; }
  .dn-freq input:checked + label { background: var(--color-navy); color: #fff; }
  .dn-amounts { display: grid; grid-template-columns: repeat(4, 1fr) 1.6fr; gap: 0.5rem; }
  .dn-amounts > label:not(.dn-custom) { display: flex; align-items: center; justify-content: center; padding: 0.75rem 0.25rem; border: 1.5px solid rgba(27,39,81,0.25); border-radius: 4px; font-family: var(--font-heading); font-size: 1.25rem; color: var(--color-navy); cursor: pointer; }
  .dn-amounts input:checked + label { border-color: #c9741f; background: #c9741f; color: #fff; }
  .dn-custom { display: flex; align-items: center; border: 1.5px solid rgba(27,39,81,0.25); border-radius: 4px; padding-left: 0.7rem; font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-navy); }
  .dn-custom:focus-within { border-color: #c9741f; }
  .dn-custom input { width: 100%; min-width: 0; border: none; outline: none; padding: 0.7rem 0.5rem; font-size: 1rem; background: transparent; }
  .dn-methods { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
  .dn-methods label { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; text-align: center; padding: 0.7rem 0.4rem; border: 1.5px solid rgba(27,39,81,0.2); border-radius: 4px; font-size: 0.75rem; font-weight: 700; color: var(--color-navy); cursor: pointer; line-height: 1.2; }
  .dn-methods input:checked + label { border-color: var(--color-navy); box-shadow: inset 0 0 0 1px var(--color-navy); background: #f3f4f9; }
  .dn-brands { display: flex; gap: 0.3rem; color: var(--color-navy); }
  .dn-form input:focus-visible + label { outline: 2px solid #c9741f; outline-offset: 2px; }
  .dn-panel { display: none; margin-top: 0.9rem; }
  .dn-form:has(#dn-m-card:checked) .dn-panel--online,
  .dn-form:has(#dn-m-paypal:checked) .dn-panel--online,
  .dn-form:has(#dn-m-bank:checked) .dn-panel--bank,
  .dn-form:has(#dn-m-gfm:checked) .dn-panel--gofundme { display: block; }
  .dn-note--card, .dn-note--paypal { display: none; }
  .dn-form:has(#dn-m-card:checked) .dn-note--card, .dn-form:has(#dn-m-paypal:checked) .dn-note--paypal { display: block; }
  .dn-note { font-family: var(--font-heading); color: var(--color-navy); font-size: 0.9375rem; line-height: 1.5; margin-bottom: 0.6rem; }
  .dn-note a, .dn-soon a, .dn-aside a { color: #c9741f; text-decoration: underline; }
  .dn-submit { width: 100%; justify-content: center; font-size: 1rem; padding: 0.95rem; }
  .dn-soon { margin-top: 0.75rem; background: #fdf3e3; border-left: 3px solid #c9741f; padding: 0.7rem 0.9rem; font-size: 0.875rem; color: var(--color-navy); line-height: 1.5; }
  .dn-error { color: #b42318; font-size: 0.8125rem; margin-top: 0.4rem; }
  .dn-bank { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1rem; margin: 0 0 0.75rem; font-size: 0.9375rem; color: var(--color-navy); background: #f7f6f3; padding: 0.9rem 1rem; border-radius: 4px; }
  .dn-bank dt { font-weight: 700; }
  .dn-bank dd { margin: 0; overflow-wrap: anywhere; }
  .dn-copy { margin-left: 0.4rem; font-size: 0.75rem; border: 1px solid var(--color-navy); border-radius: 3px; padding: 0.1rem 0.5rem; background: #fff; color: var(--color-navy); cursor: pointer; }
  .dn-campaigns { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .dn-campaigns a { display: flex; flex-direction: column; gap: 0.2rem; border: 1px solid rgba(27,39,81,0.15); border-radius: 4px; padding: 0.7rem 0.9rem; color: var(--color-navy); }
  .dn-campaigns__go { color: #c9741f; font-size: 0.8125rem; font-weight: 700; }
  .dn-secure { display: flex; gap: 0.5rem; align-items: center; justify-content: center; margin-top: 1.1rem; font-size: 0.8125rem; color: #4a5068; text-align: center; }
  .dn-aside { background: var(--color-navy-dark); color: #fff; border-radius: 6px; padding: 1.5rem; }
  .dn-aside h3 { font-family: var(--font-heading); text-transform: uppercase; font-size: 1.125rem; color: #e2a93b; margin-bottom: 1rem; }
  .dn-aside ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .dn-aside li { display: grid; grid-template-columns: 1.75rem 1fr; gap: 0.75rem; align-items: start; color: #e2a93b; }
  .dn-aside li span { color: #fff; font-size: 0.875rem; line-height: 1.45; }
  .dn-aside li strong { display: block; font-family: var(--font-heading); font-size: 1rem; font-weight: 400; }
  .dn-aside__q { margin-top: 1.25rem; font-size: 0.875rem; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 1rem; }
  @media (max-width: 900px) { .dn__grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .dn-form { padding: 1.25rem 1rem; }
    .dn-amounts { grid-template-columns: repeat(4, 1fr); }
    .dn-custom { grid-column: 1 / -1; }
    .dn-methods { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.dn-form');
  if (form) {
    const cfg = JSON.parse(form.dataset.config || '{}');
    const label = form.querySelector<HTMLElement>('.dn-submit__label')!;
    const soon = form.querySelector<HTMLElement>('.dn-soon')!;
    const error = form.querySelector<HTMLElement>('.dn-error')!;
    const custom = form.querySelector<HTMLInputElement>('input[name="custom"]')!;
    const val = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value;

    const amount = () => {
      const c = Math.round(Number(custom.value));
      if (custom.value.trim() !== '') return c >= 1 ? c : 0;
      return Number(val('amount') || 0);
    };
    const update = () => {
      const a = amount();
      const monthly = val('freq') === 'monthly';
      label.textContent = a ? `Donate €${a} ${monthly ? 'monthly' : 'now'}` : 'Donate';
      soon.hidden = true;
      error.hidden = true;
    };

    // Preselect from the URL, e.g. /donate?freq=monthly&amount=25#donate (used by the Monthly Giving page).
    const q = new URLSearchParams(location.search);
    if (q.get('freq') === 'monthly') (form.querySelector('#dn-monthly') as HTMLInputElement).checked = true;
    const qa = q.get('amount');
    if (qa === 'other') custom.focus();
    else if (qa) {
      const preset = form.querySelector<HTMLInputElement>(`#dn-a${qa}`);
      if (preset) preset.checked = true; else if (Number(qa) >= 1) custom.value = qa;
    }

    custom.addEventListener('input', () => {
      if (custom.value.trim() !== '') form.querySelectorAll<HTMLInputElement>('input[name="amount"]').forEach(r => (r.checked = false));
      update();
    });
    form.querySelectorAll<HTMLInputElement>('input[name="amount"]').forEach(r => r.addEventListener('change', () => { custom.value = ''; update(); }));
    form.querySelectorAll<HTMLInputElement>('input[name="freq"], input[name="method"]').forEach(r => r.addEventListener('change', update));

    form.querySelectorAll<HTMLButtonElement>('.dn-copy').forEach(b => b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy || ''); b.textContent = 'Copied'; } catch { b.textContent = 'Select and copy'; }
    }));

    form.addEventListener('submit', e => {
      e.preventDefault();
      const a = amount();
      if (!a) { error.hidden = false; custom.focus(); return; }
      const monthly = val('freq') === 'monthly';
      const method = val('method');
      let url = '';
      if (method === 'card' && cfg.stripeOne) {
        url = monthly ? cfg.stripeMonthly?.[a] || '' : cfg.stripeOne;
      }
      if (!url && cfg.paypal) {
        // PayPal donate page: donors without an account can pay by card as guests; for monthly gifts
        // PayPal shows the "make this a monthly donation" option (no_recurring=0).
        const p = new URLSearchParams({ business: cfg.paypal, amount: String(a), currency_code: cfg.currency, item_name: monthly ? 'Monthly donation – IICC Mission' : 'Donation – IICC Mission', no_recurring: monthly ? '0' : '1' });
        url = `https://www.paypal.com/donate/?${p}`;
      }
      if (url) window.location.href = url;
      else soon.hidden = false;
    });
    update();
  }
</script>
