---
interface Props { title: string; }
---
<aside class="sb">
  <h2>{Astro.props.title}</h2>
  <span class="sb__heart">♥</span>
  <slot />
</aside>
<style>
  .sb { background: #f8f6f1; border: 1px solid rgba(27,39,81,0.08); border-radius: 4px; padding: 1rem 1rem 1.1rem; }
  .sb h2 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.125rem; font-weight: 400; text-align: center; }
  .sb__heart { display: block; text-align: center; color: #c9741f; font-size: 0.75rem; margin-bottom: 0.75rem; }
</style>
