---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { SITE, normalize, hasIt, toIt } from '../i18n/routes.mjs';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'IICC Mission — Accompanying individuals and families in their journey toward healing, empowerment and a restored future.',
  image = '/og-default.jpg',
} = Astro.props;

const enPath = normalize(Astro.url.pathname);
const site = Astro.site?.origin ?? SITE;
const canonicalURL = new URL(enPath, site);
// Italian version (generated after the build, see src/i18n/build.mjs)
const itPath = hasIt(enPath) ? toIt(enPath) : null;

// First visit to the homepage: Italian for visitors in Italy (time zone Europe/Rome, Vatican, San Marino)
// or, as a secondary criterion, with an Italian browser — unless the visitor already chose a language with
// the IT / EN switcher (localStorage / cookie). The build step removes this script from Italian pages.
// When the site moves behind a CDN that knows the visitor's country (e.g. Cloudflare), the same rule can
// run at the edge with the iicc_lang cookie taking precedence.
const LANG_REDIRECT = `(function(){try{
var m=document.cookie.match(/(?:^|; )iicc_lang=(it|en)/),s=localStorage.getItem('iicc-lang')||(m&&m[1]);
if(s==='en')return;
var tz=Intl.DateTimeFormat().resolvedOptions().timeZone||'',bl=((navigator.languages&&navigator.languages[0])||navigator.language||'').toLowerCase();
if(s==='it'||['Europe/Rome','Europe/Vatican','Europe/San_Marino'].indexOf(tz)>=0||bl.indexOf('it')===0)location.replace('/it'+location.search+location.hash);
}catch(e){}})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | IICC Mission</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | IICC Mission`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_GB" />
    {itPath && <meta property="og:locale:alternate" content="it_IT" />}
    {itPath && <link rel="alternate" hreflang="en" href={new URL(enPath, site)} />}
    {itPath && <link rel="alternate" hreflang="it" href={new URL(itPath, site)} />}
    {itPath && <link rel="alternate" hreflang="x-default" href={new URL(enPath, site)} />}
    {enPath === '/' && <script is:inline id="lang-redirect" set:html={LANG_REDIRECT} />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Source+Sans+3:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} enPath={enPath === '/404' ? '/' : enPath} itPath={itPath ?? '/it'} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
