---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Prayer Request" description="Share your prayer request with us. Our prayer team will lift you up in faith and trust in God's love and timing.">

  <!-- Breadcrumb -->
  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/our-services">Our Programs</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/advocacy">Legal Assistance &amp; Advocacy</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Prayer Request</span>
      </nav>
    </div>
  </div>

  <!-- Hero split -->
  <div class="hero-split" style="min-height:400px;">
    <div class="hero-split__text" style="background:#fff;gap:1rem;">
      <div style="display:flex;align-items:center;gap:1rem;margin-bottom:0.5rem;">
        <div style="width:3.5rem;height:3.5rem;border-radius:50%;border:2px solid var(--color-amber);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--color-amber);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
        </div>
        <div>
          <h1 style="font-family:var(--font-display);font-weight:900;color:var(--color-navy);text-transform:uppercase;line-height:1;font-size:clamp(2rem,4.5vw,3.25rem);">
            PRAYER<br><span style="color:var(--color-amber);">REQUEST</span>
          </h1>
        </div>
      </div>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2vw,1.25rem);color:var(--color-amber);font-weight:700;line-height:1.4;">
        We believe in the power of prayer.<br>
        We are here to pray with you.
      </p>
      <p class="section-desc" style="max-width:none;">
        Share your prayer request with us, and our prayer team will lift you up in faith and trust in God's love and timing.
      </p>
    </div>
    <div class="hero-split__photo" style="min-height:320px;">
      <img
        src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=800&h=600&fit=crop"
        alt="Prayer — hands folded over a Bible"
      />
      <div class="hero-split__quote">
        <span class="hero-split__quote-mark">"</span>
        <p class="hero-split__quote-text">
          Do not be anxious about anything, but in every situation, by prayer and petition, with thanksgiving, present your requests to God.
        </p>
        <span class="hero-split__quote-ref">— Philippians 4:6</span>
      </div>
    </div>
  </div>

  <!-- Form + Sidebar -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:1fr;gap:2.5rem;">
        <div style="display:grid;grid-template-columns:1fr;gap:2.5rem;" class="prayer-layout">

          <!-- Form -->
          <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:2rem 2rem 2.5rem;">
            <h2 style="font-family:var(--font-display);font-size:0.875rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">SHARE YOUR PRAYER REQUEST</h2>
            <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>
            <p class="section-desc" style="max-width:none;margin-bottom:2rem;font-size:0.875rem;">
              Please fill out the form below. Your request will be kept confidential and shared only with our prayer team.
            </p>

            <form action="#" method="post" novalidate>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;" class="form-grid-2">
                <div class="form-field">
                  <label for="first-name">First Name <span class="required">*</span></label>
                  <input type="text" id="first-name" name="first_name" class="form-input" placeholder="Enter your first name" required />
                </div>
                <div class="form-field">
                  <label for="last-name">Last Name</label>
                  <input type="text" id="last-name" name="last_name" class="form-input" placeholder="Enter your last name" />
                </div>
              </div>

              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;" class="form-grid-2">
                <div class="form-field">
                  <label for="email">Email Address <span class="required">*</span></label>
                  <input type="email" id="email" name="email" class="form-input" placeholder="Enter your email address" required />
                </div>
                <div class="form-field">
                  <label for="phone">Phone Number (Optional)</label>
                  <input type="tel" id="phone" name="phone" class="form-input" placeholder="Enter your phone number" />
                </div>
              </div>

              <div class="form-field" style="margin-bottom:1.25rem;">
                <label>Would you like us to contact you for follow-up?</label>
                <div style="display:flex;gap:2rem;margin-top:0.5rem;">
                  <label style="display:flex;align-items:center;gap:0.5rem;font-weight:400;cursor:pointer;font-size:0.875rem;color:var(--color-muted);">
                    <input type="radio" name="contact" value="yes" style="accent-color:var(--color-amber);" /> Yes, you may contact me.
                  </label>
                  <label style="display:flex;align-items:center;gap:0.5rem;font-weight:400;cursor:pointer;font-size:0.875rem;color:var(--color-muted);">
                    <input type="radio" name="contact" value="no" style="accent-color:var(--color-amber);" /> No, please keep this request confidential.
                  </label>
                </div>
              </div>

              <div class="form-field" style="margin-bottom:1.25rem;">
                <label for="prayer-request">Please share your prayer request <span class="required">*</span></label>
                <p class="form-hint" style="margin-bottom:0.375rem;">Provide as much or as little detail as you feel comfortable sharing.</p>
                <textarea id="prayer-request" name="prayer_request" class="form-input form-input--textarea" placeholder="Enter your prayer request here..." style="min-height:9rem;" required></textarea>
              </div>

              <div class="form-field" style="margin-bottom:1.25rem;">
                <label>How would you like us to pray for you? (Select all that apply)</label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem 1.5rem;margin-top:0.5rem;" class="prayer-checks">
                  {[
                    'Health & Healing', 'Family & Relationships',
                    'Emotional Wellbeing', 'Financial Provision',
                    'Legal Matters & Justice', 'Other (please specify below)'
                  ].map(opt => (
                    <label style="display:flex;align-items:center;gap:0.5rem;font-weight:400;cursor:pointer;font-size:0.875rem;color:var(--color-muted);">
                      <input type="checkbox" name="prayer_type" value={opt} style="accent-color:var(--color-amber);" /> {opt}
                    </label>
                  ))}
                </div>
              </div>

              <div class="form-field" style="margin-bottom:1.25rem;">
                <label for="additional">Additional details (Optional)</label>
                <p class="form-hint" style="margin-bottom:0.375rem;">Any other information you would like us to know.</p>
                <textarea id="additional" name="additional" class="form-input form-input--textarea" placeholder="Enter additional details here..." style="min-height:5rem;"></textarea>
              </div>

              <div class="form-field" style="margin-bottom:1.5rem;">
                <label>Would you like this request to be included in our confidential prayer list?</label>
                <div style="display:flex;gap:2rem;margin-top:0.5rem;">
                  <label style="display:flex;align-items:center;gap:0.5rem;font-weight:400;cursor:pointer;font-size:0.875rem;color:var(--color-muted);">
                    <input type="radio" name="prayer_list" value="yes" style="accent-color:var(--color-amber);" /> Yes
                  </label>
                  <label style="display:flex;align-items:center;gap:0.5rem;font-weight:400;cursor:pointer;font-size:0.875rem;color:var(--color-muted);">
                    <input type="radio" name="prayer_list" value="no" style="accent-color:var(--color-amber);" /> No
                  </label>
                </div>
                <p class="form-hint" style="margin-top:0.25rem;">Only our prayer team will see your request.</p>
              </div>

              <!-- Urgent banner -->
              <div style="background:var(--color-off-white);border:1px solid rgba(27,39,81,0.1);border-radius:2px;padding:1rem 1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;">
                <div style="display:flex;align-items:center;gap:0.75rem;">
                  <span style="color:var(--color-amber);font-size:1.25rem;">♥</span>
                  <div>
                    <p style="font-weight:700;font-size:0.875rem;color:var(--color-navy);">Need urgent prayer?</p>
                    <p style="font-size:0.8125rem;color:var(--color-muted);">If you or someone you know is in immediate need of prayer, please contact us directly.</p>
                  </div>
                </div>
                <a href="/contact" class="btn btn--outline" style="font-size:0.75rem;padding:0.5rem 1rem;white-space:nowrap;">CONTACT US ›</a>
              </div>

              <!-- Consent + submit -->
              <div style="margin-bottom:1.5rem;">
                <label style="display:flex;align-items:flex-start;gap:0.5rem;font-weight:400;cursor:pointer;font-size:0.8125rem;color:var(--color-muted);">
                  <input type="checkbox" name="consent" style="accent-color:var(--color-amber);margin-top:0.15rem;" required />
                  I understand that my prayer request will be handled in confidence. Please read our <a href="/privacy-policy" style="color:var(--color-amber);">Privacy Policy</a> for more information.
                </label>
              </div>

              <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                <button type="reset" class="btn btn--outline" style="font-size:0.8125rem;">CLEAR FORM</button>
                <button type="submit" class="btn btn--amber" style="font-size:0.8125rem;">SUBMIT REQUEST ›</button>
              </div>
            </form>
          </div>

          <!-- Sidebar -->
          <aside style="display:flex;flex-direction:column;gap:1.5rem;">

            <!-- We are here to pray -->
            <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:1.5rem;">
              <h3 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">WE ARE HERE TO PRAY</h3>
              <span class="rule rule--amber" style="display:block;margin-bottom:1rem;"></span>
              <div style="display:flex;align-items:flex-start;gap:1rem;margin-bottom:1rem;">
                <div style="width:3rem;height:3rem;border-radius:50%;background:var(--color-navy-dark);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--color-amber);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/></svg>
                </div>
                <p style="font-size:0.875rem;color:var(--color-muted);line-height:1.65;">
                  Prayer is at the heart of everything we do. It connects us with God and with one another.
                </p>
              </div>
              <p style="font-size:0.875rem;color:var(--color-muted);font-style:italic;">You are not alone. We are honoured to pray for you.</p>
            </div>

            <!-- What happens next -->
            <div style="background:var(--color-navy-dark);border:1px solid rgba(224,123,0,0.15);border-radius:2px;padding:1.5rem;">
              <h3 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:#fff;margin-bottom:0.5rem;">WHAT HAPPENS NEXT?</h3>
              <span class="rule rule--amber" style="display:block;margin-bottom:1rem;"></span>
              <div style="display:flex;flex-direction:column;gap:1rem;">
                {[
                  { icon: '📋', title: 'We receive your request', desc: 'Your request will be sent to our prayer team.' },
                  { icon: '🙏', title: 'We pray for you', desc: 'Our team will lift you up in prayer with care and compassion.' },
                  { icon: '🔒', title: 'We keep it confidential', desc: 'Your request is kept private and shared only within the prayer team.' },
                  { icon: '✨', title: 'We trust God together', desc: 'We believe God hears every prayer and works in His perfect timing.' },
                ].map(step => (
                  <div style="display:flex;align-items:flex-start;gap:0.875rem;">
                    <div style="width:2.25rem;height:2.25rem;border-radius:50%;background:rgba(224,123,0,0.15);border:1px solid rgba(224,123,0,0.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.875rem;">
                      {step.icon}
                    </div>
                    <div>
                      <p style="font-size:0.875rem;font-weight:700;color:#fff;margin-bottom:0.125rem;">{step.title}</p>
                      <p style="font-size:0.8125rem;color:rgba(255,255,255,0.6);line-height:1.5;">{step.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Scripture on prayer -->
            <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:1.5rem;">
              <h3 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">SCRIPTURE ON PRAYER</h3>
              <span class="rule rule--amber" style="display:block;margin-bottom:1rem;"></span>
              <div style="display:flex;flex-direction:column;gap:1rem;">
                {[
                  { quote: '"The prayer of a righteous person is powerful and effective."', ref: '— James 5:16' },
                  { quote: '"Call to me and I will answer you and tell you great and unsearchable things you do not know."', ref: '— Jeremiah 33:3' },
                  { quote: '"In this world you will have trouble. But take heart! I have overcome the world."', ref: '— John 16:33' },
                ].map(v => (
                  <div style="display:flex;align-items:flex-start;gap:0.75rem;padding-bottom:0.75rem;border-bottom:1px solid rgba(27,39,81,0.06);">
                    <span style="color:var(--color-amber);font-size:1.25rem;line-height:1;flex-shrink:0;">♥</span>
                    <div>
                      <p style="font-family:var(--font-heading);font-style:italic;font-size:0.8125rem;color:var(--color-navy);line-height:1.65;margin-bottom:0.25rem;">{v.quote}</p>
                      <p style="font-size:0.75rem;font-weight:700;color:var(--color-amber);">{v.ref}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Need to talk -->
            <div style="background:var(--color-navy);border-radius:2px;padding:1.5rem;text-align:center;">
              <h3 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:#fff;margin-bottom:0.5rem;">NEED TO TALK?</h3>
              <span class="rule rule--amber rule--center" style="display:block;margin-bottom:1rem;"></span>
              <p style="font-size:0.875rem;color:rgba(255,255,255,0.7);margin-bottom:1.25rem;line-height:1.6;">
                If you need to speak with someone or are going through a difficult time, please reach out to us.
              </p>
              <a href="/contact" class="btn btn--amber" style="width:100%;justify-content:center;font-size:0.8125rem;">CONTACT US ›</a>
            </div>

          </aside>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  @media (min-width: 1024px) {
    .prayer-layout {
      grid-template-columns: 1fr 380px !important;
    }
  }
  @media (max-width: 640px) {
    .form-grid-2 {
      grid-template-columns: 1fr !important;
    }
    .prayer-checks {
      grid-template-columns: 1fr !important;
    }
  }
</style>
