---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us" description="We would love to hear from you.">
  <nav class="breadcrumb wrap"><a href="/">Home</a><span class="breadcrumb__sep">/</span><span class="breadcrumb__current">Contact Us</span></nav>

  <section class="hero-split">
    <div class="hero-split__text" style="background:var(--color-navy);">
      <span class="eyebrow eyebrow--white">Contact Us</span>
      <h1 class="section-title section-title--white" style="margin-block:0.5rem;">We Would Love <span class="text-amber">to Hear from You.</span></h1>
      <p class="section-desc section-desc--white" style="max-width:none;">
        Whether you have a question, want to get involved, or are seeking support, our team is
        here for you. Please reach out using any of the options below.
      </p>
      <p style="font-style:italic; color:rgba(255,255,255,0.75);">
        Together, we can bring hope, justice and restoration to individuals and communities in need.
      </p>
    </div>
    <div class="hero-split__photo">
      <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=1000&q=80" alt="Hands holding a heart-shaped stone" />
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap cols-60-40">
      <div>
        <span class="eyebrow">Send Us a Message</span>
        <h2 class="section-title" style="margin-bottom:1rem;">Get In Touch</h2>
        <form class="grid-2" style="display:grid; gap:1.25rem;">
          <div class="form-field"><label>First Name <span class="required">*</span></label><input class="form-input" type="text" name="first-name" required /></div>
          <div class="form-field"><label>Last Name <span class="required">*</span></label><input class="form-input" type="text" name="last-name" required /></div>
          <div class="form-field" style="grid-column:1/-1;"><label>Email Address <span class="required">*</span></label><input class="form-input" type="email" name="email" required /></div>
          <div class="form-field" style="grid-column:1/-1;"><label>Subject <span class="required">*</span></label><input class="form-input" type="text" name="subject" required /></div>
          <div class="form-field" style="grid-column:1/-1;"><label>Your Message <span class="required">*</span></label><textarea class="form-input form-input--textarea" name="message" required></textarea></div>
          <div style="grid-column:1/-1;">
            <button type="submit" class="btn btn--amber" style="width:100%; justify-content:center;">Send Message</button>
            <p class="form-hint" style="margin-top:0.5rem;">🔒 We respect your privacy. Your information will never be shared.</p>
          </div>
        </form>
      </div>
      <div>
        <span class="eyebrow">Contact Information</span>
        <div class="checklist" style="margin-top:1rem;">
          <li><strong>Head Office</strong><br />Via delle Milizie 34<br />Rome, Italy 00192</li>
          <li><strong>Email</strong><br />info@iiccmission.org</li>
          <li><strong>Phone</strong><br />+39 349 303 6235</li>
          <li><strong>Website</strong><br />www.iiccmission.org</li>
        </div>
        <div class="card" style="margin-top:1.5rem;">
          <span class="card__title">Office Hours</span>
          <p class="card__body">Monday – Friday, 9:00am – 5:00pm (CET)<br />Closed on weekends and public holidays.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="quote-box" style="max-width:640px; margin-inline:auto; margin-bottom:3rem;">
    <span class="quote-box__mark">&ldquo;</span>
    <p class="quote-box__text">"Where two or three are gathered in my name, there am I among them."</p>
    <span class="quote-box__ref">— Matthew 18:20</span>
  </div>

  <div class="cta-band">
    <div class="wrap cta-band__inner">
      <div class="cta-band__text">
        <h2 class="section-title section-title--white">Make a Difference</h2>
        <p class="section-desc section-desc--white">Together, we can bring hope, restore dignity, and build stronger communities.</p>
      </div>
      <a href="/donate" class="btn btn--amber">Donate Now &gt;</a>
    </div>
  </div>
</Layout>
