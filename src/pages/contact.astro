---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Connect With Us" description="We are here for supporters, volunteers, partners and people seeking assistance. Contact IICC Mission.">

  <!-- Hero split -->
  <div class="hero-split" style="min-height:440px;">
    <div class="hero-split__text" style="background:#fff;gap:1.25rem;">
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);font-weight:900;color:var(--color-navy);text-transform:uppercase;line-height:1.05;">
        CONNECT<br>WITH US
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2vw,1.25rem);color:var(--color-muted);line-height:1.5;">
        We are here for supporters, volunteers, partners and people seeking assistance.
      </p>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img
        src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=800&h=600&fit=crop"
        alt="Connect with IICC Mission"
      />
    </div>
  </div>

  <!-- Form + Contact Info -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-60-40" style="gap:3rem;align-items:start;">

        <!-- Form -->
        <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:2rem 2rem 2.5rem;">
          <h2 style="font-family:var(--font-display);font-size:0.875rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">SEND US A MESSAGE</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>
          <form action="#" method="post" novalidate>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;" class="contact-grid-2">
              <div class="form-field">
                <label for="c-name">Your Name</label>
                <input type="text" id="c-name" name="name" class="form-input" placeholder="Your Name" />
              </div>
              <div class="form-field">
                <label for="c-email">Email Address</label>
                <input type="email" id="c-email" name="email" class="form-input" placeholder="Email Address" />
              </div>
            </div>
            <div class="form-field" style="margin-bottom:1.25rem;">
              <label for="c-subject">Subject</label>
              <input type="text" id="c-subject" name="subject" class="form-input" placeholder="Subject" />
            </div>
            <div class="form-field" style="margin-bottom:1.5rem;">
              <label for="c-message">Your Message</label>
              <textarea id="c-message" name="message" class="form-input form-input--textarea" placeholder="Your Message" style="min-height:9rem;"></textarea>
            </div>
            <button type="submit" class="btn btn--amber" style="width:100%;justify-content:center;">
              SEND MESSAGE
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">

          <div>
            <h2 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">CONTACT INFORMATION</h2>
            <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
            <div style="display:flex;flex-direction:column;gap:1rem;">
              <div style="display:flex;align-items:flex-start;gap:0.875rem;">
                <div style="width:2rem;height:2rem;border-radius:50%;background:rgba(224,123,0,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--color-amber);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                  <p style="font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-amber);margin-bottom:0.125rem;">EMAIL</p>
                  <a href="mailto:info@iiccmission.org" style="font-size:0.9375rem;color:var(--color-navy);">info@iiccmission.org</a>
                </div>
              </div>
              <div style="display:flex;align-items:flex-start;gap:0.875rem;">
                <div style="width:2rem;height:2rem;border-radius:50%;background:rgba(224,123,0,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--color-amber);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                </div>
                <div>
                  <p style="font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-amber);margin-bottom:0.125rem;">WEBSITE</p>
                  <a href="https://www.iiccmission.org" style="font-size:0.9375rem;color:var(--color-navy);">www.iiccmission.org</a>
                </div>
              </div>
              <div style="display:flex;align-items:flex-start;gap:0.875rem;">
                <div style="width:2rem;height:2rem;border-radius:50%;background:rgba(224,123,0,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--color-amber);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <p style="font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-amber);margin-bottom:0.125rem;">ADDRESS</p>
                  <p style="font-size:0.9375rem;color:var(--color-navy);">PO Box 273<br>Cheltenham VIC 3192<br>Australia</p>
                </div>
              </div>
              <div style="display:flex;align-items:flex-start;gap:0.875rem;">
                <div style="width:2rem;height:2rem;border-radius:50%;background:rgba(224,123,0,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--color-amber);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.59 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <p style="font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-amber);margin-bottom:0.125rem;">PHONE</p>
                  <a href="tel:+61411209066" style="font-size:0.9375rem;color:var(--color-navy);">+61 411 209 066</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Follow Us -->
          <div>
            <h2 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">FOLLOW US</h2>
            <span class="rule rule--amber" style="display:block;margin-bottom:1rem;"></span>
            <p style="font-size:0.875rem;color:var(--color-muted);margin-bottom:1rem;">Stay connected and follow our journey.</p>
            <div style="display:flex;gap:0.625rem;">
              {['Facebook', 'Instagram', 'YouTube', 'LinkedIn'].map(s => (
                <a href="#" aria-label={s} style="width:2.25rem;height:2.25rem;border-radius:50%;border:1.5px solid rgba(27,39,81,0.15);display:flex;align-items:center;justify-content:center;color:var(--color-navy);transition:border-color 0.2s,color 0.2s;" onmouseover="this.style.borderColor='var(--color-amber)';this.style.color='var(--color-amber)'" onmouseout="this.style.borderColor='rgba(27,39,81,0.15)';this.style.color='var(--color-navy)'">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="3"/></svg>
                </a>
              ))}
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  @media (max-width: 540px) {
    .contact-grid-2 { grid-template-columns: 1fr !important; }
  }
</style>
