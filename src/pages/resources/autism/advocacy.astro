---
import Layout from '../../../layouts/Layout.astro';
import ResHero from '../../../components/ResHero.astro';
import ResBand from '../../../components/ResBand.astro';
import ResCards from '../../../components/ResCards.astro';
import NewsBar from '../../../components/NewsBar.astro';
import AutismHero from '../../../components/AutismHero.astro';
import AutismCta from '../../../components/AutismCta.astro';
import Icon from '../../../components/Icon.astro';
const img = (n: string) => `/images/resources/${n}.jpg`;
const stat = (items: string[][]) => items;
---
<Layout title="Autism Advocacy" description="Raising voices. Changing minds. Creating change.">
  <AutismHero kicker="Autism Advocacy" title="Raising Voices.<br/>Changing Minds.<br/>Creating Change." accent="Advocating today for<br/>a more inclusive tomorrow." text="At IICC Mission, we advocate for the rights, inclusion and dignity of individuals with autism and their families at the local, state and national levels. Together, we can build policies, practices and communities that empower every individual to thrive." img={img('ad-hero')} alt="A family holding signs: Inclusion is a right, not a privilege" quote="Speak up for those who cannot speak for themselves. Advocate for what is right." quoteRef="Proverbs 31:8" cta="Our Advocacy Priorities" />
  <ResBand items={[
    { icon: 'bullhorn', title: 'Amplify Voices', text: 'Raise awareness about autism and the needs of individuals and families.' }, { icon: 'shield-halved', title: 'Protect Rights', text: 'Advocate for policies that protect rights and promote inclusion.' },
    { icon: 'people-group', title: 'Drive Change', text: 'Influence change in schools, workplaces, healthcare and communities.' }, { icon: 'handshake', title: 'Build Partnerships', text: 'Collaborate with organizations, leaders and communities to create impact.' },
    { icon: 'hand-holding-heart', title: 'Empower Families', text: 'Equip families with tools, resources and a voice in decision-making.' }, { icon: 'cross', title: 'Faith in Action', text: 'Grounded in faith, we advocate for justice, dignity and equal opportunity.' },
  ]} />
  <ResCards center title="Ways to Advocate" cols={6} items={[
    { photo: 'ad-1', icon: 'bullhorn', title: 'Educate Yourself & Others', text: 'Learn about autism and share accurate information to reduce stigma and promote understanding.', cta: 'Learn More', button: true, href: '/resources/autism/awareness' },
    { photo: 'ad-2', icon: 'people-group', title: 'Engage Your Local Leaders', text: 'Contact lawmakers and community leaders to advocate for inclusive policies and funding.', cta: 'Take Action', button: true, href: '/contact' },
    { photo: 'ad-3', icon: 'pen', title: 'Support Legislation & Policy Change', text: 'Support legislation that advances the rights, services and opportunities for individuals with autism.', cta: 'See Priorities', button: true },
    { photo: 'ad-4', icon: 'people-group', title: 'Join Advocacy Campaigns', text: 'Participate in campaigns and initiatives that raise awareness and drive meaningful change.', cta: 'Join Now', button: true, href: '/our-services/advocacy' },
    { photo: 'ad-5', icon: 'handshake', title: 'Partner With Us', text: 'Collaborate with IICC Mission and other organizations to strengthen our collective impact.', cta: 'Partner', button: true, href: '/contact' },
    { photo: 'ad-6', icon: 'heart', title: 'Share Your Story', text: 'Your story has power. Share your journey to inspire others and advance acceptance and inclusion.', cta: 'Share Now', button: true, href: '/get-involved/submit-your-story' },
  ]} />
  <section class="wrap" style="padding-bottom:1.25rem;"><div style="background:#f3f3f3; border-radius:6px; display:grid; grid-template-columns:7rem 1.5fr 1fr; gap:1.25rem; align-items:center; padding:1.25rem;" class="camp-grid">
    <span style="color:var(--color-navy);"><Icon name="hand-holding-heart" size={96} /></span>
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-weight:400; font-size:1.25rem;">Your Voice Can Spark Change.</h2><p style="color:#c9741f; font-family:var(--font-heading); text-transform:uppercase;">Together, we can build a world where everyone belongs.</p><p style="font-size:0.875rem; margin-block:0.5rem;">Advocacy is how we create a better future—one where individuals with autism are seen, heard and valued.</p><ul class="check" style="columns:2;">{['Raise Awareness','Support Families','Influence Policy','Create Opportunity'].map(t => <li style="font-size:0.8125rem;">{t}</li>)}</ul></div>
    <div style="border-left:1px solid #ccc; padding-left:1.25rem;"><h3 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-weight:400;">Get Involved in Advocacy</h3><p style="font-size:0.875rem; margin-block:0.5rem 0.9rem;">There are many ways to make your voice heard and create positive change.</p><div style="display:flex; gap:0.75rem; flex-wrap:wrap;"><a href="/get-involved" class="btn btn--navy">Get Involved →</a><a href="/news/newsletter" class="btn btn--outline">Subscribe for Updates →</a></div></div>
  </div></section>
  <AutismCta title="Advocate today. Impact tomorrow." text="Together, our voices can build a more inclusive, compassionate and just world for all." />
</Layout>
