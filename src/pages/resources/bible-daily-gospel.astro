---
import Layout from '../../layouts/Layout.astro';
import ResHero from '../../components/ResHero.astro';
import ResBand from '../../components/ResBand.astro';
import ResCards from '../../components/ResCards.astro';
import NewsBar from '../../components/NewsBar.astro';
import CheckPanel from '../../components/CheckPanel.astro';
import ImStrip from '../../components/ImStrip.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/resources/${n}.jpg`;
const band6 = [
  { icon: 'book-open', title: 'Faith & Spirituality', text: 'Strengthen your faith and find daily encouragement.' },
  { icon: 'people-group', title: 'Legal & Rights', text: 'Know your rights and access legal information.' },
  { icon: 'hand-holding-heart', title: 'Mental Health & Wellbeing', text: 'Support for your mind and emotions.' },
  { icon: 'people-roof', title: 'Family & Relationships', text: 'Resources to strengthen families and connections.' },
  { icon: 'graduation-cap', title: 'Education & Employment', text: 'Learn, grow and build a better future.' },
  { icon: 'hand-holding-heart', title: 'Practical Help & Community', text: 'Practical guidance and community support.' },
];
const assure = [
  { icon: 'people-group', title: 'You Are Not Alone', text: 'We stand with you and your family.' },
  { icon: 'ear-listen', title: 'We Listen', text: 'Your story matters. We are here to listen.' },
  { icon: 'signs-post', title: 'We Guide', text: 'We help you understand your rights and options.' },
  { icon: 'handshake', title: 'We Connect', text: 'We refer you to trusted legal professionals.' },
  { icon: 'dove', title: 'We Hope', text: 'We believe in healing, justice, and new beginnings.' },
];
---
<Layout title="Bible & Daily Gospel" description="God's Word. Every Day. For Your Life.">
  <ResHero title="<span style='text-transform:none'>Bible &amp;<br/>Daily Gospel</span>" sub="God’s Word. Every Day. For Your Life." text={['The Bible is living and active. It speaks to our hearts, strengthens our faith, and lights our path each day. Read, reflect and be renewed through the Gospel.']} img={img('bi-hero')} alt="An open Bible with a cross at sunrise" />
  <section style="background:var(--color-navy-dark); color:#fff;"><div class="wrap camp-grid" style="display:grid; grid-template-columns:repeat(3,1fr); padding-block:1.25rem;">
    {[['book-bible','Verse of the Day','“Your word is a lamp to my feet and a light to my path.”','– Psalm 119:105',''],['calendar-days','Today’s Gospel','Sunday, 25 May 2025 · Sixth Sunday of Easter','John 15:12-17','Read Today’s Gospel'],['comment-dots','Daily Reflection','“Love one another as I have loved you.” There is no greater love than this, to lay down one’s life for one’s friends.','','Reflect Today']].map(([i,t,a,b,c],k) => <div style={`display:grid; grid-template-columns:3.5rem 1fr; gap:1rem; padding-inline:1.25rem; ${k ? 'border-left:1px solid rgba(201,150,42,0.35);' : ''}`}><span style="color:#d9862a;"><Icon name={i} size={44} /></span><div><h2 style="font-family:var(--font-heading); color:#d9862a; text-transform:uppercase; font-weight:400; font-size:1.125rem;">{t}</h2><p style="font-family:var(--font-heading); margin-top:0.4rem;">{a}</p>{b && <p style="color:#d9862a; font-family:var(--font-heading);">{b}</p>}{c && <a href="https://www.vatican.va" class="btn btn--amber" style="margin-top:0.6rem; padding:0.4rem 0.9rem; font-size:0.7rem;">{c} →</a>}</div></div>)}
  </div></section>
  <section class="wrap" style="padding-block:1.25rem 0.75rem;"><h2 class="camp-h">Explore the Bible</h2><p class="im-p" style="text-align:center;">Discover the richness of God’s Word through the Old and New Testament and Catholic resources.</p><div style="display:grid; grid-template-columns:repeat(4,1fr); gap:0.75rem; margin-top:0.9rem;" class="camp-grid">{[['scroll','Old Testament','Explore the story of God’s covenant with His people.','Explore Old Testament'],['cross','New Testament','Read the life, teachings, death and resurrection of Jesus Christ.','Explore New Testament'],['wine-glass','Catholic Daily Readings','Follow the official daily readings from the Catholic Church.','View Daily Readings'],['hands-praying','Prayer Before Reading Scripture','Come, Holy Spirit, open my heart and mind to hear Your Word.','Pray Now']].map(([i,t,d,c]) => <div style="background:#f5f2ec; border-radius:6px; padding:1.25rem 1rem; text-align:center; display:flex; flex-direction:column; align-items:center; gap:0.5rem;"><span style="width:4rem; height:4rem; border-radius:50%; background:var(--color-navy-dark); color:#fff; display:flex; align-items:center; justify-content:center;"><Icon name={i} size={28} /></span><h3 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:0.9375rem;">{t}</h3><p style="font-size:0.8125rem; flex:1;">{d}</p><a href="https://www.vatican.va" class="btn btn--navy" style="padding:0.4rem 0.9rem; font-size:0.7rem;">{c} →</a></div>)}</div></section>
  <section class="wrap" style="padding-bottom:1rem;"><h2 class="camp-h">Grow in the Word</h2><div style="display:grid; grid-template-columns:repeat(6,1fr); gap:0.6rem; margin-top:0.75rem;" class="camp-grid">{[['book-open','How to Read the Bible','Practical tips to help you understand Scripture and apply it to daily life.','Learn More'],['list-check','Bible Reading Plans','Choose a plan that fits your life and helps you grow in faith.','View Plans'],['magnifying-glass','Scripture Search','Search by keyword, book, verse or topic across the Bible.','Search Now'],['download','Download Daily Gospel','Download the Daily Gospel in PDF format and keep it with you.','Download PDF'],['envelope','Receive Daily Gospel','Start your day with God’s Word, delivered every morning.','Subscribe Now'],['hand-holding-heart','Support God’s Word','Your support helps us share the Bible with those in need.','Support Our Mission']].map(([i,t,d,c]) => <div style="background:#f5f2ec; border-radius:6px; padding:0.9rem; display:flex; flex-direction:column; gap:0.4rem;"><div style="display:grid; grid-template-columns:2.5rem 1fr; gap:0.5rem; align-items:center;"><span style="width:2.5rem; height:2.5rem; border-radius:50%; background:var(--color-navy-dark); color:#fff; display:flex; align-items:center; justify-content:center;"><Icon name={i} size={16} /></span><strong style="font-size:0.75rem; text-transform:uppercase; color:var(--color-navy);">{t}</strong></div><p style="font-size:0.75rem; line-height:1.45; flex:1;">{d}</p><a href="/resources" class="btn btn--amber" style="align-self:flex-start; padding:0.3rem 0.7rem; font-size:0.65rem;">{c} →</a></div>)}</div></section>
  <section class="wrap camp-3">
    <div style="background:#f5f2ec; border-radius:6px; padding:1.25rem;"><h2 class="camp-h" style="font-size:1.125rem;">Popular Bible Reading Plans</h2>{[['bi-pl1','1 Year Bible Plan','Read through the entire Bible in 365 days.'],['bi-pl2','New Testament in 90 Days','Focus on the life and teachings of Jesus Christ.'],['bi-pl3','Gospel in 30 Days','Read through the four Gospels and deepen your faith.'],['bi-pl4','Topical Plans','Explore topics like Faith, Hope, Forgiveness, Healing and more.']].map(([p,t,d]) => <div style="display:grid; grid-template-columns:4rem 1fr; gap:0.75rem; margin-top:0.7rem;"><img src={img(p)} alt="" style="width:100%; border-radius:3px;" /><div><strong style="font-size:0.875rem; color:var(--color-navy);">{t}</strong><p style="font-size:0.75rem;">{d}</p></div></div>)}<a href="/resources" class="btn btn--amber" style="margin-top:0.75rem; padding:0.4rem 0.9rem; font-size:0.7rem;">View All Plans →</a></div>
    <div style="background:#f5f2ec; border-radius:6px; padding:1.25rem; text-align:center;"><h2 class="camp-h" style="font-size:1.125rem;">Scripture Highlight</h2><img src={img('bi-hl')} alt="Hands clasped in prayer over an open Bible" style="width:100%; border-radius:4px; margin-block:0.6rem;" /><p style="font-family:var(--font-heading); color:var(--color-navy); font-size:0.9375rem; line-height:1.5;">“For the word of God is living and active. Sharper than any double-edged sword, it penetrates even to dividing soul and spirit, joints and marrow; it judges the thoughts and attitudes of the heart.”</p><p style="color:#c9741f; font-family:var(--font-heading);">– Hebrews 4:12</p></div>
    <div style="background:#f5f2ec; border-radius:6px; padding:1.25rem;"><CheckPanel light={false} title="Why God’s Word Matters" items={['Strengthens your relationship with God','Brings peace, hope and direction','Helps you make better daily choices','Transforms your heart and life','Equips you to live out your faith']} /><div class="im-note" style="background:var(--color-navy-dark); color:#fff; border:none;"><span style="color:#d9862a;"><Icon name="book-open" size={32} /></span><span>Your Word, O Lord, is eternal; it stands firm in the heavens.<br /><span style="color:#d9862a;">– Psalm 119:89</span></span></div></div>
  </section>
  <NewsBar title="Never Miss the Daily Gospel" text="Subscribe now and receive the Daily Gospel and reflection directly to your inbox every morning." />
  <ImStrip items={assure} />
</Layout>
