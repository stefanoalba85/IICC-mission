---
import Layout from '../layouts/Layout.astro';
import LegalTemplate from '../components/LegalTemplate.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Icon from '../components/Icon.astro';

const tabs = [
  { icon: 'comments', label: 'General Questions', href: '#general' },
  { icon: 'cross', label: 'Faith & Mission', href: '#categories' },
  { icon: 'gear', label: 'Services & Programs', href: '#categories' },
  { icon: 'people-group', label: 'Get Involved', href: '#categories' },
  { icon: 'hand-holding-heart', label: 'Donations & Funding', href: '#categories' },
  { icon: 'handshake', label: 'Partnerships', href: '#categories' },
  { icon: 'landmark-dome', label: 'Rome Headquarters', href: '#categories' },
  { icon: 'file-lines', label: 'Legal & Governance', href: '#categories' },
  { icon: 'circle-question', label: 'Other Questions', href: '#categories' },
];
const faqs = [
  { q: 'What is IICC Mission?', a: 'IICC Mission is the public identity of the Inmate International Catholic Care (IICC) — a Catholic-Christian inspired humanitarian organisation bringing faith, hope, justice and restoration to prisoners, immigration detainees and their families.' },
  { q: 'What is the mission and vision of IICC Mission?', a: 'Our mission is to accompany, support and restore people affected by imprisonment and detention. Our vision is a world where every person is treated with dignity and given the opportunity for a brighter tomorrow.' },
  { q: 'Is IICC Mission a Catholic-Christian inspired organisation?', a: 'Yes. Our work is inspired by the Gospel and the social teaching of the Catholic Church, and we serve every person regardless of faith, background or circumstance.' },
  { q: 'Who does IICC Mission help?', a: 'We serve incarcerated individuals, immigration detainees, their families, former inmates and detainees, victims of abuse and domestic violence, and vulnerable communities.' },
  { q: 'Where is IICC Mission based?', a: 'Our global headquarters is in Rome, Italy (Via delle Milizie 34, 00192), with branches and missions in Italy, Australia and other countries.' },
  { q: 'How is IICC Mission different from other organisations?', a: 'Our mission was founded on lived experience. We combine pastoral care, practical support, advocacy and the Hope Companion Program to walk alongside people for the long term.' },
  { q: 'Is IICC Mission a registered charity?', a: 'IICC Mission operates with transparency and accountability. For details about our registration and governance, please contact us at info@iiccmission.org.' },
];
const cats = [
  { icon: 'cross', t: 'Faith & Mission', d: 'Our Catholic-Christian inspiration, values and approach.', href: '/about-us/inspired-by-faith' },
  { icon: 'gear', t: 'Services & Programs', d: 'Prison ministry, immigration detention, family support and more.', href: '/our-services/who-we-serve' },
  { icon: 'people-group', t: 'Get Involved', d: 'Volunteering, advocacy and ways to support.', href: '/get-involved' },
  { icon: 'hand-holding-heart', t: 'Donations & Funding', d: 'How to donate, funding options and impact.', href: '/donate' },
  { icon: 'handshake', t: 'Partnerships', d: 'Church, NGO and community partnerships.', href: '/partnerships' },
  { icon: 'landmark-dome', t: 'Rome Headquarters', d: 'Our global headquarters in Rome, Italy.', href: '/partnerships/rome-headquarters' },
  { icon: 'file-lines', t: 'Legal & Governance', d: 'Registration, governance and transparency.', href: '/terms-conditions' },
  { icon: 'circle-question', t: 'Other Questions', d: 'Miscellaneous questions and additional information.', href: '/contact' },
];
---
<Layout title="FAQ" description="Frequently asked questions about IICC Mission, our faith, our work, our programs, partnerships and how you can get involved.">
  <style>
    .fq details { display: grid; grid-template-columns: 3.5rem 1fr; margin-top: 0.45rem; margin-left: 0; }
    .fq summary { list-style: none; display: grid; grid-template-columns: 3.5rem 1fr 1.5rem; gap: 0.5rem; align-items: center; cursor: pointer; grid-column: 1 / -1; }
    .fq summary::-webkit-details-marker { display: none; }
    .fq summary b { background: #fbefdc; color: #c9741f; font-family: var(--font-heading); font-weight: 400; text-align: center; padding-block: 0.7rem; border-radius: 3px; }
    .fq summary span { background: #f7f6f3; font-family: var(--font-heading); color: var(--color-navy); padding: 0.7rem 1rem; border-radius: 3px; }
    .fq summary i { font-style: normal; font-size: 1.4rem; color: var(--color-navy); }
    .fq details[open] summary i { transform: rotate(45deg); }
    .fq details > p { grid-column: 2 / -1; padding: 0.6rem 1rem 0.2rem 0.5rem; }
    .fq-cats { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 1rem; }
    .fq-cats a { display: grid; grid-template-columns: 3rem 1fr 1rem; gap: 0.9rem; align-items: center; border: 1px solid rgba(27,39,81,0.1); border-radius: 4px; padding: 0.9rem 1rem; color: var(--color-navy); background: #fff; }
    .fq-cats a:hover { background: #fbf6ec; }
    .fq-cats strong { display: block; font-family: var(--font-heading); text-transform: uppercase; font-weight: 400; font-size: 0.9375rem; }
    .fq-cats small { font-family: var(--font-heading); font-size: 0.8125rem; line-height: 1.4; display: block; }
    .fq-still { position: relative; border-radius: 4px; overflow: hidden; background: var(--color-navy-dark); color: #fff; }
    .fq-still img { width: 100%; aspect-ratio: 280 / 142; object-fit: cover; -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent); mask-image: linear-gradient(180deg, #000 60%, transparent); }
    .fq-still div { padding: 0 1.25rem 1.25rem; margin-top: -1.5rem; position: relative; display: flex; flex-direction: column; gap: 0.6rem; }
    .fq-still h3 { font-family: var(--font-heading); text-transform: uppercase; font-size: 1.5rem; line-height: 1.1; }
    .fq-still p { font-size: 0.9375rem; line-height: 1.45; }
    @media (max-width: 640px) { .fq-cats { grid-template-columns: 1fr; } }
  </style>
  <LegalTemplate
    kicker="FAQ"
    title="Frequently Asked"
    titleGold="Questions"
    text={[
      'Find answers to common questions about IICC Mission, our faith, our work, our programs, partnerships and how you can get involved.',
      'If you cannot find the information you are looking for, please contact our team. We will be happy to assist you.',
    ]}
    img="/images/support/faq-hero.jpg"
    alt="St Peter's Basilica and the Tiber bridges at golden hour"
    quote="Seek answers. Find hope. Be part of something meaningful."
    tabs={tabs}
    links={['Our Mission', 'Our Services', 'Our Programs', 'Get Involved', 'Donate', 'Volunteer', 'Partnership Opportunities', 'Rome Headquarters', 'News & Events', 'Contact Us']}
  >
    <div class="fq">
      <h2 id="general">General Questions</h2>
      {faqs.map((f, i) => (
        <details>
          <summary><b>{String(i + 1).padStart(2, '0')}</b><span>{f.q}</span><i>+</i></summary>
          <p>{f.a}</p>
        </details>
      ))}
      <div class="fq-cats" id="categories">
        {cats.map(c => <a href={c.href}><Icon name={c.icon} size={36} /><div><strong>{c.t}</strong><small>{c.d}</small></div><span>›</span></a>)}
      </div>
    </div>

    <div slot="sidetop" class="fq-still">
      <img src="/images/support/faq-side.jpg" alt="Statue of an angel with a cross before St Peter's Basilica" />
      <div>
        <h3>Still Have<br />a Question?</h3>
        <p>Our team is here to help. Please contact us and we will be happy to provide more information.</p>
        <a href="/contact" class="btn btn--amber" style="justify-content:space-between;"><Icon name="envelope" size={18} /> Contact Us →</a>
      </div>
    </div>
  </LegalTemplate>

  <QuoteBand quote="Together, in faith and solidarity, we can build a more just, compassionate and inclusive world." left="/images/support/faq-bl.jpg" right="/images/support/faq-br.jpg" />
</Layout>
