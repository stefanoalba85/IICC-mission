---
import Layout from '../../layouts/Layout.astro';

const pillars = [
  { title: 'Dignity for All', desc: 'A world where every person is valued, respected and treated with compassion.', icon: 'M12 2a4 4 0 0 1 4 4c0 1.5-.8 2.8-2 3.5V12h3a3 3 0 0 1 3 3v1h-2v-1a1 1 0 0 0-1-1h-3v7h-2v-7H9a1 1 0 0 0-1 1v1H6v-1a3 3 0 0 1 3-3h3V9.5C10.8 8.8 10 7.5 10 6a4 4 0 0 1 2-4Z' },
  { title: 'Opportunity & Inclusion', desc: 'Communities where everyone has access to support, education and new beginnings.', icon: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20c0-3 2.7-5 6-5s6 2 6 5v1H2v-1Zm12.3-4.6c2.1.5 3.7 2.2 3.7 4.6v1h4v-1c0-2.8-2.3-4.9-5.1-4.9-.9 0-1.8.1-2.6.3Z' },
  { title: 'Justice & Mercy', desc: 'Fairness, reconciliation and advocacy for those who are marginalised or in crisis.', icon: 'M12 2v2M4 6l8-2 8 2M4 6l-2 6h6L6 6Zm16 0-2 6h6l-2-6ZM4 12a3 3 0 0 0 6 0M14 12a3 3 0 0 0 6 0M12 4v15m-5 0h10' },
  { title: 'Healing & Restoration', desc: 'Lives transformed through spiritual, emotional and practical support.', icon: 'M12 21s-7-4.3-9-8.3C1.3 9.2 3 6 6.2 5.4c1.8-.4 3.6.4 4.5 1.9a4.3 4.3 0 0 1 4.5-1.9C18.4 6 20 9.2 18.3 12.7 16 16.7 12 21 12 21Z' },
  { title: 'Stronger Communities', desc: 'A more compassionate and united society where hope replaces despair.', icon: 'M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6' },
];
---
<Layout title="Our Vision" description="A Brighter Tomorrow for Every Life — the vision guiding IICC Mission.">
  <nav class="breadcrumb wrap"><a href="/">Home</a><span class="breadcrumb__sep">/</span><a href="/about-us">About Us</a><span class="breadcrumb__sep">/</span><span class="breadcrumb__current">Our Vision</span></nav>

  <!-- HERO -->
  <section class="hero-wave">
    <div class="hero-wave__bg">
      <img src="/images/our-vision/hero.jpg" alt="St Peter's Basilica at sunset with a dove flying" />
    </div>
    <div class="hero-wave__panel">
      <span class="eyebrow eyebrow--white">Our Vision</span>
      <h1 class="section-title section-title--white" style="font-size:clamp(1.75rem,4vw,2.5rem);">
        A Brighter <span class="text-amber">Tomorrow</span> for Every Life
      </h1>
      <p class="section-desc section-desc--white" style="max-width:360px;">
        We envision a world where every individual, regardless of their past, background or
        circumstances, is treated with dignity, supported with compassion and given the
        opportunity to rebuild their life.
      </p>
    </div>
  </section>

  <!-- VISION IN DETAIL -->
  <section class="section section--offwhite">
    <div class="wrap cols-60-40">
      <div>
        <span class="eyebrow">Our Vision in Detail</span>
        <h2 class="section-title" style="margin-block:0.5rem;">A World of Dignity, Healing and New Beginnings</h2>
        <p class="section-desc" style="max-width:none; margin-bottom:1rem;">
          We envision communities where no one is left behind — where individuals and families
          affected by incarceration, immigration detention, hardship, trauma or exclusion are
          welcomed, supported and empowered to rebuild their lives with dignity and hope.
        </p>
        <p class="section-desc" style="max-width:none;">
          Through faith-driven action, collaboration and practical support, we seek to break
          cycles of despair and create pathways to healing, restoration and reintegration.
        </p>
      </div>
      <div class="quote-box">
        <span class="quote-box__mark">&ldquo;</span>
        <p class="quote-box__text">
          "For I know the plans I have for you, plans to prosper you and not to harm you,
          plans to give you hope and a future."
        </p>
        <span class="quote-box__ref">— Jeremiah 29:11</span>
      </div>
    </div>
  </section>

  <!-- VISION PILLARS -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head section-head--left">
        <span class="eyebrow">Our Vision Pillars</span>
        <h2 class="section-title">Building a More Just, Compassionate and Hopeful World</h2>
        <p class="section-desc">Our vision is brought to life through five key pillars:</p>
      </div>
      <div class="pillars">
        {pillars.map((p, i) => (
          <div class="pillar">
            <div class={`pillar__icon-wrap ${i % 2 === 1 ? 'pillar__icon-wrap--filled' : ''}`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon}/></svg>
            </div>
            <span class="pillar__label">{p.title}</span>
            <p class="pillar__desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VISION IN ACTION -->
  <section class="photo-band">
    <div class="photo-band__bg">
      <img src="/images/our-vision/action-band.jpg" alt="A family looking over Rome at sunset" />
    </div>
    <div class="photo-band__text">
      <span class="eyebrow eyebrow--white">Our Vision in Action</span>
      <h2 class="section-title section-title--white" style="font-size:clamp(1.25rem,3vw,1.75rem);">Hope Today. Stronger Communities Tomorrow.</h2>
      <p class="section-desc section-desc--white" style="max-width:320px;">
        Through compassion, service and partnership, we work toward a world where every
        individual and family can thrive.
      </p>
      <a href="/get-involved" class="btn btn--amber" style="align-self:flex-start;">Get Involved &gt;</a>
    </div>
    <div class="photo-band__aside">
      <div class="photo-band__aside-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.3-9-8.3C1.3 9.2 3 6 6.2 5.4c1.8-.4 3.6.4 4.5 1.9a4.3 4.3 0 0 1 4.5-1.9C18.4 6 20 9.2 18.3 12.7 16 16.7 12 21 12 21Z"/></svg>
        <span>People Rebuild.</span>
      </div>
      <div class="photo-band__aside-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20c0-3 2.7-5 6-5s6 2 6 5v1H2v-1Zm12.3-4.6c2.1.5 3.7 2.2 3.7 4.6v1h4v-1c0-2.8-2.3-4.9-5.1-4.9-.9 0-1.8.1-2.6.3Z"/></svg>
        <span>Families Heal.</span>
      </div>
      <div class="photo-band__aside-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
        <span>Communities Grow.</span>
      </div>
      <div class="photo-band__aside-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3c-2 2.5-4 3-4 6a4 4 0 0 0 8 0c0-3-2-3.5-4-6Zm-7 9c1 2 3 2.5 3 5a3 3 0 0 1-6 0c0-2.5 2-3 3-5Zm14 0c1 2 3 2.5 3 5a3 3 0 0 1-6 0c0-2.5 2-3 3-5Z"/></svg>
        <span>A Brighter Tomorrow Becomes Possible.</span>
      </div>
    </div>
  </section>
</Layout>
