---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../lib/icons';

const pillars: { title: string; desc: string; icon: IconName }[] = [
  { title: 'Dignity for All', desc: 'A world where every person is valued, respected and treated with compassion.', icon: 'pray' },
  { title: 'Opportunity and Inclusion', desc: 'Communities where everyone has access to support, education and new beginnings.', icon: 'people' },
  { title: 'Justice and Mercy', desc: 'Fairness, reconciliation and advocacy for those who are marginalized or in crisis.', icon: 'scales' },
  { title: 'Healing and Restoration', desc: 'Lives transformed through spiritual, emotional and practical support.', icon: 'heartHand' },
  { title: 'Stronger Communities', desc: 'A more compassionate and united society where hope replaces despair.', icon: 'sunRoad' },
];
const promises: { text: string; icon: IconName }[] = [
  { text: 'People Rebuild.', icon: 'heart' },
  { text: 'Families Heal.', icon: 'people' },
  { text: 'Communities Grow.', icon: 'globe' },
  { text: 'A Brighter Tomorrow Becomes Possible.', icon: 'dove' },
];
---
<Layout title="Our Vision" description="A Brighter Tomorrow for Every Life — the vision guiding IICC Mission.">
  <style>
    .ov-detail { background: #f5efe3; }
    .ov-detail__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: center; }
    .ov-detail p { font-size: 1.0625rem; line-height: 1.6; color: var(--color-text); }
    .ov-pillars { background: #faf7f1; }
    .ov-action { background: var(--color-navy); }
    .ov-action .photo-band__bg { inset: 0 18% 0 28%; }
    .ov-action .photo-band__bg img { object-position: center 70%; -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); }
    .ov-action .photo-band__text { width: min(460px, 40%); background: linear-gradient(90deg, var(--color-navy) 70%, rgba(27,39,81,0)); padding-left: max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem)); }
    .ov-action .photo-band__aside { margin-right: max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem)); align-self: center; border: none; border-radius: 6px; }
    .ov-action .photo-band__aside-item { border-left: 1px solid rgba(201,160,23,0.5); padding-left: 0.875rem; }
    .ov-action .photo-band__aside-item :global(svg) { margin-left: -2.9rem; margin-right: 1rem; }
    .ov-action .photo-band__aside { padding-left: 3.25rem; }
    @media (max-width: 860px) { .ov-detail__grid { grid-template-columns: 1fr; } }
  </style>

  <section class="hero-wave">
    <div class="hero-wave__bg"><img src="/images/our-vision/hero.jpg" alt="St Peter's Basilica at sunset with a dove flying above Rome" /></div>
    <div class="hero-wave__panel">
      <span class="eyebrow">Our Vision</span>
      <h1 class="hero-wave__title">A Brighter <span class="text-amber">Tomorrow</span> for Every Life</h1>
      <p class="hero-wave__lead">
        We envision a world where every individual, regardless of their past, background or
        circumstances, is treated with dignity, supported with compassion and given the
        opportunity to rebuild their life.
      </p>
    </div>
  </section>

  <section class="section ov-detail">
    <div class="wrap">
      <span class="eyebrow">Our Vision in Detail</span>
      <h2 class="section-title" style="margin-block:0.5rem 1.5rem;">A World of Dignity, Healing and New Beginnings</h2>
      <div class="ov-detail__grid">
        <div style="display:flex; flex-direction:column; gap:1rem;">
          <p>We envision communities where no one is left behind — where individuals and families affected by incarceration, immigration detention, hardship, trauma or exclusion are welcomed, supported and empowered to rebuild their lives with dignity and hope.</p>
          <p>Through faith-driven action, collaboration and practical support, we seek to break cycles of despair and create pathways to healing, restoration and reintegration.</p>
        </div>
        <div class="divider-col">
          <div class="quote-plain">
            <p class="quote-plain__text">For I know the plans I have for you, plans to prosper you and not to harm you, plans to give you hope and a future.</p>
            <span class="quote-plain__ref">Jeremiah 29:11</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section ov-pillars">
    <div class="wrap">
      <span class="eyebrow">Our Vision Pillars</span>
      <h2 class="section-title" style="margin-top:0.5rem;">Building a More Just, Compassionate and Hopeful World</h2>
      <p style="font-size:1.0625rem; margin-block:0.5rem 2.5rem;">Our vision is brought to life through five key pillars:</p>
      <div class="pillars">
        {pillars.map((p, i) => (
          <div class="pillar">
            <div class={`pillar__icon-wrap ${i % 2 ? 'pillar__icon-wrap--filled' : ''}`}><Icon name={p.icon} /></div>
            <span class="pillar__label">{p.title}</span>
            <p class="pillar__desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="photo-band ov-action" style="min-height:340px;">
    <div class="photo-band__bg"><img src="/images/our-vision/action-band.jpg" alt="A family looking out over Rome at sunset" /></div>
    <div class="photo-band__text">
      <span class="eyebrow">Our Vision in Action</span>
      <h2 class="hero-wave__title" style="font-size:clamp(1.5rem,3vw,2.125rem);">Hope Today.<br />Stronger Communities Tomorrow.</h2>
      <p style="color:#fff; font-size:1rem; line-height:1.5;">Through compassion, service and partnership, we work toward a world where every individual and family can thrive.</p>
      <a href="/get-involved" class="btn btn--amber" style="align-self:flex-start;">Get Involved &gt;</a>
    </div>
    <div class="photo-band__aside">
      {promises.map(p => (
        <div class="photo-band__aside-item"><Icon name={p.icon} size={26} /><span>{p.text}</span></div>
      ))}
    </div>
  </section>
</Layout>
