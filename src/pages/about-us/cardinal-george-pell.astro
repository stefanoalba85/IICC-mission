---
import Layout from '../../layouts/Layout.astro';
import PellStory from '../../components/PellStory.astro';
---
<Layout title="Cardinal George Pell — Inspiration & Support" description="A message of faith, courage and hope that helped bring IICC Mission to life.">
  <PellStory
    imgDir="cardinal-pell"
    heroAlt="Cardinal George Pell praying in a candlelit cell"
    heroQuote="Faith can be tested in moments of darkness, but hope can continue to shine through every trial."
    pillars={[
      { title: 'Spiritual & Pastoral Care', icon: 'pray' },
      { title: 'Legal Assistance & Advocacy', icon: 'scales' },
      { title: 'Education & Awareness', icon: 'book', color: '#5e6b2f' },
      { title: 'Humanitarian Support', icon: 'heartHand' },
      { title: 'Healing, Restoration & Reintegration', icon: 'sunRoad', color: 'var(--color-amber)' },
    ]}
    pillarsCaption="Accompanying. Empowering. Restoring Hope."
  />
</Layout>
