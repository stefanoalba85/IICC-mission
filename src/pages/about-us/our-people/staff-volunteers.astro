---
import Layout from '../../../layouts/Layout.astro';
import PeopleHero from '../../../components/PeopleHero.astro';
import AssuranceStrip from '../../../components/AssuranceStrip.astro';
import Icon from '../../../components/Icon.astro';
import type { IconName } from '../../../lib/icons';

const img = (n: string) => `/images/staff-volunteers/${n}.jpg`;

const leaders = [
  { name: 'Antonio G. Dattilo', role: 'Ambassador & Founder', text: 'Leads our mission with lived experience, faith and a passion for justice and restoration.', email: 'antonio@iiccmission.org' },
  { name: 'Fr. Anthony David', role: 'Spiritual Director', text: 'Provides spiritual guidance and ensures our mission remains rooted in prayer, faith and the Gospel.', email: 'fr.anthony@iiccmission.org' },
  { name: 'Maria Grazia', role: 'Operations Director', text: 'Oversees programs, operations and the day-to-day running of our mission.', email: 'maria@iiccmission.org' },
  { name: 'James Porter', role: 'Outreach Director', text: 'Leads outreach initiatives and builds partnerships in communities worldwide.', email: 'james@iiccmission.org' },
  { name: 'Sr. Lucia Maria', role: 'Pastoral Care Director', text: 'Coordinates pastoral care and support for individuals and their families.', email: 'sr.lucia@iiccmission.org' },
  { name: 'Fr. Michael Tran', role: 'Chaplaincy Director', text: 'Supports chaplains and pastoral teams in prisons and detention centres.', email: 'michael@iiccmission.org' },
];
const volunteers: { title: string; text: string; icon: IconName }[] = [
  { title: 'Visit & Support', text: 'Our volunteers visit, listen and offer companionship to inmates and detainees.', icon: 'heartHand' },
  { title: 'Letters of Hope', text: 'Writing letters that bring encouragement, hope and a reminder that they are not forgotten.', icon: 'mail' },
  { title: 'Practical Help', text: 'Preparing care packages, providing essentials and practical assistance for individuals and families in need.', icon: 'home' },
  { title: 'Prayer & Intercession', text: 'Standing in prayer for those we serve and their families every day.', icon: 'pray' },
  { title: 'Community Outreach', text: 'Raising awareness, building relationships and creating pathways to restoration.', icon: 'people' },
];
const ways: { title: string; icon: IconName }[] = [
  { title: 'Volunteer Your Time', icon: 'person' },
  { title: 'Share Your Skills', icon: 'heartHand' },
  { title: 'Be a Community Advocate', icon: 'people' },
  { title: 'Pray and Support', icon: 'dove' },
];
const values: { title: string; text: string; icon: IconName }[] = [
  { title: 'Faith', text: 'Guided by the Gospel and the teachings of the Catholic Church.', icon: 'cross' },
  { title: 'Compassion', text: 'Seeing Christ in every person and responding with love and mercy.', icon: 'heart' },
  { title: 'Justice', text: 'Upholding the dignity and rights of every human person.', icon: 'scales' },
  { title: 'Dignity', text: 'Respecting and valuing every individual we serve.', icon: 'people' },
  { title: 'Restoration', text: 'Helping individuals and families rebuild hope and new futures.', icon: 'sunRoad' },
];
---
<Layout title="Staff & Volunteers" description="United in Faith. Driven by Compassion.">
  <style>
    .sv-h { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; text-align: center; font-size: 1.25rem; }
    .sv-leaders { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.75rem; margin-top: 1rem; }
    .sv-leader { background: #faf8f4; border: 1px solid rgba(27,39,81,0.08); border-radius: 6px; overflow: hidden; text-align: center; display: flex; flex-direction: column; }
    .sv-leader img { width: 100%; aspect-ratio: 150 / 140; object-fit: cover; }
    .sv-leader > div { padding: 0.75rem 0.6rem 1rem; display: flex; flex-direction: column; gap: 0.35rem; flex: 1; }
    .sv-leader h3 { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.0625rem; font-weight: 400; }
    .sv-leader .role { font-family: var(--font-heading); color: var(--color-amber); font-size: 0.8125rem; }
    .sv-leader p { font-family: var(--font-heading); font-size: 0.75rem; line-height: 1.5; flex: 1; }
    .sv-leader .contact { font-size: 0.6875rem; color: var(--color-navy); text-align: left; display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.5rem; }
    .sv-leader .contact span { display: flex; gap: 0.4rem; align-items: center; }
    .sv-leader .contact :global(svg) { color: var(--color-amber); flex-shrink: 0; }
    .sv-vols { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.75rem; margin-top: 1rem; }
    .sv-vol { background: #faf8f4; border-radius: 6px; overflow: hidden; text-align: center; }
    .sv-vol__photo { position: relative; }
    .sv-vol__photo img { width: 100%; aspect-ratio: 186 / 110; object-fit: cover; }
    .sv-vol__icon { position: absolute; left: 50%; bottom: -1.6rem; transform: translateX(-50%); width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--color-navy); color: #fff; border: 2px solid #fff; display: flex; align-items: center; justify-content: center; }
    .sv-vol > div:last-child { padding: 2.1rem 0.75rem 1rem; }
    .sv-vol h3 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 0.9375rem; font-weight: 400; }
    .sv-vol p { font-family: var(--font-heading); font-size: 0.8125rem; line-height: 1.5; margin-top: 0.4rem; }
    .sv-band { background: var(--color-navy-dark); color: #fff; }
    .sv-band__grid { display: grid; grid-template-columns: 1.4fr 1.6fr 1fr; gap: 1.5rem; align-items: center; padding-block: 1rem; }
    .sv-band h2 { font-family: var(--font-heading); color: var(--color-amber); text-transform: uppercase; font-size: 1.125rem; }
    .sv-band p { font-family: var(--font-heading); font-size: 0.875rem; line-height: 1.5; }
    .sv-ways { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 1rem; }
    .sv-ways span { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
    .sv-ways i { width: 3.25rem; height: 3.25rem; border-radius: 50%; border: 1.5px solid var(--color-amber); color: var(--color-amber); display: flex; align-items: center; justify-content: center; }
    .sv-join { background: var(--color-amber-dark); border-radius: 4px; padding: 1.25rem; text-align: center; display: flex; flex-direction: column; gap: 0.6rem; }
    .sv-join h2 { color: #fff; }
    .sv-values { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-top: 1rem; }
    .sv-value { display: grid; grid-template-columns: 3rem 1fr; gap: 0.75rem; align-items: start; color: var(--color-navy); }
    .sv-value h3 { font-family: var(--font-heading); text-transform: uppercase; font-size: 0.875rem; }
    .sv-value p { font-family: var(--font-heading); font-size: 0.78rem; line-height: 1.5; color: var(--color-text); }
    @media (max-width: 960px) {
      .sv-leaders { grid-template-columns: repeat(3, 1fr); }
      .sv-vols, .sv-values { grid-template-columns: 1fr 1fr; row-gap: 1.5rem; }
      .sv-band__grid { grid-template-columns: 1fr; }
    }
  </style>

  <PeopleHero
    title="Staff &amp;<br/>Volunteers"
    subtitle="United in Faith.<br/>Driven by Compassion."
    photo={img('hero')}
    photoAlt="IICC Mission volunteers standing together"
    quote="Carry each other’s burdens, and in this way you will fulfill the law of Christ."
    quoteRef="Galatians 6:2"
  >
    <p>Our staff and volunteers are the heart of the IICC Mission. Together, we walk alongside inmates, detainees and their families—offering hope, support and a path to restoration.</p>
  </PeopleHero>

  <div class="statement-band">
    <div class="wrap">
      <h2>One Mission. One Team. One Purpose.</h2>
      <p>Every member of our team is committed to living our values of faith, compassion, justice and dignity. We are privileged to serve those who are often forgotten and walk with them toward a brighter future.</p>
    </div>
  </div>

  <section style="padding-block:1.5rem;">
    <div class="wrap">
      <h2 class="sv-h">Our Leadership Team</h2>
      <span class="heart-rule heart-rule--center" style="max-width:120px;">♥</span>
      <div class="sv-leaders">
        {leaders.map((l, i) => (
          <article class="sv-leader">
            <img src={img(`l${i + 1}`)} alt={l.name} />
            <div>
              <h3>{l.name}</h3>
              <span class="role">{l.role}</span>
              <p>{l.text}</p>
              <div class="contact">
                <span><Icon name="mail" size={12} />{l.email}</span>
                <span><Icon name="phone" size={12} />+39 349 303 6235</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <h2 class="sv-h" style="margin-top:1.75rem;">Our Volunteers</h2>
      <span class="heart-rule heart-rule--center" style="max-width:120px;">♥</span>
      <div class="sv-vols">
        {volunteers.map((v, i) => (
          <article class="sv-vol">
            <div class="sv-vol__photo"><img src={img(`v${i + 1}`)} alt="" /><span class="sv-vol__icon"><Icon name={v.icon} size={24} /></span></div>
            <div><h3>{v.title}</h3><p>{v.text}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sv-band">
    <div class="wrap sv-band__grid">
      <div style="display:grid; grid-template-columns:3.25rem 1fr; gap:1rem; align-items:start;">
        <span class="text-amber"><Icon name="heart" size={48} stroke={1.5} /></span>
        <div><h2>Make a Difference</h2><p>There are many ways you can serve. Your time, skills and compassion can bring hope and change lives.</p></div>
      </div>
      <div class="sv-ways">
        {ways.map(w => <span><i><Icon name={w.icon} size={24} /></i>{w.title}</span>)}
      </div>
      <div class="sv-join">
        <h2>Join Our Mission</h2>
        <p>Be the hands and feet of Christ in the world.</p>
        <a href="/get-involved" class="btn btn--navy" style="justify-content:center;">Get Involved Today →</a>
      </div>
    </div>
  </section>

  <section style="padding-block:1.5rem;">
    <div class="wrap">
      <h2 class="sv-h">Our Values in Action</h2>
      <span class="heart-rule heart-rule--center" style="max-width:120px;">♥</span>
      <div class="sv-values">
        {values.map(v => (
          <div class="sv-value"><Icon name={v.icon} size={40} stroke={1.6} /><div><h3>{v.title}</h3><p>{v.text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <AssuranceStrip />
</Layout>
