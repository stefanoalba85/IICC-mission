---
import Layout from '../../../layouts/Layout.astro';

const team = [
  { name: 'Antonio G. Dattilo', role: 'Ambassador & Founder', desc: 'Leads our mission with lived experience, faith and a passion for justice and restoration.' },
  { name: 'Fr. Anthony David', role: 'Spiritual Director', desc: 'Provides spiritual guidance and ensures our mission remains rooted in prayer, faith and the Gospel.' },
  { name: 'Maria Grazia', role: 'Operations Director', desc: 'Oversees programs, operations and the day-to-day running of our mission.' },
  { name: 'James Porter', role: 'Outreach Director', desc: 'Leads outreach initiatives and builds partnerships in communities worldwide.' },
  { name: 'Sr. Lucia Maria', role: 'Pastoral Care Director', desc: 'Coordinates pastoral care and support for individuals and their families.' },
  { name: 'Fr. Michael Tran', role: 'Chaplaincy Director', desc: 'Supports chaplains and pastoral teams in prisons and detention centres.' },
];
const volunteers = [
  { title: 'Visit & Support', desc: 'Our volunteers visit, listen and offer companionship to inmates and detainees.' },
  { title: 'Letters of Hope', desc: 'Writing letters that bring encouragement, hope and a reminder that they are not forgotten.' },
  { title: 'Practical Help', desc: 'Preparing care packages, providing essentials and practical assistance for individuals and families in need.' },
  { title: 'Prayer & Intercession', desc: 'Standing in prayer for those we serve and their families every day.' },
  { title: 'Community Outreach', desc: 'Raising awareness, building relationships and creating pathways to restoration.' },
];
const values = [
  { title: 'Faith', desc: 'Guided by the Gospel and the teachings of the Catholic Church.' },
  { title: 'Compassion', desc: 'Seeing Christ in every person and responding with love and mercy.' },
  { title: 'Justice', desc: 'Upholding the dignity and rights of every human person.' },
  { title: 'Dignity', desc: 'Respecting and valuing every individual we serve.' },
  { title: 'Restoration', desc: 'Helping individuals and families rebuild hope and new futures.' },
];
---
<Layout title="Staff & Volunteers" description="United in Faith. Driven by Compassion.">

  <section class="hero-split">
    <div class="hero-split__text">
      <h1 class="section-title" style="margin-block:0.5rem;">Staff &amp; Volunteers</h1>
      <p style="font-weight:700; color:var(--color-amber);">United in Faith. Driven by Compassion.</p>
      <p class="section-desc" style="max-width:none;">
        Our staff and volunteers are the heart of the IICC Mission. Together, we walk alongside
        inmates, detainees and their families — offering hope, support and a path to restoration.
      </p>
      <div class="hero-split__quote" style="position:static; width:auto;">
        <p class="hero-split__quote-text">Carry each other's burdens, and in this way you will fulfil the law of Christ.</p>
        <span class="hero-split__quote-ref">— Galatians 6:2</span>
      </div>
    </div>
    <div class="hero-split__photo">
      <img src="https://images.unsplash.com/photo-1491438590914-bc09fcaaf77a?w=1000&q=80" alt="Volunteers walking together" />
    </div>
  </section>

  <div class="amber-band">
    <p style="font-family:var(--font-heading); font-weight:700; color:#fff; font-size:1.0625rem;">ONE MISSION. ONE TEAM. ONE PURPOSE.</p>
  </div>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head"><h2 class="section-title">Our Leadership Team</h2></div>
      <div class="grid-3">
        {team.map(t => (
          <div class="person-card">
            <div class="person-card__body">
              <p class="person-card__name">{t.name}</p>
              <span class="person-card__role">{t.role}</span>
              <p class="person-card__desc">{t.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--offwhite">
    <div class="wrap">
      <div class="section-head"><h2 class="section-title">Our Volunteers</h2></div>
      <div class="grid-3">
        {volunteers.map(v => (
          <div class="card"><span class="card__title">{v.title}</span><p class="card__body">{v.desc}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head"><h2 class="section-title">Our Values in Action</h2></div>
      <div class="pillars">
        {values.map(v => <div class="pillar"><span class="pillar__label">{v.title}</span><p class="pillar__desc">{v.desc}</p></div>)}
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="wrap cta-band__inner">
      <div class="cta-band__text">
        <h2 class="section-title section-title--white">Be the Hands and Feet of Christ in the World</h2>
        <p class="section-desc section-desc--white">There are many ways you can serve. Your time, skills and compassion can bring hope and change lives.</p>
      </div>
      <a href="/get-involved" class="btn btn--amber">Get Involved Today &gt;</a>
    </div>
  </div>
</Layout>
