---
import Layout from '../../../layouts/Layout.astro';

const groups = [
  { title: 'Former Prisoners', sub: 'A Living Testimony of Hope', desc: 'Thank you for your courage, your second chances, and for using your lived experience to inspire and help others find hope and purpose.' },
  { title: 'Prisoners & Detainees', sub: 'Our Brothers and Sisters', desc: 'Thank you for your trust, your faith, and for allowing us to walk with you in your journey. You are not forgotten. You are loved.' },
  { title: 'Chaplains & Priests', sub: 'Shepherds of Hope', desc: "Thank you for your faithful ministry, spiritual guidance, and for being Christ's presence behind bars and in detention centres." },
  { title: 'Archbishops, Bishops & Religious Leaders', sub: 'Guidance and Blessings', desc: 'Thank you for your endorsement, wisdom, and support of our mission. Your leadership and prayers strengthen our foundation.' },
  { title: 'Families & Loved Ones', sub: 'The Heart Behind Every Journey', desc: 'Thank you for your unwavering love, patience, and sacrifices. You are the silent strength that keeps hope alive.' },
  { title: 'Volunteers & Staff', sub: 'The Hands and Feet of Our Mission', desc: 'Thank you for giving your time, skills and compassion. Your dedication turns our mission into action and changes lives every day.' },
  { title: 'Donors & Supporters', sub: 'Partners in Hope', desc: 'Thank you for your generosity and belief in our mission. Your support provides resources, restores dignity and builds brighter futures.' },
  { title: 'Parishes, Communities & Organisations', sub: 'Stronger Together', desc: 'Thank you for working with us in faith, for opening doors, and for standing united with us in this mission of love and justice.' },
];
---
<Layout title="Acknowledgements" description="Grateful Hearts. Stronger Mission.">
  <nav class="breadcrumb wrap"><a href="/">Home</a><span class="breadcrumb__sep">/</span><a href="/about-us">About Us</a><span class="breadcrumb__sep">/</span><a href="/about-us/our-people">Our People</a><span class="breadcrumb__sep">/</span><span class="breadcrumb__current">Acknowledgements</span></nav>

  <section class="hero-split">
    <div class="hero-split__text">
      <h1 class="section-title" style="margin-block:0.5rem;">Acknowledgements</h1>
      <p style="font-weight:700; color:var(--color-amber);">Grateful Hearts. Stronger Mission.</p>
      <p class="section-desc" style="max-width:none;">
        The IICC Mission exists because of the generosity, faith and love of so many people. To
        every individual, community and organisation who has walked with us — thank you.
      </p>
      <p style="font-weight:700; color:var(--color-navy);">Together, we bring hope.</p>
      <div class="hero-split__quote" style="position:static; width:auto;">
        <p class="hero-split__quote-text">I can do all things through Christ who strengthens me.</p>
        <span class="hero-split__quote-ref">— Philippians 4:13</span>
      </div>
    </div>
    <div class="hero-split__photo">
      <img src="https://images.unsplash.com/photo-1529070538774-1843cb3265df?w=1000&q=80" alt="Community gathered at sunset" />
    </div>
  </section>

  <div class="amber-band">
    <p style="font-family:var(--font-heading); font-weight:700; color:#fff; font-size:1.0625rem;">WITH GRATITUDE, WE ACKNOWLEDGE EVERY HEART THAT MAKES OUR MISSION POSSIBLE.</p>
    <p style="color:rgba(255,255,255,0.9); margin-top:0.5rem;">Your prayers, time, talents, resources and encouragement strengthen our mission.</p>
  </div>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head"><h2 class="section-title">We Gratefully Acknowledge</h2></div>
      <div class="grid-4">
        {groups.map(g => (
          <div class="card">
            <span class="card__title">{g.title}</span>
            <p style="font-size:0.75rem; font-weight:700; color:var(--color-amber);">{g.sub}</p>
            <p class="card__body">{g.desc}</p>
          </div>
        ))}
      </div>
      <div class="quote-box" style="max-width:600px; margin-inline:auto; margin-top:2.5rem;">
        <p class="quote-box__text">"Whatever you did for one of the least of these brothers and sisters of mine, you did for me."</p>
        <span class="quote-box__ref">— Matthew 25:40</span>
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="wrap cta-band__inner">
      <div class="cta-band__text">
        <h2 class="section-title section-title--white">You Are Part of Their Story</h2>
        <p class="section-desc section-desc--white">Because of you, lives are being transformed. Together, we are restoring hope, rebuilding dignity and creating pathways to a new beginning.</p>
      </div>
      <a href="/get-involved" class="btn btn--amber">Join Our Mission &gt;</a>
    </div>
  </div>
</Layout>
