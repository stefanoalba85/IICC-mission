---
import Layout from '../../layouts/Layout.astro';
import PellStory from '../../components/PellStory.astro';
---
<Layout title="Inspired By Faith" description="Inspired by Cardinal George Pell — a message of faith, courage and hope that helped bring IICC Mission to life.">
  <PellStory
    imgDir="inspired-by-faith"
    heroAlt="Antonio G. Dattilo and Cardinal George Pell in front of St Peter's Basilica"
    heroQuote="The Catholic Church needs you. Your lived experience will be a treasure for many. Have courage my son, start doing something. Changes come always from the bottom and not from the top..."
    heroAside
    ring
    closing
    pillars={[
      { title: 'Prison Ministry', icon: 'bars' },
      { title: 'Immigration Detention Ministry', icon: 'globe' },
      { title: 'Families Support', icon: 'people' },
      { title: 'Pastoral Care', icon: 'dove' },
      { title: 'Advocacy & Justice', icon: 'scales' },
      { title: 'Humanitarian Support', icon: 'heartHand' },
    ]}
    pillarsCaption="Bringing Christ’s love, mercy and hope to those who feel forgotten."
  />
</Layout>
