---
import Layout from '../../layouts/Layout.astro';

const leaders = [
  { name: 'Antonio G. Dattilo', role: 'Ambassador & Founder', img: 'l1' },
  { name: 'Father John Vespa', role: 'Chief Operations Officer – Australian Branches', img: 'l2' },
  { name: 'Francesco Dattilo', role: 'President', img: 'l3' },
  { name: 'Ilenia Dattilo', role: 'Chief Operations Officer – Italian Branches', img: 'l4' },
];
---
<Layout title="Our Leadership" description="Guided by faith, compassion and service, we work together to bring hope, dignity and restoration.">
  <style>
    .ol { background: var(--color-navy-dark); color: #fff; }
    .ol-hero { position: relative; min-height: 340px; display: flex; align-items: center; overflow: hidden; }
    .ol-hero__bg { position: absolute; inset: 0 0 0 45%; }
    .ol-hero__bg img { width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 35%); mask-image: linear-gradient(90deg, transparent, #000 35%); }
    .ol-hero__text { position: relative; display: flex; flex-direction: column; gap: 1rem; }
    .ol-hero h1 { font-family: var(--font-heading); font-size: clamp(2.25rem, 5vw, 3.25rem); text-transform: uppercase; letter-spacing: 0.02em; }
    .ol-hero p { font-size: 1.25rem; line-height: 1.5; max-width: 480px; }
    .ol-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding-bottom: 2.5rem; }
    .ol-card { border: 2px solid var(--color-amber); border-radius: 4px; overflow: hidden; background: #0d1530; text-align: center; }
    .ol-card img { width: 100%; aspect-ratio: 104 / 158; object-fit: cover; }
    .ol-card h2 { font-family: var(--font-heading); font-size: 1.25rem; margin-top: 0.875rem; }
    .ol-card p { font-size: 0.875rem; line-height: 1.4; padding: 0.4rem 0.75rem 1.1rem; color: rgba(255,255,255,0.85); }
    .ol-quote { text-align: center; padding-bottom: 3rem; font-family: var(--font-heading); font-style: italic; color: var(--color-amber); font-size: 1.375rem; line-height: 1.5; }
    .ol-quote span { font-family: var(--font-heading); font-size: 2.5rem; vertical-align: -0.5rem; margin-inline: 0.5rem; }
    @media (max-width: 860px) { .ol-grid { grid-template-columns: 1fr 1fr; } .ol-hero__bg { inset: 0; opacity: 0.45; } }
  </style>

  <div class="ol">
    <section class="ol-hero">
      <div class="ol-hero__bg"><img src="/images/our-leadership/cross.jpg" alt="A cross on a hill at sunrise" /></div>
      <div class="wrap ol-hero__text">
        <h1>Our Leadership</h1>
        <p>Guided by faith, compassion and service, we work together to bring hope, dignity and restoration.</p>
      </div>
    </section>

    <section class="wrap ol-grid">
      {leaders.map(l => (
        <article class="ol-card">
          <img src={`/images/our-leadership/${l.img}.jpg`} alt={l.name} />
          <h2>{l.name}</h2>
          <p>{l.role}</p>
        </article>
      ))}
    </section>

    <p class="wrap ol-quote"><span>&ldquo;</span>Whatever you did for one of the least of these, you did for me.<span>&rdquo;</span><br /><small style="font-size:1rem;">— Matthew 25:40</small></p>
  </div>
</Layout>
