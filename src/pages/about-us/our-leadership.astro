---
import Layout from '../../layouts/Layout.astro';

const leaders = [
  { name: 'Antonio G. Dattilo', role: 'Ambassador & Founder', img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80' },
  { name: 'Father John Vespa', role: 'Chief Operations Officer — Australian Branches', img: 'https://images.unsplash.com/photo-1544717305-2782549b5136?w=400&q=80' },
  { name: 'Francesco Dattilo', role: 'President', img: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=400&q=80' },
  { name: 'Ilenia Dattilo', role: 'Chief Operations Officer — Italian Branches', img: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=400&q=80' },
];
---
<Layout title="Our Leadership" description="Guided by faith, compassion and service, we work together to bring hope, dignity and restoration.">

  <section class="hero-full" style="min-height:36vh;">
    <div class="hero-full__bg">
      <img src="https://images.unsplash.com/photo-1518199266791-5375a83190b7?w=1600&q=80" alt="A cross at sunrise" />
    </div>
    <div class="hero-full__overlay"></div>
    <div class="hero-full__content">
      <span class="eyebrow eyebrow--white">About Us</span>
      <h1 class="section-title section-title--white" style="margin-block:0.5rem;">Our Leadership</h1>
      <p class="section-desc section-desc--white" style="max-width:560px;">Guided by faith, compassion and service, we work together to bring hope, dignity and restoration.</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap grid-4">
      {leaders.map(l => (
        <div class="person-card">
          <img class="person-card__photo" src={l.img} alt={l.name} />
          <div class="person-card__body">
            <p class="person-card__name">{l.name}</p>
            <span class="person-card__role">{l.role}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="quote-box" style="max-width:600px; margin-inline:auto; margin-top:2.5rem;">
      <p class="quote-box__text">"Whatever you did for one of the least of these, you did for me."</p>
      <span class="quote-box__ref">— Matthew 25:40</span>
    </div>
  </section>

  <div class="cta-band">
    <div class="wrap cta-band__inner">
      <div class="cta-band__text">
        <h2 class="section-title section-title--white">Thank You for Being Part of Our Mission</h2>
        <p class="section-desc section-desc--white">Together we can accompany, empower and restore hope.</p>
      </div>
      <a href="/about-us/our-people" class="btn btn--amber">Meet Our People &gt;</a>
    </div>
  </div>
</Layout>
