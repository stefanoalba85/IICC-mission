---
import Layout from '../../layouts/Layout.astro';
import AboutTemplate from '../../components/AboutTemplate.astro';
---
<Layout title="Our Mission" description="A Faithful Journey of Hope — accompanying, empowering and restoring hope.">
  <AboutTemplate
    variant="mission"
    heroImg="/images/about-us/mission-hero.jpg"
    heroAlt="St Peter's Basilica at sunset"
    storyImg="/images/about-us/mission-founder.jpg"
    storyAlt="Antonio G. Dattilo, Ambassador & Founder"
    portrait
    storyEyebrow="Message From Our Founder"
    storyTitle="Driven by Faith. Inspired by People."
    storyParas={[
      'Throughout my life, I have seen how <strong>difficult circumstances</strong> can affect individuals and families. Financial hardship, trauma, addiction, loneliness and rejection can leave people feeling abandoned and without hope.',
      'The <strong>IICC Mission</strong> was founded on the belief that every person has dignity and purpose, and that no one should walk alone. We believe in accompaniment rather than abandonment, restoration rather than rejection, and hope rather than despair.',
    ]}
    bandImg="/images/about-us/mission-band.jpg"
    bandAlt="A family looking towards St Peter's Basilica at sunset"
  />
</Layout>
