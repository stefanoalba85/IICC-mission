---
import Layout from '../../layouts/Layout.astro';
import FaithLeader from '../../components/FaithLeader.astro';
---
<Layout title="Inspired By Pope Leo XIV" description="A New Chapter of Faith, Hope and Service.">
  <style>
    .pl-msg { display: grid; grid-template-columns: 1.2fr 0.8fr 1.1fr; gap: 1.5rem; align-items: center; padding-block: 1.5rem; }
    .pl-msg h2 { font-family: var(--font-heading); color: #b8892b; text-transform: uppercase; font-size: 1.25rem; margin-bottom: 0.5rem; }
    .pl-msg p { font-size: 0.875rem; line-height: 1.55; color: var(--color-text); }
    .pl-jub { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; align-items: center; background: #fff; border: 1px solid rgba(184,137,43,0.4); border-radius: 6px; padding: 1rem 1.25rem; margin-top: 1.25rem; }
    .pl-jub strong { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; }
    @media (max-width: 900px) { .pl-msg { grid-template-columns: 1fr; } }
  </style>
  <FaithLeader
    dir="pope-leo"
    name="Pope Leo XIV"
    subtitle="A New Chapter of Faith, Hope and Service"
    intro="Pope Leo XIV represents a new chapter in the continuing mission of faith, compassion and service. His leadership inspires communities around the world to remain close to those experiencing hardship, uncertainty and moments of vulnerability."
    heroQuote="Peace be with you all."
    heroQuoteRef="Pope Leo XIV"
    heroAlt="Pope Leo XIV waving in front of St Peter's Basilica"
    card={{ label: 'The Holy See<br/>Vatican', href: 'https://www.vatican.va' }}
    bandTitle="A Leader for Our Time"
    values={[
      { title: 'Faith', text: 'A faith that is humble, joyful and rooted in the Gospel of Jesus Christ.', icon: 'heartHand' },
      { title: 'Compassion', text: 'A heart that is close to the poor, the forgotten and the vulnerable.', icon: 'people' },
      { title: 'Unity', text: 'Building bridges of peace, dialogue and fraternity for all.', icon: 'dove' },
      { title: 'Justice', text: 'Promoting human dignity, protecting rights and serving the common good.', icon: 'scales' },
      { title: 'Hope', text: 'Bringing the light of Christ to a world in need of healing and renewal.', icon: 'cross' },
    ]}
    bandQuote={{ text: 'Let us walk together as a Church, as friends of Jesus, bringing hope to everyone.', ref: 'Pope Leo XIV' }}
    connectionTitle="A Connection with IICC Mission"
    connectionIntro="The values of Pope Leo XIV’s ministry align deeply with the mission of IICC Mission. Together we walk with those most in need, upholding the dignity of every person."
    connection={[
      { title: 'People in Prison', text: 'Reaching out with mercy, encouraging rehabilitation and opening doors of hope.', photo: 'c1' },
      { title: 'People in Immigration Detention', text: 'Standing with those in detention, advocating for dignity and justice.', photo: 'c2' },
      { title: 'Families', text: 'Supporting families affected by separation, struggle and uncertainty.', photo: 'c3' },
      { title: 'Vulnerable Communities', text: 'Serving the poor, the sick, the elderly and all who have no voice.', photo: 'c4' },
      { title: 'A World in Need of Hope', text: 'Working together for a more just, peaceful and compassionate world.', photo: 'c5' },
    ]}
    action={[
      { title: 'Accompaniment', text: 'Walking alongside people during moments of difficulty and uncertainty.', icon: 'people' },
      { title: 'Compassion', text: 'Seeing the person beyond their story and their circumstances.', icon: 'heart' },
      { title: 'Service', text: 'Providing practical help, resources and pathways to a better future.', icon: 'heartHand' },
      { title: 'Restoration', text: 'Believing in the power of forgiveness, healing and new beginnings.', icon: 'dove' },
      { title: 'Hope', text: 'Bringing the light of Christ to every heart and every situation.', icon: 'cross' },
    ]}
    actionQuote={{ text: 'Hope is born from love and based on the love grounded in the heart of Jesus pierced on the cross.', ref: 'Pope Leo XIV' }}
    recognition="IICC Mission gives thanks for the leadership of Pope Leo XIV and his commitment to mercy, justice, human dignity and the care of those most in need."
    signature={{ line: 'Pope Leo XIV', sub: 'Bishop of Rome<br/>Servant of the Servants of God' }}
    commitmentIntro="Inspired by Pope Leo XIV, IICC Mission continues its commitment to:"
  >
    <section slot="middle" class="wrap pl-msg">
      <div>
        <h2>A Message of Encouragement</h2>
        <p>To all who feel forgotten, discouraged or lost, know this: God never stops loving you. You are never beyond His mercy. With faith, support and opportunity, a new future is always possible.</p>
        <p style="font-family:var(--font-heading); font-style:italic; color:#b8892b; font-size:1.0625rem; margin-top:0.5rem;">You are not forgotten. You are loved. You have hope.</p>
      </div>
      <div class="pl-jub" style="grid-column: span 2; margin-top:0;">
        <span style="color:#b8892b; font-family:var(--font-heading); font-size:1.5rem; text-align:center; line-height:1.1;">14<br /><small style="font-size:0.75rem;">DEC 2025</small></span>
        <div><strong>Jubilee of Prisoners</strong><p>Pope Leo XIV has announced the Jubilee of Prisoners, a special moment of grace, mercy and hope for all those living in places of confinement and their families.</p></div>
      </div>
    </section>
  </FaithLeader>
</Layout>
