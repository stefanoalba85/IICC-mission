---
import Layout from '../../layouts/Layout.astro';
import AboutTemplate from '../../components/AboutTemplate.astro';
---
<Layout title="About Us" description="A Mission of Hope, Justice and Restoration — accompanying individuals and families toward healing, empowerment and a restored future.">
  <AboutTemplate
    variant="about"
    heroImg="/images/about-us/hero.jpg"
    heroAlt="Hands joined together at sunset with a cross in the distance"
    storyImg="/images/about-us/cross.jpg"
    storyAlt="A cross on a rocky summit at sunrise"
    storyEyebrow="Our Story"
    storyTitle="Founded on Faith. Driven by Love."
    storyParas={[
      'IICC Mission was founded on the belief that every individual is created with dignity and purpose. Our journey began with a burden to see lives transformed and communities restored through the love of Christ in action.',
      'We walk alongside those who are hurting, vulnerable or marginalised—offering not only practical support, but also spiritual and emotional care.',
    ]}
    bandImg="/images/about-us/community.jpg"
    bandAlt="People holding hands at sunset"
  />
</Layout>
