---
import Layout from '../../layouts/Layout.astro';
import FaithLeader from '../../components/FaithLeader.astro';
---
<Layout title="Archbishop Peter Comensoli" description="A Pastoral Leader Guided by Faith, Compassion and Hope.">
  <FaithLeader
    dir="comensoli"
    name="Archbishop Peter Comensoli"
    subtitle="A Pastoral Leader Guided by Faith, Compassion and Hope"
    intro="Archbishop Peter Comensoli’s pastoral leadership reflects a deep commitment to serving people, strengthening communities and recognising the dignity of every person. His example encourages us to build a Church and a community that listens, accompanies and brings hope."
    heroQuote="The Church is called to be close to people, to walk with them, to serve them, especially those who are most in need."
    heroQuoteRef="Archbishop Peter Comensoli"
    heroAlt="Archbishop Peter Comensoli in a cathedral"
    card={{ label: 'Archdiocese<br/>of Melbourne', href: 'https://melbournecatholic.org' }}
    values={[
      { title: 'Listening', text: 'Listening to people’s stories with a heart full of empathy.', icon: 'ear' },
      { title: 'Compassion', text: 'Showing mercy and standing beside those in difficult moments.', icon: 'heartHand' },
      { title: 'Community', text: 'Building communities of welcome, respect and inclusion.', icon: 'people' },
      { title: 'Hope', text: 'Bringing hope and encouragement for a better tomorrow.', icon: 'cross' },
    ]}
    connectionTitle="A Connection with IICC Mission"
    connectionIntro="The values of Archbishop Comensoli’s pastoral ministry align deeply with the mission of IICC Mission. Together we uphold the dignity of every person."
    connection={[
      { title: 'People in Prison', text: 'Supporting individuals who seek hope, rehabilitation and a second chance. Believing in the possibility of transformation and reintegration.', photo: 'c1' },
      { title: 'People in Immigration Detention', text: 'Recognising the dignity of every person and providing pastoral care, support and connection with the wider community.', photo: 'c2' },
      { title: 'Families', text: 'Understanding that imprisonment and detention affect entire families. Providing encouragement, guidance and support networks.', photo: 'c3' },
      { title: 'Communities in Need', text: 'Walking alongside vulnerable communities and creating pathways toward healing, dignity and hope.', photo: 'c4' },
    ]}
    action={[
      { title: 'Accompaniment', text: 'Walking alongside people during challenging moments, offering presence, support and understanding.', icon: 'people' },
      { title: 'Compassion', text: 'Seeing the person beyond their circumstances and responding with mercy and kindness.', icon: 'heart' },
      { title: 'Service', text: 'Transforming faith into practical support and connecting people with the resources they need.', icon: 'heartHand' },
      { title: 'Restoration', text: 'Creating opportunities for healing, growth and a new beginning with dignity and purpose.', icon: 'dove' },
    ]}
    actionQuote={{ text: 'No one is beyond the reach of God’s love and our care. Together we can build communities where every person is seen, valued and supported.' }}
    recognition="IICC Mission recognises the importance of leaders who encourage communities to respond with compassion, justice and humanity. We thank Archbishop Peter Comensoli for his continued example of pastoral leadership, service and dedication to the dignity of every person."
    signature={{ line: '+ Peter Comensoli', sub: 'Archbishop Peter Comensoli<br/>Archbishop of Melbourne' }}
    commitmentIntro="Inspired by faith and guided by compassion, IICC Mission continues its commitment to:"
  />
</Layout>
