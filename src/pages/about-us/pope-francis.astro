---
import Layout from '../../layouts/Layout.astro';
import FaithLeader from '../../components/FaithLeader.astro';
---
<Layout title="Inspired By Pope Francis" description="A Shepherd of Mercy, Compassion and Hope.">
  <style>
    .pf-feat { display: grid; grid-template-columns: 1fr 1fr; background: #fff; border-bottom: 1px solid rgba(184,137,43,0.4); }
    .pf-feat > div { display: grid; grid-template-columns: 1.15fr 1fr; }
    .pf-feat > div:first-child { border-right: 1px solid rgba(184,137,43,0.4); }
    .pf-feat > div > div { padding: 1.5rem; }
    /* on wide screens the section sits inside the 1200px container instead of padding only its first column */
    .pf-feat { padding-inline: var(--gutter); }
    .pf-feat h2 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.25rem; margin-bottom: 0.75rem; }
    .pf-feat p { font-size: 0.875rem; line-height: 1.55; color: var(--color-text); }
    .pf-feat ul { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.8125rem; }
    .pf-feat li::before { content: '✓'; display: inline-flex; width: 1rem; height: 1rem; border-radius: 50%; background: #d8c497; color: #fff; font-size: 0.6rem; align-items: center; justify-content: center; margin-right: 0.5rem; }
    .pf-feat img { width: 100%; height: 100%; object-fit: cover; }
    /* Holy Door: shown whole at its natural proportions so the inscription above the door is never cropped */
    .pf-feat img.pf-door { height: auto; object-fit: contain; align-self: start; }
    @media (max-width: 900px) { .pf-feat, .pf-feat > div { grid-template-columns: 1fr; } }
  </style>
  <FaithLeader
    dir="pope-francis"
    name="Pope Francis"
    subtitle="A Shepherd of Mercy, Compassion and Hope"
    intro="Pope Francis dedicated his life to walking with the poor, the imprisoned, the forgotten and those on the margins of society. His message of mercy, human dignity and hope continues to inspire millions around the world and guides the mission of IICC Mission."
    heroQuote="The Church is not a tollhouse; it is the house of the Father, where there is a place for everyone, with all their problems."
    heroQuoteRef="Pope Francis"
    heroAlt="Pope Francis waving"
    card={{ label: 'The Holy See<br/>Vatican', href: 'https://www.vatican.va' }}
    values={[
      { title: 'Mercy', text: 'At the heart of his ministry was mercy. A love that welcomes, forgives and restores.', icon: 'heartHand' },
      { title: 'Closeness', text: 'He walked with those on the margins, bringing the Church closer to every person.', icon: 'people' },
      { title: 'Dignity', text: 'Every person has infinite dignity and deserves respect and hope.', icon: 'dove' },
      { title: 'Justice', text: 'He spoke for the voiceless and called for a more just and compassionate world.', icon: 'scales' },
      { title: 'Hope', text: 'Hope is born from love and faith, and it never disappoints.', icon: 'cross' },
    ]}
    connectionTitle="A Message of Compassion for All"
    connectionIntro="Pope Francis called the Church to be a field hospital after battle – a place of healing, encounter and accompaniment."
    connection={[
      { title: 'People in Prison', text: 'Encouragement, pastoral care and pathways toward rehabilitation and reintegration.', photo: 'c1' },
      { title: 'People in Immigration Detention', text: 'Recognising their dignity, listening to their stories and advocating for their rights.', photo: 'c2' },
      { title: 'Families', text: 'Supporting families who suffer separation, pain and uncertainty.', photo: 'c3' },
      { title: 'The Vulnerable', text: 'Standing with the poor, the sick, the elderly and those without a voice.', photo: 'c4' },
      { title: 'Our Common Home', text: 'Caring for creation and building a world of peace, solidarity and respect.', photo: 'c5' },
    ]}
    action={[
      { title: 'Accompaniment', text: 'Walking alongside people in their journey, especially during difficult times.', icon: 'people' },
      { title: 'Compassion', text: 'Seeing the person beyond their circumstances and responding with love.', icon: 'heart' },
      { title: 'Service', text: 'Transforming faith into concrete acts of love and service.', icon: 'heartHand' },
      { title: 'Hope', text: 'Believing in new beginnings and the power of God to transform lives.', icon: 'cross' },
    ]}
    actionQuote={{ text: 'Hope is a gift from God that fills our lives with courage and strength.', ref: 'Pope Francis' }}
    recognition="IICC Mission gives thanks for the extraordinary example of Pope Francis, whose life and teachings continue to inspire our commitment to mercy, justice, human dignity and hope for all."
    signature={{ line: 'Thank you, Holy Father.', sub: 'Your legacy lives on in countless hearts.' }}
    commitmentIntro="Inspired by Pope Francis, IICC Mission continues its commitment to:"
  >
    <section slot="middle" class="pf-feat">
      <div>
        <div>
          <h2>Pope Francis and Prison Ministry</h2>
          <p>Pope Francis had a special closeness to people in prison. He reminded us that no one is defined by their past and that everyone has the capacity for change.</p>
          <ul><li>He visited prisons around the world.</li><li>He called prisoners “people, not numbers”.</li><li>He encouraged rehabilitation, not revenge.</li><li>He urged communities to open doors of hope.</li></ul>
        </div>
        <img src="/images/pope-francis/pope-francis-holy-door.jpg" alt="Pope Francis passing through the Holy Door" style="object-position:55% 50%;" />
      </div>
      <div>
        <div>
          <h2>The Holy Door of Hope at Rebibbia Prison</h2>
          <p>During the Extraordinary Jubilee of Mercy, Pope Francis opened a Holy Door at Rebibbia Prison in Rome.</p>
          <p style="margin-top:0.5rem;">This historic moment reminded the world that:</p>
          <ul><li>God’s mercy reaches every heart.</li><li>No place is beyond the love of God.</li><li>Every person can find forgiveness.</li><li>Hope can rise in the darkest places.</li></ul>
        </div>
        <img class="pf-door" src="/images/pope-francis/holy-door-st-peter.jpg" alt="The Holy Door of St Peter’s Basilica with the inscription above it" width="600" height="859" />
      </div>
    </section>
  </FaithLeader>
</Layout>
