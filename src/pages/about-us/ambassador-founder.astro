---
import Layout from '../../layouts/Layout.astro';
import PeopleHero from '../../components/PeopleHero.astro';
import AssuranceStrip from '../../components/AssuranceStrip.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../lib/icons';

const img = (n: string) => `/images/ambassador-founder/${n}.jpg`;

const story: { title: string; text: string; icon: IconName }[] = [
  { title: 'Time in Prison', text: 'I spent time in prison where I experienced hardship, regret and the reality of being forgotten.', icon: 'bars' },
  { title: 'A Turning Point', text: 'Through faith, prayer and the Gospel, I found hope, forgiveness and a new purpose.', icon: 'cross' },
  { title: '4 Years in the Prison Bakery', text: 'I worked in the prison bakery for four years. I saw how creating something with your hands can restore dignity and self-worth.', icon: 'bread' },
  { title: 'A Mission is Born', text: 'IICC Mission was born to bring hope, support and practical help to inmates, detainees and their families.', icon: 'people' },
  { title: 'Ambassador for the Forgotten', text: 'Today, I stand as their voice — an Ambassador for those who feel unseen, unheard and without hope.', icon: 'megaphone' },
];
const commitments: [string, string][] = [
  ['I walk with inmates', 'and detainees, listening with compassion and speaking with truth.'],
  ['I bring hope through the Gospel,', 'reminding them they are loved and never forgotten by God.'],
  ['I advocate for dignity, justice', 'and fair treatment for all.'],
  ['I support families', 'who carry the pain and burden of their loved ones’ imprisonment or detention.'],
  ['I build programs', 'that restore lives — through spiritual care, education, skills training, legal referrals and community.'],
  ['I empower former inmates', 'to give back to society and become leaders of change.'],
];
const drives: { title: string; text: string; icon: IconName }[] = [
  { title: 'Faith in God', text: 'Everything begins and ends with Him.', icon: 'cross' },
  { title: 'Love for People', text: 'Every person has value, purpose and a future.', icon: 'heart' },
  { title: 'Justice & Mercy', text: 'I believe in second chances and fair treatment for all.', icon: 'scales' },
  { title: 'Hope for Tomorrow', text: 'No one is beyond hope. No life is beyond change.', icon: 'sunRoad' },
];
---
<Layout title="Ambassador & Founder" description="Antonio G. Dattilo — Ambassador & Founder of IICC Mission.">
  <style>
    .af-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .af-timeline { display: flex; flex-direction: column; gap: 1.1rem; margin-top: 1.25rem; }
    .af-row { display: grid; grid-template-columns: 2.75rem 1fr; gap: 0.875rem; align-items: start; }
    .af-dot { width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--color-navy); color: var(--color-amber); display: flex; align-items: center; justify-content: center; }
    .af-row h3 { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.0625rem; }
    .af-row p, .af-commit li { font-family: var(--font-heading); font-size: 0.875rem; line-height: 1.55; color: var(--color-text); }
    .af-commit { list-style: none; padding: 0; margin: 1.25rem 0; display: flex; flex-direction: column; gap: 1rem; }
    .af-commit li { display: grid; grid-template-columns: 1.25rem 1fr; gap: 0.6rem; }
    .af-commit li::before { content: '✓'; width: 1.1rem; height: 1.1rem; border-radius: 50%; background: var(--color-amber); color: #fff; font-size: 0.65rem; display: flex; align-items: center; justify-content: center; margin-top: 0.2rem; }
    .af-darkquote { background: var(--color-navy-dark); color: #fff; border-radius: 4px; padding: 1.25rem 1.25rem 1.25rem 3.5rem; position: relative; font-family: var(--font-heading); font-size: 1.0625rem; line-height: 1.5; }
    .af-darkquote::before { content: '\201C'; position: absolute; left: 1rem; top: 0.5rem; font-size: 3rem; color: var(--color-amber); }
    .af-drive { display: grid; grid-template-columns: 3.75rem 1fr; gap: 1rem; align-items: center; margin-top: 1.75rem; }
    .af-drive .af-dot { width: 3.75rem; height: 3.75rem; }
    .af-tour { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.25rem; }
    .af-tour__card { display: grid; grid-template-columns: 1fr 1fr; border-radius: 6px; overflow: hidden; background: var(--color-navy-dark); }
    .af-tour__card img { width: 100%; height: 100%; object-fit: cover; }
    .af-tour__text { padding: 1.75rem 1.5rem; color: #fff; display: flex; flex-direction: column; gap: 0.875rem; }
    .af-tour__text h2 { font-family: var(--font-heading); color: var(--color-amber); font-size: 1.25rem; text-transform: uppercase; line-height: 1.3; }
    .af-tour__text p { font-family: var(--font-heading); font-size: 0.9375rem; line-height: 1.6; }
    .af-person { display: grid; grid-template-columns: 96px 1fr; gap: 1rem; align-items: center; margin-top: 1rem; }
    .af-person img { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; }
    .af-person h3 { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.0625rem; }
    .af-person p { font-family: var(--font-heading); font-size: 0.8125rem; line-height: 1.55; }
    .af-cta { position: relative; background: var(--color-navy-dark); color: #fff; overflow: hidden; }
    .af-cta__photo { position: absolute; inset: 0 0 0 55%; }
    .af-cta__photo img { width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%); mask-image: linear-gradient(90deg, transparent, #000 40%); }
    .af-cta__grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding-block: 1.75rem; align-items: center; }
    .af-cta h2 { font-family: var(--font-heading); color: var(--color-amber); text-transform: uppercase; font-size: 1.375rem; }
    .af-cta p { font-family: var(--font-heading); font-size: 1rem; line-height: 1.55; }
    @media (max-width: 900px) { .af-cols, .af-tour, .af-tour__card, .af-cta__grid { grid-template-columns: 1fr; } .af-cta__photo { inset: 0; opacity: 0.35; } }
  </style>

  <PeopleHero
    title="Ambassador<br/>&amp; Founder"
    subtitle="Antonio G. Dattilo"
    photo={img('hero')}
    photoAlt="Antonio G. Dattilo, Ambassador & Founder of IICC Mission"
    quote="Prison didn’t break me. It changed me. Now I’m here to change lives."
    quoteRef="Lived Experience"
  >
    <p style="font-size:1.0625rem;">Their voice. Their hope. Their future.<br /><span class="text-amber">My mission.</span></p>
    <p>I walk with inmates, detainees in immigration detention, and their families bringing hope, speaking for the forgotten and building pathways to restoration.</p>
  </PeopleHero>

  <div class="statement-band">
    <div class="wrap">
      <h2>Called by God. Shaped by Experience. Sent on Mission.</h2>
      <span class="heart-rule heart-rule--center" style="max-width:120px; margin-top:0.5rem;">♥</span>
      <p>IICC Mission was born from lived experience, faith in God, and a deep love for those society often forgets. My journey through prison, transformation and purpose has given me a voice—and that voice belongs to every inmate, detainee and family searching for hope.</p>
    </div>
  </div>

  <section class="section--sm" style="padding-block:1.5rem;">
    <div class="wrap af-cols">
      <div class="panel">
        <h2 class="panel__title">My Story</h2>
        <span class="heart-rule heart-rule--center" style="max-width:120px; margin-top:0.5rem;">♥</span>
        <div class="af-timeline">
          {story.map(s => (
            <div class="af-row"><span class="af-dot"><Icon name={s.icon} size={20} /></span><div><h3>{s.title}</h3><p>{s.text}</p></div></div>
          ))}
        </div>
      </div>
      <div class="panel">
        <h2 class="panel__title">My Commitment</h2>
        <span class="heart-rule heart-rule--center" style="max-width:120px; margin-top:0.5rem;">♥</span>
        <ul class="af-commit">
          {commitments.map(([b, t]) => <li><span><strong>{b}</strong> {t}</span></li>)}
        </ul>
        <div class="af-darkquote">During my time in prison, I wasn’t alone. I had God and the power of the Gospel guiding me.</div>
      </div>
      <div class="panel">
        <h2 class="panel__title">What Drives Me</h2>
        <span class="heart-rule heart-rule--center" style="max-width:120px; margin-top:0.5rem;">♥</span>
        {drives.map(d => (
          <div class="af-drive"><span class="af-dot"><Icon name={d.icon} size={26} /></span><div class="af-row" style="display:block;"><h3>{d.title}</h3><p>{d.text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-bottom:1.5rem;">
    <div class="wrap af-tour">
      <div class="af-tour__card">
        <img src={img('tour')} alt="Antonio G. Dattilo outside a detention centre" />
        <div class="af-tour__text">
          <h2>I Can Tour Prisons and Detention Centres</h2>
          <span class="heart-rule" style="max-width:140px;">♥</span>
          <p>I am available to visit prisons and immigration detention centres to share talks, offer hope and be a voice of encouragement to inmates, detainees and their families.</p>
          <a href="/contact" class="btn btn--amber" style="align-self:flex-start;">Request a Visit or Talk →</a>
        </div>
      </div>
      <div class="panel">
        <h2 class="panel__title">Recognition &amp; Support</h2>
        <span class="heart-rule heart-rule--center" style="max-width:120px; margin-top:0.5rem;">♥</span>
        <div class="af-person">
          <img src={img('pell')} alt="Cardinal George Pell" />
          <div><h3>Cardinal George Pell</h3><p>Encouraged the development of IICC Mission and continues to support our mission of hope, justice and restoration.</p></div>
        </div>
        <div class="af-person">
          <img src={img('comensoli')} alt="Archbishop Peter Comensoli" />
          <div><h3>Archbishop Peter Comensoli</h3><p>The first to acknowledge and approve the IICC Mission project and continues to guide and support our work.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="af-cta">
    <div class="af-cta__photo"><img src={img('sunset')} alt="" /></div>
    <div class="wrap af-cta__grid">
      <div style="display:grid; grid-template-columns:3.5rem 1fr; gap:1rem; align-items:start;">
        <span class="text-amber"><Icon name="heart" size={52} stroke={1.5} /></span>
        <div style="display:flex; flex-direction:column; gap:0.6rem;">
          <h2>Be Part of This Mission</h2>
          <p>Together, we can bring hope, restore dignity and build a future filled with faith and possibility.</p>
          <a href="/get-involved" class="btn btn--amber" style="align-self:flex-start;">Join the Mission →</a>
        </div>
      </div>
      <div>
        <p>“For I was hungry and you gave me something to eat, I was thirsty and you gave me something to drink, I was a stranger and you invited me in.”</p>
        <p class="text-amber" style="font-weight:700; margin-top:0.75rem;">– Matthew 25:35</p>
      </div>
    </div>
  </section>

  <AssuranceStrip />
</Layout>
