---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Our Story" description="The IICC Mission story — Every person has dignity, every person has a story, every person deserves hope.">

  <!-- Hero split -->
  <div class="hero-split" style="min-height:480px;">
    <div class="hero-split__text" style="background:#fff;gap:1.25rem;">
      <span class="eyebrow">Who We Are</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.25rem,5vw,3.75rem);font-weight:900;color:var(--color-navy);letter-spacing:0.02em;line-height:1.05;text-transform:uppercase;">
        OUR<br>STORY
      </h1>
      <span class="rule"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1.1rem,2.5vw,1.5rem);line-height:1.5;color:var(--color-navy);">
        Every person has dignity.<br>
        Every person has a story.<br>
        Every person deserves <span style="color:var(--color-amber);">hope.</span>
      </p>
    </div>
    <div class="hero-split__photo" style="background:var(--color-navy-dark);min-height:340px;display:flex;align-items:center;justify-content:center;padding:2rem;">
      <img
        src="/IICC_Logo.png"
        alt="IICC Mission"
        style="max-height:300px;width:auto;object-fit:contain;"
      />
    </div>
  </div>

  <!-- Message from the Founder -->
  <section class="section section--white">
    <div class="wrap">
      <div style="margin-bottom:2.5rem;">
        <span class="eyebrow">Message from the Founder</span>
        <span class="rule" style="margin-top:0.5rem;display:block;"></span>
      </div>
      <div class="cols-60-40" style="align-items:start;">
        <div>
          <h2 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-navy);margin-bottom:1rem;">MESSAGE FROM THE FOUNDER</h2>
          <span class="rule rule--amber" style="margin-bottom:1.5rem;display:block;"></span>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            Throughout life, every person encounters difficulties and challenges. Financial hardship, family struggles, trauma, addiction, loneliness and difficult circumstances can affect anyone.
          </p>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            The IICC Mission was founded on the belief that people are more than the challenges they have faced.
          </p>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            We believe in accompaniment rather than abandonment, restoration rather than rejection, and hope rather than despair.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:1rem;align-items:center;text-align:center;">
          <img
            src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=400&h=480&fit=crop&crop=top"
            alt="Antonio G. Dattilo — Ambassador & Founder"
            style="width:100%;max-width:280px;height:320px;object-fit:cover;border-radius:2px;border-bottom:3px solid var(--color-amber);"
          />
          <div>
            <p style="font-family:var(--font-heading);font-size:1rem;color:var(--color-navy);font-weight:700;">Antonio G. Dattilo</p>
            <p style="font-size:0.75rem;color:var(--color-amber);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;">Ambassador &amp; Founder</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Values — navy bg -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow eyebrow--white">What Guides Us</span>
        <span class="heart">♥</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1.25rem,2.5vw,1.75rem);letter-spacing:0.1em;text-transform:uppercase;color:#fff;">OUR VALUES</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="pillars">
        <div class="pillar">
          <div class="pillar__icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 3H6a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h12a2 2 0 0 0 2-2V9l-6-6z"/><path d="M14 3v6h6"/><line x1="12" y1="9" x2="12" y2="17"/><line x1="8" y1="13" x2="16" y2="13"/></svg>
          </div>
          <p class="pillar__label pillar__label--white">Faith</p>
          <p class="pillar__desc pillar__desc--white">Guided by the Gospel and the belief that every person has value.</p>
        </div>
        <div class="pillar">
          <div class="pillar__icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402C1 3.499 3.8 2 6 2c1.2 0 4.5.5 6 4.5C13.5 2.5 16.8 2 18 2c2.2 0 5 1.5 5 5.19 0 4.069-5.373 8.863-11 14.403z"/></svg>
          </div>
          <p class="pillar__label pillar__label--white">Compassion</p>
          <p class="pillar__desc pillar__desc--white">Seeing the person, not only the circumstance.</p>
        </div>
        <div class="pillar">
          <div class="pillar__icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="7" r="4"/><path d="M6 21v-2a6 6 0 0 1 12 0v2"/></svg>
          </div>
          <p class="pillar__label pillar__label--white">Dignity</p>
          <p class="pillar__desc pillar__desc--white">Recognising the worth of every human being.</p>
        </div>
        <div class="pillar">
          <div class="pillar__icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <p class="pillar__label pillar__label--white">Justice</p>
          <p class="pillar__desc pillar__desc--white">Supporting fairness, restoration and every opportunity.</p>
        </div>
        <div class="pillar">
          <div class="pillar__icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          </div>
          <p class="pillar__label pillar__label--white">Hope</p>
          <p class="pillar__desc pillar__desc--white">Believing that a new beginning is possible.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Become a Hope Partner -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow">Support Our Mission</span>
        <span class="heart">♥</span>
        <h2 class="section-title">BECOME A HOPE PARTNER</h2>
        <span class="rule rule--amber rule--center"></span>
        <p class="section-desc" style="text-align:center;margin-top:0.5rem;">
          Your support helps bring dignity, compassion and hope to people who need it most.
        </p>
      </div>
      <div class="grid-4">
        <div class="card" style="text-align:center;align-items:center;">
          <div class="card__icon card__icon--filled">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402C1 3.499 3.8 2 6 2c1.2 0 4.5.5 6 4.5C13.5 2.5 16.8 2 18 2c2.2 0 5 1.5 5 5.19 0 4.069-5.373 8.863-11 14.403z"/></svg>
          </div>
          <p class="card__title">Monthly Support</p>
          <p class="card__body">Provide ongoing hope through a regular monthly gift.</p>
          <a href="/donate" class="btn btn--amber" style="margin-top:0.5rem;font-size:0.75rem;padding:0.5rem 1.25rem;">GIVE MONTHLY</a>
        </div>
        <div class="card" style="text-align:center;align-items:center;">
          <div class="card__icon card__icon--filled">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <p class="card__title">One-Time Donation</p>
          <p class="card__body">Make a one-time gift and help change lives today.</p>
          <a href="/donate" class="btn btn--amber" style="margin-top:0.5rem;font-size:0.75rem;padding:0.5rem 1.25rem;">DONATE NOW</a>
        </div>
        <div class="card" style="text-align:center;align-items:center;">
          <div class="card__icon card__icon--filled">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <p class="card__title">Community Partnership</p>
          <p class="card__body">Partner with us to create a stronger and more compassionate community.</p>
          <a href="/get-involved" class="btn btn--amber" style="margin-top:0.5rem;font-size:0.75rem;padding:0.5rem 1.25rem;">PARTNER WITH US</a>
        </div>
        <div class="card" style="text-align:center;align-items:center;">
          <div class="card__icon card__icon--filled">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <p class="card__title">Volunteer Support</p>
          <p class="card__body">Give your time and talents and make a real difference.</p>
          <a href="/get-involved" class="btn btn--amber" style="margin-top:0.5rem;font-size:0.75rem;padding:0.5rem 1.25rem;">GET INVOLVED</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Donate Today amber band -->
  <div class="amber-band">
    <div class="wrap" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem;">
      <div>
        <p style="font-family:var(--font-display);font-size:1.5rem;font-weight:700;color:#fff;letter-spacing:0.04em;">
          ♥ DONATE TODAY
        </p>
        <p style="color:rgba(255,255,255,0.9);font-size:0.9375rem;margin-top:0.25rem;">
          Together we build a world of dignity, justice and hope.
        </p>
      </div>
      <a href="/donate" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;">
        DONATE NOW →
      </a>
    </div>
  </div>

</Layout>
