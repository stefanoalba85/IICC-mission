---
import Layout from '../layouts/Layout.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Sponsors & Supporters"
  description="IICC Mission Trusted Partners — Professionals, Organisations & Communities Supporting The Mission."
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=1200&fit=crop&q=80"
        alt="Partners joining hands in partnership"
        loading="eager"
      />
      <div class="page-hero-overlay"></div>
    </div>
    <div class="page-hero-content">
      <p class="section-label" style="margin-bottom:0.875rem">Our Trusted Partners</p>
      <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
      <h1 class="page-hero-title">Professionals, Organisations &amp; Communities Supporting The Mission.</h1>
      <p class="hero-scripture">&ldquo;A cord of three strands is not quickly broken.&rdquo; &mdash; Ecclesiastes 4:12</p>
      <p class="page-hero-subtitle">Together we walk alongside those who are forgotten, defend dignity, restore hope and build stronger, more compassionate communities.</p>
      <a href="#become-partner" class="btn-primary" style="margin-top:1.75rem;display:inline-block">PARTNER WITH PURPOSE &rarr;</a>
    </div>
  </section>

  <!-- SECTION 1 — PARTNER CATEGORIES -->
  <section class="section-standard">
    <div class="container">
      <div class="section-header">
        <p class="section-label">OUR PARTNER CATEGORIES</p>
        <div class="gold-rule" style="margin:0.75rem auto 1.25rem"></div>
        <h2 class="section-header-title">United in purpose. Connected in mission.</h2>
      </div>
      <div class="categories-grid">
        {[
          {
            icon: '⚖',
            title: 'LEGAL & JUSTICE PARTNERS',
            desc: 'Lawyers, legal centres and advocates helping to protect rights and ensure fair access to justice.',
          },
          {
            icon: '🧠',
            title: 'MENTAL HEALTH & WELLBEING PARTNERS',
            desc: 'Psychologists, counsellors and therapists providing compassionate care and emotional support.',
          },
          {
            icon: '✝',
            title: 'FAITH & CHAPLAINCY PARTNERS',
            desc: 'Priests, chaplains and faith communities offering spiritual care, guidance and hope.',
          },
          {
            icon: '📚',
            title: 'EDUCATION & TRAINING PARTNERS',
            desc: 'Schools, TAFEs and training providers creating pathways to learning, skills and brighter futures.',
          },
          {
            icon: '🤝',
            title: 'COMMUNITY & SOCIAL SERVICE PARTNERS',
            desc: 'Organisations supporting families, reintegration, welfare and community development.',
          },
          {
            icon: '🏢',
            title: 'CORPORATE & BUSINESS PARTNERS',
            desc: 'Businesses and enterprises supporting our mission through partnerships, resources and expertise.',
          },
          {
            icon: '🌍',
            title: 'INTERNATIONAL PARTNERS',
            desc: 'Global organisations and networks working together for justice, dignity and hope.',
          },
        ].map((cat) => (
          <div class="info-card card-hover">
            <span class="info-card-icon">{cat.icon}</span>
            <h3 class="info-card-title">{cat.title}</h3>
            <p class="info-card-desc">{cat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 2 — OUR TRUSTED PARTNERS -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="section-header">
        <p class="section-label">OUR TRUSTED PARTNERS</p>
        <div class="gold-rule" style="margin:0.75rem auto 1.25rem"></div>
        <h2 class="section-header-title">Organisations Walking Alongside Us</h2>
      </div>
      <div class="logo-grid">
        {[
          'Jesuit Social Services',
          'CatholicCare Victoria',
          'Victoria Legal Aid',
          'Prison Fellowship Australia',
          'Apricare Victoria',
          'The Salvation Army',
          'Relationships Australia Victoria',
        ].map((name) => (
          <div class="logo-card">
            <span class="logo-card-name">{name}</span>
          </div>
        ))}
        <div class="logo-card logo-card--more">
          <span class="logo-card-more-text">And many more valued partners</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3 — WHY PARTNER -->
  <section class="section-standard-dark">
    <div class="container">
      <div class="two-col why-partner-grid">
        <!-- Left: Why Partner -->
        <div class="why-left">
          <p class="section-label">JOIN US</p>
          <div class="gold-rule-left" style="margin:0.75rem 0 1.25rem"></div>
          <h2 class="why-heading">WHY PARTNER WITH IICC MISSION?</h2>
          <ul class="why-list">
            {[
              'Make a real difference in the lives of people and families.',
              'Be part of a mission rooted in faith, justice and compassion.',
              'Combine expertise and resources to achieve greater impact.',
              'Strengthen communities and create long-term change.',
              'Uphold dignity, respect and human rights for all.',
            ].map((item) => (
              <li class="why-list-item">
                <span class="why-check" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="#become-partner" class="btn-primary" style="margin-top:2rem;display:inline-block">BECOME A PARTNER &rarr;</a>
        </div>

        <!-- Right: Together We... panel -->
        <div class="together-panel">
          <p class="together-heading">TOGETHER WE...</p>
          <div class="together-list">
            {[
              { icon: '🤝', text: 'Accompany the forgotten' },
              { icon: '💪', text: 'Empower individuals and families' },
              { icon: '🌱', text: 'Restore hope and rebuild lives' },
              { icon: '⚖', text: 'Advocate for justice and dignity' },
              { icon: '✨', text: 'Inspire communities to care' },
            ].map((item) => (
              <div class="together-item">
                <span class="together-icon" aria-hidden="true">{item.icon}</span>
                <span class="together-text">{item.text}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — PARTNER SPOTLIGHT -->
  <section class="section-standard">
    <div class="container">
      <div class="section-header">
        <p class="section-label">VOICES FROM OUR PARTNERS</p>
        <div class="gold-rule" style="margin:0.75rem auto 1.25rem"></div>
        <h2 class="section-header-title">Partner Spotlight</h2>
      </div>
      <div class="card-grid-3">
        {[
          {
            quote: 'IICC Mission is a vital voice for justice and dignity. Together, we ensure no one is left without access to legal support and fairness.',
            attribution: 'Victoria Legal Aid',
          },
          {
            quote: 'Working alongside IICC Mission allows us to bring the message of restoration to people who need it most.',
            attribution: 'Prison Fellowship Australia',
          },
          {
            quote: 'We partner with IICC Mission to strengthen families and communities with compassion, care and a belief in every person\'s potential.',
            attribution: 'CatholicCare Victoria',
          },
        ].map((t) => (
          <div class="testimonial-card card-hover">
            <div class="testimonial-quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">{t.quote}</blockquote>
            <div class="testimonial-rule"></div>
            <p class="testimonial-attribution">{t.attribution}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — BECOME A PARTNER -->
  <section id="become-partner" class="become-partner-section">
    <div class="container">
      <div class="become-partner-inner">
        <p class="section-label" style="color:var(--color-navy);text-align:center">GET INVOLVED</p>
        <div class="gold-rule" style="margin:0.75rem auto 1.25rem"></div>
        <h2 class="become-partner-heading">Become a Partner. Be Part of the Change.</h2>
        <p class="become-partner-sub">Together, we can build a more just, compassionate and hopeful world.</p>
        <div class="become-partner-ctas">
          <a href="/contact" class="btn-primary">BECOME A PARTNER &rarr;</a>
          <a href="/contact" class="btn-outline">LET&rsquo;S TALK &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <QuoteBand
    quote="Our mission is bigger than any one person or organisation. Together, we create lasting change."
    dark={true}
  />

  <!-- FINAL CTA -->
  <CTASection
    dark={true}
    headline="Let's Work Together for a Better Future"
    buttons={[
      { label: 'Become a Partner', href: '/contact', primary: true },
      { label: 'Learn About Our Mission', href: '/mission', primary: false },
    ]}
  />

</Layout>

<style>
  /* HERO SCRIPTURE */
  .hero-scripture {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: var(--color-gold);
    margin: 1rem 0 0.75rem;
    opacity: 0.92;
  }

  /* PARTNER CATEGORIES GRID */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  @media (min-width: 768px) {
    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* LOGO GRID */
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }
  @media (min-width: 640px) {
    .logo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .logo-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .logo-card {
    border: 1px solid rgba(201, 160, 23, 0.3);
    border-top: 3px solid var(--color-gold);
    background: #fff;
    padding: 1.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: 2px;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .logo-card:hover {
    box-shadow: 0 4px 20px rgba(27, 39, 81, 0.1);
    border-color: var(--color-gold);
  }

  .logo-card-name {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
    line-height: 1.5;
  }

  .logo-card--more {
    border-top-color: rgba(201, 160, 23, 0.4);
    border-style: dashed;
    background: transparent;
  }
  .logo-card--more:hover {
    border-color: var(--color-gold);
    background: rgba(201, 160, 23, 0.04);
  }
  .logo-card-more-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--color-gold-dark);
    opacity: 0.85;
  }

  /* WHY PARTNER */
  .why-partner-grid {
    align-items: start;
    gap: 3rem;
  }

  .why-heading {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    letter-spacing: 0.05em;
    color: #fff;
    margin: 0 0 1.75rem;
    line-height: 1.3;
  }

  .why-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .why-list-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
  }
  .why-check {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--color-gold);
    color: var(--color-navy-dark);
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    margin-top: 0.125rem;
  }

  /* TOGETHER PANEL */
  .together-panel {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(201, 160, 23, 0.25);
    border-top: 3px solid var(--color-gold);
    padding: 2.5rem 2rem;
    border-radius: 2px;
  }
  .together-heading {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 1.75rem;
  }
  .together-list {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }
  .together-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .together-icon {
    font-size: 1.375rem;
    flex-shrink: 0;
    width: 2.5rem;
    text-align: center;
  }
  .together-text {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
  }

  /* TESTIMONIAL CARDS */
  .testimonial-card {
    background: #fff;
    border: 1px solid rgba(27, 39, 81, 0.1);
    border-top: 3px solid var(--color-gold);
    padding: 2.25rem 2rem;
    position: relative;
    border-radius: 2px;
    display: flex;
    flex-direction: column;
  }
  .testimonial-quote-mark {
    font-family: var(--font-heading);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--color-gold);
    opacity: 0.25;
    position: absolute;
    top: 0.75rem;
    left: 1.25rem;
    user-select: none;
    pointer-events: none;
  }
  .testimonial-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.0625rem;
    color: #3a3a3a;
    line-height: 1.75;
    margin: 0 0 1.5rem;
    position: relative;
    flex: 1;
  }
  .testimonial-rule {
    width: 2.5rem;
    height: 2px;
    background: var(--color-gold);
    margin-bottom: 0.875rem;
    flex-shrink: 0;
  }
  .testimonial-attribution {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-navy);
    font-weight: 700;
    margin: 0;
  }

  /* BECOME A PARTNER SECTION */
  .become-partner-section {
    padding: 6rem 0;
    background: linear-gradient(135deg, #fffbf0 0%, #fef3c7 40%, #fde68a 100%);
    border-top: 3px solid var(--color-gold);
    border-bottom: 3px solid var(--color-gold);
  }
  .become-partner-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .become-partner-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    color: var(--color-navy);
    line-height: 1.25;
    margin: 0 0 1.25rem;
  }
  .become-partner-sub {
    font-size: clamp(1rem, 1.5vw, 1.1875rem);
    color: var(--color-navy);
    opacity: 0.75;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .become-partner-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }
</style>
