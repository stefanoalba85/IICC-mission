---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Donate — Become a Hope Partner" description="Your donation brings hope, dignity and justice to inmates, detainees and families who need it most.">

  <!-- Dark hero -->
  <div class="hero-full" style="min-height:52vh;">
    <div class="hero-full__bg">
      <img src="https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=1400&h=700&fit=crop" alt="" aria-hidden="true" />
    </div>
    <div class="hero-full__overlay"></div>
    <div class="hero-full__content">
      <span class="eyebrow eyebrow--white" style="display:block;margin-bottom:0.75rem;">Support Our Mission</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,6vw,4rem);font-weight:900;color:#fff;text-transform:uppercase;line-height:1.05;margin-bottom:0.5rem;">
        ♥ DONATE TODAY
      </h1>
      <span class="rule rule--amber" style="margin-bottom:1.5rem;display:block;"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2.5vw,1.375rem);color:rgba(255,255,255,0.9);line-height:1.5;max-width:500px;">
        Together we build a world of dignity, justice and hope.
      </p>
    </div>
  </div>

  <!-- Donation options -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow">How to Give</span>
        <span class="heart">♥</span>
        <h2 class="section-title">BECOME A HOPE PARTNER</h2>
        <span class="rule rule--amber rule--center"></span>
        <p class="section-desc" style="text-align:center;margin-inline:auto;margin-top:0.5rem;">
          Your support helps bring dignity, compassion and hope to people who need it most.
        </p>
      </div>
      <div class="grid-4" style="margin-bottom:3rem;">
        {[
          { icon: '♥', title: 'Monthly Support', desc: 'Provide ongoing hope through a regular monthly gift. Cancel anytime.', btn: 'GIVE MONTHLY', highlight: true },
          { icon: '🎁', title: 'One-Time Donation', desc: 'Make a one-time gift of any amount. Every dollar makes a difference.', btn: 'DONATE NOW', highlight: false },
          { icon: '🤝', title: 'Community Partnership', desc: 'Partner with your church, business or organisation to create lasting impact.', btn: 'PARTNER WITH US', highlight: false },
          { icon: '📱', title: 'GoFundMe Campaign', desc: 'Support our active crowdfunding campaigns for specific mission needs.', btn: 'VIEW CAMPAIGNS', highlight: false },
        ].map(c => (
          <div class="card" style={`text-align:center;align-items:center;${c.highlight ? 'border-top-color:var(--color-amber);background:var(--color-navy-dark);' : ''}`}>
            <div class={`card__icon card__icon--filled`} style="font-size:1.125rem;">{c.icon}</div>
            <p class={`card__title${c.highlight ? ' ' : ''}`} style={c.highlight ? 'color:#fff;' : ''}>{c.title}</p>
            <p class={`card__body`} style={c.highlight ? 'color:rgba(255,255,255,0.7);' : ''}>{c.desc}</p>
            <a href="#donate-form" class="btn btn--amber" style="margin-top:0.5rem;font-size:0.75rem;padding:0.5rem 1.25rem;">{c.btn}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Donate form + info -->
  <section id="donate-form" class="section section--offwhite">
    <div class="wrap">
      <div class="cols-60-40" style="gap:3rem;align-items:start;">

        <!-- Form -->
        <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:2rem 2rem 2.5rem;">
          <h2 style="font-family:var(--font-display);font-size:0.875rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">MAKE YOUR DONATION</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>

          <!-- Amount selection -->
          <p style="font-weight:700;font-size:0.875rem;color:var(--color-navy);margin-bottom:0.75rem;">Select an Amount</p>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.625rem;margin-bottom:1.25rem;">
            {['$25', '$50', '$100', '$250'].map((amt, i) => (
              <button type="button" style={`padding:0.625rem;font-weight:700;font-size:0.9375rem;border-radius:2px;cursor:pointer;transition:background 0.2s,color 0.2s;${i === 1 ? 'background:var(--color-amber);color:#fff;border:1.5px solid var(--color-amber);' : 'background:#fff;color:var(--color-navy);border:1.5px solid rgba(27,39,81,0.2);'}`}>
                {amt}
              </button>
            ))}
          </div>
          <div class="form-field" style="margin-bottom:1.25rem;">
            <label for="d-amount">Other Amount ($)</label>
            <input type="number" id="d-amount" name="amount" class="form-input" placeholder="Enter custom amount" min="1" />
          </div>

          <!-- Frequency -->
          <p style="font-weight:700;font-size:0.875rem;color:var(--color-navy);margin-bottom:0.75rem;">Donation Frequency</p>
          <div style="display:flex;gap:0.625rem;margin-bottom:1.5rem;flex-wrap:wrap;">
            {['Once', 'Monthly', 'Annually'].map((f, i) => (
              <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;padding:0.5rem 1rem;border-radius:2px;border:1.5px solid rgba(27,39,81,0.15);font-size:0.875rem;font-weight:600;color:var(--color-navy);">
                <input type="radio" name="frequency" value={f} checked={i === 0} style="accent-color:var(--color-amber);" /> {f}
              </label>
            ))}
          </div>

          <!-- Personal info -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;" class="donate-grid-2">
            <div class="form-field">
              <label for="d-first">First Name <span class="required">*</span></label>
              <input type="text" id="d-first" name="first_name" class="form-input" placeholder="First name" required />
            </div>
            <div class="form-field">
              <label for="d-last">Last Name <span class="required">*</span></label>
              <input type="text" id="d-last" name="last_name" class="form-input" placeholder="Last name" required />
            </div>
          </div>
          <div class="form-field" style="margin-bottom:1.25rem;">
            <label for="d-email">Email Address <span class="required">*</span></label>
            <input type="email" id="d-email" name="email" class="form-input" placeholder="your@email.com" required />
          </div>

          <div class="form-field" style="margin-bottom:1.5rem;">
            <label style="display:flex;align-items:flex-start;gap:0.5rem;font-weight:400;cursor:pointer;font-size:0.8125rem;color:var(--color-muted);">
              <input type="checkbox" name="newsletter" style="accent-color:var(--color-amber);margin-top:0.15rem;" />
              Keep me updated on how my donation is making a difference.
            </label>
          </div>

          <button type="submit" class="btn btn--amber" style="width:100%;justify-content:center;font-size:0.9375rem;padding:0.875rem;">
            ♥ DONATE SECURELY
          </button>
          <p style="font-size:0.75rem;color:var(--color-muted);text-align:center;margin-top:0.75rem;">
            🔒 Your donation is secure and encrypted. IICC Mission is a registered charity.
          </p>
        </div>

        <!-- Info sidebar -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">

          <!-- Impact -->
          <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:1.5rem;">
            <h3 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">YOUR IMPACT</h3>
            <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
            <div style="display:flex;flex-direction:column;gap:1rem;">
              {[
                { amt: '$25', impact: 'Provides spiritual care materials for one detainee for a month.' },
                { amt: '$50', impact: 'Funds one pastoral visit to a prison or detention centre.' },
                { amt: '$100', impact: 'Supports a family in crisis with essential humanitarian aid.' },
                { amt: '$250', impact: 'Enables a Hope Companion to serve for one month.' },
              ].map(i => (
                <div style="display:flex;align-items:flex-start;gap:0.875rem;padding-bottom:0.875rem;border-bottom:1px solid rgba(27,39,81,0.06);">
                  <span style="font-family:var(--font-heading);font-size:1rem;font-weight:700;color:var(--color-amber);min-width:3.5rem;flex-shrink:0;">{i.amt}</span>
                  <p style="font-size:0.8125rem;color:var(--color-muted);line-height:1.6;">{i.impact}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Quote -->
          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">Whatever you did for one of the least of these brothers and sisters of mine, you did for me.</p>
            <span class="quote-box__ref">— Matthew 25:40</span>
          </div>

          <!-- Thank you -->
          <div style="background:var(--color-amber);border-radius:2px;padding:1.5rem;text-align:center;">
            <p style="font-family:var(--font-display);font-size:1rem;font-weight:700;color:#fff;letter-spacing:0.04em;margin-bottom:0.5rem;">THANK YOU</p>
            <p style="font-size:0.875rem;color:rgba(255,255,255,0.9);line-height:1.65;">For being part of something bigger than ourselves. Together we can restore hope.</p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Donation by category -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow eyebrow--white">Where It Goes</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1rem,2vw,1.25rem);letter-spacing:0.15em;text-transform:uppercase;color:#fff;">HOW YOUR DONATION HELPS</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="grid-3">
        {[
          { icon: '🙏', title: 'Prison Ministry', desc: 'Spiritual care, pastoral visits, sacraments and hope for those behind bars.' },
          { icon: '⚖️', title: 'Immigration Detention', desc: 'Walking alongside detainees — prayer, legal referrals and humanitarian aid.' },
          { icon: '🍞', title: 'Bakery of Hope', desc: 'Fresh bread for the homeless, soup kitchens and shelters every single day.' },
          { icon: '👥', title: 'Family Support', desc: 'Helping families of inmates and detainees stay connected and supported.' },
          { icon: '📚', title: 'Education & Advocacy', desc: 'Empowering people through education and advocating for systemic change.' },
          { icon: '🌍', title: 'Global Network', desc: 'Expanding our mission to more cities, countries and communities worldwide.' },
        ].map(c => (
          <div class="card--dark" style="align-items:center;text-align:center;gap:0.5rem;padding:1.5rem;">
            <div class="card__icon" style="font-size:1.25rem;border-color:rgba(224,123,0,0.5);">{c.icon}</div>
            <p class="card__title">{c.title}</p>
            <p class="card__body">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  @media (max-width: 540px) {
    .donate-grid-2 { grid-template-columns: 1fr !important; }
  }
</style>
