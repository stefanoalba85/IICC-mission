---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/bakery/${n}.jpg`;
const vision = [['bread-slice','Bread for Communities in Need','Supporting people experiencing poverty and hardship.'],['house','A Place of Welcome','Creating a space where dignity, compassion and human connection come together.'],['book-open','Training & Second Chances','Exploring opportunities for skills development and reintegration.'],['heart','Serving with Love','Continuing Christ’s mission of caring for the vulnerable.']];
const help = [['people-group','Supporters','Help make this vision a reality.'],['handshake','Volunteers','Share your time and skills.'],['heart','Sponsors','Support equipment, training and operations.'],['church','Parish Partnerships','Working together to serve our communities.'],['hand-holding-heart','Community Fundraising','Help build a brighter and more compassionate world.']];
---
<Layout title="Bakery of Hope — Coming Soon" description="Breaking Bread. Sharing Hope. Restoring Dignity.">
  <style>
    .bk-hero { display: grid; grid-template-columns: 0.55fr 1fr 1.05fr; min-height: 440px; background: #fff; overflow: hidden; position: relative; }
    .bk-hero { padding-left: max(0px, calc((100vw - 1200px) / 2)); }
    .bk-hero > img.logo { width: 100%; max-width: 200px; justify-self: center; align-self: center; margin-left: 1rem; }
    .bk-text { text-align: center; padding: 2rem 1rem; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
    .bk-text h1 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1; }
    .bk-text h1 span { color: #c9962a; display: block; }
    .bk-soon { border: 2px solid #c9962a; color: #c9962a; font-family: var(--font-display); letter-spacing: 0.12em; font-size: 1.75rem; padding: 0.4rem 1.5rem; }
    .bk-photo { position: relative; }
    .bk-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 20%); mask-image: linear-gradient(90deg, transparent, #000 20%); }
    .bk-script { position: absolute; right: max(1rem, calc((100vw - 1200px) / 2)); top: 1.5rem; z-index: 2; color: #fff; font-family: var(--font-script); font-size: 2.25rem; line-height: 1.15; text-align: center; text-shadow: 0 2px 8px rgba(0,0,0,0.6); }
    .bk-band { position: relative; background: var(--color-navy-dark); color: #fff; overflow: hidden; }
    .bk-band img { position: absolute; inset: 0 0 0 40%; width: 60%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 35%); mask-image: linear-gradient(90deg, transparent, #000 35%); }
    .bk-vision { background: #fbf8f2; padding-block: 1.5rem; }
    .bk-vision__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 1rem; text-align: center; }
    .bk-vision__grid > div { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; border-left: 1px solid rgba(201,150,42,0.4); padding-inline: 0.5rem; }
    .bk-vision__grid > div:first-child { border-left: none; }
    .bk-vision__grid img { width: 100%; aspect-ratio: 230 / 132; object-fit: cover; border-radius: 4px; margin-top: 0.5rem; }
    @media (max-width: 900px) { .bk-script { position: static; background: var(--color-navy-dark); padding: 1rem 1.5rem; font-size: 1.75rem; } .bk-hero > img.logo { max-width: 120px; justify-self: start; margin: 1.25rem 0 0 1.5rem; } }
    @media (max-width: 900px) { .bk-hero, .bk-vision__grid { grid-template-columns: 1fr; } .bk-photo { min-height: 300px; } .bk-band img { inset: 0; width: 100%; opacity: 0.4; } }
  </style>
  <section class="bk-hero">
    <img class="logo" src="/IICC_Logo_main.png" alt="IICC Mission" />
    <div class="bk-text">
      <span style="color:#c9962a;"><Icon name="wheat-awn" size={44} /></span>
      <p style="font-family:var(--font-heading); color:var(--color-navy); font-size:1.5rem; text-transform:uppercase;">IICC Mission</p>
      <h1>Bakery<span>of Hope</span></h1>
      <span class="bk-soon">COMING SOON</span>
      <p style="font-family:var(--font-heading); color:var(--color-navy); font-size:1.375rem; line-height:1.3;">Breaking Bread. Sharing Hope.<br />Restoring Dignity.</p>
      <p style="font-family:var(--font-heading); color:var(--color-navy); font-size:1rem; line-height:1.5; max-width:360px;">The IICC Mission Bakery of Hope will be a future initiative dedicated to providing support, dignity and new opportunities for people experiencing hardship.</p>
    </div>
    <div class="bk-photo"><img src={img('hero')} alt="Hands holding a freshly baked loaf of bread" /></div>
    <p class="bk-script">Good bread<br />builds stronger<br />communities.</p>
  </section>
  <section class="bk-band"><img src={img('band')} alt="St Peter's Basilica beyond a wheat field at sunset" />
    <div class="wrap" style="position:relative; padding-block:1.5rem;"><p style="font-family:var(--font-heading); font-size:1.75rem; line-height:1.3;"><span style="color:#c9962a; font-size:3rem; line-height:0.5;">&ldquo;</span> “I was hungry and you<br />gave me something to eat.”</p><p style="color:#c9962a; font-family:var(--font-heading); font-size:1.125rem; margin-top:0.5rem;">— Matthew 25:35</p></div>
  </section>
  <section class="bk-vision"><div class="wrap">
    <h2 class="sec-h--center" style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.875rem; display:flex; justify-content:center; align-items:center; gap:1rem;">Our Future Vision</h2>
    <div class="bk-vision__grid">{vision.map(([i,t,d],k) => <div><span style="width:4rem; height:4rem; border-radius:50%; background:var(--color-navy-dark); color:#d9a540; display:flex; align-items:center; justify-content:center;"><Icon name={i} size={28} /></span><h3 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1rem;">{t}</h3><p style="font-family:var(--font-heading); color:var(--color-navy); font-size:0.9375rem; line-height:1.4;">{d}</p><img src={img(`v${k+1}`)} alt="" /></div>)}</div>
  </div></section>
  <section style="background:var(--color-navy-dark); color:#fff; text-align:center; padding-block:1.5rem;"><div class="wrap">
    <h2 class="sec-h--center" style="font-family:var(--font-heading); text-transform:uppercase; font-size:1.875rem; display:flex; justify-content:center; align-items:center; gap:1rem;">How You Can Help</h2>
    <p style="font-family:var(--font-heading); font-size:1.0625rem; margin-top:0.4rem;">The Bakery of Hope will require the support of people, parishes, businesses and communities.</p>
    <div class="icol" style="margin-top:1.25rem; color:#fff;">{help.map(([i,t,d]) => <div style="align-items:center; text-align:center; border-color:rgba(201,150,42,0.4);"><span style="color:#d9a540;"><Icon name={i} size={44} /></span><h3 style="color:#fff; font-weight:400;">{t}</h3><p style="font-family:var(--font-heading); font-size:0.9375rem;">{d}</p></div>)}</div>
    <p style="font-family:var(--font-heading); font-style:italic; font-size:1.125rem; margin-block:1.25rem;">Join us as we prepare to bring this vision to life.</p>
    <div style="display:flex; justify-content:center; gap:1.5rem; flex-wrap:wrap;"><a href="/donate" class="btn btn--amber" style="font-size:1rem; padding:0.9rem 2rem;">♥ Support Future Projects →</a><a href="/news/newsletter" class="btn btn--outline-white" style="font-size:1rem; padding:0.9rem 2rem;">✉ Stay Connected →</a></div>
  </div></section>
</Layout>
