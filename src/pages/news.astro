---
import Layout from '../layouts/Layout.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CTASection from '../components/CTASection.astro';

const articles = [
  {
    category: 'Mission News',
    categoryColor: '#1B2751',
    date: '10 May 2025',
    title: 'Building Stronger Communities Through Hope and Action',
    excerpt: 'IICC Mission continues to walk alongside those who are forgotten, bringing dignity, support and new opportunities to those who need it most.',
    href: '/news',
  },
  {
    category: 'Founder Update',
    categoryColor: '#9e7d12',
    date: '06 May 2025',
    title: 'A Message From Our Founder: Faith in Action',
    excerpt: 'A personal reflection on the power of faith, forgiveness and the mission to restore hope to others in their most difficult moments.',
    href: '/news',
  },
  {
    category: 'Event',
    categoryColor: '#0891b2',
    date: '02 May 2025',
    title: 'Upcoming Community Forum: Restoring Hope Together',
    excerpt: 'Join us for an evening of sharing, education and action as we work together to restore hope to communities in need across our nation.',
    href: '/news',
  },
  {
    category: 'Story of Hope',
    categoryColor: '#16a34a',
    date: '29 Jun 2025',
    title: 'A Second Chance Changed Everything',
    excerpt: "John's story is one of pain, redemption and the power of never giving up. How the IICC Mission walked alongside him on his journey back.",
    href: '/news',
  },
  {
    category: 'Media Release',
    categoryColor: '#7c3aed',
    date: '24 Jun 2025',
    title: 'IICC Mission Calls For Greater Support For Families',
    excerpt: 'The urgent need for holistic support for families affected by imprisonment and displacement — a call to governments and communities to act.',
    href: '/news',
  },
  {
    category: 'Announcement',
    categoryColor: '#c2410c',
    date: '20 Jun 2025',
    title: 'Easter Message: Hope Rises Again',
    excerpt: 'This Easter, we are reminded that hope is stronger than despair and love conquers all. A special message from the IICC Mission family.',
    href: '/news',
  },
];

const events = [
  {
    date: 'May 15',
    name: 'Community Prayer Night',
    location: "St. Malachy's Parish Hall, Melbourne, VIC",
    time: '7:00 PM – 8:30 PM',
  },
  {
    date: 'May 31',
    name: 'Legal Rights Information Session',
    location: 'Online via Zoom',
    time: '2:00 PM – 4:00 PM',
  },
  {
    date: 'Jun 14',
    name: 'Hope & Restoration Community Forum',
    location: 'Melbourne Convention Centre',
    time: '6:30 PM – 9:30 PM',
  },
];
---

<Layout
  title="News & Events"
  description="IICC Mission News & Updates — Sharing the journey, stories of hope and events from the mission."
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1586339949916-3e9457bef6d3?w=1200&fit=crop&q=80"
        alt="Writing and journal"
        loading="eager"
      />
      <div class="page-hero-overlay"></div>
    </div>
    <div class="page-hero-content">
      <p class="section-label">News &amp; Updates</p>
      <div class="gold-rule-left" style="margin: 0.75rem 0 1.25rem;"></div>
      <h1 class="page-hero-title">Sharing The Journey Of The IICC Mission</h1>
      <p class="page-hero-subtitle hero-scripture-quote">"Let us not grow weary in doing good, for in due time we will reap, if we do not give up." — Galatians 6:9</p>
      <a href="#newsletter" class="btn-primary">STAY INFORMED. STAY CONNECTED. →</a>
    </div>
  </section>

  <!-- FILTER TABS -->
  <nav class="filter-bar" aria-label="News categories">
    <div class="container">
      <div class="filter-tabs">
        <a href="/news" class="filter-tab filter-tab--active">All News</a>
        <a href="/news" class="filter-tab">Mission News</a>
        <a href="/news" class="filter-tab">Events</a>
        <a href="/news" class="filter-tab">Stories of Hope</a>
        <a href="/news" class="filter-tab">Founder Updates</a>
        <a href="/news" class="filter-tab">Media Releases</a>
        <a href="/news" class="filter-tab">Announcements</a>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <section class="section-standard">
    <div class="container">
      <div class="news-layout">

        <!-- ARTICLES GRID -->
        <main class="articles-area">
          <div class="articles-grid">
            {articles.map((article) => (
              <article class="article-card card-hover">
                <div class="article-card-top">
                  <span class="article-category" style={`background-color:${article.categoryColor};`}>{article.category}</span>
                  <span class="article-date">{article.date}</span>
                </div>
                <h2 class="article-title">{article.title}</h2>
                <p class="article-excerpt">{article.excerpt}</p>
                <a href={article.href} class="learn-more-link article-link">READ MORE →</a>
              </article>
            ))}
          </div>

          <!-- LOAD MORE -->
          <div class="load-more-wrap">
            <a href="/news" class="btn-outline">LOAD MORE STORIES →</a>
          </div>
        </main>

        <!-- SIDEBAR -->
        <aside class="news-sidebar">

          <!-- UPCOMING EVENTS -->
          <div class="sidebar-box sidebar-events">
            <div class="sidebar-box-header">
              <span class="sidebar-box-label">Upcoming Events</span>
            </div>
            <div class="sidebar-events-list">
              {events.map((event) => (
                <div class="sidebar-event-item">
                  <div class="event-date-badge">
                    <span class="event-date-text">📅 {event.date}</span>
                  </div>
                  <div class="event-details">
                    <strong class="event-name">{event.name}</strong>
                    <p class="event-location">{event.location}</p>
                    <p class="event-time">{event.time}</p>
                  </div>
                </div>
              ))}
            </div>
            <a href="/news" class="sidebar-cta-link">VIEW ALL EVENTS →</a>
          </div>

          <!-- STAY CONNECTED -->
          <div class="sidebar-box sidebar-newsletter" id="newsletter">
            <div class="sidebar-box-header sidebar-box-header--light">
              <span class="sidebar-box-label sidebar-box-label--dark">Stay Connected</span>
            </div>
            <p class="newsletter-desc">Subscribe to receive the latest news, events, stories of hope and mission updates.</p>
            <div class="newsletter-form">
              <input
                type="email"
                placeholder="Your email address"
                class="newsletter-input"
                aria-label="Email address"
              />
              <button type="button" class="newsletter-btn btn-primary">SUBSCRIBE</button>
            </div>
            <p class="newsletter-privacy">We respect your privacy. Unsubscribe at any time.</p>
          </div>

          <!-- SOCIAL / SHARE -->
          <div class="sidebar-box sidebar-box--plain">
            <p class="sidebar-box-label sidebar-box-label--dark">Follow the Mission</p>
            <div class="social-links">
              <a href="#" class="social-link">Facebook</a>
              <a href="#" class="social-link">Instagram</a>
              <a href="#" class="social-link">YouTube</a>
            </div>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <!-- FEATURE BOXES -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="feature-boxes">

        <div class="feature-box feature-box--dark">
          <span class="feature-box-icon">📰</span>
          <h3 class="feature-box-title">REAL STORIES.<br>REAL IMPACT.</h3>
          <p class="feature-box-desc">Access mission media releases, photos and key resources directly from the field.</p>
          <a href="/news" class="learn-more-link" style="color:var(--color-gold)">READ THE STORIES →</a>
        </div>

        <div class="feature-box feature-box--gold">
          <span class="feature-box-icon">📢</span>
          <h3 class="feature-box-title">MEDIA &amp;<br>RESOURCES</h3>
          <p class="feature-box-desc">View all news and updates from the IICC Mission — available to press, partners and supporters.</p>
          <a href="/news" class="learn-more-link" style="color:var(--color-navy-dark)">VIEW ALL NEWS &amp; UPDATES →</a>
        </div>

        <div class="feature-box feature-box--light">
          <span class="feature-box-icon">🌟</span>
          <h3 class="feature-box-title">MISSION<br>HIGHLIGHTS</h3>
          <p class="feature-box-desc">Be the first to know about news, opportunities and stories of hope from the mission.</p>
          <a href="mailto:info@iiccmission.org?subject=Newsletter" class="learn-more-link">SUBSCRIBE TODAY →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    dark={true}
    headline="Stay Informed. Stay Involved."
    subtext="Subscribe to receive mission updates, news and stories of hope."
    buttons={[
      { label: "Subscribe to Newsletter", href: "mailto:info@iiccmission.org?subject=Newsletter", primary: true },
      { label: "View All News", href: "/news", primary: false },
    ]}
  />

</Layout>

<style>
  /* HERO SCRIPTURE ITALIC */
  .hero-scripture-quote {
    font-family: var(--font-heading);
    font-style: italic;
  }

  /* FILTER BAR */
  .filter-bar {
    background-color: var(--color-navy);
    border-bottom: 2px solid rgba(201,160,23,0.3);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .filter-tabs {
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 0;
  }
  .filter-tabs::-webkit-scrollbar { display: none; }
  .filter-tab {
    display: inline-block;
    padding: 1rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }
  .filter-tab:hover {
    color: rgba(255,255,255,0.9);
  }
  .filter-tab--active {
    color: var(--color-gold);
    border-bottom-color: var(--color-gold);
  }

  /* NEWS LAYOUT */
  .news-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .news-layout {
      grid-template-columns: 1fr 340px;
      gap: 3rem;
    }
  }

  /* ARTICLES GRID */
  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .articles-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .article-card {
    background: white;
    border: 1px solid rgba(27,39,81,0.08);
    border-radius: 2px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .article-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .article-category {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: white;
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
  }
  .article-date {
    font-size: 0.75rem;
    color: #8a8a9a;
    font-weight: 500;
  }
  .article-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    color: var(--color-navy);
    line-height: 1.3;
    margin: 0;
  }
  .article-excerpt {
    font-size: 0.9375rem;
    color: #5a5a6a;
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }
  .article-link {
    margin-top: auto;
  }

  .load-more-wrap {
    text-align: center;
    margin-top: 2.5rem;
  }

  /* SIDEBAR */
  .news-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-box {
    border-radius: 2px;
    overflow: hidden;
  }
  .sidebar-box--plain {
    background: var(--color-offwhite);
    padding: 1.5rem;
    border: 1px solid rgba(27,39,81,0.08);
    border-radius: 2px;
  }
  .sidebar-box-header {
    background: var(--color-navy);
    border-bottom: 2px solid var(--color-gold);
    padding: 0.875rem 1.25rem;
  }
  .sidebar-box-header--light {
    background: var(--color-offwhite);
    border-bottom: 2px solid var(--color-gold);
  }
  .sidebar-box-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 700;
  }
  .sidebar-box-label--dark {
    color: var(--color-gold-dark);
  }

  /* EVENTS */
  .sidebar-events {
    border: 1px solid rgba(201,160,23,0.3);
    border-top: 2px solid var(--color-gold);
  }
  .sidebar-events-list {
    background: var(--color-navy-dark);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .sidebar-event-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(201,160,23,0.15);
  }
  .sidebar-event-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .event-date-text {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 700;
  }
  .event-details {
    margin-top: 0.25rem;
  }
  .event-name {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.25rem;
  }
  .event-location {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.6);
    margin: 0 0 0.1rem;
  }
  .event-time {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    margin: 0;
    font-style: italic;
  }
  .sidebar-cta-link {
    display: block;
    background: rgba(201,160,23,0.1);
    color: var(--color-gold);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.875rem 1.25rem;
    text-align: center;
    transition: background-color 0.2s ease;
  }
  .sidebar-cta-link:hover {
    background: rgba(201,160,23,0.2);
  }

  /* NEWSLETTER */
  .sidebar-newsletter {
    border: 1px solid rgba(27,39,81,0.1);
  }
  .newsletter-desc {
    font-size: 0.9375rem;
    color: #4a4a5a;
    line-height: 1.65;
    padding: 1.25rem 1.25rem 0;
    margin: 0;
    background: var(--color-offwhite);
  }
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-offwhite);
  }
  .newsletter-input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    font-family: var(--font-body);
    border: 1.5px solid rgba(27,39,81,0.2);
    border-radius: 2px;
    background: white;
    color: #2d2d2d;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .newsletter-input:focus {
    border-color: var(--color-gold);
  }
  .newsletter-input::placeholder {
    color: #9a9aaa;
  }
  .newsletter-btn {
    width: 100%;
    border: none;
    cursor: pointer;
    justify-content: center;
    font-size: 0.8125rem;
  }
  .newsletter-privacy {
    font-size: 0.75rem;
    color: #8a8a9a;
    padding: 0 1.25rem 1.25rem;
    margin: 0;
    background: var(--color-offwhite);
    font-style: italic;
  }

  /* SOCIAL */
  .social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .social-link {
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--font-body);
    color: var(--color-navy);
    text-decoration: none;
    padding: 0.4rem 0.875rem;
    border: 1.5px solid rgba(27,39,81,0.2);
    border-radius: 2px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .social-link:hover {
    background: var(--color-navy);
    color: white;
  }

  /* FEATURE BOXES */
  .feature-boxes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .feature-boxes { grid-template-columns: repeat(3, 1fr); }
  }
  .feature-box {
    padding: 2.5rem 2rem;
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .feature-box--dark {
    background: var(--color-navy);
    border-top: 3px solid var(--color-gold);
  }
  .feature-box--gold {
    background: var(--color-gold);
  }
  .feature-box--light {
    background: white;
    border: 1px solid rgba(27,39,81,0.1);
    border-top: 3px solid var(--color-navy);
  }
  .feature-box-icon {
    font-size: 2rem;
    display: block;
  }
  .feature-box-title {
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    font-weight: 700;
  }
  .feature-box--dark .feature-box-title { color: white; }
  .feature-box--gold .feature-box-title { color: var(--color-navy-dark); }
  .feature-box--light .feature-box-title { color: var(--color-navy); }
  .feature-box-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }
  .feature-box--dark .feature-box-desc { color: rgba(255,255,255,0.7); }
  .feature-box--gold .feature-box-desc { color: rgba(18,26,56,0.75); }
  .feature-box--light .feature-box-desc { color: #5a5a6a; }
</style>
