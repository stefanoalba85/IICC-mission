---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Prayer — Together in Faith" description="Prayer changes hearts. Prayer changes lives. At IICC Mission we believe in the power of prayer.">

  <!-- Breadcrumb -->
  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/our-services">Our Programs</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/our-services/spiritual-pastoral-care">Spiritual &amp; Pastoral Care</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Prayer</span>
      </nav>
    </div>
  </div>

  <!-- Hero split -->
  <div class="hero-split" style="min-height:440px;">
    <div class="hero-split__text" style="background:#fff;gap:1rem;">
      <div style="display:flex;align-items:center;gap:1rem;">
        <div style="width:3.5rem;height:3.5rem;border-radius:50%;border:2px solid var(--color-amber);display:flex;align-items:center;justify-content:center;color:var(--color-amber);flex-shrink:0;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/></svg>
        </div>
        <div>
          <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,3.5rem);font-weight:900;color:var(--color-navy);text-transform:uppercase;line-height:1.05;">PRAYER</h1>
          <p style="font-family:var(--font-display);font-size:clamp(1rem,2.5vw,1.625rem);font-weight:700;color:var(--color-amber);text-transform:uppercase;">TOGETHER IN FAITH</p>
        </div>
      </div>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:1.0625rem;color:var(--color-amber);font-weight:700;">Prayer changes hearts. Prayer changes lives.</p>
      <p class="section-desc" style="max-width:none;">
        At IICC Mission, we believe in the power of prayer to bring hope, healing and transformation. Whether you are praying for your own needs or standing in the gap for others, you are part of a community that believes in the power of God.
      </p>
      <a href="/prayer-request" class="btn btn--amber">REQUEST PRAYER ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:300px;">
      <img
        src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=800&h=600&fit=crop"
        alt="Prayer — hands over a Bible with candle"
      />
      <div class="hero-split__quote">
        <span class="hero-split__quote-mark">"</span>
        <p class="hero-split__quote-text">Devote yourselves to prayer, being watchful and thankful.</p>
        <span class="hero-split__quote-ref">— Colossians 4:2</span>
      </div>
    </div>
  </div>

  <!-- We believe in prayer — 4 types -->
  <section class="section section--white">
    <div class="wrap">
      <div class="cols-60-40" style="gap:3rem;align-items:start;">
        <div>
          <span class="eyebrow" style="margin-bottom:0.5rem;display:block;">You Are Invited</span>
          <h2 class="section-title" style="margin-bottom:1rem;">We Believe in the Power of Prayer</h2>
          <span class="rule rule--amber" style="margin-bottom:1.25rem;display:block;"></span>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            Prayer connects us to God and to one another. It builds faith, brings comfort, and opens the door for God's miracles.
          </p>
          <p class="section-desc" style="max-width:none;">
            No matter what you are facing, you don't have to go through it alone. We are here to pray with you and for you.
          </p>
        </div>
        <div class="grid-2" style="gap:1rem;">
          {[
            { icon: '🙏', title: 'Personal Prayer', desc: 'Ask for prayer for your own needs, struggles, concerns or gratitude.' },
            { icon: '👥', title: 'Pray for Others', desc: 'Join us in lifting up others through our prayer wall and prayer requests.' },
            { icon: '📖', title: 'Daily Prayer', desc: 'Receive daily prayers and Scripture to strengthen your faith each day.' },
            { icon: '🤝', title: 'Prayer Partners', desc: 'Be matched with a prayer partner who will pray with you regularly.' },
          ].map(t => (
            <div class="card" style="align-items:center;text-align:center;gap:0.5rem;">
              <div class="card__icon card__icon--filled">{t.icon}</div>
              <p class="card__title">{t.title}</p>
              <p class="card__body">{t.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Ways to Pray — navy -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow eyebrow--white">How to Pray</span>
        <span class="heart">♥</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1rem,2vw,1.25rem);letter-spacing:0.15em;text-transform:uppercase;color:#fff;">WAYS TO PRAY</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="pillars" style="grid-template-columns:repeat(auto-fit,minmax(130px,1fr));">
        {[
          { icon: '🕊️', label: 'Private Prayer', desc: 'Take time to speak with God daily in a quiet place.' },
          { icon: '👨‍👩‍👧', label: 'Group Prayer', desc: 'Join our weekly prayer gatherings online or in person.' },
          { icon: '🌍', label: 'Global Impact', desc: 'Pray for our mission work, partners and communities around the world.' },
          { icon: '♥', label: 'Intercessory Prayer', desc: 'Stand in the gap and pray for the needs of others.' },
          { icon: '📖', label: 'Scripture & Prayer', desc: 'Let God\'s Word guide your prayers and transform your life.' },
          { icon: '✨', label: 'Prayer & Fasting', desc: 'Seek God deeply through prayer and intentional fasting.' },
        ].map(w => (
          <div class="pillar">
            <div class="pillar__icon-wrap" style="font-size:1.25rem;background:rgba(255,255,255,0.05);">{w.icon}</div>
            <p class="pillar__label pillar__label--white">{w.label}</p>
            <p class="pillar__desc pillar__desc--white">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3-col: Request / Photo quote / Join Community -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:1fr;gap:1.5rem;" class="prayer-3col">

        <!-- Request Prayer -->
        <div style="background:var(--color-navy-dark);border-radius:2px;padding:2rem;">
          <h3 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.18em;text-transform:uppercase;color:#fff;margin-bottom:0.5rem;">REQUEST PRAYER</h3>
          <span class="rule rule--amber" style="margin-bottom:1.25rem;display:block;"></span>
          <p style="font-size:0.9375rem;color:rgba(255,255,255,0.75);margin-bottom:1.25rem;line-height:1.65;">
            We would be honored to pray with you. Share your request with us confidentially.
          </p>
          <ul class="checklist checklist--white" style="margin-bottom:1.5rem;">
            <li>Fill out our simple prayer request form</li>
            <li>Our team will pray for you</li>
            <li>Your request remains confidential</li>
            <li>Follow-up care and encouragement</li>
          </ul>
          <a href="/prayer-request" class="btn btn--amber">SUBMIT A PRAYER REQUEST ›</a>
        </div>

        <!-- Cross photo quote -->
        <div style="position:relative;min-height:260px;border-radius:2px;overflow:hidden;">
          <img
            src="https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=600&h=400&fit=crop"
            alt="Cross at sunset"
            style="width:100%;height:100%;object-fit:cover;"
          />
          <div style="position:absolute;inset:0;background:rgba(18,26,56,0.55);display:flex;align-items:center;justify-content:center;padding:2rem;text-align:center;">
            <div>
              <p style="font-family:var(--font-heading);font-style:italic;font-size:clamp(1rem,2vw,1.25rem);color:#fff;line-height:1.65;">
                The Lord is near to all who call on him, to all who call on him in truth.
              </p>
              <p style="margin-top:0.75rem;font-size:0.8125rem;font-weight:700;color:var(--color-amber);">— Psalm 145:18</p>
            </div>
          </div>
        </div>

        <!-- Join Prayer Community -->
        <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:2rem;">
          <h3 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">JOIN OUR PRAYER COMMUNITY</h3>
          <span class="rule rule--amber" style="margin-bottom:1.25rem;display:block;"></span>
          <p class="section-desc" style="max-width:none;margin-bottom:1.25rem;">
            Stay connected and receive prayer updates, devotionals and encouragement.
          </p>
          <ul class="checklist" style="margin-bottom:1.5rem;">
            <li>Weekly prayer email</li>
            <li>Monthly prayer newsletter</li>
            <li>Special prayer alerts</li>
            <li>Encouragement for your journey</li>
          </ul>
          <a href="/get-involved#subscribe" class="btn btn--amber">JOIN NOW ›</a>
        </div>

      </div>
    </div>
  </section>

  <!-- Need immediate prayer -->
  <div style="background:var(--color-off-white);border-top:1px solid rgba(27,39,81,0.08);border-bottom:1px solid rgba(27,39,81,0.08);padding-block:2rem;">
    <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;">
      <div style="display:flex;align-items:center;gap:1rem;">
        <div style="width:3rem;height:3rem;border-radius:50%;background:var(--color-amber);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-size:1.25rem;">♥</div>
        <div>
          <p style="font-weight:700;font-size:1rem;color:var(--color-navy);">NEED IMMEDIATE PRAYER?</p>
          <p style="font-size:0.875rem;color:var(--color-muted);">Our team is here for you. If you need urgent prayer support, please reach out. We care and we are ready to pray with you.</p>
        </div>
      </div>
      <a href="/contact" class="btn btn--amber">CONTACT US NOW ›</a>
    </div>
  </div>

</Layout>

<style>
  @media (min-width: 900px) {
    .prayer-3col { grid-template-columns: 1fr 1fr 1fr !important; }
  }
</style>
