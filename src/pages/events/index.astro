---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Events — IICC Mission" description="Upcoming events, mission gatherings, fundraisers and community moments for IICC Mission.">

  <!-- Breadcrumb -->
  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Events</span>
      </nav>
    </div>
  </div>

  <!-- Hero split -->
  <div class="hero-split" style="min-height:440px;">
    <div class="hero-split__text" style="background:#fff;gap:1.25rem;">
      <span class="eyebrow">Gather. Grow. Give.</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:var(--color-navy);font-size:clamp(2rem,5vw,3.5rem);">MISSION</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(2rem,5vw,3.5rem);">EVENTS</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2.5vw,1.25rem);color:var(--color-muted);line-height:1.6;">
        Join us at events that bring communities together in faith, action and hope.
      </p>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img
        src="https://images.unsplash.com/photo-1511578314322-379afb476865?w=800&h=600&fit=crop"
        alt="Community event and gathering"
      />
    </div>
  </div>

  <!-- Upcoming Events -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Upcoming</span>
        <h2 class="section-title">UPCOMING EVENTS</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div style="display:flex;flex-direction:column;gap:1.5rem;max-width:860px;margin-inline:auto;">
        {[
          {
            date: { day: '15', month: 'AUG', year: '2026' },
            title: 'Annual Hope Gala Dinner',
            location: 'Melbourne Convention Centre, VIC',
            type: 'Fundraiser',
            desc: 'Join us for an evening of inspiration, music and celebration as we honour our Hope Partners and share stories of transformation from the mission field.',
          },
          {
            date: { day: '06', month: 'SEP', year: '2026' },
            title: 'Prison Ministry Volunteer Training Day',
            location: 'Cheltenham Community Hall, VIC',
            type: 'Training',
            desc: 'A full-day orientation and training for new volunteers joining our prison ministry team. Lunch provided. Numbers limited — register early.',
          },
          {
            date: { day: '19', month: 'OCT', year: '2026' },
            title: 'World Mission Sunday — Community Mass & Gathering',
            location: 'St Patrick\'s Cathedral, Melbourne',
            type: 'Faith',
            desc: 'Celebrate World Mission Sunday with IICC Mission. Special Mass followed by a community gathering, testimonials and mission exhibition.',
          },
          {
            date: { day: '08', month: 'NOV', year: '2026' },
            title: 'Advocacy Forum — Immigration Detention Reform',
            location: 'State Library, Melbourne VIC',
            type: 'Advocacy',
            desc: 'A public forum featuring speakers from law, theology and community advocacy exploring pathways to a more humane immigration detention system.',
          },
          {
            date: { day: '12', month: 'DEC', year: '2026' },
            title: 'Christmas in Detention — Volunteer Day',
            location: 'Immigration Detention Centres, VIC',
            type: 'Volunteer',
            desc: 'Spend part of your Christmas bringing joy, prayer and gifts to people held in immigration detention. Registration required.',
          },
        ].map(e => (
          <div style="display:flex;gap:1.5rem;align-items:flex-start;background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:1.5rem;border-left:4px solid var(--color-amber);" class="event-row">
            <div style="min-width:4rem;text-align:center;flex-shrink:0;">
              <div style="background:var(--color-navy-dark);color:#fff;padding:0.5rem 0.625rem 0.375rem;border-radius:2px 2px 0 0;">
                <span style="font-family:var(--font-display);font-size:1.5rem;font-weight:900;line-height:1;">{e.date.day}</span>
              </div>
              <div style="background:var(--color-amber);color:#fff;padding:0.25rem;border-radius:0 0 2px 2px;">
                <span style="font-size:0.625rem;font-weight:800;letter-spacing:0.12em;">{e.date.month}</span>
              </div>
              <span style="display:block;font-size:0.625rem;color:var(--color-muted);margin-top:0.25rem;">{e.date.year}</span>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:0.625rem;flex-wrap:wrap;margin-bottom:0.375rem;">
                <span style="font-size:0.625rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;background:rgba(224,123,0,0.1);color:var(--color-amber);padding:0.2rem 0.5rem;border-radius:2px;">{e.type}</span>
              </div>
              <p style="font-family:var(--font-heading);font-size:1.0625rem;font-weight:700;color:var(--color-navy);margin-bottom:0.25rem;">{e.title}</p>
              <p style="font-size:0.8125rem;color:var(--color-amber);font-weight:600;margin-bottom:0.5rem;">📍 {e.location}</p>
              <p style="font-size:0.875rem;color:var(--color-muted);line-height:1.65;">{e.desc}</p>
              <a href="/contact" class="btn btn--amber" style="margin-top:1rem;font-size:0.75rem;padding:0.5rem 1.25rem;">REGISTER ›</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Host an Event CTA -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:center;">
        <div>
          <span class="eyebrow eyebrow--white" style="display:block;margin-bottom:0.75rem;">Partner With Us</span>
          <h2 style="font-family:var(--font-display);font-size:clamp(1.25rem,3vw,2rem);letter-spacing:0.08em;text-transform:uppercase;color:#fff;margin-bottom:0.75rem;">HOST A MISSION EVENT</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
          <p style="font-size:0.9375rem;color:rgba(255,255,255,0.82);line-height:1.7;margin-bottom:1.25rem;">
            Want to host a fundraiser, awareness evening, prayer night or mission talk at your church, school or workplace? We would love to partner with you.
          </p>
          <a href="/contact" class="btn btn--amber">GET IN TOUCH ›</a>
        </div>
        <div class="quote-box" style="background:rgba(255,255,255,0.05);border-color:var(--color-gold);">
          <span class="quote-box__mark" style="color:var(--color-gold);">"</span>
          <p class="quote-box__text" style="color:rgba(255,255,255,0.9);">Where two or three gather in my name, there am I with them.</p>
          <span class="quote-box__ref" style="color:var(--color-amber);">— Matthew 18:20</span>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  @media (max-width: 640px) {
    .event-row { flex-direction: column; gap: 1rem; }
  }
</style>
