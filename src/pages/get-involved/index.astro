---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
---
<Layout title="Get Involved" description="Be the hands and feet of Christ. Your time. Your talents. Your compassion.">
  <GiHero kicker="Get Involved" title="Be the Hands<br/>and Feet<br/><span style='color:#c9741f'>of Christ</span>" sub="Your time. Your talents.<br/>Your compassion." text="There are many ways you can become part of the IICC Mission and help bring hope, dignity, justice and restoration to incarcerated people, immigration detainees, their families and those in need." cta="Get Involved Today" href="#ways" img={img('gi-hero')} alt="An IICC Mission volunteer walking down a prison corridor" quote="For I was hungry and you gave me something to eat, I was in prison and you came to visit me." quoteRef="Matthew 25:35-36" />
  <ResCards center title="Ways You Can Get Involved" dir="get-involved" items={[
    { photo: 'gi-1', icon: 'people-group', title: 'Volunteer', text: 'Share your time, skills and talents to support our ministries and programs.', cta: 'Become a Volunteer', button: true, href: '/get-involved/volunteer-program' },
    { photo: 'gi-2', icon: 'heart', title: 'Donate', text: 'Your financial support helps us continue our mission and reach more people in need.', cta: 'Donate Now', button: true, href: '/donate' },
    { photo: 'gi-3', icon: 'bullhorn', title: 'Become an Ambassador', text: 'Use your voice to spread hope, raise awareness and help grow our mission globally.', cta: 'Learn More', button: true, href: '/get-involved/ambassador-program' },
    { photo: 'gi-4', icon: 'handshake', title: 'Partner With Us', text: 'Parishes, schools, businesses and organisations can partner with us to create lasting change.', cta: 'Partner With Us', button: true, href: '/donate/corporate-giving' },
    { photo: 'gi-5', icon: 'hands-praying', title: 'Pray for the Mission', text: 'Your prayers sustain our mission and bring hope to those who are hurting, forgotten or marginalised.', cta: 'Submit a Prayer', button: true, href: '/get-involved/prayer-request' },
    { photo: 'gi-6', icon: 'share-nodes', title: 'Share Awareness', text: 'Follow us, like and share our posts. Help us reach more people and show that change is possible.', cta: 'Follow Us', button: true, href: '/news/newsletter' },
  ]} />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 0.95fr; gap:1rem; padding-bottom:1rem;">
    <div><h2 class="camp-h">Your Involvement Creates Real Change</h2><div class="camp-trio" style="margin-top:0.75rem;">{STATS.map(([i,n,t]) => <div><span style="color:var(--color-navy);"><Icon name={i} size={40} /></span><strong style="font-family:var(--font-heading); font-size:1.5rem; color:#c9741f; text-transform:none;">{n}</strong><span style="font-size:0.875rem;">{t}</span></div>)}</div></div>
    <div style="position:relative; border-radius:4px; overflow:hidden; background:var(--color-navy-dark); color:#fff; padding:1.25rem 1.5rem; min-height:170px;"><img class="side-bg" src={img('gi-band')} alt="" style="position:absolute; inset:0 0 0 45%; width:55%; height:100%; object-fit:cover; -webkit-mask-image:linear-gradient(90deg,transparent,#000 40%); mask-image:linear-gradient(90deg,transparent,#000 40%);" /><div style="position:relative; max-width:60%;"><h2 style="font-family:var(--font-heading); color:#d9862a; text-transform:uppercase; font-size:1.5rem; line-height:1.1;">Together,<br /><span style="color:#fff;">We Can Do More</span></h2><p style="font-family:var(--font-heading); font-size:0.9375rem; margin-block:0.5rem 0.75rem;">Your support helps us serve, educate, advocate and restore hope to those who are incarcerated, detained and vulnerable.</p><a href="/donate" class="btn btn--amber" style="padding:0.5rem 1rem; font-size:0.75rem;">Join Our Mission →</a></div></div>
  </section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; padding-bottom:1rem;">
    <div><h2 class="camp-h">Real Stories. Real Impact.</h2><div style="display:grid; grid-template-columns:0.9fr 1.3fr 0.6fr; gap:0.75rem; margin-top:0.6rem; align-items:center;"><img src={img('gi-st1')} alt="" style="width:100%; height:100%; object-fit:cover;" /><div style="font-family:var(--font-heading); font-style:italic; color:var(--color-navy); line-height:1.45;"><p>“The volunteers listened, prayed with me, and gave me hope. Today, I am rebuilding my life with faith.”<span style="display:block; color:#c9741f; font-style:normal; font-size:0.875rem;">— Former Inmate</span></p><p style="margin-top:0.75rem;">“Your support helped us when we had nothing. We felt seen, supported and never alone.”<span style="display:block; color:#c9741f; font-style:normal; font-size:0.875rem;">— Family Beneficiary</span></p></div><img src={img('gi-st2')} alt="" style="width:100%; height:100%; object-fit:cover;" /></div></div>
    <div><h2 class="camp-h">Upcoming Opportunities</h2><div style="display:grid; grid-template-columns:repeat(4,1fr); gap:0.5rem; margin-top:0.6rem;">{[['gi-o1','Prison Visit Ministry','Jun 15, 2025','Bring hope and encouragement through visits.','Learn More'],['gi-o2','Food Drive for Families','Jun 22, 2025','Help provide food and essentials for families in need.','Get Involved'],['gi-o3','Awareness Outreach Event','Jul 05, 2025','Help us spread awareness and share our mission.','Attend Event'],['gi-o4','Youth Hope Workshop','Jul 19, 2025','Inspire and empower young people to build a brighter future.','Learn More']].map(([p,t,d,x,c]) => <div style="background:#fff; box-shadow:0 2px 8px rgba(18,26,56,0.08); text-align:center; display:flex; flex-direction:column;"><img src={img(p)} alt="" style="width:100%; aspect-ratio:100/52; object-fit:cover;" /><div style="padding:0.5rem; display:flex; flex-direction:column; gap:0.3rem; flex:1;"><strong style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:0.75rem; font-weight:400;">{t}</strong><span style="color:#c9741f; font-size:0.75rem;">{d}</span><span style="font-size:0.75rem; flex:1;">{x}</span><a href="/contact" class="btn btn--amber" style="padding:0.3rem; font-size:0.6rem; justify-content:center;">{c} →</a></div></div>)}</div></div>
  </section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1.3fr 0.5fr 1.4fr; gap:1rem; padding-bottom:1.25rem; align-items:center;">
    <div><h2 class="camp-h">How Your Involvement Begins</h2><div class="camp-trio">{[['hand-pointer','Choose How to Help','Select the area that speaks to your heart.'],['file-lines','Complete the Form','Tell us a little about yourself and your interest.'],['people-group','We Connect With You','Our team will be in touch to guide you.'],['hand-holding-heart','Start Making an Impact','Begin your journey and help bring hope.']].map(([i,t,d],k) => <div><span style="width:1.6rem; height:1.6rem; border-radius:50%; background:#c9741f; color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.75rem;">{k+1}</span><Icon name={i} size={34} /><strong>{t}</strong><span>{d}</span></div>)}</div></div>
    <p style="text-align:center; font-family:var(--font-script); color:var(--color-navy); font-size:1.75rem; line-height:1.15;"><span style="color:#c9962a;"><Icon name="dove" size={56} /></span><br />Small acts of love make a big difference.</p>
    <div style="display:grid; grid-template-columns:1.3fr 0.7fr; gap:0.75rem; background:#fbf6ec;"><div style="padding:0.75rem;"><h2 class="camp-h" style="text-align:left; font-size:1.0625rem;">Our Commitment to You</h2>{[['shield-halved','Safe & Respectful Environment','We ensure a safe, supportive and respectful environment for all volunteers and those we serve.'],['book-open','Training & Support','We provide training, resources and ongoing support to help you serve with confidence.'],['people-group','Transparency & Accountability','We are committed to transparency, accountability and good stewardship.'],['heart','Grow Together','Your journey with us helps you grow in faith, compassion and purpose.']].map(([i,t,d]) => <div class="im-row" style="grid-template-columns:2.25rem 1fr; margin-top:0.5rem;"><i style="width:2.25rem; height:2.25rem;"><Icon name={i} size={16} /></i><div><h3 style="font-size:0.75rem;">{t}</h3><p style="font-size:0.75rem;">{d}</p></div></div>)}</div><img src={img('gi-commit')} alt="" style="width:100%; height:100%; object-fit:cover;" /></div>
  </section>
  <section style="background:var(--color-navy-dark); color:#fff;"><div class="wrap camp-grid" style="display:grid; grid-template-columns:4.5rem 1.4fr 1.3fr auto; gap:1.25rem; align-items:center; padding-block:1rem;"><span style="color:#d9862a;"><Icon name="heart" size={56} /></span><h2 style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400; font-size:1.25rem; line-height:1.3;">Your time. Your talents. Your compassion.<br/><span style="color:#d9862a;">Together, we bring hope.</span></h2><p style="font-family:var(--font-heading); font-style:italic; font-size:0.9375rem; border-left:1px solid rgba(255,255,255,0.3); padding-left:1rem;">Every act of service, every prayer, every gift helps transform lives. Join the IICC Mission family today.</p><a href="/get-involved" class="btn btn--amber">Get Involved Now →</a></div></section>
</Layout>
