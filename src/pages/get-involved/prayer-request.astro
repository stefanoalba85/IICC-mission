---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
---
<Layout title="Prayer Request" description="We believe in the power of prayer. We are here to pray with you.">
  <section style="position:relative; background:var(--color-navy-dark); color:#fff; overflow:hidden;">
    <img class="side-bg" src={img('pq-hero')} alt="Hands clasped in prayer over a Bible beside a candle" style="position:absolute; inset:0 0 0 38%; width:62%; height:100%; object-fit:cover; -webkit-mask-image:linear-gradient(90deg,transparent,#000 30%); mask-image:linear-gradient(90deg,transparent,#000 30%);" />
    <div class="wrap camp-grid" style="position:relative; display:grid; grid-template-columns:1.2fr 1fr; gap:2rem; padding-block:2rem; align-items:center;">
      <div style="display:flex; flex-direction:column; gap:0.75rem;">
        <div style="display:grid; grid-template-columns:5.5rem 1fr; gap:1.25rem; align-items:center;"><span style="width:5.5rem; height:5.5rem; border-radius:50%; border:2px solid #d9862a; color:#d9862a; display:flex; align-items:center; justify-content:center;"><Icon name="hands-praying" size={44} /></span><h1 style="font-family:var(--font-heading); text-transform:uppercase; font-size:clamp(2.25rem,4.5vw,3.25rem); line-height:1;">Prayer<br /><span style="color:#d9862a;">Request</span></h1></div>
        <span class="heart-rule" style="max-width:none;">♥</span>
        <p style="font-family:var(--font-heading); color:#d9862a; font-size:1.375rem; line-height:1.3;">We believe in the power of prayer.<br />We are here to pray with you.</p>
        <p style="font-size:1.0625rem; line-height:1.5;">Share your prayer request with us, and our prayer team will lift you up in faith and trust in God’s love and timing.</p>
      </div>
      <p style="justify-self:end; max-width:250px; border:1.5px solid #c9962a; padding:1.25rem; font-family:var(--font-heading); font-style:italic; font-size:1.125rem; line-height:1.5; background:rgba(18,26,56,0.85);"><span style="display:block; color:#d9862a; font-size:3rem; line-height:0.6; font-style:normal;">&ldquo;</span>Do not be anxious about anything, but in every situation, by prayer and petition, with thanksgiving, present your requests to God.<span style="display:block; color:#d9862a; font-style:normal; margin-top:0.5rem;">— Philippians 4:6</span></p>
    </div>
  </section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1.9fr 1fr; gap:1.25rem; padding-block:1.5rem;">
    <form style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem 1.25rem;" onsubmit="event.preventDefault(); this.querySelector('.done').hidden=false;">
      <div style="grid-column:1/-1;"><h2 class="im-h" style="font-size:1.25rem;">Share Your Prayer Request</h2><span style="color:#c9741f;">♥</span><p class="im-p" style="font-size:0.9375rem;">Please fill out the form below. Your request will be kept confidential and shared only with our prayer team.</p></div>
      <label class="form-field">First Name *<input class="form-input" required placeholder="Enter your first name" /></label>
      <label class="form-field">Last Name<input class="form-input" placeholder="Enter your last name" /></label>
      <label class="form-field">Email Address *<input class="form-input" type="email" required placeholder="Enter your email address" /></label>
      <label class="form-field">Phone Number (Optional)<input class="form-input" type="tel" placeholder="Enter your phone number" /></label>
      <fieldset style="grid-column:1/-1; border:none; padding:0;"><legend class="im-h" style="text-transform:none; font-size:0.9375rem; font-family:var(--font-body); font-weight:600;">Would you like us to contact you for follow-up?</legend><label style="margin-right:1.5rem;"><input type="radio" name="fu" /> Yes, you may contact me.</label><label><input type="radio" name="fu" /> No, please keep this request confidential.</label></fieldset>
      <label class="form-field" style="grid-column:1/-1;">Please share your prayer request *<span class="form-hint">Provide as much or as little detail as you feel comfortable sharing.</span><textarea class="form-input form-input--textarea" required placeholder="Enter your prayer request here..."></textarea></label>
      <fieldset style="grid-column:1/-1; border:none; padding:0;"><legend style="font-weight:600; color:var(--color-navy); font-size:0.9375rem;">How would you like us to pray for you? (Select all that apply)</legend><div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.4rem; font-size:0.875rem; margin-top:0.4rem;">{['Health & Healing','Family & Relationships','Emotional & Spiritual Wellbeing','Financial Provision','Legal Matters & Justice','Other (please specify below)'].map(t => <label><input type="checkbox" /> {t}</label>)}</div></fieldset>
      <label class="form-field" style="grid-column:1/-1;">Additional details (Optional)<span class="form-hint">Any other information you would like us to know.</span><textarea class="form-input form-input--textarea" placeholder="Enter additional details here..." style="min-height:5rem;"></textarea></label>
      <fieldset style="grid-column:1/-1; border:none; padding:0;"><legend style="font-weight:600; color:var(--color-navy); font-size:0.9375rem;">Would you like this request to be included in our confidential prayer list?</legend><label style="margin-right:1.5rem;"><input type="radio" name="pl" /> Yes</label><label><input type="radio" name="pl" /> No</label><p class="form-hint">Only our prayer team will see your request.</p></fieldset>
      <div class="m-cta" style="grid-column:1/-1; border:1px solid #e6b67a; background:#fdf8ef; border-radius:4px; padding:0.9rem 1rem; display:grid; grid-template-columns:2.5rem 1fr auto; gap:0.75rem; align-items:center;"><span style="color:#c9741f;"><Icon name="hand-holding-heart" size={32} /></span><div><strong style="color:var(--color-navy);">Need urgent prayer?</strong><p style="font-size:0.8125rem;">If you or someone you know is in immediate need of prayer, please contact us directly.</p></div><a href="/contact" class="btn btn--outline-amber" style="padding:0.4rem 0.9rem; font-size:0.7rem;">Contact Us ›</a></div>
      <label style="font-size:0.875rem; grid-column:1/-1;"><input type="checkbox" required /> I understand that my prayer request will be handled in confidence. Please read our <a href="/privacy-policy" style="text-decoration:underline;">Privacy Policy</a> for more information.</label>
      <div style="grid-column:1/-1; display:flex; gap:1rem; justify-content:flex-end;"><button type="reset" class="btn btn--navy">Clear Form</button><button type="submit" class="btn btn--amber">Submit Request ›</button></div>
      <p class="done" hidden style="grid-column:1/-1; color:var(--color-navy); font-weight:700;">Thank you. Our prayer team will lift you up in prayer.</p>
    </form>
    <aside style="display:flex; flex-direction:column; gap:0.9rem;">
      <div style="background:#f7f6f3; padding:1.25rem;"><h3 class="im-h" style="font-size:1.125rem;">We Are Here to Pray</h3><div style="display:grid; grid-template-columns:4.5rem 1fr; gap:1rem; align-items:center; margin-top:0.75rem;"><span style="width:4.5rem; height:4.5rem; border-radius:50%; background:var(--color-navy-dark); color:#d9862a; display:flex; align-items:center; justify-content:center;"><Icon name="hands-praying" size={32} /></span><p style="font-size:0.875rem;">Prayer is at the heart of everything we do. It connects us with God and with one another.</p></div><p style="font-size:0.875rem; margin-top:0.75rem; border-top:1px solid #e0c08a; padding-top:0.6rem;">You are not alone. We are honoured to pray for you.</p></div>
      <div style="background:var(--color-navy-dark); color:#fff; padding:1.25rem;"><h3 style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400;">What Happens Next?</h3>{[['envelope-open-text','We receive your request','Your request will be sent to our prayer team.'],['hands-praying','We pray for you','Our team will lift you up in prayer with care and compassion.'],['lock','We keep it confidential','Your request is kept private and shared only within the prayer team.'],['heart','We trust God together','We believe God hears every prayer and works in His perfect timing.']].map(([i,t,d]) => <div style="display:grid; grid-template-columns:2.5rem 1fr; gap:0.6rem; margin-top:0.7rem;"><span style="width:2.5rem; height:2.5rem; border-radius:50%; background:#c9741f; display:flex; align-items:center; justify-content:center;"><Icon name={i} size={16} /></span><div><strong style="font-size:0.875rem;">{t}</strong><p style="font-size:0.8125rem;">{d}</p></div></div>)}</div>
      <div style="background:#f7f6f3; padding:1.25rem;"><h3 class="im-h" style="font-size:1.125rem;">Scripture on Prayer</h3>{[['“The prayer of a righteous person is powerful and effective.”','James 5:16'],['“Call to me and I will answer you and tell you great and unsearchable things you do not know.”','Jeremiah 33:3'],['“I have told you these things, so that in me you may have peace. In this world you will have trouble. But take heart! I have overcome the world.”','John 16:33']].map(([q,r]) => <p style="display:grid; grid-template-columns:1.75rem 1fr; gap:0.5rem; margin-top:0.75rem; font-size:0.875rem;"><span style="color:#c9741f;"><Icon name="hand-holding-heart" size={20} /></span><span>{q}<span style="display:block; color:#c9741f;">— {r}</span></span></p>)}</div>
      <div style="background:var(--color-navy-dark); color:#fff; padding:1.25rem;"><h3 style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400;">Need to Talk?</h3><p style="font-size:0.8125rem; margin-block:0.4rem 0.6rem;">If you need to speak with someone or are going through a difficult time, please reach out to us.</p><a href="/contact" class="btn btn--amber" style="padding:0.4rem 0.9rem; font-size:0.7rem;">Contact Us ›</a></div>
    </aside>
  </section>
</Layout>
