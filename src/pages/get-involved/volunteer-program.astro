---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
---
<Layout title="Volunteer Program" description="Make a real difference. Your time. Your skills. Their hope.">
  <GiHero kicker="Volunteer Program" title="Make a<br/><span style='color:#c9741f'>Real Difference</span>" sub="Your Time. Your Skills. Their Hope." text="Join the IICC Mission Volunteer Program and be part of a global community bringing dignity, compassion and hope to incarcerated people, immigration detainees, their families and those in need." cta="Become a Volunteer" href="/get-involved/volunteer-application" img={img('vp-hero')} alt="An IICC Mission volunteer in a prison corridor" quote="For I was hungry and you gave me something to eat, I was in prison and you came to visit me." quoteRef="Matthew 25:35-36" />
  <GiIcons dark items={[{ icon: 'hands-praying', title: 'Serve', text: 'with love' },{ icon: 'book-open', title: 'Empower', text: 'with hope' },{ icon: 'scale-balanced', title: 'Advocate', text: 'with justice' },{ icon: 'heart', title: 'Restore', text: 'with compassion' },{ icon: 'sunRoad', title: 'Build', text: 'stronger communities' }]} />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:0.9fr 2.2fr; gap:1.25rem; padding-block:1.25rem;">
    <div><h2 class="camp-h" style="text-align:left;">Why Volunteer?</h2><p class="im-p" style="margin-block:0.5rem 1rem;">Volunteers are at the heart of the IICC Mission. Your time, skills and compassion help us support people who are incarcerated, detained, their families and those in need. Together we can create a fairer, more compassionate world.</p><div class="im-note" style="background:#fbf6ec; border:none;"><span style="color:var(--color-navy);"><Icon name="people-group" size={40} /></span><span style="font-style:italic; font-size:1.125rem;">Together, we can create a fairer, more compassionate world.</span></div></div>
    <ResCards center title="Areas Where You Can Help" dir="get-involved" items={[
      { photo: 'vp-1', icon: 'hands-praying', title: 'Pastoral & Spiritual Support', text: 'Visitation, letters, phone support, prayer and encouragement.', cta: '' },
      { photo: 'vp-2', icon: 'people-group', title: 'Family Support', text: 'Support for families of incarcerated and detained people.', cta: '' },
      { photo: 'vp-3', icon: 'scale-balanced', title: 'Legal Support & Referral', text: 'Assist with information, document preparation and referral to legal services.', cta: '' },
      { photo: 'vp-4', icon: 'book-open', title: 'Education & Life Skills', text: 'Mentoring, educational programs and reintegration support.', cta: '' },
      { photo: 'vp-5', icon: 'hand-holding-heart', title: 'Humanitarian Support', text: 'Support for people in need, including food, clothing and essential items.', cta: '' },
    ]} />
  </section>
  <section class="camp-grid" style="display:grid; grid-template-columns:1fr 1.1fr 0.8fr; background:#fbf6ec; align-items:center;">
    <img src={img('vp-hands')} alt="Many hands joined together" style="width:100%; height:100%; object-fit:cover;" />
    <div style="padding:1.25rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.75rem; line-height:1.1;">Different People.<br /><span style="color:#c9741f;">One Mission.</span></h2><p class="im-p" style="margin-top:0.5rem;">Whatever your background, there is a way you can help. Your time and compassion can bring hope, dignity and real change to the lives of others.</p></div>
    <p style="padding:1.25rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:1.1875rem; line-height:1.4;"><span style="color:#c9741f; font-size:2.5rem; line-height:0.5;">&ldquo;</span> Volunteers do not necessarily have the time; they just have the heart.<span style="display:block; color:#c9741f; font-style:normal; font-size:0.9375rem;">— Saint Teresa of Calcutta</span></p>
  </section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; padding-block:1.25rem;">
    <div><h2 class="camp-h">Your Involvement Creates Real Change</h2><div class="camp-trio" style="margin-top:0.75rem;">{STATS.map(([i,n,t]) => <div><span style="color:var(--color-navy);"><Icon name={i} size={40} /></span><strong style="font-family:var(--font-heading); font-size:1.5rem; color:#c9741f; text-transform:none;">{n}</strong><span style="font-size:0.875rem;">{t}</span></div>)}</div></div>
    <div><h2 class="camp-h">Who Can Volunteer?</h2><div class="camp-trio" style="margin-top:0.75rem;">{[['heart','People with a heart to help'],['people-group','Parish groups and faith communities'],['graduation-cap','Students and professionals'],['globe','Individuals from all backgrounds']].map(([i,t]) => <div><span style="color:#c9741f;"><Icon name={i} size={40} /></span><span style="font-size:0.875rem;">{t}</span></div>)}</div></div>
  </section>
  <section class="wrap" style="padding-bottom:1rem;"><h2 class="camp-h">Real Stories</h2><div class="camp-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-top:0.6rem;">{[['vp-r1','Being a volunteer has given me a new perspective on life. The people I’ve met have inspired me, and I’ve seen how small acts of kindness can make a huge difference.'],['vp-r2','Volunteering with IICC has been one of the most meaningful experiences of my life. I feel privileged to walk alongside people who are often forgotten.'],['vp-r3','The IICC Mission has given me the opportunity to live my faith in a practical way. Volunteering is challenging, but it is also incredibly rewarding.']].map(([p,q]) => <div style="display:grid; grid-template-columns:0.75fr 1.25fr; gap:0.75rem; align-items:center;"><img src={img(p)} alt="An IICC Mission volunteer" style="width:100%; aspect-ratio:3/4; object-fit:cover;" /><p style="font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:0.9375rem; line-height:1.45;"><span style="color:#c9741f; font-size:2rem; line-height:0.5;">&ldquo;</span>{q}<span style="display:block; color:#c9741f; font-style:normal; font-size:0.8125rem; margin-top:0.4rem;">— IICC Volunteer</span></p></div>)}</div></section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1.2fr 1fr; gap:1rem; padding-bottom:1.25rem; align-items:center;">
    <div><h2 class="camp-h">How to Become a Volunteer</h2><div class="camp-trio" style="margin-top:0.6rem;">{[['file-lines','Complete the application form'],['people-group','Meet with our team'],['shield-halved','Provide required clearances (if applicable)'],['heart','Start making a difference']].map(([i,t],k) => <div><span style="width:1.6rem; height:1.6rem; border-radius:50%; background:#c9741f; color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.75rem;">{k+1}</span><Icon name={i} size={36} /><span style="font-size:0.9375rem;">{t}</span></div>)}</div></div>
    <div style="display:grid; grid-template-columns:1.1fr 0.9fr; background:#fbf6ec; align-items:center;"><div style="padding:1rem;"><h3 class="im-h">Join Our Volunteer Community</h3><p class="im-p" style="font-size:0.875rem; margin-block:0.4rem 0.75rem;">Be part of a global network of volunteers working together to bring hope, justice and restoration to those in need.</p><a href="/get-involved/volunteer-application" class="btn btn--amber">Become a Volunteer →</a></div><img src={img('vp-join')} alt="IICC Mission volunteers at sunset" style="width:100%; height:100%; object-fit:cover;" /></div>
  </section>
  <section style="background:var(--color-navy-dark); color:#fff;"><div class="wrap camp-grid" style="display:grid; grid-template-columns:4.5rem 1.4fr 1.3fr auto; gap:1.25rem; align-items:center; padding-block:1rem;"><span style="color:#d9862a;"><Icon name="heart" size={56} /></span><h2 style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400; font-size:1.25rem; line-height:1.3;">Your time. Your talents. Your compassion.<br/><span style="color:#d9862a;">Together, we bring hope.</span></h2><p style="font-family:var(--font-heading); font-style:italic; font-size:0.9375rem; border-left:1px solid rgba(255,255,255,0.3); padding-left:1rem;">Every act of service, every prayer, every gift helps transform lives. Join the IICC Mission family today.</p><a href="/get-involved" class="btn btn--amber">Get Involved Now →</a></div></section>
</Layout>
