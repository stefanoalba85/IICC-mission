---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
const Sec = (n: number, i: string, t: string) => ({ n, i, t });
const sh = 'background:var(--color-navy-dark); color:#fff; padding:0.5rem 1rem; display:flex; gap:0.75rem; align-items:center; font-family:var(--font-heading); text-transform:uppercase; font-size:1.0625rem;';
---
<Layout title="Volunteer Application Form" description="Your time. Your skills. Their hope.">
  <GiHero kicker="Volunteer Program" title="<span style='font-size:0.7em'>Support &amp; Funding</span><br/><span style='color:#c9741f'>Volunteer<br/>Application Form</span>" sub="<em>Your time. Your skills. Their hope.</em>" text="Join the IICC Mission Volunteer Program and be part of a global community bringing dignity, compassion and hope to incarcerated people, immigration detainees, their families and those in need." img={img('va-hero')} alt="Two IICC Mission volunteers looking at St Peter’s Basilica" quote="For I was hungry and you gave me something to eat, I was in prison and you came to visit me." quoteRef="Matthew 25:35-36" />
  <form class="wrap camp-grid" style="display:grid; grid-template-columns:1.5fr 1fr; gap:1rem; padding-block:1.25rem;" onsubmit="event.preventDefault(); this.querySelector('.done').hidden=false; this.querySelector('.done').scrollIntoView({block:'center'});">
    <fieldset style="border:1px solid #e5e1d8; padding:0; margin:0;"><legend style={sh + ' width:100%;'}><Icon name="user" size={18} /> 1. Personal Information</legend><div style="padding:1rem; display:grid; grid-template-columns:repeat(6,1fr); gap:0.6rem;">
      <label class="form-field" style="grid-column:span 6;">Full Name *<input class="form-input" required /></label>
      <label class="form-field" style="grid-column:span 3;">Date of Birth *<input class="form-input" type="date" required /></label>
      <label class="form-field" style="grid-column:span 3;">Nationality *<input class="form-input" required /></label>
      <label class="form-field" style="grid-column:span 6;">Address *<input class="form-input" required /></label>
      <label class="form-field" style="grid-column:span 2;">City *<input class="form-input" required /></label>
      <label class="form-field" style="grid-column:span 2;">State/Province<input class="form-input" /></label>
      <label class="form-field" style="grid-column:span 2;">Postcode/ZIP<input class="form-input" /></label>
      <label class="form-field" style="grid-column:span 3;">Phone Number *<input class="form-input" type="tel" required /></label>
      <label class="form-field" style="grid-column:span 3;">Email Address *<input class="form-input" type="email" required /></label>
    </div></fieldset>
    <fieldset style="border:1px solid #e5e1d8; padding:0; margin:0;"><legend style={sh + ' width:100%;'}><Icon name="calendar-days" size={18} /> 2. Availability</legend><div style="padding:1rem; display:flex; flex-direction:column; gap:0.6rem; font-size:0.9375rem; color:var(--color-navy);">
      <span>I am available to volunteer: *</span><div style="display:grid; grid-template-columns:1fr 1fr; gap:0.4rem;">{['Weekdays','Evenings','Weekends','Flexible'].map(t => <label><input type="checkbox" /> {t}</label>)}</div>
      <label class="form-field">Preferred start date:<input class="form-input" type="date" /></label>
      <span>How many hours per week can you volunteer? *</span><div style="display:grid; grid-template-columns:1fr 1fr; gap:0.4rem;">{['1–5 hours','11–20 hours','6–10 hours','More than 20 hours'].map(t => <label><input type="radio" name="hours" required /> {t}</label>)}</div>
    </div></fieldset>
    <fieldset style="border:1px solid #e5e1d8; padding:0; margin:0;"><legend style={sh + ' width:100%;'}><Icon name="heart" size={18} /> 3. Areas of Interest <small style="text-transform:none;">(Select one or more)</small></legend><div style="padding:1rem; display:grid; grid-template-columns:1fr 1fr; gap:0.6rem; font-size:0.875rem; color:var(--color-navy);">{[['Pastoral & Spiritual Care','Visits, letters, phone support, prayer'],['Humanitarian Support','Food, clothing, essential items'],['Family Support','Support for families of incarcerated and detained people'],['Events & Fundraising','Community events, campaigns, donor support'],['Legal Support & Referral','Administrative support, document preparation, referrals to legal services'],['Administration & Office Support','Data entry, research, communications'],['Education & Life Skills','Mentoring, educational programs, reintegration support'],['Media & Communications','Social media, content creation, awareness']].map(([t,d]) => <label style="display:grid; grid-template-columns:1.25rem 1fr; gap:0.4rem;"><input type="checkbox" /><span><strong style="font-weight:400; font-family:var(--font-heading); font-size:0.9375rem;">{t}</strong><br /><small>{d}</small></span></label>)}<label style="grid-column:2;"><input type="checkbox" /> Other (please specify) <input class="form-input" style="margin-top:0.3rem;" /></label></div></fieldset>
    <fieldset style="border:1px solid #e5e1d8; padding:0; margin:0;"><legend style={sh + ' width:100%;'}><Icon name="gear" size={18} /> 4. Skills &amp; Experience</legend><div style="padding:1rem;"><label class="form-field">Please tell us about your skills, experience or qualifications relevant to volunteering with IICC Mission.<textarea class="form-input form-input--textarea" style="min-height:10rem;"></textarea></label></div></fieldset>
    <fieldset style="border:1px solid #e5e1d8; padding:0; margin:0;"><legend style={sh + ' width:100%;'}><Icon name="comment-dots" size={18} /> 5. Motivation</legend><div style="padding:1rem;"><label class="form-field">Why do you want to volunteer with IICC Mission? What inspires you to be part of this mission?<textarea class="form-input form-input--textarea"></textarea></label></div></fieldset>
    <fieldset style="border:1px solid #e5e1d8; padding:0; margin:0;"><legend style={sh + ' width:100%;'}><Icon name="people-group" size={18} /> 6. References <small style="text-transform:none;">(Optional)</small></legend><div style="padding:1rem; display:grid; grid-template-columns:1fr 1fr; gap:0.6rem;"><p style="grid-column:1/-1; font-size:0.875rem;">Please provide the details of one referee (e.g. employer, community leader, parish priest, teacher).</p><label class="form-field">Name<input class="form-input" /></label><label class="form-field">Relationship<input class="form-input" /></label><label class="form-field">Phone Number<input class="form-input" type="tel" /></label><label class="form-field">Email Address<input class="form-input" type="email" /></label></div></fieldset>
    <fieldset style="border:1px solid #e5e1d8; padding:0; margin:0;"><legend style={sh + ' width:100%;'}><Icon name="file-lines" size={18} /> 7. Agreement &amp; Declaration</legend><div style="padding:1rem; display:flex; flex-direction:column; gap:0.5rem; font-size:0.875rem;"><label><input type="checkbox" required /> I confirm that the information provided in this application is true and correct.</label><label><input type="checkbox" required /> I understand that I may be required to provide a police/background check and other relevant clearances (if applicable).</label><label><input type="checkbox" required /> I agree to uphold the values, policies and safeguarding standards of IICC Mission.</label><div style="display:grid; grid-template-columns:1.4fr 1fr; gap:0.6rem;"><label class="form-field">Signature *<input class="form-input" required /></label><label class="form-field">Date *<input class="form-input" type="date" required /></label></div><button class="btn btn--amber" type="submit" style="align-self:flex-start;">Submit Application →</button><p class="done" hidden style="color:var(--color-navy); font-weight:700;">Thank you! Your application has been received. Our team will be in touch soon.</p></div></fieldset>
    <div style="background:#fbf6ec; padding:1.25rem; display:grid; grid-template-columns:1.6fr 1fr; gap:1rem;"><div><h3 style="font-family:var(--font-heading); color:#c9741f; text-transform:uppercase; font-size:1.25rem; font-weight:400;">♡ Next Steps</h3>{['Submit your application form.','Our team will review your application.','We will be in touch to discuss next steps, including any required clearances and an onboarding session.','Once approved, you will receive a welcome pack and further information about your volunteer role.'].map((t,k) => <p style="display:grid; grid-template-columns:1.6rem 1fr; gap:0.6rem; margin-top:0.6rem; font-size:0.875rem; color:var(--color-navy);"><span style="width:1.6rem; height:1.6rem; border-radius:50%; background:#c9741f; color:#fff; display:flex; align-items:center; justify-content:center;">{k+1}</span>{t}</p>)}</div><p style="text-align:center; font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:1.25rem; line-height:1.3;"><span style="color:#c9962a;"><Icon name="dove" size={60} /></span><br />Together, we can create a fairer, more compassionate world.</p></div>
  </form>
</Layout>
