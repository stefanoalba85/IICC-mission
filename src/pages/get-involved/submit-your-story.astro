---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
const STEPS = [['envelope','We Receive Your Story','Our team will acknowledge your submission.'],['people-group','We Review Your Story','We may contact you for further details.'],['comments','We Discuss Together','We will talk with you about how your story can be shared (e.g. anonymous, first name only, with photos or video).'],['heart','Your Story Makes a Difference','Your story may be featured on our website, media channels, publications or advocacy initiatives to bring hope and create change.']];
---
<Layout title="Submit Your Story" description="Your story can bring hope.">
  <GiHero kicker="Submit Your Story" title="Your Story<br/><span style='color:#c9741f'>Can Bring</span><br/>Hope" text="Every story matters. By sharing your experience, you can inspire others, raise awareness, and help create positive change for people who are incarcerated, detained and their families." img={img('ss-hero')} alt="A man sitting by a prison window at sunrise" quote="Your story could be the encouragement someone else needs to keep going." />
  <GiIcons items={[{ icon: 'pen', title: 'Inspire Others', text: 'Your story can give hope to people facing similar challenges.' },{ icon: 'bullhorn', title: 'Raise Awareness', text: 'Help shine a light on the real issues facing people who are incarcerated and detained.' },{ icon: 'people-group', title: 'Drive Change', text: 'Your story can support advocacy and policy reform.' },{ icon: 'heart', title: 'A Stronger Community', text: 'Together, we can build a more compassionate and just society.' },{ icon: 'book-open', title: 'Your Voice Matters', text: 'Real people. Real stories. Real impact.' }]} />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:2fr 1fr; gap:1.25rem; padding-block:1.25rem;">
    <form class="camp-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.7rem 1rem; border:1px solid #e5e1d8; padding:1.25rem;" onsubmit="event.preventDefault(); this.querySelector('.done').hidden=false;">
      <div style="grid-column:1/-1;"><h2 class="im-h" style="font-size:1.375rem;">Share Your Story</h2><p class="im-p">Please complete the form below. You can share as much or as little as you feel comfortable with. All stories are treated with compassion, confidentiality and respect.</p></div>
      <label class="form-field">Full Name *<input class="form-input" required placeholder="Your full name" /></label>
      <label class="form-field">Email Address *<input class="form-input" type="email" required placeholder="Your email address" /></label>
      <label class="form-field">Phone Number<input class="form-input" type="tel" placeholder="Your phone number (optional)" /></label>
      <label class="form-field">Country *<select class="form-input" required><option value="">Please select</option><option>Italy</option><option>Australia</option><option>United States</option><option>Canada</option><option>Other</option></select></label>
      <label class="form-field">State/Region (if applicable)<input class="form-input" /></label>
      <fieldset style="border:none; padding:0; font-size:0.8125rem;"><legend style="font-weight:600; color:var(--color-navy);">Are you happy for us to use your first name only?</legend><label style="margin-right:1rem;"><input type="radio" name="fn" checked /> Yes</label><label><input type="radio" name="fn" /> No</label></fieldset>
      <fieldset style="grid-column:1/-1; border:none; padding:0;"><legend style="font-weight:600; color:var(--color-navy); font-size:0.875rem;">Type of Story *</legend><div style="display:grid; grid-template-columns:1fr 1fr; gap:0.35rem; font-size:0.875rem; margin-top:0.3rem;">{['Personal journey (incarceration or detention)','Support from a chaplain/faith community','Family member’s experience','Legal assistance or advocacy','Path to healing and reintegration','Education, training or work programs','Overcoming challenges','How IICC Mission has helped','Faith, hope and spirituality','Other (please specify)'].map(t => <label><input type="checkbox" /> {t}</label>)}</div></fieldset>
      <label class="form-field" style="grid-column:1/-1;">Your Story *<textarea class="form-input form-input--textarea" required maxlength="20000" placeholder="Tell us your story... What happened? What were the challenges? What helped you? What message would you like to share with others?"></textarea><span class="form-hint" style="text-align:right;">Up to 3000 words</span></label>
      <label class="form-field" style="grid-column:span 2;">Upload Photos or Videos (optional)<input class="form-input" type="file" multiple accept="image/*,video/*" /><span class="form-hint">You can upload photos or videos (Max 5 files, 50MB each).</span></label>
      <label style="font-size:0.8125rem;"><strong style="display:block; color:var(--color-navy);">Consent *</strong><input type="checkbox" required /> I give permission for IICC Mission to use my story, including text, photos or videos, for its website, media channels, publications and advocacy. I understand my story will be treated with respect and confidentiality.</label>
      <button type="submit" class="btn btn--amber" style="grid-column:1/-1; justify-self:center; font-size:1rem; padding:0.85rem 2.5rem;"><Icon name="paper-plane" size={18} /> Submit Your Story →</button>
      <p style="grid-column:1/-1; text-align:center; font-size:0.75rem;">Your information is safe with us. We will never share your personal details without your permission. Read our Privacy Policy for more information.</p>
      <p class="done" hidden style="grid-column:1/-1; text-align:center; color:var(--color-navy); font-weight:700;">Thank you for sharing your story.</p>
    </form>
    <aside style="display:flex; flex-direction:column; gap:0.75rem;">
      <div style="position:relative; background:var(--color-navy-dark); min-height:180px;"><img src={img('ss-hands')} alt="" style="position:absolute; inset:0; width:55%; height:100%; object-fit:cover;" /><p style="position:relative; margin-left:52%; padding:1rem; color:#fff; font-family:var(--font-heading); font-size:1.125rem; line-height:1.25; text-transform:uppercase;">Real stories. Real people. <span style="color:#d9862a;">A brighter tomorrow.</span></p></div>
      <div style="border:1px solid #e5e1d8; padding:1rem;"><h3 class="im-h" style="font-size:1.125rem;">What Happens Next?</h3>{STEPS.map(([i,t,d],k) => <div style="display:grid; grid-template-columns:3rem 1fr; gap:0.75rem; margin-top:0.75rem;"><span style="width:3rem; height:3rem; border-radius:50%; background:var(--color-navy-dark); color:#d9a540; display:flex; align-items:center; justify-content:center;"><Icon name={i} size={20} /></span><div><strong style="font-family:var(--font-heading); color:var(--color-navy); font-weight:400; font-size:1rem;">{k+1}. {t}</strong><p style="font-size:0.8125rem;">{d}</p></div></div>)}</div>
      <div style="background:#fbf6ec; padding:1rem; display:grid; grid-template-columns:2.5rem 1fr; gap:0.75rem;"><span style="color:#c9741f;"><Icon name="lock" size={30} /></span><div><h3 class="im-h" style="font-size:1rem;">Your Privacy Matters</h3><p style="font-size:0.8125rem;">We respect your privacy and will always seek your consent before sharing your story. You can choose to remain anonymous or use a different name.</p></div></div>
      <div style="position:relative; background:var(--color-navy-dark); min-height:200px;"><img src={img('ss-man')} alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.7;" /><p style="position:relative; padding:1rem; padding-left:45%; color:#fff; font-family:var(--font-heading); font-size:1.125rem; line-height:1.25; text-transform:uppercase;">From our stories to a <span style="color:#d9862a;">brighter tomorrow.</span></p></div>
    </aside>
  </section>
  <section class="camp-grid" style="display:grid; grid-template-columns:0.9fr 1.1fr; background:#fbf6ec; align-items:center;"><img src={img('ss-rome')} alt="A dove flying over St Peter’s Basilica" style="width:100%; height:100%; object-fit:cover;" /><p style="padding:1.5rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:1.375rem; line-height:1.4;"><span style="color:#c9741f; font-size:2.5rem; line-height:0.5;">&ldquo;</span> When we share our stories with courage, we help others find hope, healing and the strength to rebuild their lives.</p></section>
</Layout>
