---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
const STEPS = [['envelope','We Receive Your Request','Our team will review your information.'],['people-group','We Assess Your Needs','We may contact you for further details.'],['handshake','We Connect You with Support','We will provide guidance, referrals or direct assistance where possible.'],['heart','We Walk With You','Ongoing support and follow-up.']];
---
<Layout title="Support Request Form" description="You are not alone. We are here to listen, support and walk with you.">
  <GiHero kicker="Support Request Form" title="You Are<br/><span style='color:#c9741f'>Not Alone</span>" sub="We are here to listen, support and walk with you or your loved one." text="Use this form to request support, assistance or information. All requests are treated with compassion, confidentiality and respect." img={img('sr-hero')} alt="A priest comforting a man" quote="Every person matters. Every story matters. We are here to listen, to support and to bring hope." />
  <GiIcons items={[{ icon: 'hands-praying', title: 'Spiritual & Pastoral Care', text: 'Prayer, pastoral support and faith-based guidance.' },{ icon: 'scale-balanced', title: 'Legal Assistance & Advocacy', text: 'Information, referrals and advocacy support.' },{ icon: 'people-group', title: 'Family Support', text: 'Support for families and loved ones.' },{ icon: 'book-open', title: 'Education & Reintegration', text: 'Access to programs, skills and opportunities.' },{ icon: 'hand-holding-heart', title: 'Humanitarian Support', text: 'Essential items and practical assistance.' }]} />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:2fr 1fr; gap:1.25rem; padding-block:1.25rem;">
    <form style="display:grid; grid-template-columns:repeat(6,1fr); gap:0.7rem 1rem; border:1px solid #e5e1d8; padding:1.25rem;" onsubmit="event.preventDefault(); this.querySelector('.done').hidden=false;">
      <div style="grid-column:1/-1;"><h2 class="im-h" style="font-size:1.375rem;">Submit a Support Request</h2><p class="im-p">Please complete the form below and we will get back to you as soon as possible.</p></div>
      <label class="form-field" style="grid-column:span 2;">Full Name *<input class="form-input" required placeholder="Your full name" /></label>
      <label class="form-field" style="grid-column:span 2;">Email Address *<input class="form-input" type="email" required placeholder="Your email address" /></label>
      <label class="form-field" style="grid-column:span 2;">Phone Number<input class="form-input" type="tel" placeholder="Your phone number" /></label>
      <fieldset style="grid-column:1/-1; border:none; padding:0;"><legend style="font-weight:600; color:var(--color-navy); font-size:0.875rem;">Are you requesting support for: *</legend>{['Myself','A family member','A friend','Other'].map(t => <label style="margin-right:1.25rem; font-size:0.875rem;"><input type="radio" name="for" required /> {t}</label>)}</fieldset>
      <label class="form-field" style="grid-column:span 2;">Relationship to the person (if applicable)<input class="form-input" placeholder="e.g. spouse, parent, child, friend, etc." /></label>
      <label class="form-field" style="grid-column:span 2;">Country *<select class="form-input" required><option value="">Please select</option><option>Italy</option><option>Australia</option><option>United States</option><option>Canada</option><option>San Marino</option><option>Monaco</option><option>Other</option></select></label>
      <label class="form-field" style="grid-column:span 2;">State/Region (if applicable)<input class="form-input" /></label>
      <label class="form-field" style="grid-column:span 4;">Current Location / Facility (if applicable)<input class="form-input" placeholder="e.g. detention centre, prison, city" /></label>
      <label class="form-field" style="grid-column:span 2;">Date of Birth (if applicable)<input class="form-input" type="date" /></label>
      <fieldset style="grid-column:1/-1; border:none; padding:0;"><legend style="font-weight:600; color:var(--color-navy); font-size:0.875rem;">Type of Support Requested *</legend><div style="display:grid; grid-template-columns:1fr 1fr; gap:0.35rem; font-size:0.875rem; margin-top:0.3rem;">{['Spiritual / Pastoral Care','Education / Reintegration Programs','Legal Assistance / Information','Mental Health & Wellbeing Support','Family Support','Advocacy Support','Humanitarian Support (essentials)','Other (please specify)'].map(t => <label><input type="checkbox" /> {t}</label>)}</div></fieldset>
      <label class="form-field" style="grid-column:1/-1;">Your Message / Details *<textarea class="form-input form-input--textarea" required placeholder="Please tell us more about your situation and how we can help..."></textarea></label>
      <label class="form-field" style="grid-column:1/-1;">Upload Supporting Documents (optional)<input class="form-input" type="file" multiple /><span class="form-hint">You can upload letters, documents or other relevant information (Max 5 files, 10MB each).</span></label>
      <label style="grid-column:1/-1; font-size:0.875rem;"><input type="checkbox" required /> I confirm that the information provided is true and accurate to the best of my knowledge. *</label>
      <button type="submit" class="btn btn--amber" style="grid-column:2/6; justify-content:center; font-size:1rem; padding:0.85rem;"><Icon name="paper-plane" size={18} /> Submit Request →</button>
      <p style="grid-column:1/-1; text-align:center; font-size:0.75rem;">By submitting this form, you agree that IICC Mission may contact you in relation to your request. All information is treated in strict confidence and in accordance with our Privacy Policy.</p>
      <p class="done" hidden style="grid-column:1/-1; text-align:center; color:var(--color-navy); font-weight:700;">Thank you. Your request has been received.</p>
    </form>
    <aside style="display:flex; flex-direction:column; gap:0.75rem;">
      <div style="position:relative; background:var(--color-navy-dark); min-height:170px;"><img src={img('sr-hands')} alt="" style="position:absolute; inset:0; width:55%; height:100%; object-fit:cover;" /><p style="position:relative; margin-left:52%; padding:1rem; color:#fff; font-family:var(--font-heading); font-size:1.125rem; line-height:1.25;">Compassion Today. Brighter Tomorrows Ahead.</p></div>
      <div style="border:1px solid #e5e1d8; padding:1rem;"><h3 class="im-h" style="font-size:1.125rem;">What Happens Next?</h3>{STEPS.map(([i,t,d],k) => <div style="display:grid; grid-template-columns:3rem 1fr; gap:0.75rem; margin-top:0.75rem;"><span style="width:3rem; height:3rem; border-radius:50%; background:var(--color-navy-dark); color:#d9a540; display:flex; align-items:center; justify-content:center;"><Icon name={i} size={20} /></span><div><strong style="font-family:var(--font-heading); color:var(--color-navy); font-weight:400; font-size:1rem;">{k+1}. {t}</strong><p style="font-size:0.8125rem;">{d}</p></div></div>)}</div>
      <div style="background:#fbf6ec; padding:1rem; display:grid; grid-template-columns:2.5rem 1fr; gap:0.75rem;"><span style="color:#c0392b;"><Icon name="circle-exclamation" size={34} /></span><div><h3 class="im-h" style="font-size:1rem;">Need Immediate Help?</h3><p style="font-size:0.8125rem;">If you or someone you know is in immediate danger or at risk, please contact local emergency services or relevant authorities in your country.</p></div></div>
      <div style="position:relative; background:var(--color-navy-dark); min-height:170px;"><img src={img('sr-rosary')} alt="" style="position:absolute; inset:0; width:55%; height:100%; object-fit:cover;" /><p style="position:relative; margin-left:52%; padding:1rem; color:#fff; font-family:var(--font-heading); font-size:1.125rem; line-height:1.25; text-transform:uppercase;">Hope. Help. Healing. <span style="color:#d9862a;">A brighter tomorrow.</span></p></div>
    </aside>
  </section>
</Layout>
