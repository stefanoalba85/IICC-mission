---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
---
<Layout title="Ambassador Program" description="Champions of Hope. Using influence for a greater purpose.">
  <GiHero kicker="Ambassador Program" title="Champions<br/><span style='color:#c9741f'>of Hope</span>" sub="Using Influence for a Greater Purpose." text="The IICC Mission Ambassador Program brings together people of influence, compassion and integrity who share our vision of a fairer, more compassionate world for incarcerated people, immigration detainees, their families and those in need." cta="Become an Ambassador" href="/contact" img={img('amb-hero')} alt="An IICC Mission ambassador looking at St Peter’s Basilica" quote="Let your light shine before others, that they may see your good deeds and glorify your Father in heaven." quoteRef="Matthew 5:16" />
  <GiIcons dark items={[{ icon: 'people-group', title: 'Raise Awareness', text: 'Give a voice to those who are often not heard.' },{ icon: 'heart', title: 'Inspire Change', text: 'Encourage compassion, justice and restoration in society.' },{ icon: 'sitemap', title: 'Expand Our Reach', text: 'Help us connect with new communities, supporters and partners.' },{ icon: 'handshake', title: 'Build Partnerships', text: 'Open doors to new opportunities and collaborations.' },{ icon: 'globe', title: 'Create Lasting Impact', text: 'Together, we can transform lives and build a more just world.' }]} />
  <section class="camp-grid" style="display:grid; grid-template-columns:1.2fr 0.8fr 1fr; background:#fbf6ec; align-items:center;">
    <div style="padding:1.25rem 1.5rem 1.25rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem));"><h2 class="im-h" style="font-size:1.25rem;">What is an IICC Mission Ambassador?</h2><p class="im-p" style="margin-top:0.5rem;">An IICC Mission Ambassador is a respected individual who supports our mission by using their platform, influence, skills and networks to raise awareness, promote our work, and help us build meaningful partnerships and support.</p></div>
    <p style="padding:1.25rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:1.1875rem;"><span style="color:#c9741f; font-size:2.5rem; line-height:0.5;">&ldquo;</span> Together, we can create a fairer, more compassionate world.</p>
    <img src={img('amb-team')} alt="IICC Mission ambassadors at sunset" style="width:100%; height:100%; object-fit:cover;" />
  </section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1.25fr 0.8fr 1.2fr; gap:1rem; padding-block:1.25rem;">
    <div><h2 class="im-h" style="font-size:1.25rem;">Who Can Be an Ambassador?</h2><p class="im-p" style="margin-block:0.3rem 0.75rem;">We welcome individuals from all walks of life, including:</p><div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; text-align:center;">{[['clapperboard','Artists & Entertainers'],['people-group','Public Figures & Influencers'],['briefcase','Business Leaders & Entrepreneurs'],['graduation-cap','Academics & Professionals'],['hands-praying','Faith Leaders & Community Figures'],['heart','Advocates & Humanitarian Supporters']].map(([i,t]) => <div style="color:var(--color-navy); display:flex; flex-direction:column; align-items:center; gap:0.4rem; font-family:var(--font-heading);"><Icon name={i} size={36} />{t}</div>)}</div></div>
    <img src={img('amb-diff')} alt="Different people. One mission." style="width:100%; height:100%; object-fit:cover;" />
    <div><h2 class="im-h" style="font-size:1.25rem;">Ambassador Roles</h2><p class="im-p" style="margin-bottom:0.5rem;">Ambassadors may choose to be involved in one or more areas:</p>{[['bullhorn','Awareness & Advocacy','Help share our message through media, events and personal networks.'],['people-group','Fundraising Support','Support campaigns and initiatives to help sustain and grow our programs.'],['handshake','Partnerships','Introduce us to potential partners, sponsors and supporters.'],['video','Media & Content','Help create and share content to inspire and inform.'],['heart','Special Initiatives','Be involved in specific programs, events or projects that align with your expertise and interests.']].map(([i,t,d],k) => <div class="im-row"><i style={k%2 ? 'background:#c9741f' : ''}><Icon name={i} size={20} /></i><div><h3>{t}</h3><p>{d}</p></div></div>)}</div>
  </section>
  <section class="camp-grid" style="display:grid; grid-template-columns:1.1fr 1fr; background:#fbf6ec; align-items:center;">
    <div style="padding:1.25rem 1.5rem 1.25rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem));"><h2 class="im-h" style="font-size:1.25rem;">The Impact You Can Make</h2><div class="camp-trio" style="margin-top:0.6rem;">{[['people-group','Give Hope','Help change lives and restore dignity.'],['scale-balanced','Promote Justice','Support a fairer, more compassionate society.'],['globe','Expand Our Global Reach','Help us reach new communities worldwide.'],['dove','Be a Voice for the Voiceless','Stand alongside those who are often forgotten.']].map(([i,t,d]) => <div><span style="color:#c9741f;"><Icon name={i} size={40} /></span><strong>{t}</strong><span>{d}</span></div>)}</div></div>
    <div style="position:relative; min-height:200px;"><img src={img('amb-rome')} alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" /><p style="position:absolute; right:1rem; top:1rem; width:45%; background:rgba(251,246,236,0.92); padding:0.75rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy);">“Small acts of love, when multiplied by millions of people, can transform the world.”</p></div>
  </section>
  <section style="background:var(--color-navy-dark); color:#fff;"><div class="camp-grid" style="display:grid; grid-template-columns:1.2fr repeat(4,0.4fr);">
    <div style="padding:1.25rem 1.5rem 1.25rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem));"><h2 style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400; font-size:1.25rem;">Become an IICC Mission Ambassador</h2><p style="margin-block:0.5rem 0.9rem;">If you share our values and would like to use your influence to make a real difference, we would love to hear from you.</p><a href="/contact" class="btn btn--amber">Apply to Become an Ambassador →</a></div>
    {[1,2,3,4].map(n => <img src={img(`amb-b${n}`)} alt="" style="width:100%; height:100%; object-fit:cover;" />)}
  </div></section>
</Layout>
