---
import Layout from '../layouts/Layout.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Our Mission"
  description="IICC Mission — Accompanying, Empowering, Restoring Hope. Every person has dignity, a story and deserves hope."
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=1200&fit=crop&q=80"
        alt="Prayer hands in light"
        loading="eager"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
      <p class="section-label" style="margin-bottom:0.875rem">Our Mission</p>
      <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
      <h1 class="page-hero-title">Accompanying. Empowering.<br>Restoring Hope.</h1>
      <p class="page-hero-subtitle">
        Every person has dignity. Every person has a story. Every person deserves hope.
      </p>
      <a href="/our-services" class="btn-primary">DISCOVER OUR WORK →</a>
    </div>
  </section>

  <!-- SECTION 1: WHO WE SERVE -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="section-header">
        <p class="section-label">WHO WE SERVE</p>
        <div class="gold-rule"></div>
        <h2 class="section-header-title" style="margin-top:1rem">
          We walk alongside people through life's most challenging circumstances.
        </h2>
      </div>

      <div class="card-grid-3">
        <div class="info-card card-hover">
          <span class="info-card-icon">🔒</span>
          <h3 class="info-card-title">Prisoners &amp; Inmates</h3>
          <p class="info-card-desc">Behind every inmate there is a human being deserving of dignity, encouragement and hope.</p>
          <ul class="serve-list">
            <li>Dignity</li>
            <li>Encouragement</li>
            <li>Spiritual support</li>
            <li>Pathways toward change</li>
          </ul>
        </div>

        <div class="info-card card-hover">
          <span class="info-card-icon">🚪</span>
          <h3 class="info-card-title">Former Prisoners</h3>
          <p class="info-card-desc">Restoration continues beyond release. We walk with people into a new beginning.</p>
          <ul class="serve-list">
            <li>Reintegration</li>
            <li>Rebuilding relationships</li>
            <li>Education</li>
            <li>New beginnings</li>
          </ul>
        </div>

        <div class="info-card card-hover">
          <span class="info-card-icon">✈</span>
          <h3 class="info-card-title">Immigration Detainees</h3>
          <p class="info-card-desc">Every person deserves dignity and compassion, regardless of circumstance.</p>
          <ul class="serve-list">
            <li>Connection</li>
            <li>Pastoral care</li>
            <li>Encouragement</li>
            <li>Pathways to support</li>
          </ul>
        </div>

        <div class="info-card card-hover">
          <span class="info-card-icon">👨‍👩‍👧</span>
          <h3 class="info-card-title">Families</h3>
          <p class="info-card-desc">Behind every person there is a family. We support families in their most difficult moments.</p>
          <ul class="serve-list">
            <li>Separation</li>
            <li>Hardship</li>
            <li>Uncertainty</li>
            <li>Difficult circumstances</li>
          </ul>
        </div>

        <div class="info-card card-hover">
          <span class="info-card-icon">🛡</span>
          <h3 class="info-card-title">Victims Of Abuse</h3>
          <p class="info-card-desc">Standing with people on the path toward healing, safety and restoration.</p>
          <ul class="serve-list">
            <li>Counsellors</li>
            <li>Support services</li>
            <li>Professional assistance</li>
            <li>Recovery pathways</li>
          </ul>
        </div>

        <div class="info-card card-hover">
          <span class="info-card-icon">💙</span>
          <h3 class="info-card-title">Vulnerable People</h3>
          <p class="info-card-desc">Helping those who feel forgotten, isolated, excluded, without hope — showing them they are loved.</p>
          <ul class="serve-list">
            <li>Compassion</li>
            <li>Connection</li>
            <li>Practical assistance</li>
            <li>Community belonging</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: MISSION PILLARS -->
  <section class="section-standard">
    <div class="container">
      <div class="section-header">
        <p class="section-label">OUR MISSION PILLARS</p>
        <div class="gold-rule"></div>
        <h2 class="section-header-title" style="margin-top:1rem">Five Pillars That Guide Every Action</h2>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card card-hover">
          <span class="pillar-card-icon">✝</span>
          <h3 class="pillar-card-title">Spiritual &amp; Pastoral Care</h3>
          <p class="pillar-card-desc">Faith, prayer, guidance and encouragement at the heart of everything we do. Meeting people in their darkness and walking them toward the light of Christ.</p>
          <a href="/our-services#spiritual" class="learn-more-link">LEARN MORE →</a>
        </div>

        <div class="pillar-card card-hover">
          <span class="pillar-card-icon">⚖</span>
          <h3 class="pillar-card-title">Legal Assistance &amp; Advocacy</h3>
          <p class="pillar-card-desc">Working alongside trusted professionals to promote dignity, justice and awareness.</p>
          <ul class="pillar-list">
            <li>Criminal lawyers</li>
            <li>Immigration lawyers</li>
            <li>Civil lawyers</li>
            <li>Commercial lawyers</li>
            <li>Advocacy professionals</li>
          </ul>
          <a href="/our-services#legal" class="learn-more-link">LEARN MORE →</a>
        </div>

        <div class="pillar-card card-hover">
          <span class="pillar-card-icon">📚</span>
          <h3 class="pillar-card-title">Education &amp; Awareness</h3>
          <p class="pillar-card-desc">Creating understanding through learning, awareness campaigns, community education and Hope Media.</p>
          <ul class="pillar-list">
            <li>Learning programs</li>
            <li>Awareness campaigns</li>
            <li>Community education</li>
            <li>Hope Media</li>
          </ul>
          <a href="/our-services#education" class="learn-more-link">LEARN MORE →</a>
        </div>

        <div class="pillar-card card-hover">
          <span class="pillar-card-icon">🤲</span>
          <h3 class="pillar-card-title">Humanitarian Support</h3>
          <p class="pillar-card-desc">Providing compassion, practical assistance and community connection to those in greatest need.</p>
          <ul class="pillar-list">
            <li>Compassion</li>
            <li>Practical assistance</li>
            <li>Community connection</li>
          </ul>
          <a href="/our-services#humanitarian" class="learn-more-link">LEARN MORE →</a>
        </div>

        <div class="pillar-card card-hover">
          <span class="pillar-card-icon">🌱</span>
          <h3 class="pillar-card-title">Healing, Restoration &amp; Reintegration</h3>
          <p class="pillar-card-desc">Supporting people on the path from brokenness to wholeness — rebuilding belonging and purpose.</p>
          <ul class="pillar-list">
            <li>Recovery</li>
            <li>Rebuilding</li>
            <li>Belonging</li>
            <li>Purpose</li>
          </ul>
          <a href="/our-services#healing" class="learn-more-link">LEARN MORE →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: ADVOCACY (dark, two-col) -->
  <section class="section-standard-dark">
    <div class="container">
      <div class="two-col">
        <div class="advocacy-text">
          <p class="section-label">ADVOCACY</p>
          <div class="gold-rule-left" style="margin:0.875rem 0 1.25rem"></div>
          <h2 class="advocacy-heading">Giving A Voice To Forgotten Issues</h2>
          <p class="advocacy-body">
            The IICC Mission believes some people and issues are overlooked. Through awareness, collaboration and respectful advocacy, we seek to bring attention to challenges affecting individuals, families and communities.
          </p>
          <div class="advocacy-tags">
            <span class="advocacy-tag">Human Dignity</span>
            <span class="advocacy-tag">Rehabilitation</span>
            <span class="advocacy-tag">Support Systems</span>
            <span class="advocacy-tag">Vulnerable Communities</span>
            <span class="advocacy-tag">Social Awareness</span>
          </div>
        </div>
        <div class="advocacy-img-wrap">
          <img
            src="https://images.unsplash.com/photo-1589994965851-a8f479c573a9?w=600&fit=crop&q=80"
            alt="Advocacy — standing for justice and dignity"
            loading="lazy"
            class="advocacy-img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: RESTORATION PROJECTS (offwhite, two-col) -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="two-col">
        <div class="restoration-text">
          <p class="section-label">RESTORATION PROJECTS</p>
          <div class="gold-rule-left" style="margin:0.875rem 0 1.25rem"></div>
          <h2 class="restoration-heading">IICC Mission Restoration Bakery Network</h2>
          <p class="restoration-sub">From simple ingredients to new beginnings.</p>
          <p class="restoration-body">
            Our restoration projects provide people with practical skills, training and opportunities to rebuild their lives with dignity.
          </p>
          <ul class="restoration-list">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Skills development
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Responsibility
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Confidence
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Opportunity
            </li>
          </ul>
          <a href="/bakery" class="btn-primary" style="margin-top:1.75rem">DISCOVER RESTORATION PROJECTS →</a>
        </div>
        <div class="restoration-img-wrap">
          <img
            src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=600&fit=crop&q=80"
            alt="IICC Mission Restoration Bakery — bread and new beginnings"
            loading="lazy"
            class="restoration-img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: GLOBAL MISSION NETWORK (dark) -->
  <section class="network-dark-section">
    <div class="container network-dark-inner">
      <div class="network-dark-text">
        <h2 class="network-dark-heading">One Mission. Many Hands. Endless Hope.</h2>
        <a href="/global-network" class="btn-outline" style="margin-top:2rem">VIEW OUR GLOBAL NETWORK →</a>
      </div>
      <div class="mission-flow">
        <div class="mission-flow-steps">
          <div class="flow-step">
            <span class="flow-step-num">01</span>
            <span class="flow-step-label">International Missions</span>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <span class="flow-step-num">02</span>
            <span class="flow-step-label">National Missions</span>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <span class="flow-step-num">03</span>
            <span class="flow-step-label">State &amp; Provincial Missions</span>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <span class="flow-step-num">04</span>
            <span class="flow-step-label">Regional Missions</span>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <span class="flow-step-num">05</span>
            <span class="flow-step-label">Local Missions</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <QuoteBand
    quote="ONE MISSION. MANY NATIONS. ONE LOVE IN CHRIST."
    dark={true}
  />

  <!-- CTA SECTION -->
  <CTASection
    eyebrow="One Mission"
    headline="Join The Mission"
    subtext="Be part of a global movement of hope, compassion and restoration."
    buttons={[
      { label: 'Become An Ambassador', href: '/get-involved', primary: true },
      { label: 'Support The Mission', href: '/donate', primary: false },
      { label: 'Work With Us', href: '/get-involved#volunteer', primary: false },
    ]}
    dark={true}
  />

</Layout>

<style>
  /* WHO WE SERVE CARDS */
  .serve-list {
    list-style: none;
    padding: 0;
    margin: 0.875rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .serve-list li {
    font-size: 0.8125rem;
    color: #5a5a6a;
    padding-left: 1rem;
    position: relative;
  }
  .serve-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-size: 0.75rem;
  }

  /* MISSION PILLARS */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .pillars-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .pillar-card {
    background: white;
    border: 1px solid rgba(27,39,81,0.08);
    border-top: 3px solid var(--color-gold);
    padding: 2rem 1.75rem;
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pillar-card-icon {
    font-size: 2rem;
    display: block;
  }
  .pillar-card-title {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-navy);
    margin: 0;
    text-transform: uppercase;
  }
  .pillar-card-desc {
    font-size: 0.9rem;
    color: #5a5a6a;
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }
  .pillar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pillar-list li {
    font-size: 0.8125rem;
    color: #5a5a6a;
    padding-left: 1rem;
    position: relative;
  }
  .pillar-list li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-weight: 700;
  }

  /* ADVOCACY */
  .advocacy-text {
    color: white;
  }
  .advocacy-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: white;
    margin-bottom: 1.25rem;
  }
  .advocacy-body {
    color: rgba(255,255,255,0.75);
    line-height: 1.75;
    font-size: 1.0625rem;
    margin-bottom: 1.75rem;
  }
  .advocacy-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .advocacy-tag {
    background: rgba(201,160,23,0.15);
    border: 1px solid rgba(201,160,23,0.4);
    color: var(--color-gold);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.375rem 0.75rem;
    border-radius: 2px;
    text-transform: uppercase;
  }
  .advocacy-img-wrap {
    border-radius: 2px;
    overflow: hidden;
  }
  .advocacy-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 300px;
    display: block;
  }

  /* RESTORATION */
  .restoration-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }
  .restoration-sub {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.0625rem;
    color: var(--color-gold-dark);
    margin-bottom: 1rem;
  }
  .restoration-body {
    color: #4a4a4a;
    line-height: 1.75;
    font-size: 1.0625rem;
    margin-bottom: 1.25rem;
  }
  .restoration-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .restoration-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--color-navy);
    font-weight: 600;
  }
  .restoration-list svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }
  .restoration-img-wrap {
    border-radius: 2px;
    overflow: hidden;
  }
  .restoration-img {
    width: 100%;
    object-fit: cover;
    display: block;
    min-height: 320px;
  }

  /* GLOBAL MISSION NETWORK */
  .network-dark-section {
    background-color: var(--color-navy-dark);
    padding: 5rem 0;
    border-top: 1px solid rgba(201,160,23,0.2);
    border-bottom: 1px solid rgba(201,160,23,0.2);
  }
  .network-dark-inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .network-dark-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .network-dark-text {
    flex-shrink: 0;
  }
  .network-dark-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    color: white;
    max-width: 400px;
    line-height: 1.2;
  }
  .mission-flow {
    flex: 1;
    overflow-x: auto;
  }
  .mission-flow-steps {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: min-content;
  }
  .flow-step {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(201,160,23,0.25);
    border-top: 2px solid var(--color-gold);
    padding: 1rem 1.25rem;
    text-align: center;
    min-width: 130px;
  }
  .flow-step-num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-gold);
    font-weight: 700;
    margin-bottom: 0.375rem;
  }
  .flow-step-label {
    display: block;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.7);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .flow-arrow {
    font-size: 1.25rem;
    color: var(--color-gold);
    opacity: 0.6;
    flex-shrink: 0;
  }
</style>
