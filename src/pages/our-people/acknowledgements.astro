---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Acknowledgements — Our People — IICC Mission" description="Gratitude to all who have supported, guided and blessed the IICC Mission.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/our-people">Our People</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Acknowledgements</span>
      </nav>
    </div>
  </div>

  <div class="hero-full" style="min-height:44vh;">
    <div class="hero-full__bg">
      <img src="https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=1400&h=600&fit=crop" alt="" aria-hidden="true" />
    </div>
    <div class="hero-full__overlay"></div>
    <div class="hero-full__content">
      <span class="eyebrow eyebrow--white" style="display:block;margin-bottom:0.75rem;">With Gratitude</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);font-weight:900;color:#fff;text-transform:uppercase;margin-bottom:0.5rem;">ACKNOWLEDGEMENTS</h1>
      <span class="rule rule--amber" style="display:block;margin-bottom:1rem;"></span>
      <p style="font-size:1rem;color:rgba(255,255,255,0.9);font-style:italic;">"Give thanks in all circumstances." — 1 Thessalonians 5:18</p>
    </div>
  </div>

  <section class="section section--white">
    <div class="wrap" style="max-width:860px;">
      <div style="text-align:center;margin-bottom:3rem;">
        <span class="heart" style="font-size:1.5rem;display:block;margin-bottom:1rem;">♥</span>
        <p class="section-desc" style="margin-inline:auto;">
          IICC Mission exists because of the generosity, courage and dedication of so many people. We are deeply grateful to each person who has believed in this mission, supported it with prayer, time or resources, and walked with us on this journey.
        </p>
      </div>

      <!-- Church endorsements -->
      <div style="margin-bottom:3rem;">
        <h2 class="section-title" style="margin-bottom:0.5rem;">Church Recognition &amp; Endorsements</h2>
        <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>
        <div style="display:flex;flex-direction:column;gap:1.25rem;">
          {[
            { name: 'His Eminence Cardinal George Pell', role: 'Former Archbishop of Melbourne / Prefect of the Secretariat for the Economy', note: 'Recognised the extraordinary prison ministry of Ambassador Antonio Dattilo.' },
            { name: 'His Grace Archbishop Peter Comensoli', role: 'Archbishop of Melbourne', note: 'Acknowledged the pastoral mission of IICC Mission to the incarcerated and marginalised.' },
            { name: 'His Holiness Pope Francis', role: 'Bishop of Rome', note: 'Whose call to accompany the marginalised and visit the imprisoned inspires our entire mission.' },
            { name: 'His Holiness Pope Leo XIV', role: 'Bishop of Rome', note: 'Whose pontificate continues to inspire the IICC Mission in its service to the poorest.' },
          ].map(e => (
            <div style="display:flex;align-items:flex-start;gap:1rem;padding:1.25rem;background:var(--color-off-white);border-left:3px solid var(--color-amber);border-radius:2px;">
              <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:var(--color-navy);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <span style="color:var(--color-gold);font-size:0.875rem;">✝</span>
              </div>
              <div>
                <p style="font-weight:700;font-size:0.9375rem;color:var(--color-navy);margin-bottom:0.125rem;">{e.name}</p>
                <p style="font-size:0.75rem;color:var(--color-amber);font-weight:600;letter-spacing:0.06em;margin-bottom:0.375rem;">{e.role}</p>
                <p style="font-size:0.8125rem;color:var(--color-muted);line-height:1.6;">{e.note}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Hope Partners -->
      <div style="margin-bottom:3rem;">
        <h2 class="section-title" style="margin-bottom:0.5rem;">Our Hope Partners &amp; Supporters</h2>
        <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>
        <p class="section-desc" style="margin-bottom:1.5rem;">We are profoundly grateful to every Hope Partner, donor, volunteer and supporter who has made this mission possible. You are the heart of everything we do.</p>
        <div style="background:var(--color-navy-dark);border-radius:2px;padding:2rem;text-align:center;">
          <span class="heart" style="color:var(--color-gold);display:block;margin-bottom:0.75rem;">♥</span>
          <p style="font-family:var(--font-heading);font-size:1.125rem;color:#fff;font-style:italic;line-height:1.65;">"Whatever you did for one of the least of these brothers and sisters of mine, you did for me." — Matthew 25:40</p>
        </div>
      </div>

      <!-- Country acknowledgements -->
      <div>
        <h2 class="section-title" style="margin-bottom:0.5rem;">Country of Operations Acknowledgement</h2>
        <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>
        <p class="section-desc">
          IICC Mission acknowledges the Traditional Owners of the lands on which we operate across Australia, and pays respect to their Elders past, present and emerging. We acknowledge the deep spiritual connection of Aboriginal and Torres Strait Islander peoples to Country, and commit to working for justice, dignity and healing for all people.
        </p>
      </div>

    </div>
  </section>

</Layout>
