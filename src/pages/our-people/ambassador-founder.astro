---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Ambassador & Founder — Antonio G. Dattilo" description="Ambassador & Founder of IICC Mission — Antonio G. Dattilo: Their voice. Their hope. Their future. My mission.">

  <!-- Hero split -->
  <div class="hero-split" style="min-height:520px;">
    <div class="hero-split__text" style="background:#fff;gap:1.25rem;">
      <img src="/IICC_Logo.png" alt="IICC Mission" style="height:80px;width:auto;object-fit:contain;" />
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,4.5vw,3.25rem);font-weight:900;color:var(--color-navy);text-transform:uppercase;line-height:1.05;">
        Ambassador<br>&amp; Founder
      </h1>
      <p style="font-family:var(--font-heading);font-size:clamp(1.125rem,2.5vw,1.625rem);color:var(--color-amber);font-weight:700;line-height:1.2;">
        Antonio G. Dattilo
      </p>
      <span class="rule rule--amber"></span>
      <span class="heart">♥</span>
      <p style="font-family:var(--font-heading);font-size:1rem;color:var(--color-muted);font-style:italic;line-height:1.5;">
        Their voice. Their hope. Their future.<br>
        <span style="color:var(--color-amber);font-style:normal;font-weight:600;">My mission.</span>
      </p>
      <p class="section-desc" style="max-width:none;">
        I walk with inmates, detainees in immigration detention, and their families — bringing hope, speaking for the forgotten and building pathways to restoration.
      </p>
    </div>
    <div class="hero-split__photo" style="min-height:400px;">
      <img
        src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&h=700&fit=crop&crop=top"
        alt="Antonio G. Dattilo — Ambassador & Founder"
      />
      <div class="hero-split__quote" style="border-left-color:var(--color-amber);">
        <span class="hero-split__quote-mark">"</span>
        <p class="hero-split__quote-text">Prison didn't break me. It changed me. Now I'm here to change lives.</p>
        <span class="hero-split__quote-ref">— Lived Experience</span>
      </div>
    </div>
  </div>

  <!-- Called by God band -->
  <section style="background:var(--color-navy);padding-block:3rem;text-align:center;">
    <div class="wrap" style="max-width:760px;">
      <p style="font-family:var(--font-display);font-size:clamp(0.875rem,2vw,1.125rem);letter-spacing:0.15em;text-transform:uppercase;color:var(--color-amber);margin-bottom:0.75rem;">
        CALLED BY GOD. SHAPED BY EXPERIENCE. SENT ON MISSION.
      </p>
      <span class="rule rule--amber rule--center" style="margin-bottom:1.25rem;display:block;"></span>
      <p class="section-desc section-desc--white" style="text-align:center;margin-inline:auto;max-width:640px;">
        IICC Mission was born from lived experience, faith in God, and a deep love for those society often forgets. My journey through prison, transformation and purpose has given me a voice — and that voice belongs to every inmate, detainee and family searching for hope.
      </p>
    </div>
  </section>

  <!-- 3-col: My Story / My Commitment / What Drives Me -->
  <section class="section section--white">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:1fr;gap:2.5rem;" class="story-grid">

        <!-- My Story timeline -->
        <div>
          <h2 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">MY STORY</h2>
          <span class="rule rule--amber" style="margin-bottom:1.5rem;display:block;"></span>
          <div style="display:flex;flex-direction:column;gap:1.25rem;">
            {[
              { icon: '🏛', title: 'Time in Prison', desc: 'I spent time in prison where I experienced hardship, regret and the reality of being forgotten.' },
              { icon: '✝️', title: 'A Turning Point', desc: 'Through faith, prayer and the Gospel, I found hope, forgiveness and a new purpose.' },
              { icon: '🍞', title: '4 Years in the Prison Bakery', desc: 'I worked in the prison bakery for four years. I saw how creating something with your hands can restore dignity and self-worth.' },
              { icon: '🌟', title: 'A Mission is Born', desc: 'IICC Mission was born to bring hope, support and practical help to inmates, detainees and their families.' },
              { icon: '📢', title: 'Ambassador for the Forgotten', desc: 'Today, I stand as their voice — an Ambassador for those who feel unseen, unheard and without hope.' },
            ].map(s => (
              <div style="display:flex;align-items:flex-start;gap:1rem;">
                <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:var(--color-navy-dark);border:1px solid rgba(224,123,0,0.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1rem;">
                  {s.icon}
                </div>
                <div>
                  <p style="font-weight:700;font-size:0.875rem;color:var(--color-navy);margin-bottom:0.25rem;">{s.title}</p>
                  <p style="font-size:0.8125rem;color:var(--color-muted);line-height:1.6;">{s.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- My Commitment checklist -->
        <div>
          <h2 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">MY COMMITMENT</h2>
          <span class="rule rule--amber" style="margin-bottom:1.5rem;display:block;"></span>
          <ul class="checklist" style="margin-bottom:1.5rem;">
            <li><span><strong>I walk with inmates</strong> and detainees, listening with compassion and speaking with truth.</span></li>
            <li><span><strong>I bring hope through the Gospel</strong>, reminding them they are loved and never forgotten by God.</span></li>
            <li><span><strong>I advocate for dignity, justice</strong> and fair treatment for all.</span></li>
            <li><span><strong>I support families</strong> who carry the pain and burden of their loved ones' imprisonment or detention.</span></li>
            <li><span><strong>I build programs</strong> that restore lives — through spiritual care, education, skills training, legal referrals and community.</span></li>
            <li><span><strong>I empower former inmates</strong> to give back to society and become leaders of change.</span></li>
          </ul>
          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">During my time in prison, I wasn't alone. I had God and the power of the Gospel guiding me.</p>
          </div>
        </div>

        <!-- What Drives Me -->
        <div>
          <h2 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">WHAT DRIVES ME</h2>
          <span class="rule rule--amber" style="margin-bottom:1.5rem;display:block;"></span>
          <div style="display:flex;flex-direction:column;gap:1rem;">
            {[
              { icon: '✝️', title: 'Faith in God', desc: 'Everything begins and ends with Him.' },
              { icon: '♥', title: 'Love for People', desc: 'Every person has value, purpose and a future.' },
              { icon: '⚖️', title: 'Justice & Mercy', desc: 'I believe in second chances and fair treatment for all.' },
              { icon: '🌅', title: 'Hope for Tomorrow', desc: 'No one is beyond hope. No life is beyond change.' },
            ].map(d => (
              <div style="display:flex;align-items:flex-start;gap:1rem;padding:1rem;background:var(--color-off-white);border-radius:2px;">
                <div style="width:2.75rem;height:2.75rem;border-radius:50%;background:var(--color-navy-dark);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.125rem;">
                  {d.icon}
                </div>
                <div>
                  <p style="font-weight:700;font-size:0.875rem;color:var(--color-navy);margin-bottom:0.125rem;">{d.title}</p>
                  <p style="font-size:0.8125rem;color:var(--color-muted);line-height:1.5;">{d.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- I can tour prisons / Recognition -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:start;">
        <div style="display:flex;gap:1.5rem;align-items:flex-start;flex-wrap:wrap;">
          <img
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=280&h=340&fit=crop&crop=top"
            alt="Antonio G. Dattilo"
            style="width:200px;height:260px;object-fit:cover;border-radius:2px;flex-shrink:0;"
          />
          <div>
            <span class="eyebrow" style="margin-bottom:0.5rem;display:block;">Available to Visit</span>
            <h2 style="font-family:var(--font-display);font-size:clamp(1.125rem,2.5vw,1.5rem);letter-spacing:0.08em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">
              I CAN TOUR PRISONS AND DETENTION CENTRES
            </h2>
            <span class="rule rule--amber" style="margin-bottom:1rem;display:block;"></span>
            <p class="section-desc" style="max-width:none;margin-bottom:1.5rem;">
              I am available to visit prisons and immigration detention centres to share talks, offer hope and be a voice of encouragement to inmates, detainees and their families.
            </p>
            <a href="/contact" class="btn btn--amber">REQUEST A VISIT OR TALK →</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">RECOGNITION &amp; SUPPORT</h2>
          <span class="rule rule--amber" style="margin-bottom:1.5rem;display:block;"></span>
          <div style="display:flex;flex-direction:column;gap:1.25rem;">
            {[
              { name: 'Cardinal George Pell', role: '', desc: 'Encouraged the development of IICC Mission and continues to support our mission of hope, justice and restoration.', img: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop&crop=top' },
              { name: 'Archbishop Peter Comensoli', role: '', desc: 'The first to acknowledge and approve the IICC Mission project and continues to guide and support our work.', img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop&crop=top', href: '/our-people/peter-comensoli' },
            ].map(p => (
              <div style="display:flex;align-items:flex-start;gap:1rem;background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:1rem;">
                <img src={p.img} alt={p.name} style="width:3.5rem;height:3.5rem;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(224,123,0,0.25);" />
                <div>
                  <p style="font-weight:700;font-size:0.9375rem;color:var(--color-navy);margin-bottom:0.25rem;">{p.name}</p>
                  <p style="font-size:0.8125rem;color:var(--color-muted);line-height:1.6;">{p.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <div style="background:var(--color-navy-dark);padding-block:3.5rem;">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:center;">
        <div>
          <span class="heart" style="font-size:1.25rem;display:block;margin-bottom:0.75rem;">♥</span>
          <h2 style="font-family:var(--font-display);font-size:clamp(1.125rem,2.5vw,1.625rem);letter-spacing:0.08em;text-transform:uppercase;color:#fff;margin-bottom:0.75rem;">BE PART OF THIS MISSION</h2>
          <p style="font-size:0.9375rem;color:rgba(255,255,255,0.7);margin-bottom:1.5rem;line-height:1.65;">
            Together, we can bring hope, restore dignity and build a future filled with faith and possibility.
          </p>
          <a href="/get-involved" class="btn btn--amber">JOIN THE MISSION →</a>
        </div>
        <div class="quote-box" style="border-left-color:var(--color-amber);">
          <span class="quote-box__mark">"</span>
          <p class="quote-box__text">For I was hungry and you gave me something to eat, I was thirsty and you gave me something to drink, I was a stranger and you invited me in.</p>
          <span class="quote-box__ref">— Matthew 25:35</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Value strip -->
  <div class="value-strip">
    <div class="wrap">
      <div class="value-strip__inner">
        <div class="value-strip__item"><span class="value-strip__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span><p class="value-strip__title">You Are Not Alone</p><p class="value-strip__desc">We stand with you and your family.</p></div>
        <div class="value-strip__item"><span class="value-strip__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg></span><p class="value-strip__title">We Listen</p><p class="value-strip__desc">Your story matters. We are here to listen.</p></div>
        <div class="value-strip__item"><span class="value-strip__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><p class="value-strip__title">We Guide</p><p class="value-strip__desc">We help you understand your rights and options.</p></div>
        <div class="value-strip__item"><span class="value-strip__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span><p class="value-strip__title">We Connect</p><p class="value-strip__desc">We refer you to trusted services and professionals.</p></div>
        <div class="value-strip__item"><span class="value-strip__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402C1 3.499 3.8 2 6 2c1.2 0 4.5.5 6 4.5C13.5 2.5 16.8 2 18 2c2.2 0 5 1.5 5 5.19 0 4.069-5.373 8.863-11 14.403z"/></svg></span><p class="value-strip__title">We Hope</p><p class="value-strip__desc">We believe in healing, justice, and new beginnings.</p></div>
      </div>
    </div>
  </div>

</Layout>

<style>
  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr 1.2fr 1fr !important;
    }
  }
</style>
