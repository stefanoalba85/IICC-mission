---
import Layout from '../layouts/Layout.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Get Involved"
  description="JOIN THE MISSION — Become Part Of The Movement Of Hope. There are many ways to get involved with IICC Mission."
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1200&fit=crop&q=80"
        alt="People together"
        loading="eager"
      />
      <div class="page-hero-overlay"></div>
    </div>
    <div class="page-hero-content">
      <p class="section-label" style="margin-bottom:0.875rem">Join The Mission</p>
      <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
      <h1 class="page-hero-title">Become Part Of The Movement Of Hope.</h1>
      <p class="page-hero-subtitle">
        Together we bring hope. Together we restore lives. Together we build a better future.
      </p>
      <a href="#ways-to-help" class="btn-primary">JOIN US. MAKE A DIFFERENCE. →</a>
    </div>
  </section>

  <!-- SECTION 1 — WAYS TO GET INVOLVED -->
  <section class="section-standard" id="ways-to-help">
    <div class="container">
      <div class="section-header">
        <p class="section-label">THERE ARE MANY WAYS TO GET INVOLVED</p>
        <div class="gold-rule" style="margin:0.75rem auto 1.25rem"></div>
        <p class="section-header-desc">Your time, your voice and your support can change lives.</p>
      </div>

      <div class="involvement-grid">

        <!-- AMBASSADORS -->
        <div class="involve-card card-hover">
          <div class="involve-card-header">
            <span class="involve-card-icon">📣</span>
            <div>
              <h3 class="involve-card-title">AMBASSADORS</h3>
              <p class="involve-card-subtitle">Be a voice of hope.</p>
            </div>
          </div>
          <p class="involve-card-desc">
            Ambassadors help raise awareness, inspire others and support the mission in their communities and networks.
          </p>
          <ul class="involve-list">
            <li>Spread awareness</li>
            <li>Represent the mission</li>
            <li>Lead with compassion</li>
            <li>Create impact</li>
          </ul>
          <a href="/contact" class="btn-primary involve-card-cta">BECOME AN AMBASSADOR →</a>
        </div>

        <!-- VOLUNTEERS -->
        <div class="involve-card card-hover">
          <div class="involve-card-header">
            <span class="involve-card-icon">🤝</span>
            <div>
              <h3 class="involve-card-title">VOLUNTEERS</h3>
              <p class="involve-card-subtitle">Give your time. Change a life.</p>
            </div>
          </div>
          <p class="involve-card-desc">
            Volunteers are the heart of our mission. Your time and skills help us accompany and serve those in need.
          </p>
          <ul class="involve-list">
            <li>Community support</li>
            <li>Events &amp; outreach</li>
            <li>Administration</li>
            <li>Projects &amp; programs</li>
          </ul>
          <a href="/contact" class="btn-primary involve-card-cta">VOLUNTEER WITH US →</a>
        </div>

        <!-- PRAYER SUPPORTERS -->
        <div class="involve-card card-hover">
          <div class="involve-card-header">
            <span class="involve-card-icon">🙏</span>
            <div>
              <h3 class="involve-card-title">PRAYER SUPPORTERS</h3>
              <p class="involve-card-subtitle">Pray. Believe. Make a difference.</p>
            </div>
          </div>
          <p class="involve-card-desc">
            Prayer brings strength, healing and hope. Join our community of prayer supporters lifting up individuals, families and the mission.
          </p>
          <ul class="involve-list">
            <li>Daily prayers</li>
            <li>Prayer requests</li>
            <li>Faith community</li>
            <li>Spiritual support</li>
          </ul>
          <a href="/faith-hope#prayer" class="btn-primary involve-card-cta">JOIN IN PRAYER →</a>
        </div>

        <!-- PARTNERS & DONORS -->
        <div class="involve-card card-hover">
          <div class="involve-card-header">
            <span class="involve-card-icon">💛</span>
            <div>
              <h3 class="involve-card-title">PARTNERS &amp; DONORS</h3>
              <p class="involve-card-subtitle">Partner with purpose.</p>
            </div>
          </div>
          <p class="involve-card-desc">
            Your partnership helps us continue vital programs, projects and advocacy that restore dignity and bring hope.
          </p>
          <ul class="involve-list">
            <li>Financial support</li>
            <li>In-kind donations</li>
            <li>Corporate partnership</li>
            <li>Mission sponsorship</li>
          </ul>
          <a href="/sponsors-supporters" class="btn-primary involve-card-cta">BECOME A PARTNER →</a>
        </div>

        <!-- MISSION COMMUNITY -->
        <div class="involve-card involve-card--wide card-hover">
          <div class="involve-card-header">
            <span class="involve-card-icon">🌍</span>
            <div>
              <h3 class="involve-card-title">MISSION COMMUNITY</h3>
              <p class="involve-card-subtitle">Belong. Connect. Grow.</p>
            </div>
          </div>
          <p class="involve-card-desc">
            Join a global community of people who share faith, compassion and a desire to make a difference.
          </p>
          <ul class="involve-list involve-list--horizontal">
            <li>Mission updates</li>
            <li>Resources</li>
            <li>Special events</li>
            <li>Global connection</li>
          </ul>
          <a href="/contact" class="btn-primary involve-card-cta">JOIN THE COMMUNITY →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 2 — SHARE YOUR STORY -->
  <section class="section-standard-offwhite story-section">
    <div class="container">
      <div class="two-col two-col--60-40">

        <div class="story-text-col">
          <p class="section-label">SHARE YOUR STORY</p>
          <div class="gold-rule-left" style="margin:0.75rem 0 1.25rem"></div>
          <h2 class="story-heading">Your story can bring hope to others.</h2>
          <p class="story-body">
            Every story of struggle, courage and restoration can inspire someone on their journey.
          </p>
          <ul class="story-checklist">
            <li>Your experience matters</li>
            <li>Your voice has power</li>
            <li>Your story brings hope</li>
          </ul>
          <a href="mailto:info@iiccmission.org?subject=My Story" class="btn-primary" style="margin-top:1.75rem;display:inline-block">
            SHARE YOUR STORY →
          </a>
          <div class="story-pull-quote">
            <div class="story-pull-quote-mark">&ldquo;</div>
            <blockquote class="story-pull-quote-text">
              I was in prison and felt forgotten. Today I have hope, purpose and a new beginning.
            </blockquote>
            <cite class="story-pull-quote-ref">— A Story Of Transformation</cite>
          </div>
        </div>

        <div class="story-img-col">
          <img
            src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=600&fit=crop&q=80"
            loading="lazy"
            alt="Share your story"
            class="story-img"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 3 — TOGETHER WE CREATE LASTING CHANGE -->
  <section class="section-standard-dark">
    <div class="container">
      <div class="section-header">
        <p class="section-label">OUR COLLECTIVE IMPACT</p>
        <div class="gold-rule" style="margin:0.75rem auto 1.25rem"></div>
        <h2 class="section-header-title section-header-title--white">TOGETHER, WE CREATE LASTING CHANGE</h2>
      </div>

      <div class="card-grid-3">
        <div class="info-card info-card--dark card-hover">
          <span class="info-card-icon">🤝</span>
          <h3 class="info-card-title">ACCOMPANY</h3>
          <p class="info-card-desc">We walk with people in their journey.</p>
        </div>
        <div class="info-card info-card--dark card-hover">
          <span class="info-card-icon">💪</span>
          <h3 class="info-card-title">EMPOWER</h3>
          <p class="info-card-desc">We equip people with dignity and hope.</p>
        </div>
        <div class="info-card info-card--dark card-hover">
          <span class="info-card-icon">🌱</span>
          <h3 class="info-card-title">RESTORE</h3>
          <p class="info-card-desc">We support healing, rebuilding and renewal.</p>
        </div>
        <div class="info-card info-card--dark card-hover">
          <span class="info-card-icon">📣</span>
          <h3 class="info-card-title">ADVOCATE</h3>
          <p class="info-card-desc">We give a voice to those unheard.</p>
        </div>
        <div class="info-card info-card--dark card-hover">
          <span class="info-card-icon">🌍</span>
          <h3 class="info-card-title">CONNECT</h3>
          <p class="info-card-desc">We build bridges and stronger communities.</p>
        </div>
        <div class="info-card info-card--dark card-hover">
          <span class="info-card-icon">✨</span>
          <h3 class="info-card-title">INSPIRE</h3>
          <p class="info-card-desc">We inspire enterprises that changes lives.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <QuoteBand
    quote="When we reach out in compassion, we touch the face of Christ."
    dark={true}
  />

  <!-- CTA SECTION -->
  <CTASection
    dark={true}
    eyebrow="Be Part of Something Greater"
    headline="Your Involvement Today Can Change a Life Forever"
    buttons={[
      { label: 'Become An Ambassador', href: '/contact', primary: true },
      { label: 'Volunteer With Us', href: '/contact', primary: false },
      { label: 'Support The Mission', href: '/donate', primary: false },
    ]}
  />

</Layout>

<style>
  /* =============================================
     SECTION 1: INVOLVEMENT GRID
  ============================================= */
  .involvement-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  @media (min-width: 640px) {
    .involvement-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .involvement-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .involve-card {
    background: white;
    border: 1px solid rgba(27, 39, 81, 0.08);
    border-top: 3px solid var(--color-gold);
    padding: 2rem 1.75rem;
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* The 5th card spans full width on desktop */
  .involve-card--wide {
    grid-column: 1 / -1;
  }

  .involve-card-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .involve-card-icon {
    font-size: 2.25rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .involve-card-title {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--color-navy);
    margin: 0 0 0.25rem;
    text-transform: uppercase;
  }

  .involve-card-subtitle {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-gold-dark);
    margin: 0;
  }

  .involve-card-desc {
    font-size: 0.9375rem;
    color: #4a4a5a;
    line-height: 1.75;
    margin: 0;
    flex: 1;
  }

  .involve-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .involve-list li {
    font-size: 0.875rem;
    color: var(--color-navy);
    font-weight: 600;
    padding-left: 1.375rem;
    position: relative;
  }

  .involve-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-weight: 700;
    font-size: 0.8125rem;
  }

  /* Horizontal list layout for the wide card */
  .involve-list--horizontal {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.375rem 2rem;
  }

  .involve-card-cta {
    margin-top: 0.5rem;
    align-self: flex-start;
    white-space: nowrap;
  }

  /* =============================================
     SECTION 2: SHARE YOUR STORY
  ============================================= */
  .story-section {
    background-color: #f5f1e8;
  }

  .story-text-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .story-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-navy);
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .story-body {
    font-size: 1.0625rem;
    color: #4a4a5a;
    line-height: 1.8;
    margin: 0 0 1.25rem;
  }

  .story-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .story-checklist li {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-navy);
    padding-left: 1.5rem;
    position: relative;
  }

  .story-checklist li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-weight: 700;
  }

  .story-pull-quote {
    position: relative;
    background: var(--color-navy);
    border-left: 3px solid var(--color-gold);
    padding: 1.75rem 1.5rem 1.5rem;
    border-radius: 2px;
    margin-top: 2rem;
  }

  .story-pull-quote-mark {
    font-family: var(--font-heading);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-gold);
    opacity: 0.3;
    position: absolute;
    top: 0.375rem;
    left: 1rem;
    user-select: none;
    pointer-events: none;
  }

  .story-pull-quote-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    color: white;
    line-height: 1.7;
    margin: 0 0 0.875rem;
    position: relative;
  }

  .story-pull-quote-ref {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--color-gold);
    display: block;
  }

  .story-img-col {
    border-radius: 2px;
    overflow: hidden;
  }

  .story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 360px;
    display: block;
  }

  @media (max-width: 767px) {
    .story-img { min-height: 280px; }
    .involve-card--wide { grid-column: 1; }
    .involve-list--horizontal { flex-direction: column; gap: 0.375rem; }
  }
</style>
