---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Get Involved — IICC Mission" description="Volunteer, partner, advocate or pray — there are many ways to join the IICC Mission family.">

  <!-- Hero split -->
  <div class="hero-split" style="min-height:500px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">Join Our Mission Family</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(2rem,5vw,3.5rem);">GET</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(2rem,5vw,3.5rem);">INVOLVED</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2.5vw,1.25rem);color:rgba(255,255,255,0.85);line-height:1.6;">
        Every act of love changes the world. You have a role to play.
      </p>
      <a href="#ways" class="btn btn--amber">FIND YOUR WAY TO HELP ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:320px;position:relative;">
      <img
        src="https://images.unsplash.com/photo-1531206715517-5c0ba140b2b7?w=800&h=600&fit=crop"
        alt="Volunteers together in community"
      />
      <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(18,26,56,0.85));padding:2rem 1.5rem 1.5rem;">
        <p style="font-family:var(--font-heading);font-size:0.9375rem;color:rgba(255,255,255,0.9);font-style:italic;line-height:1.55;">"Each of you should use whatever gift you have received to serve others." — 1 Peter 4:10</p>
      </div>
    </div>
  </div>

  <!-- Ways to get involved -->
  <section id="ways" class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow">How to Help</span>
        <span class="heart">♥</span>
        <h2 class="section-title">WAYS TO MAKE A DIFFERENCE</h2>
        <span class="rule rule--amber rule--center"></span>
        <p class="section-desc" style="text-align:center;margin-inline:auto;margin-top:0.5rem;">
          Whether you have time, talents, financial resources or a heart for prayer — there is a place for you in this mission.
        </p>
      </div>

      <div class="grid-3" style="margin-bottom:2rem;">
        {[
          {
            icon: '🤝',
            title: 'Volunteer',
            desc: 'Give your time and skills to serve alongside our team in prisons, detention centres, soup kitchens and community events.',
            cta: 'APPLY TO VOLUNTEER',
            href: '/contact',
          },
          {
            icon: '🙏',
            title: 'Pray With Us',
            desc: 'Join our prayer community and intercede for the people we serve, our teams, and the transformation of broken systems.',
            cta: 'JOIN PRAYER COMMUNITY',
            href: '/prayer',
          },
          {
            icon: '♥',
            title: 'Donate',
            desc: 'Your financial gift fuels our ministry and brings hope, dignity and justice to those who need it most.',
            cta: 'GIVE TODAY',
            href: '/donate',
          },
          {
            icon: '📣',
            title: 'Advocate',
            desc: 'Raise your voice for justice. Share our stories, sign petitions and stand up for systemic reform.',
            cta: 'JOIN ADVOCACY',
            href: '/advocacy',
          },
          {
            icon: '🏢',
            title: 'Partner With Us',
            desc: 'Is your church, business or organisation ready to become a Hope Partner? Let\'s build something together.',
            cta: 'BECOME A PARTNER',
            href: '/contact',
          },
          {
            icon: '📢',
            title: 'Spread the Word',
            desc: 'Share our mission on social media, at your church or in your workplace. Every conversation starts a movement.',
            cta: 'SHARE THE MISSION',
            href: '/contact',
          },
        ].map(c => (
          <div class="card" style="align-items:center;text-align:center;">
            <div class="card__icon card__icon--filled" style="font-size:1.125rem;">{c.icon}</div>
            <p class="card__title">{c.title}</p>
            <p class="card__body" style="flex:1;">{c.desc}</p>
            <a href={c.href} class="btn btn--amber" style="font-size:0.75rem;padding:0.5rem 1.25rem;margin-top:auto;">{c.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Volunteer signup section -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-60-40" style="gap:3rem;align-items:start;">

        <!-- Form -->
        <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:2rem 2rem 2.5rem;">
          <h2 style="font-family:var(--font-display);font-size:0.875rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">REGISTER YOUR INTEREST</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>
          <p style="font-size:0.875rem;color:var(--color-muted);margin-bottom:1.5rem;line-height:1.65;">
            Fill in this form and our team will be in touch to discuss how you can best serve with IICC Mission.
          </p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;" class="gi-grid-2">
            <div class="form-field">
              <label for="gi-first">First Name <span class="required">*</span></label>
              <input type="text" id="gi-first" name="first_name" class="form-input" placeholder="First name" required />
            </div>
            <div class="form-field">
              <label for="gi-last">Last Name <span class="required">*</span></label>
              <input type="text" id="gi-last" name="last_name" class="form-input" placeholder="Last name" required />
            </div>
          </div>
          <div class="form-field" style="margin-bottom:1.25rem;">
            <label for="gi-email">Email Address <span class="required">*</span></label>
            <input type="email" id="gi-email" name="email" class="form-input" placeholder="your@email.com" required />
          </div>
          <div class="form-field" style="margin-bottom:1.25rem;">
            <label for="gi-phone">Phone Number</label>
            <input type="tel" id="gi-phone" name="phone" class="form-input" placeholder="+61 4XX XXX XXX" />
          </div>
          <div class="form-field" style="margin-bottom:1.25rem;">
            <label for="gi-area">How would you like to help? <span class="required">*</span></label>
            <select id="gi-area" name="area" class="form-input" required>
              <option value="" disabled selected>Select an area…</option>
              <option>Volunteer — Prison Ministry</option>
              <option>Volunteer — Immigration Detention</option>
              <option>Volunteer — Francis Bakery</option>
              <option>Volunteer — Events & Administration</option>
              <option>Prayer Warrior</option>
              <option>Community Partnership</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-field" style="margin-bottom:1.5rem;">
            <label for="gi-msg">Tell us a little about yourself</label>
            <textarea id="gi-msg" name="message" class="form-input form-input--textarea" placeholder="Your experience, motivation, availability…" style="min-height:7rem;"></textarea>
          </div>
          <button type="submit" class="btn btn--amber" style="width:100%;justify-content:center;">
            SUBMIT INTEREST ›
          </button>
        </div>

        <!-- Info -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div>
            <h3 style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">WHAT TO EXPECT</h3>
            <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
            <div style="display:flex;flex-direction:column;gap:1rem;">
              {[
                { n: '1', title: 'Submit your interest', desc: 'Fill in the form and tell us how you\'d like to help.' },
                { n: '2', title: 'We\'ll be in touch', desc: 'Our team will contact you within 3–5 business days.' },
                { n: '3', title: 'Orientation & training', desc: 'We\'ll walk you through everything you need to know.' },
                { n: '4', title: 'Start serving', desc: 'Join the mission and start making a real difference.' },
              ].map(s => (
                <div style="display:flex;align-items:flex-start;gap:0.875rem;">
                  <div style="width:1.875rem;height:1.875rem;border-radius:50%;background:var(--color-amber);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.75rem;font-weight:800;color:#fff;">{s.n}</div>
                  <div>
                    <p style="font-weight:700;font-size:0.875rem;color:var(--color-navy);margin-bottom:0.125rem;">{s.title}</p>
                    <p style="font-size:0.8125rem;color:var(--color-muted);line-height:1.55;">{s.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">The harvest is plentiful but the workers are few. Ask the Lord of the harvest, therefore, to send out workers into his harvest field.</p>
            <span class="quote-box__ref">— Matthew 9:37–38</span>
          </div>

          <div style="background:var(--color-navy-dark);border-radius:2px;padding:1.5rem;">
            <p style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-amber);margin-bottom:0.5rem;">QUESTIONS?</p>
            <p style="font-size:0.875rem;color:rgba(255,255,255,0.85);line-height:1.65;margin-bottom:0.75rem;">Contact us directly and we'll help you find your place in the mission.</p>
            <a href="mailto:info@iiccmission.org" style="font-size:0.875rem;color:#fff;font-weight:600;">info@iiccmission.org</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Value strip -->
  <div class="value-strip">
    {['Volunteer', 'Pray', 'Give', 'Advocate', 'Partner', 'Share'].map(v => (
      <span class="value-strip__item">{v}</span>
    ))}
  </div>

</Layout>

<style>
  @media (max-width: 540px) {
    .gi-grid-2 { grid-template-columns: 1fr !important; }
  }
</style>
