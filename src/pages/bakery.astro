---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Francis Bakery — Feed the Homeless" description="Francis Bakery — Because no one should be hungry. Because every person is precious. We bake with love. We serve with dignity.">

  <!-- Hero split -->
  <div class="hero-split" style="min-height:520px;">
    <div class="hero-split__text" style="background:#fff;gap:1rem;">
      <img src="/IICC_Logo.png" alt="IICC Mission" style="height:80px;width:auto;object-fit:contain;" />
      <div>
        <p style="font-family:var(--font-display);font-size:0.6875rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-amber);margin-bottom:0.25rem;">FRANCIS BAKERY</p>
        <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);font-weight:900;color:var(--color-navy);text-transform:uppercase;line-height:1.05;">
          FEED THE<br><span style="color:var(--color-amber);">HOMELESS</span>
        </h1>
      </div>
      <span class="rule rule--amber"></span>
      <span class="heart">♥</span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2vw,1.25rem);color:var(--color-navy);line-height:1.5;">
        Because no one should be hungry.<br>Because <span style="color:var(--color-amber);">every person is precious.</span>
      </p>
      <p class="section-desc" style="max-width:none;">
        Through the Francis Bakery, we provide fresh bread and baked goods to the homeless, soup kitchens, shelters and community organisations every single day.
      </p>
      <p style="font-family:var(--font-heading);font-weight:700;color:var(--color-navy);font-size:0.9375rem;">We bake with love. We serve with dignity.</p>
    </div>
    <div class="hero-split__photo" style="min-height:360px;">
      <img
        src="https://images.unsplash.com/photo-1509440159596-0249088772ff?w=800&h=700&fit=crop"
        alt="Baker sharing fresh bread with those in need"
      />
      <div class="hero-split__quote">
        <span class="hero-split__quote-mark">"</span>
        <p class="hero-split__quote-text">When we feed the hungry, we feed more than the body. We feed hope. We feed dignity. We feed love.</p>
        <span class="hero-split__quote-ref">— Founder</span>
      </div>
    </div>
  </div>

  <!-- How We Help — 6 icons, white -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow">What We Do</span>
        <span class="heart">♥</span>
        <h2 class="section-title">HOW WE HELP</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="pillars" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr));">
        {[
          { icon: '🍞', label: 'Fresh Bread Daily', desc: 'We produce and donate fresh bread and baked goods every day.' },
          { icon: '🍲', label: 'Soup Kitchens', desc: 'We partner with soup kitchens to provide meals to those in need.' },
          { icon: '🏠', label: 'Shelters & Missions', desc: 'We supply shelters, missions and outreach programs with nutritious food.' },
          { icon: '♥', label: 'Made with Dignity', desc: 'Every item is made with care by our team of trainee bakers.' },
          { icon: '🙏', label: 'Built on Compassion', desc: 'We serve all people regardless of background, belief or situation.' },
          { icon: '🤝', label: 'Community Partners', desc: 'Working together with local organisations to reach more people in need.' },
        ].map(h => (
          <div class="pillar">
            <div class="pillar__icon-wrap" style="font-size:1.25rem;">{h.icon}</div>
            <p class="pillar__label">{h.label}</p>
            <p class="pillar__desc">{h.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- More Than Bread / Hunger Is Real / Bread of Hope — 3-col -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:1fr;gap:1.5rem;" class="bakery-3col">

        <!-- More Than Bread -->
        <div style="background:var(--color-navy-dark);border-radius:2px;overflow:hidden;">
          <img
            src="https://images.unsplash.com/photo-1549931319-a545dcf3bc73?w=600&h=220&fit=crop"
            alt="Fresh bread"
            style="width:100%;height:160px;object-fit:cover;"
          />
          <div style="padding:1.5rem;">
            <h3 style="font-family:var(--font-display);font-size:0.875rem;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:0.25rem;">MORE THAN BREAD</h3>
            <p style="color:var(--color-amber);font-weight:700;font-size:0.875rem;margin-bottom:1rem;">We give hope.</p>
            <p style="font-size:0.875rem;color:rgba(255,255,255,0.7);margin-bottom:1rem;line-height:1.65;">A warm loaf of bread can bring comfort, but a kind heart can bring change.</p>
            <ul class="checklist checklist--white">
              <li>Restores dignity and self-worth</li>
              <li>Shows that someone cares</li>
              <li>Builds connections and community</li>
              <li>Opens doors to support and hope</li>
              <li>Creates a pathway to a better future</li>
            </ul>
            <p style="margin-top:1rem;font-size:0.875rem;color:var(--color-amber);font-weight:700;">Together, we can make a difference.</p>
          </div>
        </div>

        <!-- Hunger Is Real -->
        <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-radius:2px;padding:1.5rem;">
          <h3 style="font-family:var(--font-display);font-size:0.875rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-navy);margin-bottom:0.5rem;">HUNGER IS REAL</h3>
          <span class="rule rule--amber" style="margin-bottom:1.25rem;display:block;"></span>
          <div style="display:flex;flex-direction:column;gap:1rem;">
            {[
              { icon: '👥', stat: 'Over 800 million people worldwide are hungry.' },
              { icon: '📊', stat: '1 in 5 Australians have experienced food insecurity.' },
              { icon: '🏙️', stat: 'Thousands sleep rough every night in our cities.' },
              { icon: '🍽️', stat: 'Simple acts of kindness create lasting change.' },
            ].map(f => (
              <div style="display:flex;align-items:flex-start;gap:0.875rem;">
                <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:rgba(224,123,0,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1rem;">{f.icon}</div>
                <p style="font-size:0.875rem;color:var(--color-muted);line-height:1.6;margin-top:0.25rem;">{f.stat}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Bread of Hope -->
        <div style="background:var(--color-navy);border-radius:2px;overflow:hidden;">
          <img
            src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&h=200&fit=crop"
            alt="Bakery team"
            style="width:100%;height:140px;object-fit:cover;"
          />
          <div style="padding:1.5rem;">
            <h3 style="font-family:var(--font-display);font-size:0.875rem;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:0.25rem;">BREAD OF HOPE</h3>
            <p style="color:var(--color-amber);font-weight:700;font-size:0.875rem;margin-bottom:0.75rem;">Made by hands. Given with love.</p>
            <p style="font-size:0.875rem;color:rgba(255,255,255,0.75);margin-bottom:1rem;line-height:1.65;">
              Our former inmates and trainees bake bread that feeds the hungry and builds their own future.
            </p>
            <p style="font-family:var(--font-heading);font-weight:700;color:#fff;font-size:1rem;margin-bottom:0.5rem;">Every loaf is a step toward restoration.</p>
            <span style="color:var(--color-amber);font-size:1.5rem;">🍞♥</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Stats band -->
  <div class="stat-band">
    <div class="wrap">
      <div style="text-align:center;margin-bottom:2rem;">
        <h2 style="font-family:var(--font-display);font-size:clamp(1rem,2vw,1.25rem);letter-spacing:0.15em;text-transform:uppercase;color:#fff;">THE IMPACT TOGETHER</h2>
        <span class="rule rule--amber rule--center" style="margin-top:0.75rem;display:block;"></span>
      </div>
      <div class="stat-band__inner" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));">
        <div class="stat-band__item"><span class="stat-band__icon">🍞</span><p class="stat-band__num">10,000+</p><p class="stat-band__label">Loaves of bread donated each month</p></div>
        <div class="stat-band__item"><span class="stat-band__icon">👥</span><p class="stat-band__num">5,000+</p><p class="stat-band__label">People and families fed every month</p></div>
        <div class="stat-band__item"><span class="stat-band__icon">🏠</span><p class="stat-band__num">50+</p><p class="stat-band__label">Soup kitchens, shelters and charities supported</p></div>
        <div class="stat-band__item"><span class="stat-band__icon">♥</span><p class="stat-band__num">100%</p><p class="stat-band__label">Donations go directly to feeding the hungry</p></div>
        <div class="stat-band__item"><span class="stat-band__icon">🤝</span><p class="stat-band__num">Countless</p><p class="stat-band__label">Lives touched with dignity and hope</p></div>
      </div>
    </div>
  </div>

  <!-- You Can Help Feed the Hungry -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Get Involved</span>
        <h2 class="section-title">YOU CAN HELP FEED THE HUNGRY</h2>
        <span class="rule rule--amber rule--center"></span>
        <p class="section-desc" style="text-align:center;margin-inline:auto;margin-top:0.5rem;">Your support helps us bake bread and bring hope to those who need it most.</p>
      </div>
      <div class="grid-4">
        {[
          { icon: '♥', title: 'Donate Now', desc: 'Help us bake more bread and feed more people.', btn: 'DONATE', href: '/donate' },
          { icon: '🌐', title: 'Support on GoFundMe', desc: 'Fund our bread program and outreach.', btn: 'SUPPORT', href: '/donate' },
          { icon: '👐', title: 'Volunteer With Us', desc: 'Join our bakery team or outreach program.', btn: 'VOLUNTEER', href: '/get-involved' },
          { icon: '📢', title: 'Share This Mission', desc: 'Share our mission and inspire others.', btn: 'SHARE', href: '/get-involved' },
        ].map(c => (
          <div class="card" style="text-align:center;align-items:center;">
            <div class="card__icon card__icon--filled" style="font-size:1.125rem;">{c.icon}</div>
            <p class="card__title">{c.title}</p>
            <p class="card__body">{c.desc}</p>
            <a href={c.href} class="btn btn--amber" style="margin-top:0.5rem;font-size:0.75rem;padding:0.5rem 1.25rem;">{c.btn}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mother Teresa quote / amber CTA -->
  <div style="background:var(--color-off-white);border-top:1px solid rgba(27,39,81,0.07);padding-block:3.5rem;">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:center;">
        <div style="display:flex;align-items:flex-start;gap:1rem;">
          <div style="width:3rem;height:3rem;border-radius:50%;background:var(--color-amber);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-size:1.125rem;">♥</div>
          <div>
            <p style="font-family:var(--font-heading);font-size:1.0625rem;color:var(--color-navy);font-weight:700;margin-bottom:0.25rem;">A small act of kindness can change someone's day.</p>
            <p style="font-family:var(--font-heading);font-size:1.0625rem;color:var(--color-navy);">Together, we can change lives.</p>
          </div>
        </div>
        <div>
          <span style="color:var(--color-amber);font-size:2rem;line-height:0.75;display:block;">"</span>
          <p style="font-family:var(--font-heading);font-style:italic;font-size:clamp(1rem,2vw,1.25rem);color:var(--color-navy);line-height:1.65;margin-bottom:0.75rem;">
            If you can't feed a hundred people, then feed just one.
          </p>
          <p style="font-size:0.875rem;font-weight:700;color:var(--color-amber);">— Mother Teresa</p>
        </div>
      </div>
    </div>
  </div>

</Layout>

<style>
  @media (min-width: 900px) {
    .bakery-3col { grid-template-columns: 1fr 1fr 1fr !important; }
  }
</style>
