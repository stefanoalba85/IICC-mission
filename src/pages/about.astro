---
import Layout from '../layouts/Layout.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="About Us"
  description="Learn about IICC Mission — a Catholic international charity born from lived experience, dedicated to restoring hope, dignity and justice to prisoners, families and communities worldwide."
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1552832230-c0197dd311b5?w=1200&fit=crop&q=80"
        alt="St. Peter's Square, Vatican City"
        loading="eager"
      />
      <div class="page-hero-overlay"></div>
    </div>
    <div class="page-hero-content">
      <p class="section-label" style="margin-bottom:0.875rem">About IICC Mission</p>
      <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
      <h1 class="page-hero-title">A Mission Born From Lived Experience. A Mission Dedicated To Restoring Hope.</h1>
      <a href="/mission" class="learn-more-link" style="color:var(--color-gold)">OUR MISSION, OUR PURPOSE →</a>
    </div>
  </section>

  <!-- FOUNDER SECTION -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="founder-grid">
        <div class="founder-img-col">
          <div class="founder-img-wrap">
            <img
              src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=600&fit=crop&q=80"
              alt="Antonio G. Dattilo, Founder & Mission Director"
              loading="lazy"
              class="founder-img"
            />
            <div class="founder-img-badge">
              <span class="founder-img-badge-label">Founder &amp; Mission Director</span>
            </div>
          </div>
        </div>
        <div class="founder-text-col">
          <p class="section-label">OUR FOUNDER &amp; MISSION DIRECTOR</p>
          <div class="gold-rule-left" style="margin:0.75rem 0 1.25rem"></div>
          <h2 class="founder-name">Antonio G. Dattilo</h2>
          <p class="founder-subrole">Founder &amp; Mission Director, IICC Mission</p>
          <p class="founder-bio">
            The IICC Mission was founded by Antonio G. Dattilo, who combines professional knowledge and a deep commitment to justice, faith and humanity. His personal journey has become the foundation of a mission dedicated to supporting people and families through some of life's most difficult challenges.
          </p>
          <p class="founder-signature">Antonio G. Dattilo</p>
          <div class="founder-quote-card">
            <div class="founder-quote-mark">&ldquo;</div>
            <blockquote class="founder-quote-text">
              Behind every person there is a story. Behind every story there is a family. Behind every family there should be hope. This mission exists to bring that hope.
            </blockquote>
            <cite class="founder-quote-ref">— Antonio G. Dattilo, Founder &amp; Mission Director</cite>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR STORY -->
  <section class="section-standard">
    <div class="container">
      <div class="story-grid">
        <div class="story-text">
          <p class="section-label">OUR STORY</p>
          <div class="gold-rule-left" style="margin:0.75rem 0 1.25rem"></div>
          <h2 class="story-heading">A Journey That Became A Mission</h2>
          <p class="story-body">
            The IICC Mission was born from real life experiences that revealed the need for compassion, reform and restoration. Through personal challenges, professional work and witnessing the struggles of others, the mission was created to make a meaningful difference.
          </p>
          <p class="story-body">
            We understand the pain. We value dignity. We believe in second chances and in the power of hope.
          </p>
          <a href="/our-story" class="learn-more-link" style="margin-top:1rem;display:inline-flex">READ THE FULL STORY →</a>
        </div>
        <div class="story-pull">
          <div class="story-pull-card">
            <div class="story-pull-quote-mark">&ldquo;</div>
            <p class="story-pull-text">
              We understand the pain. We value dignity. We believe in second chances and in the power of hope.
            </p>
            <div class="story-pull-rule"></div>
            <p class="story-pull-label">The Heart of Our Mission</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR VISION -->
  <section class="section-standard-dark">
    <div class="container">
      <div class="vision-grid">
        <div>
          <p class="section-label">OUR VISION</p>
          <div class="gold-rule-left" style="margin:0.75rem 0 1.25rem"></div>
          <h2 class="vision-heading">A World Where Dignity, Justice And Hope Prevail</h2>
        </div>
        <div>
          <p class="vision-body">
            We envision a world where every person is valued, every family is supported and every community is strengthened. We advocate for fair opportunities, rehabilitation, inclusion and the restoration of hope.
          </p>
          <p class="vision-body">
            Together, we can create a future built on dignity, compassion, justice and faith.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR VALUES -->
  <section class="section-standard">
    <div class="container">
      <div class="section-header">
        <p class="section-label">OUR VALUES — THE FOUNDATION OF OUR MISSION</p>
        <div class="gold-rule" style="margin:0.75rem auto 1.25rem"></div>
        <h2 class="section-header-title">Everything We Do Is Guided By These Principles</h2>
      </div>
      <div class="values-grid">
        {[
          {
            icon: '✝',
            title: 'SPIRITUAL & PASTORAL CARE',
            desc: 'We provide faith-based support, spiritual guidance and pastoral care to nurture hope, healing and inner strength.',
          },
          {
            icon: '⚖',
            title: 'LEGAL ASSISTANCE & ADVOCACY',
            desc: 'We advocate for fairness, protect rights and provide legal support to promote dignity, justice and reform.',
          },
          {
            icon: '📚',
            title: 'EDUCATION & AWARENESS',
            desc: 'We empower through education, training and awareness to create opportunities and build brighter futures.',
          },
          {
            icon: '🤲',
            title: 'HUMANITARIAN SUPPORT',
            desc: 'We provide practical assistance and essential resources to individuals and families in need.',
          },
          {
            icon: '🌟',
            title: 'HEALING, RESTORATION & REINTEGRATION',
            desc: 'We walk alongside people on their journey to healing and help rebuild lives with dignity, purpose and belonging.',
          },
        ].map((val) => (
          <div class="info-card card-hover">
            <span class="info-card-icon">{val.icon}</span>
            <h3 class="info-card-title">{val.title}</h3>
            <p class="info-card-desc">{val.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ACKNOWLEDGEMENT BAND -->
  <section class="ack-band">
    <div class="container">
      <div class="ack-inner">
        <div class="ack-rule"></div>
        <p class="ack-text">
          The IICC Mission acknowledges the strength of the communities, professionals, faith leaders and supporters who contribute to this mission every day. Together, we can restore hope and build stronger communities.
        </p>
        <div class="ack-rule"></div>
      </div>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <QuoteBand
    quote="Faith. Hope. Justice. Restoration. These are not just words — they are our calling."
    dark={true}
  />

  <!-- FINAL CTA -->
  <CTASection
    eyebrow="Be Part of the Mission"
    headline="Join Us in Bringing Hope to Those Who Need It Most"
    buttons={[
      { label: 'Join The Mission', href: '/get-involved', primary: true },
      { label: 'Support The Mission', href: '/donate', primary: false },
      { label: 'Our Partners', href: '/sponsors-supporters', primary: false },
      { label: 'Contact Us', href: '/contact', primary: false },
    ]}
    dark={true}
  />

</Layout>

<style>
  /* FOUNDER */
  .founder-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .founder-grid {
      grid-template-columns: 2fr 3fr;
      align-items: center;
    }
  }

  .founder-img-wrap {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
  }
  .founder-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  @media (max-width: 767px) {
    .founder-img { height: 320px; }
  }
  .founder-img-badge {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(18,26,56,0.88);
    border-top: 2px solid var(--color-gold);
    padding: 0.75rem 1rem;
    backdrop-filter: blur(6px);
  }
  .founder-img-badge-label {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .founder-name {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-navy);
    margin: 0 0 0.375rem;
  }
  .founder-subrole {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    margin-bottom: 1.5rem;
  }
  .founder-bio {
    font-size: 1.0625rem;
    color: #4a4a4a;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }
  .founder-signature {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 1.75rem;
    opacity: 0.8;
  }

  .founder-quote-card {
    position: relative;
    background: var(--color-navy);
    padding: 2rem;
    border-left: 3px solid var(--color-gold);
    border-radius: 2px;
  }
  .founder-quote-mark {
    font-family: var(--font-heading);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-gold);
    opacity: 0.3;
    position: absolute;
    top: 0.5rem;
    left: 1rem;
    user-select: none;
    pointer-events: none;
  }
  .founder-quote-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.0625rem;
    color: white;
    line-height: 1.7;
    margin: 0 0 1rem;
    position: relative;
  }
  .founder-quote-ref {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-gold);
  }

  /* STORY */
  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .story-grid { grid-template-columns: 3fr 2fr; align-items: center; }
  }
  .story-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--color-navy);
    margin: 0 0 1.25rem;
  }
  .story-body {
    font-size: 1.0625rem;
    color: #4a4a4a;
    line-height: 1.8;
    margin-bottom: 0.875rem;
  }
  .story-pull-card {
    background: var(--color-offwhite);
    border: 1px solid rgba(201,160,23,0.25);
    border-top: 3px solid var(--color-gold);
    padding: 2rem;
    position: relative;
    border-radius: 2px;
  }
  .story-pull-quote-mark {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--color-gold);
    opacity: 0.35;
    position: absolute;
    top: 0.5rem;
    left: 0.875rem;
    user-select: none;
    pointer-events: none;
  }
  .story-pull-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-navy);
    line-height: 1.65;
    margin-bottom: 1.25rem;
    position: relative;
  }
  .story-pull-rule {
    width: 2.5rem;
    height: 2px;
    background: var(--color-gold);
    margin-bottom: 0.875rem;
  }
  .story-pull-label {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    margin: 0;
  }

  /* VISION */
  .vision-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .vision-grid { grid-template-columns: 1fr 1fr; }
  }
  .vision-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: white;
    margin: 0;
  }
  .vision-body {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.78);
    line-height: 1.8;
    margin-bottom: 1rem;
  }
  .vision-body:last-child { margin-bottom: 0; }

  /* VALUES */
  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .values-grid { grid-template-columns: repeat(5, 1fr); }
  }

  /* ACKNOWLEDGEMENT */
  .ack-band {
    padding: 4rem 0;
    background-color: var(--color-offwhite);
    border-top: 1px solid rgba(201,160,23,0.2);
    border-bottom: 1px solid rgba(201,160,23,0.2);
  }
  .ack-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .ack-rule {
    flex-shrink: 0;
    width: 3rem;
    height: 1px;
    background: var(--color-gold);
    opacity: 0.6;
  }
  @media (max-width: 480px) {
    .ack-inner { flex-direction: column; gap: 1rem; }
    .ack-rule { width: 2rem; }
  }
  .ack-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-navy);
    line-height: 1.7;
    text-align: center;
    margin: 0;
    opacity: 0.85;
  }
</style>
