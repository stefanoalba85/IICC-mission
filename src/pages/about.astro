---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About IICC Mission" description="IICC Mission — who we are, what we believe, and why we do what we do.">

  <!-- Split hero -->
  <div class="hero-split" style="min-height:500px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">International Institute of Compassion &amp; Care</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(2rem,5vw,3.5rem);">ABOUT</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(2rem,5vw,3.5rem);">IICC MISSION</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2.5vw,1.25rem);color:rgba(255,255,255,0.85);line-height:1.6;">
        A faith-driven movement to accompany, empower and restore hope — for those who need it most.
      </p>
      <div style="display:flex;gap:0.875rem;flex-wrap:wrap;">
        <a href="/our-story" class="btn btn--amber">OUR STORY ›</a>
        <a href="/our-mission" class="btn btn--outline-white">OUR MISSION ›</a>
      </div>
    </div>
    <div class="hero-split__photo" style="min-height:320px;position:relative;">
      <img
        src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=800&h=600&fit=crop"
        alt="IICC Mission — community in prayer"
      />
      <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(18,26,56,0.85));padding:2rem 1.5rem 1.5rem;">
        <p style="font-family:var(--font-heading);font-size:0.9375rem;color:rgba(255,255,255,0.9);font-style:italic;line-height:1.55;">"I was in prison and you came to visit me." — Matthew 25:36</p>
      </div>
    </div>
  </div>

  <!-- Who we are -->
  <section class="section section--white">
    <div class="wrap">
      <div class="cols-2" style="gap:3.5rem;align-items:start;">
        <div>
          <span class="eyebrow" style="display:block;margin-bottom:0.5rem;">Who We Are</span>
          <h2 class="section-title" style="margin-bottom:0.75rem;">A Mission Born from Experience and Faith</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>
          <span class="heart" style="display:block;margin-bottom:1rem;">♥</span>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            IICC Mission (International Institute of Compassion &amp; Care) is a faith-based humanitarian organisation dedicated to accompanying, empowering and restoring hope to some of society's most vulnerable people — including inmates, immigration detainees, the homeless, and families in crisis.
          </p>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            Founded by Antonio G. Dattilo — a man who has walked through the criminal justice system himself — we bring authentic, lived experience to our ministry. We know what it feels like to be forgotten, dismissed and without hope. That is precisely why we refuse to look away.
          </p>
          <p class="section-desc" style="max-width:none;">
            We are not simply a charity. We are a movement of compassion rooted in the Gospel, guided by prayer and driven by love for every human person.
          </p>
        </div>
        <div>
          <span class="eyebrow" style="display:block;margin-bottom:0.5rem;">What Drives Us</span>
          <h2 class="section-title" style="margin-bottom:0.75rem;">Our Core Convictions</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>
          <div style="display:flex;flex-direction:column;gap:1rem;">
            {[
              { icon: '✝️', title: 'Faith as Foundation', desc: 'Every person carries the image of God and deserves dignity, care and hope — regardless of their past.' },
              { icon: '🤝', title: 'Accompaniment', desc: 'We do not just provide services. We walk alongside people through their darkest moments.' },
              { icon: '⚖️', title: 'Justice', desc: 'We advocate for systemic change and speak up for those whose voices are rarely heard.' },
              { icon: '🌍', title: 'Global Vision', desc: 'Our mission extends across nations, cultures and communities to bring hope without borders.' },
              { icon: '♥', title: 'Unconditional Love', desc: 'Our care is not conditional. We love without limits, just as we are loved.' },
            ].map(c => (
              <div style="display:flex;align-items:flex-start;gap:0.875rem;padding-bottom:0.875rem;border-bottom:1px solid rgba(27,39,81,0.07);">
                <div style="width:2.25rem;height:2.25rem;border-radius:50%;background:rgba(224,123,0,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.875rem;">{c.icon}</div>
                <div>
                  <p style="font-weight:700;font-size:0.875rem;color:var(--color-navy);margin-bottom:0.2rem;">{c.title}</p>
                  <p style="font-size:0.8125rem;color:var(--color-muted);line-height:1.6;">{c.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats band -->
  <div class="stat-band">
    {[
      { n: '15+', label: 'Years of Mission' },
      { n: '6+', label: 'National Missions' },
      { n: '20+', label: 'State Missions' },
      { n: '10,000+', label: 'Lives Touched' },
      { n: '100%', label: 'Faith-Driven' },
    ].map(s => (
      <div class="stat-band__item">
        <span class="stat-band__number">{s.n}</span>
        <span class="stat-band__label">{s.label}</span>
      </div>
    ))}
  </div>

  <!-- What we do -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow eyebrow--white">Our Work</span>
        <span class="heart" style="color:var(--color-gold);display:block;margin-bottom:0.75rem;">♥</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1rem,2vw,1.25rem);letter-spacing:0.15em;text-transform:uppercase;color:#fff;">WHAT WE DO</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="grid-3">
        {[
          { icon: '🙏', title: 'Prison Ministry', desc: 'Visiting, praying, celebrating sacraments and walking with inmates and their families.' },
          { icon: '⚖️', title: 'Immigration Detention Ministry', desc: 'Providing pastoral care, legal referrals and humanitarian assistance to detainees.' },
          { icon: '🍞', title: 'Francis Bakery', desc: 'Feeding the homeless through fresh bread, soup kitchens and community partnerships.' },
          { icon: '📣', title: 'Advocacy', desc: 'Raising our voice for systemic reform, human dignity and justice for the marginalised.' },
          { icon: '🌍', title: 'Global Missions', desc: 'Building an international network of mission across nations and cultures.' },
          { icon: '💬', title: 'Spiritual & Pastoral Care', desc: 'Faith-based counselling, prayer and pastoral support for individuals and families.' },
        ].map(c => (
          <div class="card--dark" style="text-align:center;align-items:center;gap:0.5rem;">
            <div class="card__icon" style="font-size:1.125rem;border-color:rgba(224,123,0,0.4);">{c.icon}</div>
            <p class="card__title">{c.title}</p>
            <p class="card__body">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Story link section -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:center;">
        <div style="position:relative;border-radius:2px;overflow:hidden;min-height:340px;">
          <img
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=700&h=500&fit=crop"
            alt="Ambassador Antonio G. Dattilo, Founder of IICC Mission"
            style="width:100%;height:100%;object-fit:cover;"
          />
          <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(18,26,56,0.9));padding:1.5rem 1.25rem 1.25rem;">
            <p style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.15em;color:var(--color-amber);margin-bottom:0.25rem;">OUR FOUNDER</p>
            <p style="font-weight:700;font-size:1rem;color:#fff;">Ambassador Antonio G. Dattilo</p>
          </div>
        </div>
        <div>
          <span class="eyebrow" style="display:block;margin-bottom:0.5rem;">Our Founder</span>
          <h2 class="section-title" style="margin-bottom:0.75rem;">Called by God, Shaped by Experience</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.5rem;"></span>
          <span class="heart" style="display:block;margin-bottom:1rem;">♥</span>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            Our founder, Ambassador Antonio G. Dattilo, has a story unlike most. Having walked through the justice system himself, he emerged with a burning conviction: that every person in prison, every detainee, every person forgotten by society deserves to be seen, loved and accompanied.
          </p>
          <p class="section-desc" style="max-width:none;margin-bottom:1.5rem;">
            Recognised by Cardinal George Pell and Archbishop Peter Comensoli for his extraordinary prison ministry, Antonio has dedicated his life to a mission that flows directly from his personal encounter with Christ — and with suffering.
          </p>
          <a href="/our-people/ambassador-founder" class="btn btn--amber">MEET OUR FOUNDER ›</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <div class="amber-band">
    <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;">
      <div>
        <p style="font-family:var(--font-display);font-size:clamp(1.125rem,2.5vw,1.5rem);font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.375rem;">READY TO JOIN THE MISSION?</p>
        <p style="font-size:0.9375rem;color:rgba(255,255,255,0.88);line-height:1.5;">Partner with us as we bring hope where it is needed most.</p>
      </div>
      <div style="display:flex;gap:0.875rem;flex-wrap:wrap;">
        <a href="/donate" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;">♥ DONATE</a>
        <a href="/get-involved" class="btn btn--outline-white">GET INVOLVED ›</a>
      </div>
    </div>
  </div>

  <!-- Value strip -->
  <div class="value-strip">
    {['We See Need', 'We Speak Up', 'We Walk Beside', 'We Restore Hope', 'We Love Unconditionally'].map(v => (
      <span class="value-strip__item">{v}</span>
    ))}
  </div>

</Layout>
