---
import Layout from '../layouts/Layout.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Faith & Hope"
  description="Faith & Hope — The Spiritual Foundation of the IICC Mission. Faith gives strength. Hope gives courage. Love restores."
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1200&fit=crop&q=80"
        alt="Prayer and candle"
        loading="eager"
      />
      <div class="page-hero-overlay"></div>
    </div>
    <div class="page-hero-content">
      <p class="section-label">Faith &amp; Hope</p>
      <div class="gold-rule-left" style="margin: 0.75rem 0 1.25rem;"></div>
      <h1 class="page-hero-title">Faith gives strength.<br>Hope gives courage.<br><span style="color:var(--color-gold)">Love restores.</span></h1>
      <p class="page-hero-subtitle">The Spiritual Foundation of the IICC Mission</p>
      <a href="#word-of-hope" class="btn-primary">EXPLORE THE WORD OF HOPE →</a>
    </div>
  </section>

  <!-- 1. THE WORD OF HOPE -->
  <section class="section-standard-offwhite" id="word-of-hope">
    <div class="container">
      <div class="numbered-section-header">
        <div class="section-number">1</div>
        <div>
          <p class="section-label">The Word of Hope</p>
          <div class="gold-rule-left" style="margin: 0.75rem 0 1rem;"></div>
          <h2 class="section-heading">The Word of God Provides</h2>
        </div>
      </div>
      <div class="card-grid-4" style="margin-top:2.5rem;">
        <div class="info-card">
          <span class="info-card-icon">📖</span>
          <h3 class="info-card-title">Encouragement</h3>
          <p class="info-card-desc">Encouragement during difficulties — the Word of God speaks hope into every painful moment and season.</p>
        </div>
        <div class="info-card">
          <span class="info-card-icon">🧭</span>
          <h3 class="info-card-title">Guidance</h3>
          <p class="info-card-desc">Guidance in moments of uncertainty — God's Word is a lamp to our feet and a light to our path.</p>
        </div>
        <div class="info-card">
          <span class="info-card-icon">💪</span>
          <h3 class="info-card-title">Strength</h3>
          <p class="info-card-desc">Strength through challenges — His Word renews our strength and enables us to endure with perseverance.</p>
        </div>
        <div class="info-card">
          <span class="info-card-icon">❤</span>
          <h3 class="info-card-title">God's Love</h3>
          <p class="info-card-desc">A reminder of God's mercy and love — the Scriptures reveal His unfailing care for every person.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. OLD TESTAMENT -->
  <section class="section-standard">
    <div class="container">
      <div class="numbered-section-header">
        <div class="section-number">2</div>
        <div>
          <p class="section-label">Old Testament — The Foundation of Faith</p>
          <div class="gold-rule-left" style="margin: 0.75rem 0 1rem;"></div>
          <h2 class="section-heading">The Journey of God's People</h2>
          <p class="section-intro">The Old Testament shares the journey of God's people and the foundations of faith, justice and hope.</p>
        </div>
      </div>
      <div class="ot-grid">
        <div class="ot-col">
          <div class="ot-col-header">THE LAW</div>
          <div class="ot-label">Stories of:</div>
          <ul class="ot-list">
            <li>Creation</li>
            <li>Covenant</li>
            <li>Faithfulness</li>
            <li>God's relationship with humanity</li>
          </ul>
        </div>
        <div class="ot-col">
          <div class="ot-col-header">HISTORICAL BOOKS</div>
          <div class="ot-label">Lessons of:</div>
          <ul class="ot-list">
            <li>Courage</li>
            <li>Perseverance</li>
            <li>Leadership</li>
            <li>Trust</li>
          </ul>
        </div>
        <div class="ot-col">
          <div class="ot-col-header">WISDOM BOOKS</div>
          <div class="ot-label">Reflections on:</div>
          <ul class="ot-list">
            <li>Suffering</li>
            <li>Prayer</li>
            <li>Wisdom</li>
            <li>Life</li>
          </ul>
        </div>
        <div class="ot-col">
          <div class="ot-col-header">PROPHETS</div>
          <div class="ot-label">Messages of:</div>
          <ul class="ot-list">
            <li>Justice</li>
            <li>Mercy</li>
            <li>Renewal</li>
            <li>Hope</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. NEW TESTAMENT + FOUR GOSPELS -->
  <section class="section-standard-dark">
    <div class="container">
      <div class="numbered-section-header numbered-section-header--dark">
        <div class="section-number section-number--gold">3</div>
        <div>
          <p class="section-label">New Testament — The Message Of Jesus Christ</p>
          <div class="gold-rule-left" style="margin: 0.75rem 0 1rem;"></div>
          <h2 class="section-heading section-heading--white">The Life and Teachings of Jesus</h2>
          <p class="section-intro section-intro--white">The New Testament reveals the life, teachings, death and resurrection of Jesus Christ and His message of love, forgiveness and salvation.</p>
        </div>
      </div>
      <div class="gospels-header">
        <p class="gospels-label">THE FOUR GOSPELS</p>
        <div class="gold-rule" style="margin: 0.5rem auto 0;"></div>
      </div>
      <div class="card-grid-4" style="margin-top:2rem;">
        <div class="info-card--dark">
          <span class="info-card-icon">📖</span>
          <h3 class="info-card-title">Matthew</h3>
          <p class="info-card-desc">Faith, discipleship and the teachings of Jesus — the Kingdom of Heaven revealed to God's people.</p>
        </div>
        <div class="info-card--dark">
          <span class="info-card-icon">✝</span>
          <h3 class="info-card-title">Mark</h3>
          <p class="info-card-desc">Service, action and commitment — the urgent, powerful mission of Jesus in the world.</p>
        </div>
        <div class="info-card--dark">
          <span class="info-card-icon">❤</span>
          <h3 class="info-card-title">Luke</h3>
          <p class="info-card-desc">Mercy, compassion and care for those on the margins — God's love poured out for the vulnerable.</p>
        </div>
        <div class="info-card--dark">
          <span class="info-card-icon">🕊</span>
          <h3 class="info-card-title">John</h3>
          <p class="info-card-desc">Love, faith and the relationship with Christ — the Word made flesh dwelling among us.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. GOSPEL REFLECTIONS -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="numbered-section-header">
        <div class="section-number">4</div>
        <div>
          <p class="section-label">Gospel Reflections</p>
          <div class="gold-rule-left" style="margin: 0.75rem 0 1rem;"></div>
          <h2 class="section-heading">Inspiration and encouragement for everyday life.</h2>
        </div>
      </div>
      <div class="card-grid-4" style="margin-top:2.5rem;">
        <div class="reflection-card">
          <span class="reflection-icon">💙</span>
          <h3 class="reflection-theme">MERCY</h3>
          <div class="reflection-rule"></div>
          <p class="reflection-text">"God's mercy is new every morning." His compassion never fails — there is always a new beginning in Christ.</p>
        </div>
        <div class="reflection-card">
          <span class="reflection-icon">🕊</span>
          <h3 class="reflection-theme">FORGIVENESS</h3>
          <div class="reflection-rule"></div>
          <p class="reflection-text">"Forgiveness sets us free." When we forgive as we have been forgiven, healing and restoration begin.</p>
        </div>
        <div class="reflection-card">
          <span class="reflection-icon">⚓</span>
          <h3 class="reflection-theme">HOPE</h3>
          <div class="reflection-rule"></div>
          <p class="reflection-text">"Hope anchors the soul." In every darkness, Christ is the light that guides us safely home.</p>
        </div>
        <div class="reflection-card">
          <span class="reflection-icon">🌱</span>
          <h3 class="reflection-theme">RESTORATION</h3>
          <div class="reflection-rule"></div>
          <p class="reflection-text">"God restores what is broken." Nothing is beyond His power to heal, renew and make whole again.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. PRAYER -->
  <section class="section-standard" id="prayer">
    <div class="container">
      <div class="prayer-inner">
        <div class="prayer-content">
          <div class="numbered-section-header">
            <div class="section-number">5</div>
            <div>
              <p class="section-label">Prayer — A Place For Prayer And Hope</p>
              <div class="gold-rule-left" style="margin: 0.75rem 0 1rem;"></div>
              <h2 class="section-heading">You can submit:</h2>
            </div>
          </div>
          <ul class="prayer-types">
            <li><span class="prayer-icon">🙏</span><span>Prayer requests</span></li>
            <li><span class="prayer-icon">💛</span><span>Gratitude messages</span></li>
            <li><span class="prayer-icon">✝</span><span>Intentions</span></li>
            <li><span class="prayer-icon">📖</span><span>Reflections</span></li>
          </ul>
          <a href="mailto:info@iiccmission.org?subject=Prayer Request" class="btn-primary prayer-cta">SUBMIT A PRAYER REQUEST →</a>
          <p class="prayer-note">The IICC Mission welcomes prayer as a source of comfort, strength and connection. Every request is received with care and held in our community's heart.</p>
        </div>
        <div class="prayer-img-wrap">
          <img src="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=600&fit=crop&q=80" alt="Prayer" loading="lazy" />
          <div class="prayer-img-overlay">
            <p class="prayer-img-quote">"Ask and you shall receive."</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FAITH MESSAGES -->
  <section class="section-standard-dark">
    <div class="container">
      <div class="numbered-section-header numbered-section-header--dark">
        <div class="section-number section-number--gold">6</div>
        <div>
          <p class="section-label">Faith Messages</p>
          <div class="gold-rule-left" style="margin: 0.75rem 0 1rem;"></div>
          <h2 class="section-heading section-heading--white">Special messages for every season of faith.</h2>
        </div>
      </div>
      <div class="card-grid-4" style="margin-top:2.5rem;">
        <div class="season-card">
          <span class="season-icon">✨</span>
          <h3 class="season-name">ADVENT</h3>
          <p class="season-desc">A time of preparation and expectation. We await with hope the coming of the light of Christ into the world.</p>
        </div>
        <div class="season-card">
          <span class="season-icon">🌟</span>
          <h3 class="season-name">CHRISTMAS</h3>
          <p class="season-desc">Peace, family and generosity. The Word made flesh — Emmanuel, God with us, born into our world.</p>
        </div>
        <div class="season-card">
          <span class="season-icon">✝</span>
          <h3 class="season-name">HOLY WEEK</h3>
          <p class="season-desc">Sacrifice, love and compassion. We accompany Jesus on His journey of suffering and ultimate love.</p>
        </div>
        <div class="season-card">
          <span class="season-icon">🌅</span>
          <h3 class="season-name">EASTER</h3>
          <p class="season-desc">Resurrection and new hope. Death is defeated — Christ is risen, and with Him, all things are made new.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FAITH IN ACTION -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="numbered-section-header">
        <div class="section-number">7</div>
        <div>
          <p class="section-label">Faith in Action — Connecting belief with service.</p>
          <div class="gold-rule-left" style="margin: 0.75rem 0 1rem;"></div>
          <h2 class="section-heading">Faith inspires us to:</h2>
        </div>
      </div>
      <div class="action-strip">
        <div class="action-item">
          <span class="action-icon">🤝</span>
          <strong>Show Compassion</strong>
          <p>Meeting people where they are with care and dignity.</p>
        </div>
        <div class="action-item">
          <span class="action-icon">💙</span>
          <strong>Provide Support</strong>
          <p>Walking alongside those in their darkest hours.</p>
        </div>
        <div class="action-item">
          <span class="action-icon">⚖</span>
          <strong>Advocate for Justice</strong>
          <p>Speaking up for the rights and dignity of every person.</p>
        </div>
        <div class="action-item">
          <span class="action-icon">🌍</span>
          <strong>Build Community</strong>
          <p>Creating bonds of belonging and mutual care.</p>
        </div>
        <div class="action-item">
          <span class="action-icon">🌱</span>
          <strong>Bring Restoration</strong>
          <p>Helping broken lives become whole again through love.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <QuoteBand
    quote="The Gospel brings hope. Hope inspires action. Action restores lives."
    dark={true}
  />

  <!-- FINAL SECTION -->
  <section class="section-standard-dark">
    <div class="container final-btns-inner">
      <div class="final-btns">
        <a href="/faith-hope" class="btn-outline">READ REFLECTIONS</a>
        <a href="mailto:info@iiccmission.org?subject=Prayer Request" class="btn-primary">SUBMIT PRAYER REQUEST →</a>
        <a href="/get-involved" class="btn-outline">JOIN THE MISSION →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    dark={false}
    headline="Walk Together in Faith and Hope"
    subtext="Together, we can bring light to darkness and hope into every heart."
    buttons={[
      { label: "Submit a Prayer Request", href: "mailto:info@iiccmission.org?subject=Prayer Request", primary: true },
      { label: "Join The Mission", href: "/get-involved", primary: false },
    ]}
  />

</Layout>

<style>
  /* NUMBERED SECTION HEADER */
  .numbered-section-header {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
  }
  .section-number {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 7vw, 6rem);
    font-weight: 700;
    color: var(--color-gold);
    opacity: 0.25;
    line-height: 0.85;
    flex-shrink: 0;
    user-select: none;
  }
  .section-number--gold {
    opacity: 0.4;
  }
  .section-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--color-navy);
    margin: 0;
    line-height: 1.2;
  }
  .section-heading--white {
    color: white;
  }
  .section-intro {
    margin-top: 0.875rem;
    font-size: 1.0625rem;
    color: #5a5a6a;
    line-height: 1.7;
    max-width: 680px;
  }
  .section-intro--white {
    color: rgba(255,255,255,0.7);
  }

  /* OLD TESTAMENT GRID */
  .ot-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 768px) {
    .ot-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .ot-col {
    background: white;
    border: 1px solid rgba(27,39,81,0.08);
    border-top: 3px solid var(--color-gold);
    padding: 1.5rem;
    border-radius: 2px;
  }
  .ot-col-header {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-navy);
    font-weight: 700;
    margin-bottom: 0.875rem;
  }
  .ot-label {
    font-size: 0.75rem;
    color: var(--color-gold-dark);
    font-weight: 600;
    font-style: italic;
    margin-bottom: 0.5rem;
  }
  .ot-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .ot-list li {
    font-size: 0.875rem;
    color: #4a4a5a;
    padding-left: 0.875rem;
    position: relative;
  }
  .ot-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-weight: 700;
  }

  /* GOSPELS HEADER */
  .gospels-header {
    text-align: center;
    margin-top: 3rem;
  }
  .gospels-label {
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 700;
  }

  /* REFLECTION CARDS */
  .reflection-card {
    background: white;
    border: 1px solid rgba(27,39,81,0.08);
    border-top: 3px solid var(--color-gold);
    padding: 1.75rem;
    border-radius: 2px;
    text-align: center;
  }
  .reflection-icon {
    font-size: 2.25rem;
    display: block;
    margin-bottom: 0.875rem;
  }
  .reflection-theme {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--color-navy);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .reflection-rule {
    width: 2rem;
    height: 2px;
    background-color: var(--color-gold);
    margin: 0 auto 0.875rem;
  }
  .reflection-text {
    font-size: 0.875rem;
    color: #5a5a6a;
    line-height: 1.65;
    font-style: italic;
    font-family: var(--font-heading);
    margin: 0;
  }

  /* PRAYER */
  .prayer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .prayer-inner { grid-template-columns: 3fr 2fr; }
  }
  .prayer-types {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
  }
  .prayer-types li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-navy);
    background: var(--color-offwhite);
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--color-gold);
  }
  .prayer-icon {
    font-size: 1.25rem;
  }
  .prayer-cta {
    display: inline-flex;
    margin-bottom: 1.5rem;
  }
  .prayer-note {
    font-size: 0.9375rem;
    color: #5a5a6a;
    line-height: 1.7;
    font-style: italic;
    max-width: 520px;
    margin: 0;
  }
  .prayer-img-wrap {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(27,39,81,0.15);
  }
  .prayer-img-wrap img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }
  .prayer-img-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(18,26,56,0.85), transparent 80%);
    padding: 1.5rem 1.25rem 1.25rem;
  }
  .prayer-img-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.9);
    margin: 0;
  }

  /* SEASON CARDS */
  .season-card {
    padding: 2rem 1.5rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(201,160,23,0.2);
    border-top: 3px solid var(--color-gold);
    text-align: center;
    border-radius: 2px;
  }
  .season-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }
  .season-name {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 700;
    margin-bottom: 0.875rem;
  }
  .season-desc {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.65;
    margin: 0;
  }

  /* FAITH IN ACTION STRIP */
  .action-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 768px) {
    .action-strip { grid-template-columns: repeat(5, 1fr); }
  }
  .action-item {
    text-align: center;
    padding: 1.75rem 1.25rem;
    background: white;
    border: 1px solid rgba(27,39,81,0.08);
    border-radius: 2px;
    border-bottom: 3px solid var(--color-gold);
  }
  .action-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.75rem;
  }
  .action-item strong {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }
  .action-item p {
    font-size: 0.8125rem;
    color: #5a5a6a;
    line-height: 1.55;
    margin: 0;
  }

  /* FINAL BUTTONS */
  .final-btns-inner {
    padding: 3rem 1.5rem;
  }
  .final-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }
</style>
