---
import Layout from '../../layouts/Layout.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import CTASection from '../../components/CTASection.astro';
---

<Layout
  title="Immigration Detention Ministry"
  description="IICC Mission Immigration Detention Ministry — Seeing Christ in Every Person. Standing with Those in Detention."
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1200&fit=crop&q=80"
        alt="People, community"
        loading="eager"
      />
      <div class="page-hero-overlay"></div>
    </div>
    <div class="page-hero-content">
      <p class="section-label">Immigration Detention Ministry</p>
      <div class="gold-rule-left" style="margin: 0.75rem 0 1.25rem;"></div>
      <h1 class="page-hero-title">Seeing Christ in Every Person.<br>Standing with Those in Detention.</h1>
      <a href="tel:+61476725061" class="btn-primary">GET SUPPORT →</a>
    </div>
  </section>

  <!-- EMERGENCY INFO BOX -->
  <section class="emergency-band">
    <div class="container">
      <div class="emergency-box">
        <div class="emergency-header">
          <span class="emergency-badge">WE ARE HERE FOR YOU</span>
          <p class="emergency-tagline">We listen. We support. We advocate.</p>
        </div>
        <div class="emergency-contacts">
          <div class="emergency-contact-item">
            <span class="emergency-icon">📞</span>
            <div>
              <strong>+61 476 725 061</strong>
              <span>Detention Ministry Line</span>
            </div>
          </div>
          <div class="emergency-contact-item">
            <span class="emergency-icon">📧</span>
            <div>
              <strong>detentionministry@iiccmission.org</strong>
              <span>Email Support</span>
            </div>
          </div>
          <div class="emergency-contact-item">
            <span class="emergency-icon">🏛</span>
            <div>
              <strong>Head Office: Vatican City / Rome</strong>
              <span>Via dei Curriculum 24, 00187 Rome, Italy</span>
            </div>
          </div>
        </div>
        <a href="tel:+61476725061" class="btn-primary emergency-cta">GET SUPPORT →</a>
      </div>
    </div>
  </section>

  <!-- OUR MISSION — TWO COL -->
  <section class="section-standard">
    <div class="container">
      <div class="two-col">
        <div class="mission-text">
          <p class="section-label">Our Mission</p>
          <div class="gold-rule-left" style="margin: 0.75rem 0 1.25rem;"></div>
          <h2 class="mission-heading">Bringing the Love of Christ to Those in Detention</h2>
          <p class="mission-desc">IICC visits and supports people in immigration detention centres and their families. We provide pastoral care, practical assistance, advocacy and hope — affirming the dignity of every person, regardless of their circumstances.</p>
          <blockquote class="mission-scripture">
            <p>"I was a stranger and you welcomed me."</p>
            <cite>— Matthew 25:35</cite>
          </blockquote>
        </div>
        <div class="mission-img-wrap">
          <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=600&fit=crop&q=80" alt="Immigration Detention Ministry" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- SUPPORT SERVICES — DARK -->
  <section class="section-standard-dark">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Support Services</p>
        <div class="gold-rule"></div>
        <h2 class="section-header-title section-header-title--white" style="margin-top:1rem;">Our Support Services</h2>
        <p class="section-header-desc" style="color:rgba(255,255,255,0.7);">Every service is delivered with dignity, compassion and the love of Christ.</p>
      </div>
      <div class="card-grid-3">

        <div class="info-card--dark">
          <span class="info-card-icon">🏛</span>
          <h3 class="info-card-title">Detention Visits</h3>
          <p class="info-card-desc">Regular pastoral visits to provide companionship, spiritual support and a listening ear. No one should face detention alone.</p>
        </div>

        <div class="info-card--dark">
          <span class="info-card-icon">✝</span>
          <h3 class="info-card-title">Pastoral &amp; Spiritual Care</h3>
          <p class="info-card-desc">Prayer, sacraments, faith conversations and spiritual resources for those in detention, whatever their faith background.</p>
        </div>

        <div class="info-card--dark">
          <span class="info-card-icon">⚖</span>
          <h3 class="info-card-title">Advocacy &amp; Case Support</h3>
          <p class="info-card-desc">Advocating for fair and humane treatment and connecting people with legal assistance, information and resources.</p>
        </div>

        <div class="info-card--dark">
          <span class="info-card-icon">👨‍👩‍👧</span>
          <h3 class="info-card-title">Family Assistance</h3>
          <p class="info-card-desc">Supporting families with information, referrals and emotional support during difficult times of separation and uncertainty.</p>
        </div>

        <div class="info-card--dark">
          <span class="info-card-icon">📦</span>
          <h3 class="info-card-title">Practical Assistance</h3>
          <p class="info-card-desc">Providing essential items, resources and practical support to meet the basic needs of those in detention.</p>
        </div>

        <div class="info-card--dark">
          <span class="info-card-icon">🔗</span>
          <h3 class="info-card-title">Referrals &amp; Reconnection</h3>
          <p class="info-card-desc">Connecting people to community organisations, support services and the broader community after release from detention.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- IMPACT STATS -->
  <div class="stat-band">
    <div class="stat-band-inner">
      <div>
        <span class="stat-num">6,000+</span>
        <span class="stat-label">People visited in detention centres</span>
      </div>
      <div>
        <span class="stat-num">2,300+</span>
        <span class="stat-label">Pastoral care sessions provided</span>
      </div>
      <div>
        <span class="stat-num">1,700+</span>
        <span class="stat-label">Advocacy &amp; legal referrals supported</span>
      </div>
      <div>
        <span class="stat-num">3,100+</span>
        <span class="stat-label">Family members supported</span>
      </div>
    </div>
  </div>

  <!-- IMPORTANT INFORMATION -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="two-col">

        <div class="info-left">
          <p class="section-label">Important Information</p>
          <div class="gold-rule-left" style="margin: 0.75rem 0 1.25rem;"></div>
          <h2 class="info-heading">Our Commitment to You</h2>
          <ul class="commitment-list">
            <li>
              <span class="check-icon">✓</span>
              <span>We respect the confidentiality and privacy of everyone we serve.</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>Our visits are pastoral, not legal advice.</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>We work in accordance with all relevant laws and regulations.</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>We do not discriminate based on nationality, faith, gender or background.</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span>We are here to listen, support and walk with you.</span>
            </li>
          </ul>
        </div>

        <div class="help-right">
          <div class="help-box">
            <p class="section-label">How You Can Help</p>
            <div class="gold-rule-left" style="margin: 0.75rem 0 1.25rem;"></div>
            <h3 class="help-heading">Your support can make a real difference.</h3>
            <div class="help-ways">
              <div class="help-way">
                <span class="help-icon">🙏</span>
                <div>
                  <strong>Pray</strong>
                  <p>Lift up those in detention and our ministry team in your prayers.</p>
                </div>
              </div>
              <div class="help-way">
                <span class="help-icon">💛</span>
                <div>
                  <strong>Donate</strong>
                  <p>Your generosity funds visits, resources and advocacy.</p>
                </div>
              </div>
              <div class="help-way">
                <span class="help-icon">🤝</span>
                <div>
                  <strong>Volunteer</strong>
                  <p>Join our team of dedicated pastoral visitors and supporters.</p>
                </div>
              </div>
              <div class="help-way">
                <span class="help-icon">📣</span>
                <div>
                  <strong>Advocate</strong>
                  <p>Raise awareness and speak up for humane treatment of detainees.</p>
                </div>
              </div>
            </div>
            <a href="/get-involved" class="btn-primary" style="margin-top:1.5rem;">GET INVOLVED →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- EMERGENCY CONTACT -->
  <section class="urgent-section">
    <div class="container urgent-inner">
      <p class="section-label" style="color:var(--color-gold)">Urgent Support</p>
      <div class="gold-rule" style="margin: 0.75rem auto 1.25rem;"></div>
      <h2 class="urgent-heading">Need Immediate Help?</h2>
      <p class="urgent-desc">If you or someone you know is in immigration detention and needs urgent support, please contact our Detention Ministry Support Line.</p>
      <div class="urgent-phone">+61 476 725 061</div>
      <p class="urgent-sub">Detention Ministry Line — Available 24/7</p>
      <p class="urgent-quote">"You are not alone. You are valued. You are loved."</p>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <QuoteBand
    quote="Do not forget to show hospitality to strangers, for by doing that some have entertained angels without knowing it."
    reference="Hebrews 13:2"
    dark={true}
  />

  <!-- CTA -->
  <CTASection
    dark={true}
    headline="We Are Here For You"
    subtext="No matter where you are, we will walk with you."
    buttons={[
      { label: "Call Us Now", href: "tel:+61476725061", primary: true },
      { label: "Email Us", href: "mailto:detentionministry@iiccmission.org", primary: false },
      { label: "Donate to Support This Ministry", href: "/donate", primary: false },
    ]}
  />

</Layout>

<style>
  /* EMERGENCY BAND */
  .emergency-band {
    background-color: var(--color-navy-dark);
    border-bottom: 3px solid var(--color-gold);
    padding: 2.5rem 0;
  }
  .emergency-box {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(201,160,23,0.35);
    border-top: 3px solid var(--color-gold);
    padding: 2rem 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .emergency-box {
      grid-template-columns: auto 1fr auto;
      gap: 2.5rem;
    }
  }
  .emergency-header {
    text-align: left;
  }
  .emergency-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-navy-dark);
    background-color: var(--color-gold);
    padding: 0.25rem 0.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .emergency-tagline {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.75);
    margin: 0.5rem 0 0;
    font-style: italic;
    font-family: var(--font-heading);
  }
  .emergency-contacts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .emergency-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: white;
  }
  .emergency-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
    margin-top: 0.1em;
  }
  .emergency-contact-item strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    color: white;
  }
  .emergency-contact-item span:not(.emergency-icon) {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.6);
  }
  .emergency-cta {
    white-space: nowrap;
    align-self: center;
  }

  /* MISSION SECTION */
  .mission-text {
    max-width: 620px;
  }
  .mission-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--color-navy);
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }
  .mission-desc {
    font-size: 1.0625rem;
    color: #4a4a4a;
    line-height: 1.75;
    margin-bottom: 1.5rem;
  }
  .mission-scripture {
    padding: 1.25rem 1.5rem;
    background: var(--color-offwhite);
    border-left: 3px solid var(--color-gold);
    margin: 0;
  }
  .mission-scripture p {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-navy);
    margin: 0 0 0.5rem;
  }
  .mission-scripture cite {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-gold-dark);
  }
  .mission-img-wrap {
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(27,39,81,0.15);
  }
  .mission-img-wrap img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }

  /* COMMITMENT LIST */
  .info-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 2vw, 1.875rem);
    color: var(--color-navy);
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }
  .commitment-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .commitment-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    color: #3a3a4a;
    line-height: 1.6;
  }
  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    background-color: #22c55e;
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.1em;
  }

  /* HELP BOX */
  .help-box {
    background: var(--color-navy);
    padding: 2rem;
    border-top: 3px solid var(--color-gold);
  }
  .help-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: white;
    margin-bottom: 1.5rem;
  }
  .help-ways {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .help-way {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.8);
  }
  .help-icon {
    font-size: 1.375rem;
    flex-shrink: 0;
    margin-top: 0.05em;
  }
  .help-way strong {
    display: block;
    color: white;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }
  .help-way p {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.65);
    margin: 0;
    line-height: 1.5;
  }

  /* URGENT SECTION */
  .urgent-section {
    background-color: var(--color-navy-dark);
    padding: 5rem 0;
    text-align: center;
    border-top: 1px solid rgba(201,160,23,0.2);
  }
  .urgent-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .urgent-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    color: white;
    margin-bottom: 1rem;
  }
  .urgent-desc {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 2rem;
  }
  .urgent-phone {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
    line-height: 1;
  }
  .urgent-sub {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 2rem;
  }
  .urgent-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.25rem;
    color: rgba(255,255,255,0.85);
    margin: 0;
  }
</style>
