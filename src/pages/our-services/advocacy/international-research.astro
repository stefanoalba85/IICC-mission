---
import Layout from '../../../layouts/Layout.astro';
import MinHero from '../../../components/MinHero.astro';
import CampBand from '../../../components/CampBand.astro';
import MinBand from '../../../components/MinBand.astro';
import IconCards from '../../../components/IconCards.astro';
import CampCards from '../../../components/CampCards.astro';
import ActionBox from '../../../components/ActionBox.astro';
import CheckPanel from '../../../components/CheckPanel.astro';
import StatsRow from '../../../components/StatsRow.astro';
import LeadersBand from '../../../components/LeadersBand.astro';
import QuoteBanner from '../../../components/QuoteBanner.astro';
import JoinCta from '../../../components/JoinCta.astro';
import MiddlePanel from '../../../components/MiddlePanel.astro';
import ImStrip from '../../../components/ImStrip.astro';
import Icon from '../../../components/Icon.astro';
const img = (n: string) => `/images/advocacy/${n}.jpg`;
---
<Layout title="International Research" description="Knowledge. Evidence. Change. Better prisons. Better lives.">
  <MinHero boxed kicker="🌐 Global Advocacy" title="International<br/><span>Research</span>" subtitle="Knowledge. Evidence. Change.<br/><span style='color:#c9741f'>Better prisons. Better lives.</span>"
    intro={['We conduct and support independent, ethical research on prisons, detention and rehabilitation around the world. Our research informs policy, strengthens advocacy and drives reforms that uphold human dignity and justice.']}
    img={img('ir-hero')} alt="A globe and research papers on a desk" quote="Research is the foundation of justice. Evidence guides reform." quoteRef="Desmond Tutu" />
  <CampBand lead="Research brings truth to light and turns evidence into action." items={[
    { icon: 'clipboard-check', title: 'Evidence-Based', text: 'We gather reliable data to understand real conditions.' }, { icon: 'globe', title: 'Global Perspective', text: 'We study systems across countries to identify solutions.' },
    { icon: 'chart-column', title: 'Policy Impact', text: 'We translate research into practical policy recommendations.' }, { icon: 'hand-holding-heart', title: 'Human Rights Focus', text: 'Our research defends dignity, fairness and fundamental rights.' },
    { icon: 'people-group', title: 'Collaborative', text: 'We partner with universities, researchers, NGOs and communities.' }, { icon: 'folder-open', title: 'Public Access', text: 'We share findings freely to promote transparency and informed debate.' },
  ]} />
  <IconCards title="Our International Research Focus" items={[
    { icon: 'bars', title: 'Prison Conditions', text: 'Examining living conditions, overcrowding, safety, sanitation and access to basic needs.' }, { icon: 'brain', title: 'Health & Mental Health', text: 'Studying healthcare access, mental health services and the impact of isolation and trauma.' },
    { icon: 'chart-line', title: 'Rehabilitation Outcomes', text: 'Evaluating education, vocational training and rehabilitation programs and their effectiveness.' }, { icon: 'people-roof', title: 'Children & Families', text: 'Researching the impact of incarceration on families and the rights of children of prisoners.' },
    { icon: 'building-lock', title: 'Solitary Confinement', text: 'Investigating the use, effects and alternatives to solitary confinement and long-term isolation.' }, { icon: 'scale-balanced', title: 'Legal & Policy Reform', text: 'Analysing laws, policies and practices to promote fairness, proportionate and human rights compliance.' },
  ]} />
  <section class="wrap camp-split">
    <img src={img('ir-laptop')} alt="A researcher studying a world map on a laptop" />
    <div style="padding:0.5rem; text-align:center;"><h2 class="camp-h" style="font-size:1.0625rem;">Our Approach</h2><p class="im-p" style="font-size:0.9375rem;">We use rigorous methods, global standards and a commitment to ethics in every study we undertake.</p><div class="camp-trio">{[['clipboard-list','Collect','Reliable data from multiple sources'],['magnifying-glass','Analyse','Identify patterns, gaps and root causes'],['lightbulb','Recommend','Develop practical and humane recommendations'],['bullhorn','Advocate','Promote reforms through dialogue and partnerships']].map(([i,t,d]) => <div><Icon name={i} size={30} /><strong>{t}</strong><span>{d}</span></div>)}</div></div>
    <ActionBox title="Support Research. Drive Change." text="Your support helps us expand research, publish critical reports and influence policies that transform lives." buttons={[{ label: 'Support Our Research' }, { label: 'Download Reports', icon: 'file-lines', kind: 'white', href: '/resources/download-guides' }, { label: 'Support on GoFundMe', kind: 'green' }, { label: 'Donate Now', icon: 'heart' }]} />
  </section>
  <section class="wrap camp-3">
    <CheckPanel title="Our Research Informs" items={['Governments and policy makers','Human rights organisations','Legal professionals and academics','Faith leaders and communities','Media and the general public','Advocates and change makers']} />
    <div style="background:#f7f6f3; border-radius:4px; padding:1.25rem;"><h2 class="camp-h" style="font-size:1.125rem;">Recent &amp; Upcoming Research Topics</h2>{['The Global State of Overcrowding in Prisons 2024–2025','Mental Health in Long-Term Detention','Alternatives to Incarceration: What Works?','Women in Prison: Challenges and Opportunities','Children with Incarcerated Parents: Global Impact'].map(t => <p style="display:grid; grid-template-columns:1.5rem 1fr; gap:0.5rem; margin-top:0.6rem; font-family:var(--font-heading); color:var(--color-navy); font-size:0.875rem;"><Icon name="file-lines" size={18} />{t}</p>)}<a href="/resources/articles" style="color:#c9741f; font-size:0.8125rem; display:block; margin-top:0.75rem;">View all research reports →</a></div>
    <div style="background:#f7f6f3; border-radius:4px; padding:1.25rem; text-align:center;"><h2 class="camp-h" style="font-size:1.125rem;">Partner With Us</h2><p class="im-p" style="font-size:0.9375rem;">We collaborate with research institutes, NGOs and experts worldwide. Together we can build knowledge and create lasting change.</p><a href="/contact" class="btn btn--navy" style="margin-top:0.75rem;">Become a Research Partner →</a><div style="color:var(--color-navy); margin-top:0.75rem;"><Icon name="handshake" size={40} /></div></div>
  </section>
  <StatsRow label="Our Impact<br/>Through Research" items={[
    { icon: 'globe', num: '60+', text: 'Countries researched' }, { icon: 'people-group', num: '120+', text: 'Research partners worldwide' },
    { icon: 'file-lines', num: '25+', text: 'Reports and policy papers published' }, { icon: 'people-group', num: '1M+', text: 'People reached through our research' }, { icon: 'chart-line', num: 'Real Change', text: 'Policies influenced. Lives improved.' },
  ]} />
  <QuoteBanner dark left="ir-ql" right="ir-qr" quote="Information is power. But like all power,<br/>there are those who want to keep it for themselves." by="Julian Assange" />
  <LeadersBand title="Supported by People of Faith, Law, Health & Human Rights Leaders" sub="Together, we research. Together, we advocate. Together, we change lives." people={[
    { photo: 'ir-p1', name: 'Pope Leo XIV', role: 'Pope of the Catholic Church' }, { photo: 'ir-p2', name: 'Cardinal Matteo Zuppi', role: 'President, CEI' },
    { photo: 'ir-p3', name: 'Archbishop Desmond Tutu', role: '(RIP)' }, { photo: 'ir-p4', name: 'Mary Robinson', role: 'Former UN High Commissioner for Human Rights' }, { photo: 'ir-p5', name: 'Michelle Bachelet', role: 'Former UN High Commissioner for Human Rights' },
  ]} />
</Layout>
