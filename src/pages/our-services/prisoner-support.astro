---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Prisoner Support — IICC Mission" description="Pastoral visits, sacraments, prayer and hope for inmates across Australian correctional facilities.">

  <!-- Breadcrumb -->
  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/our-services">Our Programs</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Prisoner Support</span>
      </nav>
    </div>
  </div>

  <!-- Hero split -->
  <div class="hero-split" style="min-height:500px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <div style="display:flex;align-items:center;gap:1rem;">
        <img src="/IICC_Logo.png" alt="IICC Mission" style="height:3.5rem;object-fit:contain;" />
        <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
          <span style="display:block;color:#fff;font-size:clamp(1.75rem,4vw,2.75rem);">PRISON</span>
          <span style="display:block;color:var(--color-amber);font-size:clamp(1.75rem,4vw,2.75rem);">MINISTRY</span>
        </h1>
      </div>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:1.0625rem;color:var(--color-amber);font-weight:700;">No one is beyond the reach of God's love.</p>
      <p style="font-size:0.9375rem;color:rgba(255,255,255,0.85);line-height:1.7;">
        Our prison ministry team enters correctional facilities across Australia to bring prayer, pastoral care, sacraments and the transforming hope of the Gospel to those behind bars.
      </p>
      <a href="/contact" class="btn btn--amber">REQUEST A PRISON VISIT ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:320px;position:relative;">
      <img
        src="https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=800&h=600&fit=crop"
        alt="Prison ministry — pastoral care behind bars"
      />
      <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(18,26,56,0.9));padding:2rem 1.5rem 1.5rem;">
        <p style="font-family:var(--font-heading);font-size:0.9375rem;color:rgba(255,255,255,0.9);font-style:italic;">"I was in prison and you came to visit me." — Matthew 25:36</p>
      </div>
    </div>
  </div>

  <!-- Mission Cards -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow eyebrow--white">Our Commitment</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1rem,2vw,1.25rem);letter-spacing:0.15em;text-transform:uppercase;color:#fff;">HOW WE SERVE INSIDE</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="grid-3">
        {[
          { icon: '✝️', title: 'Pastoral Visits', desc: 'Regular visits to correctional facilities to pray with, listen to and accompany inmates on their journey.' },
          { icon: '🕊️', title: 'Sacraments & Liturgy', desc: 'Celebrating Mass, Confession, Anointing and other sacraments for Catholic inmates wherever possible.' },
          { icon: '📖', title: 'Scripture & Formation', desc: 'Bible studies, faith formation groups and spiritual reading to nourish the faith of those inside.' },
          { icon: '👨‍👩‍👧', title: 'Family Connection', desc: 'Supporting families of inmates through visits, letters, prayer and practical assistance.' },
          { icon: '📚', title: 'Education & Rehab', desc: 'Supporting education programs that equip inmates with skills and purpose for life after release.' },
          { icon: '🚪', title: 'Reintegration Support', desc: 'Walking alongside those about to be released to ensure they have the support they need on the outside.' },
        ].map(c => (
          <div class="card--dark" style="align-items:center;text-align:center;">
            <div class="card__icon" style="font-size:1.125rem;border-color:rgba(224,123,0,0.4);">{c.icon}</div>
            <p class="card__title">{c.title}</p>
            <p class="card__body">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Checklist section -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:center;">
        <div>
          <span class="eyebrow" style="display:block;margin-bottom:0.5rem;">Our Presence</span>
          <h2 class="section-title" style="margin-bottom:0.75rem;">We Walk Into the Darkness So No One Faces It Alone</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
          <span class="heart" style="display:block;margin-bottom:1rem;">♥</span>
          <p class="section-desc" style="max-width:none;margin-bottom:1.25rem;">
            Our teams enter prisons not just as visitors, but as bearers of hope. Every visit, every prayer, every sacrament is a reminder to an inmate that they are seen, loved and not forgotten.
          </p>
          <ul class="checklist" style="margin-bottom:1.5rem;">
            <li>Accredited prison chaplaincy and pastoral care</li>
            <li>Regular weekly and fortnightly visits to facilities</li>
            <li>One-on-one pastoral conversations and prayer</li>
            <li>Group faith formation and Bible study sessions</li>
            <li>Emergency pastoral support for inmates in crisis</li>
            <li>Support for families throughout the incarceration period</li>
          </ul>
          <a href="/contact" class="btn btn--amber">JOIN OUR TEAM ›</a>
        </div>
        <div style="border-radius:2px;overflow:hidden;min-height:340px;">
          <img
            src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=700&h=500&fit=crop"
            alt="Prison ministry prayer"
            style="width:100%;height:100%;object-fit:cover;"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Sub-pages nav -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Learn More</span>
        <h2 class="section-title">EXPLORE OUR PRISON MINISTRY</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="grid-3">
        {[
          { title: 'Education & Rehabilitation', href: '/our-services/prison-ministry/education-rehabilitation', icon: '📚' },
          { title: 'Family Support', href: '/our-services/prison-ministry/family-support', icon: '👨‍👩‍👧' },
          { title: 'Legal Assistance', href: '/our-services/prison-ministry/legal-assistance', icon: '⚖️' },
          { title: 'Prayer Requests', href: '/our-services/prison-ministry/prayer-requests', icon: '🙏' },
          { title: 'Reintegration Support', href: '/our-services/prison-ministry/reintegration-support', icon: '🚪' },
          { title: 'FAQ', href: '/our-services/prison-ministry/faq', icon: '❓' },
        ].map(l => (
          <a href={l.href} style="display:flex;align-items:center;gap:1rem;padding:1.25rem 1.5rem;background:var(--color-off-white);border-radius:2px;border:1px solid rgba(27,39,81,0.08);text-decoration:none;border-left:3px solid var(--color-amber);transition:background 0.2s;">
            <span style="font-size:1.125rem;">{l.icon}</span>
            <span style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-navy);font-weight:700;">{l.title}</span>
            <span style="margin-left:auto;color:var(--color-amber);font-weight:700;">›</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="amber-band">
    <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;">
      <div>
        <p style="font-family:var(--font-display);font-size:clamp(1.125rem,2.5vw,1.5rem);font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.375rem;">SUPPORT PRISON MINISTRY</p>
        <p style="font-size:0.9375rem;color:rgba(255,255,255,0.88);">Your gift brings pastoral care into facilities across Australia.</p>
      </div>
      <a href="/donate" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;white-space:nowrap;">♥ DONATE</a>
    </div>
  </div>

</Layout>
