---
import Layout from '../../../layouts/Layout.astro';
import MhDetail from '../../../components/MhDetail.astro';
---
<Layout title="Family Mental Health Support" description="Stronger Families. Brighter Tomorrows. You are not alone.">
  <MhDetail k="f" title="Family Mental<br/><span>Health Support</span>" subtitle="Stronger Families. Brighter Tomorrows.<br/>You are not alone."
    intro="The IICC Mission supports the mental health and emotional wellbeing of families with loved ones in prison or immigration detention, providing guidance, resources and compassionate support during challenging times."
    heroAlt="A mother embracing her two children" quote="“Cast your cares on the Lord and he will sustain you; he will never let the righteous be shaken.”" quoteRef="Psalm 55:22"
    band={[
      { icon: 'people-group', title: 'Emotional Support', text: 'A listening ear and practical encouragement for families.' },
      { icon: 'heart', title: 'Mental Health Guidance', text: 'Resources and strategies to manage stress, anxiety, and emotional challenges.' },
      { icon: 'book-open', title: 'Practical Resources', text: 'Information, tools and referrals to support family wellbeing.' },
      { icon: 'people-roof', title: 'Connection & Community', text: 'Support groups and networks with others who understand.' },
      { icon: 'leaf', title: 'Hope & Resilience', text: 'Helping families find strength, build resilience and look to a brighter tomorrow.' },
    ]}
    leftTitle="The Impact on Families"
    left={['When a loved one is in prison or immigration detention, the whole family can experience significant emotional and mental health challenges. Feelings of worry, sadness, stress, isolation and uncertainty are common, and can affect parents, partners, children and extended family members.']}
    leftNote="Families are often the silent victims, yet their strength and love are vital to the healing and reintegration journey."
    centerQuote="Family is where life begins<br/>and love never ends."
    gridTitle="Common Challenges Families Face"
    grid={[
      { icon: 'brain', label: 'Anxiety<br/>and stress' }, { icon: 'cloud-rain', label: 'Depression<br/>and low mood' }, { icon: 'user', label: 'Feelings of<br/>isolation' }, { icon: 'question', label: 'Uncertainty<br/>about the future' },
      { icon: 'child', label: 'Impact on<br/>children' }, { icon: 'heart-crack', label: 'Relationship<br/>strain' }, { icon: 'coins', label: 'Financial<br/>pressure' }, { icon: 'people-group', label: 'Stigma and<br/>judgement' },
    ]}
    supportTitle="How We Support Families"
    support={[
      { title: 'Listen & Support', text: 'A safe, non-judgemental space to share your feelings, concerns and questions.' },
      { title: 'Counselling & Referrals', text: 'Connection to professional counselling services and mental health support in your local area.' },
      { title: 'Resources & Guidance', text: 'Practical tools, educational materials and advice to help families manage challenges and build resilience.' },
      { title: 'Family Support Groups', text: 'Meet others who understand. Share experiences, learn coping strategies and build a supportive community.' },
      { title: 'Children & Young People', text: 'Age-appropriate support to help children and young people understand, cope and maintain their wellbeing.' },
    ]}
    story="I felt overwhelmed and so alone. Through IICC Mission I found people who listened, understood and gave me the support I needed to keep going for my children." storyBy="Family Member"
    alone={['It’s okay to feel overwhelmed.', 'There is hope, and help is available.', 'Talking to someone can make a difference.', 'Your family’s wellbeing matters.', 'You are valued. You are loved.', 'You are not alone.']}
    need="If you are a family member of someone in prison or immigration detention and would like to speak with someone, we are here for you. Reach out through our contact form or our IICC Mission team."
    needCta="Get Support Now"
    ctaTitle="Together, we can support stronger families and brighter tomorrows." ctaText="Compassion. Understanding. Support. Hope. A brighter tomorrow." />
</Layout>
