---
import Layout from '../../../layouts/Layout.astro';
import MhDetail from '../../../components/MhDetail.astro';
---
<Layout title="Mental Health in Long-Term Detention" description="Enduring uncertainty. Supporting resilience. Restoring hope.">
  <MhDetail k="l" title="Mental Health<br/><span>in Long Term</span><br/>Detention" subtitle="Enduring uncertainty. Supporting<br/>resilience. Restoring hope."
    intro="Long term detention can have a profound impact on mental health. The IICC Mission provides compassionate support, practical resources and spiritual care to help individuals in long term immigration detention, offering hope, dignity and a pathway to healing."
    heroAlt="A man praying by a barred window at sunrise" quote="“For I know the plans I have for you,” declares the Lord, “plans to prosper you and not to harm you, plans to give you hope and a future.”" quoteRef="Jeremiah 29:11"
    band={[
      { icon: 'brain', title: 'Mental Health Awareness', text: 'Recognising the unique mental health challenges of long term detention.' },
      { icon: 'people-group', title: 'Emotional Support', text: 'A listening ear, encouragement and connection with trained support workers.' },
      { icon: 'spa', title: 'Counselling & Referrals', text: 'Access to qualified professionals and referral pathways for ongoing care.' },
      { icon: 'book-open', title: 'Faith & Hope', text: 'Spiritual support, prayer and pastoral care for strength and healing.' },
      { icon: 'hand-holding-heart', title: 'Family & Community', text: 'Supporting connection with loved ones and community networks throughout the journey.' },
    ]}
    leftTitle="The Impact of<br/>Long Term Detention"
    left={['Prolonged detention can lead to significant mental health challenges, including anxiety, depression, trauma, sleep disturbances and feelings of isolation and hopelessness. Uncertainty about the future, separation from family and limited freedom can compound these effects.']}
    centerQuote="You are not alone<br/>in this journey.<br/>There is hope."
    gridTitle="Common Challenges"
    grid={[
      { icon: 'brain', label: 'Anxiety<br/>and stress' }, { icon: 'cloud-rain', label: 'Depression<br/>and low mood' }, { icon: 'user', label: 'Isolation<br/>and loneliness' }, { icon: 'heart-pulse', label: 'Trauma<br/>and PTSD' },
      { icon: 'moon', label: 'Sleep<br/>disturbances' }, { icon: 'question', label: 'Uncertainty<br/>about the future' }, { icon: 'heart-crack', label: 'Grief and loss' }, { icon: 'link-slash', label: 'Loss of purpose<br/>and self-worth' },
    ]}
    supportTitle="How We Support"
    support={[
      { title: 'Listen & Encourage', text: 'Provide a safe, non-judgemental space to talk and be heard.' },
      { title: 'Counselling & Referrals', text: 'Connect with mental health professionals and support services, either in detention or in the community.' },
      { title: 'Practical Resources', text: 'Provide self-help guides, workbooks and educational materials to support mental wellbeing.' },
      { title: 'Spiritual Support', text: 'Offer prayer, Scripture, pastoral care and faith-based encouragement for strength and peace.' },
      { title: 'Family Connection', text: 'Support communication with family and loved ones, helping maintain important relationships.' },
    ]}
    story="During my long detention, I felt I had lost everything. The prayers, letters and support from IICC Mission gave me strength to keep going. They reminded me that I am not alone." storyBy="Immigration Detainee"
    alone={['It’s okay to not be okay.', 'There is hope, and help is available.', 'Talking to someone can make a difference.', 'You are valued. You are loved.', 'Your life matters.']}
    need="If you are in long term detention and would like to speak with someone, we are here for you. Reach out through chaplains, support services or our IICC Mission team."
    ctaTitle="Together, we can support healthier minds and brighter lives." ctaText="Compassion. Understanding. Support. Hope. A brighter tomorrow." />
</Layout>
