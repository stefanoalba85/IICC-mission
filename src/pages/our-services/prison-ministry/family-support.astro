---
import Layout from '../../../layouts/Layout.astro';
import MinistryTemplate from '../../../components/MinistryTemplate.astro';
---
<Layout title="Family Support for Prisoners" description="When we support families, we strengthen the foundation of hope, healing and restoration.">
  <MinistryTemplate
    dir="family"
    kicker="Prison Ministry"
    title="Family" titleAccent="Support"
    subtitle="Bringing Christ’s Love and Hope Behind Bars"
    intro={['We believe that when we support families, we strengthen the foundation of hope, healing and restoration—for their loved one and for the whole family.']}
    heroQuote="I was in prison and you visited me. You cared for my family too." heroQuoteRef="Matthew 25:36"
    heroAlt="A priest comforting a distressed mother"
    bandTitle="Our Commitment to Families"
    bandIntro="We walk alongside families with compassion, providing practical help, emotional support and spiritual care throughout their journey."
    band={[
      { icon: 'hand-holding-heart', title: 'Emotional Support', text: 'We listen, care and walk with you through the highs and lows.' },
      { icon: 'people-group', title: 'Practical Assistance', text: 'Helping with resources, referrals and everyday challenges your family may face.' },
      { icon: 'cross', title: 'Spiritual Care', text: 'Prayer, encouragement and faith-filled support for strength and peace.' },
      { icon: 'house', title: 'Child & Youth Support', text: 'We support children and young people affected by parental incarceration.' },
      { icon: 'scale-balanced', title: 'Legal & System Guidance', text: 'We help families understand the system and connect with trusted partners.' },
      { icon: 'dove', title: 'Hope for the Future', text: 'We help families stay strong today and build a hopeful tomorrow.' },
    ]}
    leftTitle="What We Offer"
    left={[
      { icon: 'people-roof', title: 'Family Counselling', text: 'One-on-one and family support to cope with worry, stress and separation.' },
      { icon: 'people-group', title: 'Support Groups', text: 'Connecting with others who understand your journey.' },
      { icon: 'building-lock', title: 'Visitation Guidance', text: 'Help with understanding visitation processes and staying connected.' },
      { icon: 'clipboard-list', title: 'Financial & Community Referrals', text: 'Connecting you with services for food, housing, transport, and more.' },
      { icon: 'envelope', title: 'Letter & Phone Support', text: 'We help you stay connected with your loved one through letters and phone calls.' },
      { icon: 'hand-holding-medical', title: 'Crisis Support', text: 'Immediate support in times of crisis or urgent need.' },
    ]}
    centerQuote="Families are the heartbeat of healing and the hope that keeps the story alive." centerRef="IICC Mission"
    rightTitle="You Are Not Alone"
    right={[
      { icon: 'heart', title: 'We Understand', text: 'We know this journey is hard, and we are here for you.' },
      { icon: 'heart', title: 'We Care', text: 'Your family matters to us.' },
      { icon: 'person-praying', title: 'We Walk With You', text: 'You don’t have to face this alone.' },
      { icon: 'hand-holding-heart', title: 'We Offer Hope', text: 'There is hope for today and a brighter future.' },
    ]}
    box={['We support the family.', 'We strengthen hope.', 'We restore lives.']} boxAccent="Together, we can get through this."
    stripTitle="We Are Here for Every Member of the Family"
    strip={[
      { title: 'Parents', text: 'We support you with compassion and care.' },
      { title: 'Spouses & Partners', text: 'You are not alone. We are here for you.' },
      { title: 'Children', text: 'We care for young hearts and their future.' },
      { title: 'Grandparents', text: 'We honour your love and support.' },
      { title: 'Siblings', text: 'We walk with you every step of the way.' },
      { title: 'Whole Family', text: 'Together, we are stronger in God’s love.' },
    ]}
    supportTitle="Let us support your family today." supportText="You are valued. You are loved. You are never forgotten."
    supportCta="Get Support for Your Family"
  />
</Layout>
