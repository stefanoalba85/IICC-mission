---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Family Support — Prison Ministry — IICC Mission" description="Supporting the families of inmates — because incarceration affects the whole family.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services">Programs</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services/prisoner-support">Prison Ministry</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Family Support</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:420px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">Families Behind the Walls</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(1.5rem,3.5vw,2.5rem);">FAMILY</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(1.5rem,3.5vw,2.5rem);">SUPPORT</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-size:0.9375rem;color:rgba(255,255,255,0.85);line-height:1.7;">
        When someone goes to prison, the whole family is affected. IICC Mission stands beside families — offering pastoral care, practical support and the assurance that they are not alone.
      </p>
      <a href="/contact" class="btn btn--amber">CONTACT US ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=800&h=600&fit=crop" alt="Family support — hands together" />
    </div>
  </div>

  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:start;">
        <div>
          <h2 class="section-title" style="margin-bottom:0.75rem;">How We Support Families</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
          <ul class="checklist">
            <li>Pastoral visits and prayer support for families</li>
            <li>Helping families navigate the prison visitation system</li>
            <li>Facilitating communication between inmates and families</li>
            <li>Emotional and spiritual support for children of inmates</li>
            <li>Practical assistance — transport to visits, material aid</li>
            <li>Grief and trauma support for families dealing with the shame of incarceration</li>
            <li>Connecting families with community and faith-based support networks</li>
          </ul>
        </div>
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">Love one another deeply, from the heart.</p>
            <span class="quote-box__ref">— 1 Peter 1:22</span>
          </div>
          <div style="background:var(--color-amber);border-radius:2px;padding:1.5rem;text-align:center;">
            <p style="font-size:0.9375rem;color:#fff;line-height:1.65;margin-bottom:1rem;">If your family member is in prison, you are not alone. Reach out to us today.</p>
            <a href="/contact" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;">GET SUPPORT ›</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
