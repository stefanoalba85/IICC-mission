---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Education & Rehabilitation — Prison Ministry — IICC Mission" description="Equipping inmates with education, skills and purpose to build a better future.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services">Programs</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services/prisoner-support">Prison Ministry</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Education &amp; Rehabilitation</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:420px;">
    <div class="hero-split__text" style="background:#fff;gap:1.25rem;">
      <span class="eyebrow">Empowering Through Knowledge</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:var(--color-navy);font-size:clamp(1.5rem,3.5vw,2.5rem);">EDUCATION &amp;</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(1.5rem,3.5vw,2.5rem);">REHABILITATION</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p class="section-desc" style="max-width:none;">Knowledge, skills and purpose — the foundations of lasting rehabilitation. IICC Mission supports education programs that give inmates the tools for a genuinely new life.</p>
      <a href="/contact" class="btn btn--amber">GET INVOLVED ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img src="https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?w=800&h=600&fit=crop" alt="Education in prison — books and study" />
    </div>
  </div>

  <section class="section section--white">
    <div class="wrap">
      <div class="grid-3">
        {[
          { icon: '📚', title: 'Literacy & Numeracy', desc: 'Basic and advanced literacy and numeracy programs for inmates with limited prior education.' },
          { icon: '💼', title: 'Vocational Training', desc: 'Trade and vocational skills that open real employment pathways after release.' },
          { icon: '🎓', title: 'Tertiary Education', desc: 'Supporting inmates who wish to pursue university-level study and formal qualifications.' },
          { icon: '🧠', title: 'Life Skills', desc: 'Financial literacy, conflict resolution, communication and other essential life skills.' },
          { icon: '💻', title: 'Digital Literacy', desc: 'Technology skills for a world that increasingly requires digital competence.' },
          { icon: '✝️', title: 'Faith Formation', desc: 'Spiritual and theological education that nourishes the inner person and builds resilience.' },
        ].map(c => (
          <div class="card" style="align-items:center;text-align:center;">
            <div class="card__icon card__icon--filled">{c.icon}</div>
            <p class="card__title">{c.title}</p>
            <p class="card__body">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap" style="max-width:700px;text-align:center;">
      <span class="heart" style="color:var(--color-gold);font-size:1.25rem;display:block;margin-bottom:1rem;">♥</span>
      <blockquote style="font-family:var(--font-heading);font-size:clamp(1.125rem,2.5vw,1.5rem);color:#fff;font-style:italic;line-height:1.65;margin-bottom:0.75rem;">"My people are destroyed from lack of knowledge."</blockquote>
      <p style="font-size:0.875rem;color:var(--color-amber);letter-spacing:0.12em;font-weight:700;margin-bottom:2rem;">— Hosea 4:6</p>
      <a href="/donate" class="btn btn--amber">SUPPORT EDUCATION ›</a>
    </div>
  </section>

</Layout>
