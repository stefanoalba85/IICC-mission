---
import Layout from '../../../layouts/Layout.astro';
import MinistryTemplate from '../../../components/MinistryTemplate.astro';
---
<Layout title="Prison Education & Skills" description="Learning Today. A Brighter Tomorrow. Coming soon.">
  <MinistryTemplate
    dir="skills"
    kicker="Prison Ministry"
    title="Prison" titleAccent="Education<br/>&amp; Skills"
    subtitle="Learning Today. A Brighter Tomorrow."
    intro={['The IICC Mission is developing a new education and skills program to help incarcerated individuals build knowledge, confidence and practical skills for a brighter future.']}
    heroQuote="Give a person a skill and you give them a second chance." heroQuoteRef="IICC Mission"
    heroAlt="An inmate taking notes in a prison classroom"
    bandTitle="Coming Soon"
    bandIntro="A new initiative of the IICC Mission is being prepared. This program will provide education, training and skills development for incarcerated individuals, helping them build confidence, gain practical skills and create real opportunities for life after release."
    band={[
      { icon: 'book-open', title: 'Education Programs', text: 'Providing access to learning, literacy and personal development.' },
      { icon: 'screwdriver-wrench', title: 'Practical Skills', text: 'Building job-ready skills for real opportunities in the community.' },
      { icon: 'people-group', title: 'Mentorship and Guidance', text: 'Working with volunteers, professionals and faith leaders to support growth and reintegration.' },
      { icon: 'briefcase', title: 'Employment Readiness', text: 'Helping individuals develop skills, confidence and work readiness for a brighter future.' },
      { icon: 'chart-line', title: 'Pathways to Reintegration', text: 'Creating opportunities for meaningful employment and independent living after release.' },
    ]}
    leftTitle="Our Commitment"
    left={[
      { icon: 'graduation-cap', title: 'Accessible Learning', text: 'Tailored education and skills programs.' },
      { icon: 'people-group', title: 'Supportive Environment', text: 'Encouragement, guidance and faith-based support.' },
      { icon: 'handshake', title: 'Community Partnerships', text: 'Working with organisations, businesses and volunteers.' },
      { icon: 'file-lines', title: 'Real Opportunities', text: 'Helping individuals prepare for successful reintegration.' },
      { icon: 'heart', title: 'A Brighter Tomorrow', text: 'Building hope, dignity and purpose through education and skills.' },
    ]}
    rightTitle="Stay Connected"
    right={[
      { icon: 'bell', text: 'Follow our updates for announcements.' },
      { icon: 'globe', text: 'Learn more about our programs.' },
      { icon: 'heart', text: 'Join us in supporting new opportunities for those in need.' },
      { icon: 'people-group', text: 'Partner with us to make a lasting difference.' },
    ]}
    box={['This program is coming soon.', 'Stay connected.']} boxAccent="A new chapter of the IICC Mission journey will be announced soon."
    strip={[
      { title: 'Knowledge Builds Confidence', text: '' },
      { title: 'Skills Create Opportunities', text: '' },
      { title: 'Training Builds Independence', text: '' },
      { title: 'Education Today, A Brighter Tomorrow', text: '' },
    ]}
    supportTitle="Together we can create brighter futures." supportText="Education. Skills. Opportunities. Restoration."
    supportCta="Support Our Prison Ministry"
  />
</Layout>
