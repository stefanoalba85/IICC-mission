---
import Layout from '../../../layouts/Layout.astro';
import MinistryTemplate from '../../../components/MinistryTemplate.astro';
---
<Layout title="Restorative Justice" description="Healing Relationships. Building Safer Communities. A Brighter Tomorrow.">
  <MinistryTemplate
    dir="restorative"
    kicker="Prison Ministry"
    title="Restorative" titleAccent="Justice"
    subtitle="Healing Relationships. Building Safer Communities. A Brighter Tomorrow."
    intro={['The IICC Mission promotes restorative justice within the prison system, supporting opportunities for accountability, healing and reconciliation between individuals, families and communities.']}
    heroQuote="Be reconciled to one another." heroQuoteRef="2 Corinthians 5:18"
    heroAlt="A priest in conversation with an inmate"
    bandTitle="Our Restorative Justice Approach"
    bandIntro="We support programs and initiatives that encourage accountability, dialogue, healing and reintegration, helping to break the cycle of crime and build safer, stronger communities."
    band={[
      { icon: 'people-group', title: 'Accountability and Responsibility', text: 'Encouraging individuals to take responsibility for their actions and make positive choices for the future.' },
      { icon: 'heart', title: 'Healing and Reconciliation', text: 'Supporting opportunities for dialogue, forgiveness and restored relationships where appropriate.' },
      { icon: 'people-roof', title: 'Family and Community Involvement', text: 'Helping to rebuild relationships with family and community through supported processes and programs.' },
      { icon: 'seedling', title: 'Reintegration and Second Chances', text: 'Providing practical support, education and guidance to help individuals successfully reintegrate into society.' },
      { icon: 'shield-halved', title: 'Safer Communities', text: 'Working towards long-term change by addressing the causes of offending and supporting positive community outcomes.' },
    ]}
    leftTitle="What We Offer"
    left={[
      { icon: 'comments', title: 'Facilitated Dialogue', text: 'Where appropriate, supporting restorative conversations between individuals, families and affected community members.' },
      { icon: 'people-group', title: 'Victim Awareness', text: 'Education and reflection to help individuals understand the impact of their actions on others.' },
      { icon: 'file-lines', title: 'Program Referrals', text: 'Connecting individuals with restorative justice programs and support services.' },
      { icon: 'book-open', title: 'Spiritual Support', text: 'Prayer, guidance and faith-based reflection to encourage personal growth and reconciliation.' },
      { icon: 'handshake', title: 'Reintegration Support', text: 'Practical assistance with education, employment pathways and community connections.' },
    ]}
    centerQuote="Restorative justice is not about erasing the past, but about creating a better future for individuals, families and communities." centerRef="IICC Mission"
    rightTitle="You Are Not Alone"
    right={[
      { icon: 'heart', title: 'We Listen', text: 'Your story matters.' },
      { icon: 'people-group', title: 'We Understand', text: 'We recognise that change is possible.' },
      { icon: 'cross', title: 'We Support', text: 'We walk with you on your journey of accountability and hope.' },
      { icon: 'hand-holding-heart', title: 'We Encourage', text: 'We believe in second chances and the power of restoration.' },
      { icon: 'book-open', title: 'We Build', text: 'We help you develop the tools to rebuild your life.' },
    ]}
    box={['People can change.', 'Relationships can heal.', 'Communities can be stronger.']} boxAccent="Together, we build a brighter tomorrow."
    stripTitle="Real People. Real Change."
    strip={[
      { title: 'Greater Awareness', text: 'Understanding the impact of their actions.' },
      { title: 'Healing Relationships', text: 'Opportunities for dialogue and reconciliation.' },
      { title: 'New Opportunities', text: 'Building skills, confidence and a positive future.' },
      { title: 'Stronger Communities', text: 'Safer communities for future generations.' },
      { title: 'A Brighter Tomorrow', text: 'Restoration brings hope and new beginnings.' },
    ]}
    supportTitle="Together we can restore lives." supportText="Accountability. Healing. Reconciliation. Stronger Communities."
    supportCta="Support Our Prison Ministry"
  />
</Layout>
