---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Reintegration Support — Prison Ministry — IICC Mission" description="Practical and spiritual support for former prisoners returning to the community.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services">Programs</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services/prisoner-support">Prison Ministry</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Reintegration Support</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:420px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">From Inside to Outside</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(1.5rem,3.5vw,2.5rem);">REINTEGRATION</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(1.5rem,3.5vw,2.5rem);">SUPPORT</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-size:0.9375rem;color:rgba(255,255,255,0.85);line-height:1.7;">The moment someone walks out of prison is critical. Without support, many return. With it, lives change. IICC Mission is there at the gate and beyond.</p>
      <a href="/contact" class="btn btn--amber">GET SUPPORT ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=800&h=600&fit=crop" alt="New beginnings — walking forward" />
    </div>
  </div>

  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:start;">
        <div>
          <h2 class="section-title" style="margin-bottom:0.75rem;">What We Offer After Release</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
          <ul class="checklist">
            <li>Pre-release planning and support conversations</li>
            <li>Connecting with housing services before the release date</li>
            <li>Help with welfare registration and Centrelink</li>
            <li>Employment pathways and vocational referrals</li>
            <li>Mentoring from trained Hope Companions</li>
            <li>Ongoing pastoral care and prayer support</li>
            <li>Faith community connection and belonging</li>
            <li>Family reconciliation support</li>
          </ul>
        </div>
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">For I know the plans I have for you — plans to prosper you and not to harm you, plans to give you hope and a future.</p>
            <span class="quote-box__ref">— Jeremiah 29:11</span>
          </div>
          <div style="background:var(--color-amber);border-radius:2px;padding:1.5rem;text-align:center;">
            <p style="font-size:0.9375rem;color:#fff;line-height:1.65;margin-bottom:1rem;">Are you or someone you know about to be released? Contact us now so we can begin planning support.</p>
            <a href="/contact" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;">CONTACT US ›</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
