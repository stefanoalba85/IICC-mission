---
import Layout from '../../../layouts/Layout.astro';
import MinistryTemplate from '../../../components/MinistryTemplate.astro';
---
<Layout title="Reintegration Support" description="We walk alongside former inmates as they return to society with purpose, dignity and hope.">
  <MinistryTemplate
    dir="reintegration"
    kicker="Prison Ministry"
    title="Reintegration" titleAccent="Support"
    subtitle="Bringing Christ’s Love and Hope Behind Bars"
    intro={['We believe that every person has the potential to change, heal, and build a better future. Our reintegration support walks alongside former inmates as they return to society, empowering them to live with purpose, dignity, and hope.']}
    heroQuote="I was in prison and you visited me. You came alongside me when I needed a new beginning." heroQuoteRef="Matthew 25:36"
    heroAlt="A smiling man working in a carpentry workshop"
    bandTitle="Our Commitment to Your Future"
    bandIntro="We provide the tools, resources, and relationships that support a successful return to society and a fulfilling life."
    band={[
      { icon: 'user', title: 'Personal Development', text: 'Building confidence, self-worth, and a positive mindset.' },
      { icon: 'briefcase', title: 'Employment Support', text: 'Job readiness, resumé help, and connection to employers.' },
      { icon: 'house', title: 'Housing Assistance', text: 'Help finding safe, stable, and affordable housing.' },
      { icon: 'people-arrows', title: 'Family Reconnection', text: 'Restoring and strengthening relationships with loved ones.' },
      { icon: 'book-open', title: 'Education & Training', text: 'Access to education, vocational training, and life skills development.' },
      { icon: 'hand-holding-heart', title: 'Faith & Spiritual Growth', text: 'Faith-based support to build hope, purpose, and a renewed identity in Christ.' },
      { icon: 'bullseye', title: 'Ongoing Support', text: 'Continued care and mentorship to help you stay on track and thrive.' },
    ]}
    features={[
      { title: 'Working Toward a Better Future', text: 'Hands-on training and job opportunities help build skills and confidence for lasting employment.' },
      { title: 'Education Opens Doors', text: 'Continuing education and vocational training create new possibilities and brighter tomorrows.' },
      { title: 'A Healthy Body, a Strong Mind', text: 'Physical fitness builds discipline, strength, and resilience for a better life ahead.' },
      { title: 'Community & Connection', text: 'Positive relationships and supportive communities help you belong, grow, and give back.' },
    ]}
    leftTitle="How We Support You"
    left={[
      { icon: 'clipboard-list', title: 'Release Planning', text: 'Preparing for a successful transition before release.' },
      { icon: 'people-arrows', title: 'Mentoring & Counselling', text: 'One-on-one support to overcome challenges and stay focused.' },
      { icon: 'id-card', title: 'Document & ID Support', text: 'Assistance with IDs, documents, and essential paperwork.' },
      { icon: 'hand-holding-heart', title: 'Life & Wellbeing', text: 'Support for mental health, addiction recovery, and personal wellness.' },
      { icon: 'people-group', title: 'Community Connections', text: 'Linking you with faith communities, resources, and support networks.' },
      { icon: 'kit-medical', title: 'Healthcare Referrals', text: 'Connecting you to healthcare and wellness services.' },
    ]}
    centerQuote="Therefore, if anyone is in Christ, the new creation has come: The old has gone, the new is here!" centerRef="2 Corinthians 5:17"
    boxUnderCenter
    box={['You are not defined by your past.', 'You are defined by your future.', 'We are here to walk with you.']} boxAccent="Together, we build new beginnings."
    rightTitle="Pathways to Success"
    right={[
      { icon: 'graduation-cap', title: 'Education & Certification', text: 'Earn certificates and qualifications to advance your career.' },
      { icon: 'briefcase', title: 'Employment Partnerships', text: 'We connect you with employers who believe in second chances.' },
      { icon: 'people-arrows', title: 'Skill Building', text: 'Develop marketable skills for long-term success.' },
      { icon: 'cross', title: 'Faith & Purpose', text: 'Discover purpose, hope, and a new identity in Christ.' },
      { icon: 'handshake', title: 'Leadership & Giving Back', text: 'Be a mentor and inspire others on their journey.' },
      { icon: 'hand-holding-dollar', title: 'Financial Literacy', text: 'Learn budgeting, saving, and planning for a strong future.' },
    ]}
    stripTitle="Your Journey, Our Support – Every Step of the Way" stripLight stripNumbered
    strip={[
      { title: 'Prepare', text: 'We help you prepare for release.' },
      { title: 'Transition', text: 'We welcome you and help with your first steps.' },
      { title: 'Equip', text: 'We provide training, tools, and resources.' },
      { title: 'Grow', text: 'You build skills, confidence, and stability.' },
      { title: 'Thrive', text: 'You achieve goals and create a new life.' },
      { title: 'Inspire', text: 'You give back and help others find hope.' },
    ]}
    supportTitle="A new beginning is possible." supportText="Let us walk with you."
    supportCta="Get Reintegration Support Today"
  />
</Layout>
