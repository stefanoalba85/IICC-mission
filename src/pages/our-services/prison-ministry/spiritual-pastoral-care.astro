---
import Layout from '../../../layouts/Layout.astro';
import MinistryTemplate from '../../../components/MinistryTemplate.astro';
---
<Layout title="Spiritual & Pastoral Care" description="Bringing Christ's Love and Hope Behind Bars.">
  <MinistryTemplate
    dir="spiritual"
    kicker="Prison <span style='color:#b8892b'>Ministry</span>"
    title="Spiritual &amp;<br/>Pastoral Care" titleAccent=""
    subtitle="Bringing Christ’s Love and Hope Behind Bars"
    intro={['We believe every person is created in the image of God and has infinite dignity. Our Spiritual & Pastoral Care brings Christ’s presence to inmates, offering hope, comfort, guidance and a path to healing and renewal.']}
    heroQuote="I was in prison and you visited me." heroQuoteRef="Matthew 25:36"
    heroAlt="A priest comforting a man in prison"
    bandTitle="Our Commitment"
    bandIntro="We accompany inmates on their faith journey through prayer, sacraments, spiritual guidance and pastoral support. No one is forgotten. No one is beyond hope."
    band={[
      { icon: 'hands-praying', title: 'Prayer', text: 'We pray with and for inmates every day.' },
      { icon: 'book-bible', title: 'God’s Word', text: 'Bringing the Bible and Gospel messages of hope.' },
      { icon: 'cross', title: 'Sacraments', text: 'Offering the Eucharist, Reconciliation and other sacraments.' },
      { icon: 'person-cane', title: 'Pastoral Care', text: 'One-on-one spiritual support, listening with compassion and respect.' },
      { icon: 'people-roof', title: 'Family Support', text: 'Encouraging and supporting families through prayer and guidance.' },
      { icon: 'dove', title: 'Hope & Healing', text: 'Helping hearts find peace, purpose and a new beginning.' },
    ]}
    leftTitle="What We Offer"
    left={[
      { icon: 'hand-holding-heart', title: 'Chaplaincy Visits', text: 'Regular visits by priests, chaplains and pastoral volunteers.' },
      { icon: 'wine-glass', title: 'Mass & Eucharist', text: 'Celebrating Mass and bringing Holy Communion.' },
      { icon: 'people-arrows', title: 'Reconciliation', text: 'The Sacrament of Reconciliation for healing and forgiveness.' },
      { icon: 'book-open', title: 'Bible Study & Reflection', text: 'Faith formation through Bible study and sharing the Word of God.' },
      { icon: 'heart', title: 'Spiritual Direction', text: 'Guidance and mentoring for personal growth in faith.' },
      { icon: 'people-group', title: 'Pastoral Counselling', text: 'Emotional and spiritual support for life’s challenges.' },
    ]}
    centerQuote="Your presence brings light into places the world forgets. Your care restores what was broken." centerRef="Ambassador & Founder, IICC Mission"
    rightTitle="Our Approach"
    right={[
      { icon: 'heart', title: 'We Listen', text: 'Every person’s story matters.' },
      { icon: 'hands', title: 'We Respect', text: 'We treat everyone with dignity, compassion and love.' },
      { icon: 'cross', title: 'We Encourage', text: 'We strengthen faith and inspire a life of purpose.' },
      { icon: 'people-group', title: 'We Walk Together', text: 'We journey together toward healing and restoration.' },
      { icon: 'shield-heart', title: 'We Believe', text: 'In second chances and the transforming power of Christ.' },
    ]}
    box={['You are seen.', 'You are loved.', 'You are not alone.']} boxAccent="God has a plan for you."
    stripTitle="Making a Difference Every Day"
    strip={[
      { title: 'Bringing Christ’s Presence', text: 'We bring Christ behind bars through our presence and love.' },
      { title: 'Sharing Hope', text: 'The Gospel gives hope where there is pain.' },
      { title: 'Restoring Dignity', text: 'Through the sacraments, we restore dignity and joy.' },
      { title: 'Building Relationships', text: 'We build trust and friendship that lasts beyond prison.' },
      { title: 'Inspiring New Beginnings', text: 'With faith, anything is possible. A new future can begin today.' },
    ]}
    supportTitle="Support our Spiritual & Pastoral Care Ministry" supportText="Your prayers, time and generosity bring Christ’s love behind bars."
  />
</Layout>
