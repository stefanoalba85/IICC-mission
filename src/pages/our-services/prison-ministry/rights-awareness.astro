---
import Layout from '../../../layouts/Layout.astro';
import MinistryTemplate from '../../../components/MinistryTemplate.astro';
---
<Layout title="Rights Awareness" description="Knowledge. Fairness. Dignity for All.">
  <MinistryTemplate
    dir="rights"
    kicker="Prison Ministry"
    title="Rights" titleAccent="Awareness"
    subtitle="Knowledge. Fairness. Dignity for All."
    intro={['The IICC Mission provides information and education to help incarcerated individuals understand their rights, the legal processes that affect them, and the support services available, empowering them to make informed decisions and access the help they need.']}
    heroQuote="The truth will set you free." heroQuoteRef="John 8:32"
    heroAlt="A priest reviewing documents with an inmate"
    bandTitle="How We Support Rights Awareness"
    bandIntro="We provide clear, accurate and easy-to-understand information about legal rights and processes, working in partnership with legal professionals, chaplains and support organisations."
    band={[
      { icon: 'book-open', title: 'Information Sessions', text: 'Simple, clear guidance on rights, legal processes and available support services.' },
      { icon: 'file-lines', title: 'Educational Materials', text: 'Easy-to-understand resources on key rights, procedures and next steps.' },
      { icon: 'people-group', title: 'Referrals to Legal Services', text: 'Connecting individuals with trusted legal professionals and support organisations.' },
      { icon: 'comments', title: 'One-on-One Guidance', text: 'Support from chaplains and trained volunteers to help answer questions and reduce confusion.' },
      { icon: 'scale-balanced', title: 'Advocacy and Awareness', text: 'Promoting fair treatment, transparency and respect for the rights and dignity of all incarcerated individuals.' },
    ]}
    leftTitle="Key Areas We Cover"
    left={[
      { icon: 'gavel', title: 'Legal Rights', text: 'Understanding your rights while in prison or detention.' },
      { icon: 'clipboard-list', title: 'Disciplinary Processes', text: 'Information on procedures and how to respond.' },
      { icon: 'people-group', title: 'Parole & Release', text: 'Guidance on eligibility and processes.' },
      { icon: 'scale-balanced', title: 'Appeals & Reviews', text: 'General information on appeal options.' },
      { icon: 'hand-holding-heart', title: 'Support Services', text: 'Referrals to legal aid, welfare and rehabilitation programs.' },
      { icon: 'globe', title: 'Immigration Matters', text: 'Information and referral for non-citizens where applicable.' },
    ]}
    centerQuote="When people know their rights, they can make better choices, have a stronger voice, and take positive steps toward a brighter future." centerRef="IICC Mission"
    rightTitle="You Are Not Alone"
    right={[
      { icon: 'heart', title: 'We Listen', text: 'Your questions matter.' },
      { icon: 'people-group', title: 'We Inform', text: 'We provide clear and honest information.' },
      { icon: 'cross', title: 'We Support', text: 'We walk with you on your journey.' },
      { icon: 'book-open', title: 'We Connect', text: 'We link you to trusted legal and community services.' },
      { icon: 'handshake', title: 'We Believe', text: 'Everyone deserves fair treatment, respect and a second chance.' },
    ]}
    box={['Knowledge creates hope.', 'Information empowers change.']} boxAccent="Together, we build brighter futures."
    stripTitle="Real People. Real Impact."
    strip={[
      { title: 'More Confidence', text: 'Understanding their rights reduces fear and uncertainty.' },
      { title: 'Better Decisions', text: 'Information helps people make informed choices.' },
      { title: 'Greater Access', text: 'Connections to legal and community services.' },
      { title: 'Restored Dignity', text: 'Knowledge brings strength, purpose and hope.' },
      { title: 'A Brighter Tomorrow', text: 'When rights are respected, lives can be rebuilt.' },
    ]}
    supportTitle="Let’s promote fairness, dignity and hope." supportText="Support our Prison Ministry and help us empower more lives."
    supportCta="Support Our Mission"
  />
</Layout>
