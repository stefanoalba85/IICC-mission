---
import Layout from '../../../layouts/Layout.astro';
import ServeTemplate from '../../../components/ServeTemplate.astro';
const img = (n: string) => `/images/who-we-serve/${n}.jpg`;
---
<Layout title="Incarcerated Individuals" description="Every person, regardless of their past, has inherent dignity and deserves hope, compassion and a second chance.">
  <ServeTemplate
    title="Incarcerated" titleAccent="Individuals"
    lead="Every person, regardless of their past, has inherent dignity and deserves hope, compassion and a second chance."
    text="The IICC Mission stands alongside men and women in prisons, offering spiritual, emotional and practical support, and helping to build pathways toward rehabilitation, restoration and a brighter future."
    heroImg={img('inc-hero')} heroAlt="A man praying in a prison cell lit by the window"
    reality="Incarcerated individuals often face isolation, uncertainty and significant personal challenges. Many carry feelings of shame, rejection and hopelessness, yet each person has a story, a family, and the potential for a new beginning."
    quote="I was in prison and you visited me." quoteRef="Matthew 25:36" realityImg={img('inc-reality')}
    supportIntro="Through faith, compassion and practical assistance, the IICC Mission provides:"
    support={[
      { title: 'Spiritual & Pastoral Care', icon: 'pray', items: ['Chaplaincy support', 'Prayer and guidance', 'Pastoral visits', 'A message of hope'] },
      { title: 'Letters & Encouragement', icon: 'mail', items: ['Regular communication', 'Positive reinforcement', 'Building connection', 'Reducing isolation'] },
      { title: 'Hope & Connection', icon: 'people', items: ['A listening ear', 'Human connection', 'Support networks', 'Reminding them they are not forgotten'] },
      { title: 'Education & Skills', icon: 'book', items: ['Access to educational resources', 'Life skills development', 'Personal growth', 'Opportunities for a better future'] },
      { title: 'Pathways to Restoration', icon: 'road', items: ['Rehabilitation support', 'Reintegration pathways', 'Employment opportunities', 'Preparing for a fresh start in the community'] },
    ]}
    bandImg={img('inc-band')}
    bandQuote="No one is beyond hope. With support, encouragement and the right opportunities, lives can change and new beginnings are possible."
    ctaTitle="Building a Brighter Tomorrow"
    ctaText="We believe in the potential for change. With the right support, encouragement and opportunities, incarcerated individuals can rebuild their lives, restore relationships and contribute positively to their families and communities."
  />
</Layout>
