---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Our Programs — IICC Mission" description="Prison ministry, immigration detention, pastoral care, advocacy and more — programs that restore hope.">

  <!-- Hero split -->
  <div class="hero-split" style="min-height:480px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">Faith in Action</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(2rem,5vw,3.5rem);">OUR</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(2rem,5vw,3.5rem);">PROGRAMS</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2.5vw,1.25rem);color:rgba(255,255,255,0.85);line-height:1.6;">
        Accompaniment, empowerment and hope — through every program we run.
      </p>
    </div>
    <div class="hero-split__photo" style="min-height:320px;position:relative;">
      <img
        src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=800&h=600&fit=crop"
        alt="IICC Mission programs — community service"
      />
      <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(18,26,56,0.85));padding:2rem 1.5rem 1.5rem;">
        <p style="font-family:var(--font-heading);font-size:0.9375rem;color:rgba(255,255,255,0.9);font-style:italic;line-height:1.55;">"Whatever you did for one of the least of these brothers and sisters of mine, you did for me." — Matthew 25:40</p>
      </div>
    </div>
  </div>

  <!-- Programs grid -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow">How We Serve</span>
        <span class="heart">♥</span>
        <h2 class="section-title">PROGRAMS &amp; MINISTRIES</h2>
        <span class="rule rule--amber rule--center"></span>
        <p class="section-desc" style="text-align:center;margin-inline:auto;margin-top:0.5rem;">
          Each program is rooted in the Gospel call to see Christ in the face of those who suffer — and to respond with love.
        </p>
      </div>

      <div class="grid-3" style="margin-bottom:3rem;">
        {[
          {
            icon: '🙏',
            title: 'Prison Ministry',
            desc: 'Pastoral visits, sacraments, prayer and hope for inmates across Australian correctional facilities.',
            sub: ['Education & Rehabilitation', 'Family Support', 'Legal Assistance', 'Prayer Support', 'Reintegration'],
            href: '/our-services/prisoner-support',
          },
          {
            icon: '⚖️',
            title: 'Immigration Detention',
            desc: 'Walking alongside detainees with pastoral care, humanitarian aid, legal referrals and unwavering compassion.',
            sub: ['Pastoral Care', 'Legal Referrals', 'Family Support', 'Humanitarian Aid', 'Community Integration'],
            href: '/our-services/immigration-detention',
          },
          {
            icon: '💬',
            title: 'Spiritual & Pastoral Care',
            desc: 'Faith-based counselling, prayer and spiritual guidance for individuals, families and communities in need.',
            sub: ['Prayer Ministry', 'Pastoral Counselling', 'Spiritual Guidance', 'Faith Community'],
            href: '/our-services/spiritual-pastoral-care',
          },
          {
            icon: '🍞',
            title: 'Francis Bakery',
            desc: 'Fresh bread, soup kitchens and meals for the homeless — compassion that feeds the body and the soul.',
            sub: ['Daily Bread', 'Soup Kitchens', 'Shelter Support', 'Community Partners'],
            href: '/bakery',
          },
          {
            icon: '📣',
            title: 'Advocacy',
            desc: 'Raising our voice for justice, dignity and systemic reform for people inside and outside detention.',
            sub: ['Immigration Reform', 'Autism Advocacy', 'Legal Assistance', 'Policy Reform'],
            href: '/advocacy',
          },
          {
            icon: '🤝',
            title: 'Humanitarian Support',
            desc: 'Emergency assistance, welfare support and practical help for individuals and families in crisis.',
            sub: ['Emergency Aid', 'Welfare Referrals', 'Crisis Support', 'Material Assistance'],
            href: '/our-services/humanitarian-support',
          },
        ].map(p => (
          <div class="card" style="gap:0.75rem;">
            <div class="card__icon card__icon--filled" style="font-size:1.125rem;">{p.icon}</div>
            <p class="card__title">{p.title}</p>
            <p class="card__body" style="flex:1;">{p.desc}</p>
            <ul style="list-style:none;padding:0;margin:0;border-top:1px solid rgba(27,39,81,0.08);padding-top:0.75rem;width:100%;display:flex;flex-direction:column;gap:0.25rem;">
              {p.sub.map(s => (
                <li style="font-size:0.75rem;color:var(--color-muted);display:flex;align-items:center;gap:0.375rem;">
                  <span style="color:var(--color-amber);font-size:0.5rem;">●</span> {s}
                </li>
              ))}
            </ul>
            <a href={p.href} class="btn btn--amber" style="font-size:0.75rem;padding:0.5rem 1.25rem;margin-top:0.25rem;width:100%;justify-content:center;">LEARN MORE ›</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mission statement band -->
  <section class="section section--navy">
    <div class="wrap" style="max-width:760px;">
      <div style="text-align:center;">
        <span class="eyebrow eyebrow--white" style="display:block;margin-bottom:0.75rem;">Our Approach</span>
        <span class="heart" style="color:var(--color-gold);font-size:1.25rem;display:block;margin-bottom:1rem;">♥</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1rem,2vw,1.125rem);letter-spacing:0.15em;text-transform:uppercase;color:#fff;margin-bottom:1rem;">TO ACCOMPANY, EMPOWER AND RESTORE HOPE</h2>
        <span class="rule rule--amber rule--center" style="display:block;margin-bottom:1.5rem;"></span>
        <p style="font-size:0.9375rem;color:rgba(255,255,255,0.82);line-height:1.8;margin-bottom:1.5rem;">
          At IICC Mission, we don't just provide services — we walk alongside people. We believe that every human being carries the image of God, and that genuine accompaniment — being present, being patient, being persistent — is the most powerful force for transformation.
        </p>
        <a href="/our-mission" class="btn btn--amber">READ OUR MISSION ›</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="amber-band">
    <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;">
      <div>
        <p style="font-family:var(--font-display);font-size:clamp(1.125rem,2.5vw,1.5rem);font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.375rem;">SUPPORT OUR PROGRAMS</p>
        <p style="font-size:0.9375rem;color:rgba(255,255,255,0.88);line-height:1.5;">Your donation funds the work that changes lives every single day.</p>
      </div>
      <a href="/donate" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;white-space:nowrap;">♥ DONATE NOW</a>
    </div>
  </div>

</Layout>
