---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Family Support — Immigration Detention — IICC Mission" description="Supporting the families of immigration detainees through prayer, practical help and pastoral care.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services">Programs</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services/immigration-detention">Immigration Detention</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Family Support</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:420px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">Families Are Not Forgotten</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(1.5rem,3.5vw,2.5rem);">FAMILY</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(1.5rem,3.5vw,2.5rem);">SUPPORT</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-size:0.9375rem;color:rgba(255,255,255,0.85);line-height:1.7;">When a family member is in detention, the entire family suffers. IICC Mission stands with families of detainees — offering pastoral care, practical assistance and the knowledge that they are not alone.</p>
      <a href="/contact" class="btn btn--amber">REACH OUT ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=800&h=600&fit=crop" alt="Family — togetherness and hope" />
    </div>
  </div>

  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:start;">
        <div>
          <h2 class="section-title" style="margin-bottom:0.75rem;">Support for Families of Detainees</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
          <ul class="checklist">
            <li>Pastoral visits and prayer with affected families</li>
            <li>Information about the detention process and detainee rights</li>
            <li>Connecting families with legal referrals and advocacy</li>
            <li>Emotional and spiritual support through periods of uncertainty</li>
            <li>Practical assistance — food, transport and material aid</li>
            <li>Helping children cope with the absence of a parent in detention</li>
            <li>Facilitation of family visits where possible</li>
          </ul>
          <a href="/contact" class="btn btn--amber" style="margin-top:1.5rem;display:inline-flex;">GET IN TOUCH ›</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">Carry each other's burdens, and in this way you will fulfil the law of Christ.</p>
            <span class="quote-box__ref">— Galatians 6:2</span>
          </div>
          <div style="background:var(--color-amber);border-radius:2px;padding:1.5rem;text-align:center;">
            <p style="font-size:0.9375rem;color:#fff;line-height:1.65;margin-bottom:1rem;">Is your family member in detention? We are here for you. Contact us today.</p>
            <a href="/contact" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;">CONTACT US ›</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
