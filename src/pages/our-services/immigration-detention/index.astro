---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Immigration Detention Ministry" description="Bringing Christ's Love and Hope Behind Walls. We walk with people in immigration detention centres and their families.">

  <!-- Hero split: logo/title left, photo right -->
  <div class="hero-split" style="min-height:520px;">
    <div class="hero-split__text" style="background:#fff;gap:1.25rem;">
      <img src="/IICC_Logo.png" alt="IICC Mission" style="height:80px;width:auto;object-fit:contain;" />
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.25rem);font-weight:900;color:var(--color-navy);text-transform:uppercase;line-height:1.05;">
        IMMIGRATION<br>DETENTION<br>MINISTRY
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:1rem;color:var(--color-muted);font-style:italic;">
        Bringing Christ's Love and Hope Behind Walls
      </p>
      <span class="heart">♥</span>
      <p class="section-desc" style="max-width:none;">
        We walk with people in immigration detention centres and their families, offering spiritual care, practical support, legal referrals, and a voice for justice and human dignity.
      </p>
    </div>
    <div class="hero-split__photo" style="min-height:360px;">
      <img
        src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=800&h=700&fit=crop"
        alt="Immigration Detention Ministry — pastoral care"
      />
      <div class="hero-split__quote">
        <span class="hero-split__quote-mark">"</span>
        <p class="hero-split__quote-text">I was a stranger and you welcomed me.</p>
        <span class="hero-split__quote-ref">— Matthew 25:35</span>
      </div>
    </div>
  </div>

  <!-- Our Mission — navy -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow eyebrow--white">What We Stand For</span>
        <span class="heart">♥</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1rem,2vw,1.25rem);letter-spacing:0.15em;text-transform:uppercase;color:#fff;">OUR MISSION</h2>
        <span class="rule rule--amber rule--center"></span>
        <p class="section-desc section-desc--white" style="text-align:center;margin-top:0.5rem;max-width:600px;">
          To share Christ's love and stand in solidarity with people in immigration detention. We provide pastoral care, advocacy, and essential support while upholding the dignity and rights of every person.
        </p>
      </div>
      <div class="grid-3" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr));">
        {[
          { title: 'Spiritual & Pastoral Care', desc: 'Offering prayer, sacraments, and faith support to detainees.', icon: 'M18 8h1a4 4 0 0 1 0 8h-1 M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z' },
          { title: 'Legal Assistance & Referrals', desc: 'Connecting individuals with trusted Catholic and professional legal services.', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' },
          { title: 'Family Support', desc: 'Supporting families with communication, resources, and emotional care.', icon: 'M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10' },
          { title: 'Advocacy & Justice', desc: 'Advocating for fair treatment, human dignity, and just immigration policies.', icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z' },
          { title: 'Education & Empowerment', desc: 'Providing resources and learning opportunities during detention.', icon: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z' },
          { title: 'Basic Needs & Humanitarian Aid', desc: 'Addressing urgent needs and connecting detainees with essential services.', icon: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z' },
        ].map(item => (
          <div class="card--dark" style="align-items:flex-start;">
            <div class="card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d={item.icon}/></svg>
            </div>
            <p class="card__title">{item.title}</p>
            <p class="card__body">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- We walk beside them — split with checklist -->
  <section class="section section--white">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:start;">
        <img
          src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=600&h=500&fit=crop"
          alt="Pastoral care in detention"
          style="width:100%;height:340px;object-fit:cover;border-radius:2px;"
        />
        <div>
          <span class="eyebrow" style="margin-bottom:0.5rem;display:block;">How We Help</span>
          <h2 class="section-title" style="margin-bottom:1rem;">WE WALK BESIDE THEM</h2>
          <span class="rule rule--amber" style="margin-bottom:1.5rem;display:block;"></span>
          <ul class="checklist">
            <li>Visit detainees in immigration detention centres</li>
            <li>Facilitate phone calls, letters, and family contact</li>
            <li>Provide religious materials and prayer support</li>
            <li>Refer to legal services and accredited professionals</li>
            <li>Support mental health and wellbeing</li>
            <li>Advocate for humane treatment and due process</li>
            <li>Assist with release planning and community connections</li>
          </ul>
        </div>
        <img
          src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&h=500&fit=crop"
          alt="Person in reflection"
          style="width:100%;height:340px;object-fit:cover;border-radius:2px;"
        />
      </div>
    </div>
  </section>

  <!-- Scripture quote band -->
  <div style="background:var(--color-navy-dark);padding-block:3rem;border-top:1px solid rgba(224,123,0,0.15);">
    <div class="wrap" style="text-align:center;max-width:860px;">
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2.5vw,1.375rem);color:#fff;line-height:1.7;font-style:italic;">
        <span style="color:var(--color-amber);font-size:1.5rem;vertical-align:middle;">"</span>
        For I was hungry and you gave me something to eat, I was thirsty and you gave me something to drink,
        I was a stranger and you invited me in.
        <span style="color:var(--color-amber);font-size:1.5rem;vertical-align:middle;">"</span>
      </p>
      <p style="margin-top:1rem;font-size:0.875rem;font-weight:700;color:var(--color-amber);letter-spacing:0.08em;">— Matthew 25:35</p>
    </div>
  </div>

  <!-- 5-service photo cards -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Our Services</span>
        <h2 class="section-title">HOW WE SUPPORT</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1.5rem;">
        {[
          { title: 'Pastoral Care', desc: 'We bring the presence of Christ to detention centres through prayer, listening, and the sacraments.', img: 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=400&h=260&fit=crop', icon: '♥' },
          { title: 'Legal Assistance', desc: 'We connect detainees with experienced Catholic lawyers and legal professionals for advice and representation.', img: 'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=400&h=260&fit=crop', icon: '⚖' },
          { title: 'Family Connection', desc: 'We support families left behind with updates, guidance, and resources during a very difficult time.', img: 'https://images.unsplash.com/photo-1531983412531-1f49a365ffed?w=400&h=260&fit=crop', icon: '👨‍👩‍👧' },
          { title: 'Education & Growth', desc: 'We provide educational resources and opportunities to help detainees grow in knowledge and hope.', img: 'https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=400&h=260&fit=crop', icon: '📚' },
          { title: 'Humanitarian Support', desc: 'We respond to practical needs with dignity and compassion, ensuring no one is forgotten.', img: 'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=400&h=260&fit=crop', icon: '🤝' },
        ].map(s => (
          <div class="photo-card">
            <img class="photo-card__img" src={s.img} alt={s.title} />
            <div class="photo-card__body">
              <p class="photo-card__title">{s.title}</p>
              <p class="photo-card__desc">{s.desc}</p>
              <span style="color:var(--color-amber);font-size:1.125rem;margin-top:0.5rem;display:block;">{s.icon}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- You can make a difference -->
  <section class="section section--white">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:start;">
        <div>
          <span class="eyebrow" style="margin-bottom:0.5rem;display:block;">Get Involved</span>
          <h2 class="section-title" style="margin-bottom:1rem;">YOU CAN MAKE A DIFFERENCE</h2>
          <span class="rule rule--amber" style="margin-bottom:1.5rem;display:block;"></span>
          <p class="section-desc" style="max-width:none;margin-bottom:2rem;">
            Your support helps us bring hope, dignity, and justice to people in immigration detention.
          </p>
          <div class="pillars" style="grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:1.5rem;text-align:center;">
            {[
              { label: 'Pray', desc: 'Pray for detainees, their families, and our ministry.' },
              { label: 'Volunteer', desc: 'Join our team to visit, write letters, or offer your professional skills.' },
              { label: 'Donate', desc: 'Your generosity helps us provide essential services and vital support.' },
              { label: 'Advocate', desc: 'Speak up for just and humane immigration policies.' },
              { label: 'Spread Hope', desc: 'Share our mission and help others get involved.' },
            ].map(a => (
              <div class="pillar">
                <div class="pillar__icon-wrap">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402C1 3.499 3.8 2 6 2c1.2 0 4.5.5 6 4.5C13.5 2.5 16.8 2 18 2c2.2 0 5 1.5 5 5.19 0 4.069-5.373 8.863-11 14.403z"/></svg>
                </div>
                <p class="pillar__label">{a.label}</p>
                <p class="pillar__desc">{a.desc}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="quote-box">
          <span class="quote-box__mark">"</span>
          <p class="quote-box__text">
            Every person is precious to God. Together, we can be a sign of His love.
          </p>
          <a href="/get-involved" class="btn btn--amber" style="margin-top:1.25rem;">GET INVOLVED TODAY →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA amber band -->
  <div class="amber-band">
    <div class="wrap" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem;">
      <div>
        <p style="font-family:var(--font-heading);font-size:1.125rem;color:#fff;font-weight:700;">
          Every person is precious to God.<br>
          <span style="font-style:italic;">Together, we can be a sign of His love.</span>
        </p>
      </div>
      <a href="/get-involved" class="btn" style="background:var(--color-navy-dark);color:#fff;font-weight:800;white-space:nowrap;">
        GET INVOLVED TODAY ›
      </a>
    </div>
  </div>

  <!-- Value strip -->
  <div class="value-strip">
    <div class="wrap">
      <div class="value-strip__inner">
        <div class="value-strip__item">
          <span class="value-strip__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          </span>
          <p class="value-strip__title">You Are Not Alone</p>
          <p class="value-strip__desc">We stand with you and your family.</p>
        </div>
        <div class="value-strip__item">
          <span class="value-strip__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
          </span>
          <p class="value-strip__title">We Listen</p>
          <p class="value-strip__desc">Your story matters. We are here to listen.</p>
        </div>
        <div class="value-strip__item">
          <span class="value-strip__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </span>
          <p class="value-strip__title">We Guide</p>
          <p class="value-strip__desc">We help you understand your rights and options.</p>
        </div>
        <div class="value-strip__item">
          <span class="value-strip__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <p class="value-strip__title">We Connect</p>
          <p class="value-strip__desc">We refer you to trusted services and professionals.</p>
        </div>
        <div class="value-strip__item">
          <span class="value-strip__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402C1 3.499 3.8 2 6 2c1.2 0 4.5.5 6 4.5C13.5 2.5 16.8 2 18 2c2.2 0 5 1.5 5 5.19 0 4.069-5.373 8.863-11 14.403z"/></svg>
          </span>
          <p class="value-strip__title">We Hope</p>
          <p class="value-strip__desc">We believe in healing, justice, and new beginnings.</p>
        </div>
      </div>
    </div>
  </div>

</Layout>
