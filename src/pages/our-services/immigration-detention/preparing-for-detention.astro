---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Preparing for Detention — Immigration Detention — IICC Mission" description="Practical guidance and spiritual support for individuals facing immigration detention.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services">Programs</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services/immigration-detention">Immigration Detention</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Preparing for Detention</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:420px;">
    <div class="hero-split__text" style="background:#fff;gap:1.25rem;">
      <span class="eyebrow">You Don't Have to Face It Alone</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:var(--color-navy);font-size:clamp(1.5rem,3.5vw,2.5rem);">PREPARING</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(1.5rem,3.5vw,2.5rem);">FOR DETENTION</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p class="section-desc" style="max-width:none;">Facing immigration detention is frightening. IICC Mission provides practical information, spiritual accompaniment and a compassionate presence to help individuals and families navigate this difficult time.</p>
      <a href="/contact" class="btn btn--amber">REACH OUT NOW ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img src="https://images.unsplash.com/photo-1476703993599-0035a21b17a9?w=800&h=600&fit=crop" alt="Support and guidance" />
    </div>
  </div>

  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:start;">
        <div>
          <h2 class="section-title" style="margin-bottom:0.75rem;">What We Can Help With</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
          <ul class="checklist">
            <li>Understanding what immigration detention involves</li>
            <li>What rights you have as a detainee</li>
            <li>How to arrange legal representation before being detained</li>
            <li>Notifying family members and making practical arrangements</li>
            <li>Spiritual preparation and prayer for the journey ahead</li>
            <li>What to expect from IICC Mission once inside</li>
            <li>Post-release planning and support referrals</li>
          </ul>
          <a href="/contact" class="btn btn--amber" style="margin-top:1.5rem;display:inline-flex;">CONTACT US ›</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">Be strong and courageous. Do not be afraid; do not be discouraged, for the Lord your God will be with you wherever you go.</p>
            <span class="quote-box__ref">— Joshua 1:9</span>
          </div>
          <div style="background:var(--color-amber);border-radius:2px;padding:1.5rem;text-align:center;">
            <p style="font-size:0.9375rem;color:#fff;line-height:1.65;margin-bottom:1rem;">Facing detention? Contact us immediately. We can connect you with support, prayer and guidance.</p>
            <a href="/contact" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;">CALL FOR HELP ›</a>
          </div>
          <div style="background:var(--color-navy-dark);border-radius:2px;padding:1.25rem;text-align:center;">
            <p style="font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;color:var(--color-amber);margin-bottom:0.375rem;">URGENT CONTACT</p>
            <a href="tel:+61411209066" style="font-size:1.125rem;font-weight:700;color:#fff;">+61 411 209 066</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
