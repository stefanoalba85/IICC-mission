---
import Layout from '../../../layouts/Layout.astro';
import MinHero from '../../../components/MinHero.astro';
import Icon from '../../../components/Icon.astro';

const img = (n: string) => `/images/immigration/preparing/${n}.jpg`;
const values = [
  { icon: 'cross', t: 'Faith', s: 'in God' }, { icon: 'handshake', t: 'Support', s: 'in Community' }, { icon: 'scale-balanced', t: 'Justice', s: 'for All' },
  { icon: 'shield-heart', t: 'Dignity', s: 'for Every Person' }, { icon: 'sun', t: 'Hope', s: 'for Tomorrow' },
];
const topics = [
  { title: 'The Transfer Process', icon: 'van-shuttle', items: ['What happens after your release from prison', 'How you will be moved to Immigration Detention', 'What to expect on arrival', 'Your belongings and property'], noteIcon: 'people-group', note: 'Understanding the process reduces fear and uncertainty.' },
  { title: 'Life in Immigration Detention', icon: 'building', items: ['Daily routines and schedules', 'Meals and healthcare', 'Living conditions', 'Visitation and phone calls', 'Work and education opportunities'], noteIcon: 'book', note: 'Knowledge helps you prepare and stay mentally strong.' },
  { title: 'Legal Options & Rights', icon: 'scale-balanced', items: ['Visa cancellation explained', 'Legal options available', 'Merits review, appeals and other pathways', 'Your rights in detention'], noteIcon: 'shield-halved', note: 'We connect you with trusted legal support and information.' },
  { title: 'Staying Connected with Family', icon: 'people-roof', items: ['Keeping in touch with loved ones', 'Visits, phone calls and letters', 'Supporting your children and partner'], noteIcon: 'hand-holding-heart', note: 'We help you maintain important relationships and stay connected.' },
  { title: 'Emotional & Mental Wellbeing', icon: 'brain', items: ['Managing stress, fear and anxiety', 'Dealing with uncertainty', 'Avoiding isolation', 'Finding strength and purpose'], noteIcon: 'hand-holding-heart', note: 'You are not alone. We provide pastoral care and mental health support.' },
  { title: 'Faith, Hope & Pastoral Care', icon: 'cross', items: ['Spiritual support and prayer', 'Sacraments and faith groups', 'Finding hope and healing', 'Encouragement for the journey'], noteIcon: 'hands-praying', note: 'Faith can give you peace, hope, and the strength to keep going.' },
  { title: 'What to Bring & What to Know', icon: 'suitcase', items: ['What you can and cannot bring', 'Important documents', 'Clothing and personal items', 'Money and canteen information'], noteIcon: 'clipboard-list', note: 'Being prepared helps you feel more in control and less anxious.' },
  { title: 'Healthcare & Wellbeing', icon: 'heart-pulse', items: ['Accessing healthcare services', 'Mental health support', 'Medication and medical needs', 'Wellbeing in detention'], noteIcon: 'heart-pulse', note: 'Your health matters. We encourage you to seek help when needed.' },
  { title: 'Information & Communication', icon: 'comments', items: ['Interpreter and translation services', 'Reading and education resources', 'Keeping informed about your case'], noteIcon: 'circle-info', note: 'We help you understand your situation and stay informed.' },
  { title: 'Hope for the Future', icon: 'sun', items: ['Exploring future pathways', 'Reintegration support', 'Building a new beginning', 'You are not defined by this moment'], noteIcon: 'seedling', note: 'There is hope beyond detention. We walk with you toward a new future.' },
];
const steps = [
  { icon: 'user', t: 'Before Transfer', d: 'We prepare you with knowledge, information and support.' },
  { icon: 'hand-holding-heart', t: 'During Detention', d: 'We accompany you with pastoral care, advocacy and practical assistance.' },
  { icon: 'dove', t: 'After Detention', d: 'We support your healing, reintegration and new beginning.' },
];
const help = ['One-on-one support', 'Practical preparation', 'Legal information and referrals', 'Emotional and spiritual care', 'Support for your family'];
const extra = [
  { t: 'Pastoral Care and Chaplaincy', d: 'Spiritual guidance, prayer, sacraments and pastoral accompaniment.' },
  { t: 'Legal Advocacy and Referrals', d: 'Connecting you with experienced immigration lawyers and advocates.' },
  { t: 'Peer Support Groups', d: 'Sharing your story, listening to others, and finding encouragement.' },
  { t: 'Education and Skills Programs', d: 'Helping you use this time to learn, grow and prepare for the future.' },
  { t: 'Letter Writing and Communication', d: 'We help you stay connected with your family and support network.' },
  { t: 'Reintegration Post-Detention', d: 'Support for housing, employment, counselling and community reintegration.' },
];
const beliefs = [
  { icon: 'people-group', t: 'We Believe', d: 'Everyone deserves dignity and second chances.' },
  { icon: 'ear-listen', t: 'We Listen', d: 'Every story matters. Every voice matters.' },
  { icon: 'handshake', t: 'We Support', d: 'We walk alongside those who are struggling.' },
  { icon: 'book-open', t: 'We Empower', d: 'We provide tools and resources for change.' },
  { icon: 'sun', t: 'We Restore Hope', d: 'Hope is the light that never fades.' },
  { icon: 'cross', t: 'We Trust in God', d: 'Guiding our mission to serve with love.' },
];
---
<Layout title="Preparing for Immigration Detention" description="Helping you understand the next step with dignity, knowledge and hope.">
  <style>
    .pd-band { background: var(--color-navy-dark); color: #fff; }
    .pd-band .wrap { display: grid; grid-template-columns: 5rem 1.6fr repeat(5, 1fr); gap: 1rem; align-items: center; padding-block: 1.1rem; }
    .pd-band .wrap > img { width: 5rem; border-radius: 50%; }
    .pd-band p { font-family: var(--font-heading); font-size: 1rem; line-height: 1.5; }
    .pd-val { text-align: center; border-left: 1px solid rgba(255,255,255,0.15); display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
    .pd-val span { color: #d9a540; }
    .pd-val strong { font-family: var(--font-heading); text-transform: uppercase; font-weight: 400; font-size: 0.9375rem; }
    .pd-val small { font-size: 0.8125rem; }
    .pd-h { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.25rem; font-weight: 400; text-align: center; }
    .pd-heart { display: block; text-align: center; color: #c9741f; margin-bottom: 1rem; }
    .pd-topics { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.75rem 0.75rem; }
    .pd-topic { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; padding-inline: 0.4rem; border-left: 1px solid rgba(27,39,81,0.08); }
    .pd-topic:nth-child(5n + 1) { border-left: none; }
    .pd-topic h3 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 0.875rem; font-weight: 400; text-align: center; min-height: 2.5rem; }
    .pd-topic > i { width: 3.75rem; height: 3.75rem; border-radius: 50%; background: var(--color-navy-dark); color: #fff; display: flex; align-items: center; justify-content: center; }
    .pd-topic ul { list-style: none; padding: 0; margin: 0; align-self: stretch; flex: 1; }
    .pd-topic li { position: relative; padding-left: 0.9rem; font-family: var(--font-heading); color: var(--color-navy); font-size: 0.8125rem; line-height: 1.4; margin-bottom: 0.45rem; }
    .pd-topic li::before { content: ''; position: absolute; left: 0; top: 0.45em; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: #c9741f; }
    .pd-note { align-self: stretch; background: #f3eee4; border-radius: 4px; padding: 0.6rem; display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.5rem; align-items: center; font-family: var(--font-heading); color: var(--color-navy); font-size: 0.75rem; line-height: 1.35; }
    .pd-three { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 0.75rem; padding-block: 1.5rem; }
    .pd-founder { background: var(--color-navy-dark); color: #fff; border-radius: 4px; padding: 1rem; }
    .pd-founder h2, .pd-box h2 { font-family: var(--font-heading); text-transform: uppercase; font-size: 0.9375rem; font-weight: 400; text-align: center; margin-bottom: 0.75rem; }
    .pd-founder > div { display: grid; grid-template-columns: 0.75fr 1fr; gap: 0.9rem; }
    .pd-founder img { width: 100%; height: 100%; object-fit: cover; border-radius: 2px; }
    .pd-founder p { font-family: var(--font-heading); font-size: 0.8125rem; line-height: 1.45; margin-bottom: 0.5rem; }
    .pd-sign { font-family: var(--font-script); color: #d9a540; font-size: 1.5rem; }
    .pd-box { background: #f3f1ec; border-radius: 4px; padding: 1rem 1.1rem; color: var(--color-navy); }
    .pd-step { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; align-items: center; margin-bottom: 1rem; }
    .pd-step i { width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--color-navy-dark); color: #d9a540; display: flex; align-items: center; justify-content: center; }
    .pd-step strong { display: block; color: #c9741f; text-transform: uppercase; font-size: 0.75rem; }
    .pd-step p, .pd-box > p { font-family: var(--font-heading); font-size: 0.8125rem; line-height: 1.45; }
    .pd-box ul { list-style: none; padding: 0; margin: 0.75rem 0; }
    .pd-box li { display: flex; gap: 0.6rem; align-items: center; font-family: var(--font-heading); font-size: 0.8125rem; padding-block: 0.25rem; }
    .pd-call { background: var(--color-navy-dark); color: #fff; border-radius: 6px; padding: 0.75rem 1rem; display: grid; grid-template-columns: 2rem 1fr; gap: 0.75rem; align-items: center; font-family: var(--font-heading); font-size: 0.875rem; line-height: 1.4; }
    .pd-call b { color: #d9a540; font-weight: 400; }
    .pd-extra { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; text-align: center; padding-bottom: 1.5rem; }
    .pd-extra img { width: 100%; max-width: 120px; aspect-ratio: 1; object-fit: cover; border-radius: 50%; margin-inline: auto; box-shadow: 0 4px 10px rgba(27,39,81,0.15); }
    .pd-extra h3 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 0.8125rem; font-weight: 400; margin-block: 0.6rem 0.3rem; }
    .pd-extra p { font-family: var(--font-heading); color: var(--color-navy); font-size: 0.75rem; line-height: 1.4; }
    .pd-cta { background: var(--color-navy-dark); color: #fff; }
    .pd-cta .wrap { display: grid; grid-template-columns: 1.4fr 4rem 1.6fr; gap: 1.5rem; align-items: center; padding-block: 1.25rem; }
    .pd-cta blockquote { margin: 0; display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.5rem; font-family: var(--font-heading); font-size: 1rem; line-height: 1.5; text-align: center; }
    .pd-cta blockquote::before { content: '\201C'; color: #d9a540; font-size: 3rem; line-height: 0.8; }
    .pd-cta cite { display: block; color: #d9a540; font-style: normal; }
    .pd-cta a { background: #c9922f; border-radius: 6px; padding: 0.9rem 1.25rem; color: #fff; display: grid; grid-template-columns: 2.5rem 1fr 1.5rem; gap: 0.75rem; align-items: center; }
    .pd-cta a strong { font-family: var(--font-heading); text-transform: uppercase; font-weight: 400; font-size: 1.125rem; display: block; }
    .pd-cta a small { font-size: 0.8125rem; line-height: 1.4; display: block; }
    .pd-beliefs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.75rem; padding-block: 1rem; }
    .pd-beliefs > div { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.5rem; align-items: start; color: var(--color-navy); }
    .pd-beliefs strong { display: block; font-size: 0.6875rem; text-transform: uppercase; }
    .pd-beliefs span { font-size: 0.6875rem; line-height: 1.35; }
    @media (max-width: 960px) {
      .pd-band .wrap { grid-template-columns: 4rem 1fr; } .pd-val { grid-column: span 1; border-left: none; }
      .pd-topics { grid-template-columns: repeat(2, 1fr); } .pd-topic { border-left: none; }
      .pd-three, .pd-cta .wrap { grid-template-columns: 1fr; }
      .pd-extra, .pd-beliefs { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 560px) { .pd-topics, .pd-extra, .pd-beliefs { grid-template-columns: 1fr 1fr; } }
  </style>

  <MinHero
    kicker="Immigration Detention Ministry"
    title="Preparing for<br/>Immigration<br/>Detention"
    subtitle="Helping You Understand the Next Step<br/>with Dignity, Knowledge and Hope."
    intro={['If you are in prison and know you will be transferred to an Immigration Detention Centre because your visa has been cancelled, you do not have to face this next step alone.', '<strong>We are here to walk with you—before, during, and after your transfer.</strong>']}
    img={img('hero')}
    alt="An IICC Mission chaplain speaking with a small group around a table"
  />

  <section class="pd-band">
    <div class="wrap">
      <img src="/IICC_Badge.png" alt="" />
      <p>You are more than your past.<br />This is a new chapter, and we will help you prepare, stay strong, and protect your dignity at every step of the way.</p>
      {values.map(v => <div class="pd-val"><span><Icon name={v.icon} size={34} /></span><strong>{v.t}</strong><small>{v.s}</small></div>)}
    </div>
  </section>

  <section class="wrap" style="padding-block:1.75rem 0.5rem;">
    <h2 class="pd-h">What You Need to Know and How We Can Help</h2>
    <span class="pd-heart">♡</span>
    <div class="pd-topics">
      {topics.map((t, i) => (
        <div class="pd-topic">
          <h3>{i + 1}. {t.title}</h3>
          <i><Icon name={t.icon} size={28} /></i>
          <ul>{t.items.map(x => <li>{x}</li>)}</ul>
          <div class="pd-note"><Icon name={t.noteIcon} size={28} /><span>{t.note}</span></div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap pd-three">
    <div class="pd-founder">
      <h2>A Message from Our Founder</h2>
      <div>
        <img src={img('founder')} alt="Antonio G. Dattilo, Ambassador & Founder" />
        <div>
          <p>I know how overwhelming it feels when your world changes so quickly.</p>
          <p>I came here straight from prison.</p>
          <p>I understand the fear, the uncertainty, and the pain of not knowing what lies ahead.</p>
          <p>But I also know that hope is stronger than any wall.</p>
          <p>You are not alone. We are here for you—before, during, and after your transfer.</p>
          <span class="pd-sign">Antonio G. Dattilo</span>
          <p style="color:#d9a540; text-transform:uppercase; font-size:0.6875rem;">Ambassador &amp; Founder – IICC Mission</p>
        </div>
      </div>
    </div>
    <div class="pd-box">
      <h2>We Walk with You Every Step</h2>
      {steps.map(s => <div class="pd-step"><i><Icon name={s.icon} size={18} /></i><div><strong>{s.t}</strong><p>{s.d}</p></div></div>)}
    </div>
    <div class="pd-box">
      <h2>We Are Here to Help</h2>
      <p style="text-align:center;">If you are in prison and know you will be transferred to an Immigration Detention Centre, contact us for a confidential preparation session.</p>
      <ul>{help.map(h => <li><Icon name="circle-check" size={16} />{h}</li>)}</ul>
      <a href="/contact" class="pd-call"><Icon name="phone" size={24} /><span>You don’t have to do <b>this alone.</b><br />Let us walk with you.</span></a>
    </div>
  </section>

  <section class="wrap">
    <h2 class="pd-h">Additional Support We Provide</h2>
    <span class="pd-heart">♡</span>
    <div class="pd-extra">
      {extra.map((e, i) => <div><img src={img(`s${i + 1}`)} alt="" loading="lazy" /><h3>{e.t}</h3><p>{e.d}</p></div>)}
    </div>
  </section>

  <section class="pd-cta">
    <div class="wrap">
      <blockquote><div>Be strong and courageous. Do not be afraid; do not be discouraged, for the Lord your God will be with you wherever you go.<cite>– Joshua 1:9</cite></div></blockquote>
      <span style="color:#d9a540;"><Icon name="cross" size={56} /></span>
      <a href="/contact"><Icon name="people-group" size={34} /><div><strong>You Are Not Alone. There Is Hope.</strong><small>We are here to help you prepare for the journey ahead.<br />Hope. Support. Guidance. Always.</small></div><span>→</span></a>
    </div>
  </section>

  <section class="wrap pd-beliefs">
    {beliefs.map(b => <div><Icon name={b.icon} size={30} /><div><strong>{b.t}</strong><span>{b.d}</span></div></div>)}
  </section>
</Layout>
