---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Legal Referral Services — Immigration Detention — IICC Mission" description="Connecting immigration detainees with legal information, advice and pro bono legal support.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services">Programs</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services/immigration-detention">Immigration Detention</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Legal Referral Services</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:420px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">Know Your Rights</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(1.5rem,3.5vw,2.5rem);">LEGAL REFERRAL</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(1.5rem,3.5vw,2.5rem);">SERVICES</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-size:0.9375rem;color:rgba(255,255,255,0.85);line-height:1.7;">Understanding your legal rights in an immigration detention system can be overwhelming. IICC Mission connects detainees and their families with the legal support they need — because justice is not optional.</p>
      <a href="/contact" class="btn btn--amber">REQUEST REFERRAL ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=800&h=600&fit=crop" alt="Legal support and justice" />
    </div>
  </div>

  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:start;">
        <div>
          <h2 class="section-title" style="margin-bottom:0.75rem;">Our Legal Referral Network</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
          <ul class="checklist">
            <li>Referrals to registered migration agents and solicitors</li>
            <li>Connections with pro bono immigration law services</li>
            <li>Information about visa applications, review rights and appeals</li>
            <li>Support navigating the Administrative Appeals Tribunal (AAT)</li>
            <li>Help understanding detention review processes</li>
            <li>Access to community legal centres across Australia</li>
            <li>Advocacy with detention centre management where appropriate</li>
          </ul>
        </div>
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">Speak up for those who cannot speak for themselves, for the rights of all who are destitute.</p>
            <span class="quote-box__ref">— Proverbs 31:8</span>
          </div>
          <div style="background:#fff;border:1px solid rgba(27,39,81,0.08);border-left:3px solid var(--color-amber);border-radius:2px;padding:1.25rem;">
            <p style="font-size:0.8125rem;color:var(--color-muted);line-height:1.7;"><strong style="color:var(--color-navy);">Disclaimer:</strong> IICC Mission does not provide legal advice. We connect individuals with qualified legal professionals and services. For urgent matters, contact a registered migration agent or Legal Aid directly.</p>
          </div>
          <a href="/contact" class="btn btn--amber" style="text-align:center;justify-content:center;">REQUEST A REFERRAL ›</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
