---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Support for Detainees — Immigration Detention — IICC Mission" description="Comprehensive support for people inside immigration detention — spiritual, legal, material and emotional.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services">Programs</a><span class="breadcrumb__sep">›</span>
        <a href="/our-services/immigration-detention">Immigration Detention</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Support for Detainees</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:480px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <div style="display:flex;align-items:center;gap:1rem;">
        <img src="/IICC_Logo.png" alt="IICC Mission" style="height:3.5rem;object-fit:contain;" />
        <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
          <span style="display:block;color:#fff;font-size:clamp(1.5rem,3.5vw,2.5rem);">SUPPORT FOR</span>
          <span style="display:block;color:var(--color-amber);font-size:clamp(1.5rem,3.5vw,2.5rem);">DETAINEES</span>
        </h1>
      </div>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:1.0625rem;color:var(--color-amber);font-weight:700;">You are not alone. You are not forgotten. You matter.</p>
      <p style="font-size:0.9375rem;color:rgba(255,255,255,0.85);line-height:1.7;">IICC Mission provides holistic support for people inside immigration detention — addressing spiritual, legal, material and emotional needs with dignity, compassion and unwavering presence.</p>
      <a href="/contact" class="btn btn--amber">GET IN TOUCH ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:320px;position:relative;">
      <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=800&h=600&fit=crop" alt="Support and compassion" />
      <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(18,26,56,0.88));padding:2rem 1.5rem 1.5rem;">
        <p style="font-family:var(--font-heading);font-size:0.9375rem;color:rgba(255,255,255,0.9);font-style:italic;">"I was a stranger and you invited me in." — Matthew 25:35</p>
      </div>
    </div>
  </div>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Comprehensive Care</span>
        <h2 class="section-title">WHAT WE OFFER INSIDE DETENTION</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="grid-3">
        {[
          { icon: '🙏', title: 'Spiritual Care', desc: 'Prayer, sacraments, scripture and pastoral presence to nourish the soul in a difficult place.', href: '/our-services/immigration-detention/faith-pastoral-care' },
          { icon: '⚖️', title: 'Legal Referrals', desc: 'Connecting with qualified immigration lawyers, migration agents and pro bono legal services.', href: '/our-services/immigration-detention/legal-referral-services' },
          { icon: '🤝', title: 'Humanitarian Aid', desc: 'Essential items, welfare support and practical care that upholds dignity.', href: '/our-services/immigration-detention/humanitarian-assistance' },
          { icon: '👨‍👩‍👧', title: 'Family Connection', desc: 'Facilitating and supporting contact with family members during detention.', href: '/our-services/immigration-detention/family-support' },
          { icon: '💬', title: 'Pastoral Listening', desc: 'A compassionate presence to hear stories, offer comfort and pray with those in need.' },
          { icon: '🌍', title: 'Community Integration', desc: 'Planning for life after detention — housing, employment and community belonging.', href: '/our-services/immigration-detention/community-integration' },
        ].map(c => (
          <div class="card" style="align-items:center;text-align:center;gap:0.5rem;">
            <div class="card__icon card__icon--filled">{c.icon}</div>
            <p class="card__title">{c.title}</p>
            <p class="card__body" style="flex:1;">{c.desc}</p>
            {c.href && <a href={c.href} style="font-size:0.75rem;font-weight:700;color:var(--color-amber);text-decoration:none;letter-spacing:0.08em;margin-top:0.5rem;">LEARN MORE ›</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="amber-band">
    <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;">
      <div>
        <p style="font-family:var(--font-display);font-size:clamp(1rem,2.5vw,1.375rem);font-weight:900;color:#fff;text-transform:uppercase;margin-bottom:0.375rem;">SUPPORT THIS MINISTRY</p>
        <p style="font-size:0.9375rem;color:rgba(255,255,255,0.88);">Your donation brings dignity and hope into detention centres.</p>
      </div>
      <a href="/donate" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;white-space:nowrap;">♥ DONATE</a>
    </div>
  </div>

</Layout>
