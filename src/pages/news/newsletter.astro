---
import Layout from '../../layouts/Layout.astro';
import ResHero from '../../components/ResHero.astro';
import SideBox from '../../components/SideBox.astro';
import HcOr from '../../components/HcOr.astro';
import ColorCards from '../../components/ColorCards.astro';
import Icon from '../../components/Icon.astro';

const img = (n: string) => `/images/support/${n}.jpg`;
const why = [
  { icon: 'envelope', bg: 'var(--color-navy-dark)', title: 'Be Inspired', text: 'Real stories of hope and transformation.' },
  { icon: 'calendar-days', bg: '#b97a14', title: 'Stay Informed', text: 'Latest news, events and program updates.' },
  { icon: 'people-group', bg: '#1d4d34', title: 'See the Impact', text: 'How your support changes lives.' },
  { icon: 'hands-praying', bg: '#3a2470', title: 'Grow in Faith', text: 'Reflections, prayers and spiritual encouragement.' },
];
const inIssue = ['A Message from our Founder', 'Hope Companion Program Updates', 'New Bakery of Hope in Italy', 'Volunteer Spotlight', 'Upcoming Events Calendar', 'Prayer for our Mission'];
const pillars = [
  { icon: 'hands-praying', t: 'Spiritual & Pastoral Care' }, { icon: 'scale-balanced', t: 'Legal Assistance & Advocacy' }, { icon: 'book-open', t: 'Education & Awareness' },
  { icon: 'hand-holding-heart', t: 'Humanitarian Support' }, { icon: 'person-walking', t: 'Healing, Restoration & Reintegration' },
];
const past = [
  { month: 'April 2025', issue: 14 }, { month: 'March 2025', issue: 13 }, { month: 'February 2025', issue: 12 }, { month: 'January 2025', issue: 11 },
];
const contents = [
  { icon: 'people-group', t: 'Message from our Founder' }, { icon: 'database', t: 'Mission Highlights' }, { icon: 'calendar-check', t: 'Program Updates' },
  { icon: 'calendar-days', t: 'Upcoming Events' }, { icon: 'user', t: 'Stories of Hope' }, { icon: 'person-praying', t: 'Prayer Corner' }, { icon: 'user-plus', t: 'Ways to Get Involved' },
];
const quotes = [
  { q: 'The IICC Newsletter fills my heart with hope every month. The stories remind me that we are not alone in this mission.', who: 'Maria, Volunteer' },
  { q: 'I share every issue with my parish. It inspires others to pray and support those who are forgotten.', who: 'John, Donor' },
  { q: 'Reading the stories of transformation brings me so much joy and encouragement.', who: 'Angela, Prayer Partner' },
];
---
<Layout title="Newsletter — Hope Delivered" description="Stories. Updates. Inspiration. Direct to your inbox — the IICC Mission newsletter.">
  <style>
    .nl-body { display: grid; grid-template-columns: 1fr 260px; gap: 1rem; padding-block: 1rem 1.25rem; align-items: start; }
    .nl-main { display: flex; flex-direction: column; gap: 1rem; }
    .nl-card { background: #fff; border: 1px solid rgba(27,39,81,0.1); border-radius: 4px; padding: 1rem 1.25rem; }
    .nl-h { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 1.125rem; font-weight: 400; text-align: center; }
    .nl-heart { display: block; text-align: center; color: #c9741f; font-size: 0.75rem; margin-bottom: 0.75rem; }
    .nl-why { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; }
    .nl-why > div { padding-inline: 0.75rem; display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
    .nl-why > div + div { border-left: 1px solid rgba(201,116,31,0.35); }
    .nl-why i { width: 3.6rem; height: 3.6rem; border-radius: 50%; color: #fff; display: flex; align-items: center; justify-content: center; }
    .nl-why h3 { font-family: var(--font-heading); color: var(--color-navy); text-transform: uppercase; font-size: 0.8125rem; font-weight: 400; }
    .nl-why p { font-size: 0.8125rem; line-height: 1.4; color: var(--color-navy); }
    .nl-latest { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 1.5rem; align-items: start; }
    .nl-cover { border: 1px solid rgba(27,39,81,0.15); padding: 0.75rem; text-align: center; box-shadow: 0 4px 12px rgba(27,39,81,0.12); background: #fff; }
    .nl-cover > img:first-child { width: 120px; margin-inline: auto; }
    .nl-cover h3 { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.375rem; text-transform: uppercase; border-top: 1px solid #c9741f; margin-top: 0.4rem; padding-top: 0.3rem; }
    .nl-cover .ph { width: 100%; aspect-ratio: 231 / 132; object-fit: cover; margin-top: 0.4rem; }
    .nl-cover p { font-family: var(--font-heading); color: var(--color-navy); font-size: 0.8125rem; margin-block: 0.4rem; }
    .nl-pillars { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.2rem; color: var(--color-navy); }
    .nl-pillars span { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; font-size: 0.5rem; text-transform: uppercase; line-height: 1.2; }
    .nl-issue { font-size: 0.75rem; color: #c9741f; text-transform: uppercase; }
    .nl-latest h2 { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.5rem; font-weight: 400; margin-block: 0.3rem 0.6rem; }
    .nl-latest p.t { font-family: var(--font-heading); color: var(--color-navy); font-size: 0.9375rem; line-height: 1.45; }
    .nl-latest h4 { font-size: 0.8125rem; text-transform: uppercase; color: var(--color-navy); margin-top: 0.75rem; }
    .nl-latest ul { list-style: none; padding: 0; margin: 0.3rem 0 1rem; }
    .nl-latest li { display: flex; gap: 0.5rem; align-items: center; font-family: var(--font-heading); color: var(--color-navy); font-size: 0.875rem; padding-block: 0.1rem; }
    .nl-latest li :global(svg) { color: #c9741f; flex-shrink: 0; }
    .nl-past { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
    .nl-past > div { display: grid; grid-template-columns: 58px 1fr; gap: 0.6rem; align-items: center; border: 1px solid rgba(27,39,81,0.1); padding: 0.4rem; border-radius: 3px; }
    .nl-mini { border: 1px solid rgba(27,39,81,0.2); padding: 0.2rem; text-align: center; background: #fff; }
    .nl-mini img:first-child { width: 22px; margin-inline: auto; }
    .nl-mini b { display: block; font-family: var(--font-heading); font-size: 0.375rem; color: var(--color-navy); font-weight: 400; }
    .nl-mini img + b + img { width: 100%; aspect-ratio: 1; object-fit: cover; }
    .nl-past p { font-family: var(--font-heading); color: var(--color-navy); font-size: 0.8125rem; line-height: 1.35; text-transform: uppercase; }
    .nl-past p small { display: block; text-transform: none; }
    .nl-past a { font-family: var(--font-body); font-weight: 700; font-size: 0.6875rem; color: var(--color-navy); display: block; margin-top: 0.2rem; }
    .nl-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .nl-quotes blockquote { margin: 0; display: grid; grid-template-columns: 1.75rem 1fr; gap: 0.4rem; font-family: var(--font-heading); color: var(--color-navy); font-size: 0.8125rem; line-height: 1.45; }
    .nl-quotes blockquote::before { content: '\201C'; color: #c9741f; font-size: 2.5rem; line-height: 0.8; }
    .nl-quotes cite { display: block; font-style: normal; font-weight: 700; margin-top: 0.5rem; }
    .nl-side { display: flex; flex-direction: column; gap: 0.75rem; }
    .nl-join { background: var(--color-navy-dark); color: #fff; border-radius: 4px; padding: 1rem; text-align: center; display: flex; flex-direction: column; gap: 0.5rem; }
    .nl-join h2 { font-family: var(--font-heading); text-transform: uppercase; font-size: 1.0625rem; font-weight: 400; }
    .nl-join input { padding: 0.55rem 0.7rem; border: none; border-radius: 2px; font-size: 0.8125rem; }
    .nl-join small { font-size: 0.6875rem; line-height: 1.4; }
    .nl-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
    .nl-list li { display: flex; gap: 0.6rem; align-items: center; font-family: var(--font-heading); color: var(--color-navy); font-size: 0.875rem; }
    .nl-list li :global(svg) { color: var(--color-navy); }
    .nl-feat img { width: 100%; aspect-ratio: 235 / 108; object-fit: cover; }
    .nl-feat p { text-align: center; font-family: var(--font-heading); color: var(--color-navy); font-size: 0.8125rem; line-height: 1.4; margin-block: 0.5rem; }
    .nl-feat p strong { display: block; font-weight: 400; font-size: 1rem; }
    .nl-know { background: var(--color-navy-dark); color: #fff; border-radius: 4px; padding: 1rem; display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.75rem; align-items: center; }
    .nl-know span { width: 3.5rem; height: 3.5rem; border-radius: 50%; border: 1.5px solid #c9962a; display: flex; align-items: center; justify-content: center; }
    .nl-know h2 { font-family: var(--font-heading); text-transform: uppercase; font-size: 0.9375rem; font-weight: 400; }
    .nl-know p { font-size: 0.75rem; line-height: 1.4; }
    @media (max-width: 960px) { .nl-body { grid-template-columns: 1fr; } .nl-why, .nl-past { grid-template-columns: 1fr 1fr; row-gap: 1rem; } .nl-latest, .nl-quotes { grid-template-columns: 1fr; } }
  </style>

  <ResHero
    logo={false}
    kicker="IICC Mission Newsletter"
    title="Newsletter<br/><span style='color:#c9741f'>Hope Delivered</span>"
    sub="<span style='color:var(--color-navy)'>Stories. Updates. Inspiration.<br/>Direct to your inbox.</span>"
    text={['Our newsletter keeps you connected to the people, programs and mission that bring hope, justice and restoration to prisoners, detainees and their families worldwide.']}
    img={img('nl-hero')}
    alt="IICC Mission chaplain and volunteers reading the Hope in Action newsletter"
    quote="I was in prison and you visited me. I was in detention and you came to me. Thank you for bringing hope."
    quoteRef="Matthew 25:36"
    cta="Stay informed. Stay part of the mission"
    ctaHref="#join"
  />

  <div class="wrap nl-body">
    <div class="nl-main">
      <div class="nl-card nl-why">
        {why.map(w => <div><i style={`background:${w.bg};`}><Icon name={w.icon} size={28} /></i><h3>{w.title}</h3><p>{w.text}</p></div>)}
      </div>

      <div class="nl-card">
        <h2 class="nl-h">Latest Newsletter</h2><span class="nl-heart">♥</span>
        <div class="nl-latest">
          <div class="nl-cover">
            <img src="/IICC_Logo_main.png" alt="IICC Mission" />
            <h3>Hope in Action</h3>
            <img class="ph" src={img('nl-cphoto')} alt="Volunteers and a priest handing over a care package" />
            <p>Bringing Hope to Those in Need.</p>
            <div class="nl-pillars">{pillars.map(p => <span><Icon name={p.icon} size={16} />{p.t}</span>)}</div>
          </div>
          <div>
            <p class="nl-issue">May 2025 &nbsp;|&nbsp; Issue No. 15</p>
            <h2>Hope in Action</h2>
            <p class="t">In this issue, we celebrate the incredible impact of our Hope Companions, share inspiring stories of lives changed, and invite you to be part of what God is doing through the IICC Mission.</p>
            <h4>In This Issue:</h4>
            <ul>{inIssue.map(i => <li><Icon name="circle-check" size={14} />{i}</li>)}</ul>
            <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
              <a href="/news" class="btn btn--navy">Read Online <Icon name="book-open" size={16} /></a>
              <a href="/resources/download-guides" class="btn btn--outline">Download PDF ↓</a>
            </div>
          </div>
        </div>
      </div>

      <div class="nl-card">
        <h2 class="nl-h">Previous Newsletters</h2><span class="nl-heart">♥</span>
        <div class="nl-past">
          {past.map(p => (
            <div>
              <span class="nl-mini"><img src="/IICC_Badge.png" alt="" /><b>HOPE IN ACTION</b><img src={img('nl-cphoto')} alt="" loading="lazy" /></span>
              <p>{p.month}<small>Issue No. {p.issue}</small><a href="/news">Read Online | PDF</a></p>
            </div>
          ))}
        </div>
        <div style="display:flex; justify-content:center; margin-top:0.9rem;"><a href="/news" class="btn btn--outline">View All Past Issues →</a></div>
      </div>

      <div class="nl-card">
        <h2 class="nl-h">What Our Readers Say</h2><span class="nl-heart">♥</span>
        <div class="nl-quotes">
          {quotes.map(q => <blockquote><div>{q.q}<cite>— {q.who}</cite></div></blockquote>)}
        </div>
      </div>
    </div>

    <div class="nl-side">
      <form class="nl-join" id="join" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Subscribed — thank you';">
        <h2>Join Our Newsletter</h2><span style="color:#d9862a; font-size:0.75rem;">♥</span>
        <p style="font-family:var(--font-heading); font-size:0.9375rem;">Subscribe today and receive our latest updates.</p>
        <input name="first-name" placeholder="First Name" aria-label="First name" required />
        <input name="last-name" placeholder="Last Name" aria-label="Last name" required />
        <input type="email" name="email" placeholder="Email Address" aria-label="Email address" required />
        <button class="btn btn--amber" style="justify-content:center;">Subscribe Now <Icon name="paper-plane" size={16} /></button>
        <small><Icon name="lock" size={11} /> We respect your privacy. Unsubscribe anytime with one click.</small>
      </form>
      <SideBox title="In This Issue">
        <ul class="nl-list">{contents.map(c => <li><Icon name={c.icon} size={15} />{c.t}</li>)}</ul>
      </SideBox>
      <SideBox title="Featured Story">
        <div class="nl-feat">
          <img src={img('nl-feat')} alt="A Hope Companion embracing a man" loading="lazy" />
          <p><strong>From Despair to Hope</strong>Michael’s story of transformation through friendship and faith.</p>
          <a href="/programs/hope-companion/stories" style="display:block; text-align:center; font-weight:700; font-size:0.8125rem; color:var(--color-navy); text-transform:uppercase;">Read More →</a>
        </div>
      </SideBox>
      <div class="nl-know">
        <span><Icon name="people-group" size={28} /></span>
        <div><h2>Did You Know?</h2><p>Every newsletter helps more people discover hope. Share it with a friend!</p></div>
        <a href="/contact" class="btn btn--amber" style="grid-column:1 / -1; justify-content:center;">Forward Newsletter →</a>
      </div>
    </div>
  </div>

  <HcOr
    leftTitle="Stay Connected"
    leftText="Get the latest news, stories and updates delivered to your inbox."
    leftCta="Subscribe Now"
    leftHref="#join"
    rightTitle="Support the Mission"
    rightText="Your generosity helps us share hope, restore dignity and change lives."
  />
  <ColorCards />
</Layout>
