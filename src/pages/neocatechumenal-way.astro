---
import Layout from '../layouts/Layout.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Neocatechumenal Way"
  description="The Neocatechumenal Way — A path of faith, formation and evangelization at the heart of the IICC Mission."
>

  <!-- HERO -->
  <section class="page-hero page-hero--neo">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1476234251399-ae2aba3cdb3f?w=1200&fit=crop&q=80"
        alt="Religious gathering — Neocatechumenal Way"
        loading="eager"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
      <p class="section-label" style="margin-bottom:0.875rem">Neocatechumenal Way</p>
      <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
      <h1 class="page-hero-title">A Path of Faith, Formation<br>and Evangelization</h1>
      <p class="page-hero-subtitle">
        Walking together close to those on the margins — a precious instrument of the Church for our time.
      </p>
    </div>
  </section>

  <!-- SECTION 1: WHAT IS THE NEOCATECHUMENAL WAY -->
  <section class="section-standard">
    <div class="container">
      <div class="two-col">
        <div class="neo-intro-img-wrap">
          <img
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&fit=crop&q=80"
            alt="Candles and prayer — faith journey"
            loading="lazy"
            class="neo-intro-img"
          />
        </div>
        <div class="neo-intro-text">
          <p class="section-label">THE NEOCATECHUMENAL WAY</p>
          <div class="gold-rule-left" style="margin:0.875rem 0 1.25rem"></div>
          <h2 class="neo-intro-heading">A Journey of Faith, Formation and Evangelization</h2>
          <p class="neo-intro-body">
            The Neocatechumenal Way is a post-baptismal catechetical journey, a path of Christian initiation for adults who wish to rediscover their faith and be renewed in it. At the IICC Mission, we walk together with the Neocatechumenal Way, a path of faith, formation and evangelization close to those on the margins.
          </p>
          <p class="neo-intro-body">
            The Way accompanies the mission in its core calling: to bring the Gospel to the forgotten, the imprisoned, the outcast and the vulnerable — showing that Christ is present with them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: POPE FRANCIS QUOTE (dark, centered) -->
  <section class="section-standard-dark neo-quote-section">
    <div class="container">
      <div class="neo-quote-wrap">
        <div class="neo-quote-mark">&ldquo;</div>
        <blockquote class="neo-quote-primary">
          The Neocatechumenal Way is a precious instrument of the Church for our time.
        </blockquote>
        <cite class="neo-quote-ref">— Pope Francis</cite>
        <div class="neo-quote-divider"></div>
        <p class="neo-quote-secondary">
          "A path of encounter with the living Christ, a journey of initiation that leads people to rediscover their baptism — and with it, their identity as children of God, beloved and called to bring His love to the world."
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: HOW THE WAY GUIDES OUR MISSION (offwhite, 3 cards) -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="section-header">
        <p class="section-label">HOW THE WAY GUIDES OUR MISSION</p>
        <div class="gold-rule"></div>
        <h2 class="section-header-title" style="margin-top:1rem">Rooted in Faith. Sent to Serve.</h2>
      </div>

      <div class="card-grid-3">
        <div class="info-card card-hover neo-guide-card">
          <span class="info-card-icon">📖</span>
          <h3 class="info-card-title">Formation</h3>
          <p class="info-card-desc">
            Deep formation in the faith gives our missionaries the spiritual foundation to walk with those most in need. Encountering the living Word of God transforms the heart and equips us to bring His mercy to others.
          </p>
        </div>

        <div class="info-card card-hover neo-guide-card">
          <span class="info-card-icon">✝</span>
          <h3 class="info-card-title">Evangelization</h3>
          <p class="info-card-desc">
            The Way sends forth missionaries to bring the Good News to those who feel furthest from God — into prisons, detention centres, shelters and the margins of society, proclaiming that no one is forgotten.
          </p>
        </div>

        <div class="info-card card-hover neo-guide-card">
          <span class="info-card-icon">🤝</span>
          <h3 class="info-card-title">Community</h3>
          <p class="info-card-desc">
            Rooted in community life, the Way builds bonds of charity, support and accompaniment. No one walks alone. Together we carry one another's burdens and celebrate God's grace in our lives.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: WALKING CLOSE TO THE MARGINS (full-width image with overlay) -->
  <section class="margins-section">
    <div class="margins-bg">
      <img
        src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1920&fit=crop&q=80"
        alt="Walking close to the margins — IICC Mission"
        loading="lazy"
      />
      <div class="margins-overlay"></div>
    </div>
    <div class="container margins-content">
      <div class="margins-text-block">
        <p class="section-label" style="margin-bottom:0.875rem">WALKING CLOSE TO THE MARGINS</p>
        <div class="gold-rule-left" style="margin-bottom:1.5rem"></div>
        <p class="margins-body">
          With the Neocatechumenal Way, the IICC Mission goes where people feel most forgotten — into prisons, detention centres, shelters and communities — bringing the message of God's love and mercy.
        </p>
        <a href="/mission" class="btn-primary" style="margin-top:1.75rem">LEARN MORE ABOUT OUR MISSION →</a>
      </div>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <QuoteBand
    quote="Go into all the world and proclaim the Gospel to the whole creation."
    reference="Mark 16:15"
    dark={true}
  />

  <!-- CTA SECTION -->
  <CTASection
    headline="Walk With Us in Faith"
    subtext="The Neocatechumenal Way is a precious instrument of the Church. Discover how you can walk this path with the IICC Mission."
    dark={false}
    buttons={[
      { label: 'Join The Mission', href: '/get-involved', primary: true },
      { label: 'Learn About Our Work', href: '/mission', primary: false },
    ]}
  />

</Layout>

<style>
  /* HERO */
  .page-hero--neo {
    min-height: 56vh;
  }

  /* SECTION 1 — INTRO */
  .neo-intro-img-wrap {
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }
  .neo-intro-img {
    width: 100%;
    object-fit: cover;
    display: block;
    min-height: 380px;
  }
  .neo-intro-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--color-navy);
    margin-bottom: 1.25rem;
  }
  .neo-intro-body {
    color: #4a4a4a;
    line-height: 1.8;
    font-size: 1.0625rem;
    margin-bottom: 1rem;
  }
  .neo-intro-body:last-child {
    margin-bottom: 0;
  }

  /* SECTION 2 — POPE FRANCIS QUOTE */
  .neo-quote-section {
    position: relative;
    overflow: hidden;
  }
  .neo-quote-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(201,160,23,0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .neo-quote-wrap {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    position: relative;
  }
  .neo-quote-mark {
    font-family: var(--font-heading);
    font-size: 6rem;
    color: var(--color-gold);
    opacity: 0.25;
    line-height: 0.8;
    display: block;
    margin-bottom: 1rem;
    user-select: none;
  }
  .neo-quote-primary {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.375rem, 2.5vw, 2rem);
    color: white;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }
  .neo-quote-ref {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    display: block;
    margin-bottom: 2rem;
  }
  .neo-quote-divider {
    width: 3rem;
    height: 1px;
    background: rgba(201,160,23,0.4);
    margin: 0 auto 2rem;
  }
  .neo-quote-secondary {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1rem, 1.5vw, 1.1875rem);
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin: 0;
  }

  /* SECTION 3 — GUIDE CARDS */
  .neo-guide-card {
    text-align: left;
  }
  .neo-guide-card .info-card-icon {
    font-size: 2rem;
  }
  .neo-guide-card .info-card-title {
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* SECTION 4 — MARGINS */
  .margins-section {
    position: relative;
    padding: 6rem 0;
    overflow: hidden;
  }
  .margins-bg {
    position: absolute;
    inset: 0;
  }
  .margins-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .margins-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(18,26,56,0.92) 0%,
      rgba(18,26,56,0.75) 55%,
      rgba(18,26,56,0.4) 100%
    );
  }
  .margins-content {
    position: relative;
    z-index: 2;
  }
  .margins-text-block {
    max-width: 580px;
  }
  .margins-body {
    font-size: clamp(1rem, 1.5vw, 1.1875rem);
    color: rgba(255,255,255,0.85);
    line-height: 1.8;
  }
</style>
