---
import Layout from '../layouts/Layout.astro';
import LegalTemplate from '../components/LegalTemplate.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Icon from '../components/Icon.astro';

const tabs = [
  { icon: 'shield-halved', label: 'Our Commitment', href: '#commitment' },
  { icon: 'file-lines', label: 'Information We Collect', href: '#collect' },
  { icon: 'gear', label: 'How We Use Information', href: '#use' },
  { icon: 'lock', label: 'How We Protect Your Information', href: '#protect' },
  { icon: 'people-group', label: 'Your Rights', href: '#rights' },
  { icon: 'globe', label: 'Cookies', href: '#cookies' },
  { icon: 'envelope', label: 'Third-Party Services', href: '#third-party' },
  { icon: 'circle-info', label: 'Contact Us', href: '#contact' },
];
const collect = [
  { icon: 'user', t: 'Name and contact details' }, { icon: 'envelope', t: 'Email address' }, { icon: 'heart', t: 'Donation information' },
  { icon: 'people-group', t: 'Volunteer applications' }, { icon: 'comment', t: 'Messages and enquiries' }, { icon: 'file-lines', t: 'Newsletter subscriptions' },
];
const rights = ['access the personal information we hold about you;', 'request correction of inaccurate information;', 'request deletion of your information;', 'withdraw your consent;', 'object to certain processing activities.'];
---
<Layout title="Privacy Policy" description="Your privacy matters. How IICC Mission collects, uses, safeguards and manages your personal information.">
  <LegalTemplate
    kicker="Privacy Policy"
    title="Your Privacy"
    titleGold="Matters"
    text={['At IICC Mission, we are committed to protecting your personal information and respecting your privacy. This Privacy Policy explains how we collect, use, safeguard and manage your information when you visit our website or engage with our work.']}
    img="/images/support/pp-hero.jpg"
    alt="St Peter's Basilica and the Tiber at sunset"
    quote="With respect and integrity, we value your trust and are committed to protecting your privacy."
    tabs={tabs}
    links={['Our Mission', 'Our Services', 'Get Involved', 'Donate', 'Volunteer', 'Partnerships', 'Legal & Governance', 'Contact Us']}
  >
    <h2 id="commitment">1. Our Commitment</h2>
    <p>IICC Mission (“we”, “our”, “us”) respects your privacy and is committed to protecting your personal information. This Privacy Policy explains how we collect, use, store and safeguard your information when you visit our website (www.iiccmission.org), make a donation, subscribe to our newsletter, volunteer, contact us or engage with our work.</p>
    <p>We are committed to handling your personal information in accordance with applicable data protection laws, including the EU General Data Protection Regulation (GDPR), where relevant, and other applicable privacy laws.</p>

    <h2 id="collect">2. Information We Collect</h2>
    <p>We may collect personal information that you provide to us directly, including:</p>
    <div class="lg-icons">{collect.map(c => <span><Icon name={c.icon} size={30} />{c.t}</span>)}</div>
    <p>We may also collect limited technical information automatically when you visit our website, including your IP address, browser type, device information and pages visited.</p>

    <h2 id="use">3. How We Use Your Information</h2>
    <p>We may use your personal information to:</p>
    <ul class="lg-check">
      <li>respond to your enquiries;</li>
      <li>process donations and issue receipts;</li>
      <li>send you updates, newsletters and information about our work (if you have opted in);</li>
      <li>manage volunteer and partnership enquiries;</li>
      <li>improve our website and communications;</li>
      <li>comply with legal and regulatory requirements.</li>
    </ul>

    <h2 id="protect">4. How We Protect Your Information</h2>
    <p>We take appropriate technical and organisational measures to protect your personal information from unauthorised access, loss, misuse or disclosure. We only retain your information for as long as necessary to fulfil the purposes outlined in this policy or as required by law.</p>

    <h2 id="cookies">5. Cookies</h2>
    <p>Our website may use essential cookies to function correctly and, where you consent, analytics cookies that help us understand how visitors use our pages. You can manage or disable cookies at any time through your browser settings.</p>

    <h2 id="third-party">6. Third-Party Services</h2>
    <p>We use trusted third-party providers, such as secure payment processors and email services, to support our work. These providers only process your information on our behalf and in line with this policy. We never sell your personal information.</p>

    <h2 id="contact">7. Contact Us</h2>
    <p>For any privacy-related enquiries, please contact us at IICC Mission, Via delle Milizie 34, 00192 Rome, Italy | info@iiccmission.org | www.iiccmission.org</p>

    <Fragment slot="side">
      <div class="lg-box" id="rights">
        <h3><Icon name="scale-balanced" size={20} /> Your Rights</h3>
        <p style="font-family:var(--font-heading); color:var(--color-navy); font-size:0.875rem; line-height:1.45;">Depending on your location, you may have the right to:</p>
        <ul style="list-style:none; padding:0; margin:0.4rem 0;">
          {rights.map(r => <li style="display:flex; gap:0.5rem; font-family:var(--font-heading); color:var(--color-navy); font-size:0.8125rem; line-height:1.4; padding-block:0.15rem;"><span style="color:#d4932a;">●</span>{r}</li>)}
        </ul>
        <p style="font-family:var(--font-heading); color:var(--color-navy); font-size:0.875rem; line-height:1.45;">To exercise your rights, please contact us using the details below.</p>
      </div>
      <div class="lg-box">
        <h3><Icon name="envelope" size={20} /> Contact Us</h3>
        <p style="font-family:var(--font-heading); color:var(--color-navy); font-size:0.875rem; line-height:1.45; margin-bottom:0.75rem;">If you have any questions about this Privacy Policy or how we handle your personal information, please contact us:</p>
        <p style="display:grid; grid-template-columns:1.5rem 1fr; gap:0.5rem; font-family:var(--font-heading); color:var(--color-navy); font-size:0.875rem; line-height:1.6;"><Icon name="location-dot" size={18} /><span>Via delle Milizie 34<br />00192 Rome, Italy</span><Icon name="envelope" size={18} /><span>info@iiccmission.org</span><Icon name="globe" size={18} /><span>www.iiccmission.org</span></p>
      </div>
    </Fragment>
  </LegalTemplate>

  <QuoteBand quote="Your trust enables us to continue our mission of hope, justice and restoration." cite="IICC Mission" right="/images/support/pp-band.jpg" />
</Layout>
