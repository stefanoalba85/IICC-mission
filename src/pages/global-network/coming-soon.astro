---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Coming Soon — Global Network — IICC Mission" description="New IICC Mission locations and global network expansions — coming soon.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/global-network">Global Network</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Coming Soon</span>
      </nav>
    </div>
  </div>

  <!-- Centred announcement -->
  <section class="section section--white" style="min-height:60vh;display:flex;align-items:center;">
    <div class="wrap" style="text-align:center;max-width:680px;">
      <img src="/IICC_Logo.png" alt="IICC Mission" style="height:80px;object-fit:contain;margin-bottom:2rem;" />
      <span class="eyebrow" style="display:block;margin-bottom:0.75rem;">Global Expansion</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);font-weight:900;color:var(--color-navy);text-transform:uppercase;line-height:1.05;margin-bottom:0.5rem;">COMING SOON</h1>
      <span class="rule rule--amber rule--center" style="display:block;margin-bottom:1.5rem;"></span>
      <p style="font-size:1.0625rem;color:var(--color-muted);line-height:1.75;margin-bottom:2rem;">
        IICC Mission is expanding its global network to new cities, countries and communities. We are preparing to announce new mission locations, regional partnerships and international programs.
      </p>
      <p style="font-family:var(--font-heading);font-size:1.125rem;font-weight:700;color:var(--color-amber);margin-bottom:2rem;">Stay tuned for exciting news from the mission field.</p>
      <div style="display:flex;gap:0.875rem;justify-content:center;flex-wrap:wrap;">
        <a href="/global-network" class="btn btn--amber">VIEW CURRENT NETWORK ›</a>
        <a href="/contact" class="btn btn--outline" style="border-color:var(--color-navy);color:var(--color-navy);">PARTNER WITH US ›</a>
      </div>
    </div>
  </section>

  <section class="section section--navy" style="padding-block:2rem;">
    <div class="wrap" style="text-align:center;">
      <p style="font-size:0.875rem;color:rgba(255,255,255,0.7);margin-bottom:0.5rem;">Be the first to know about new mission openings</p>
      <div style="display:flex;gap:0.625rem;justify-content:center;flex-wrap:wrap;max-width:400px;margin-inline:auto;">
        <input type="email" placeholder="Your email address" class="form-input" style="flex:1;min-width:180px;background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.25);color:#fff;" />
        <button class="btn btn--amber">NOTIFY ME</button>
      </div>
    </div>
  </section>

</Layout>
