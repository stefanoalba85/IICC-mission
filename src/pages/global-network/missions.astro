---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="All Missions — Global Network — IICC Mission" description="Complete listing of IICC Mission national, state and regional missions around the world.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/global-network">Global Network</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">All Missions</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:440px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">A Mission Without Borders</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(2rem,5vw,3.5rem);">ALL</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(2rem,5vw,3.5rem);">MISSIONS</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2.5vw,1.25rem);color:rgba(255,255,255,0.85);line-height:1.6;">
        From Vatican City to Canberra, Ottawa to Washington — our network of hope spans the globe.
      </p>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img src="https://images.unsplash.com/photo-1446776709462-d6b525b8c413?w=800&h=600&fit=crop" alt="Earth from space at night" />
    </div>
  </div>

  <section class="section section--white">
    <div class="wrap">

      <!-- National Missions -->
      <div style="margin-bottom:3rem;">
        <h2 class="section-title" style="margin-bottom:0.5rem;">National Missions</h2>
        <span class="rule rule--amber" style="display:block;margin-bottom:2rem;"></span>
        <div class="grid-3">
          {[
            { flag: '🇦🇺', country: 'Australia', cities: ['Melbourne (HQ)', 'Sydney', 'Brisbane', 'Adelaide'] },
            { flag: '🇮🇹', country: 'Italy', cities: ['Rome', 'Vatican City', 'San Marino'] },
            { flag: '🇺🇸', country: 'United States', cities: ['Washington DC', 'New York'] },
            { flag: '🇨🇦', country: 'Canada', cities: ['Ottawa', 'Toronto'] },
            { flag: '🇲🇨', country: 'Monaco', cities: ['Principality of Monaco'] },
            { flag: '🌍', country: 'Expanding', cities: ['New missions coming soon…'] },
          ].map(m => (
            <div class="card" style="gap:0.75rem;">
              <p style="font-size:2rem;">{m.flag}</p>
              <p class="card__title">{m.country}</p>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.25rem;">
                {m.cities.map(c => (
                  <li style="font-size:0.8125rem;color:var(--color-muted);display:flex;align-items:center;gap:0.375rem;">
                    <span style="color:var(--color-amber);font-size:0.5rem;">●</span> {c}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- State & Regional -->
      <div>
        <h2 class="section-title" style="margin-bottom:0.5rem;">State &amp; Regional Missions (Australia)</h2>
        <span class="rule rule--amber" style="display:block;margin-bottom:2rem;"></span>
        <div class="grid-4">
          {[
            'Victoria', 'New South Wales', 'Queensland', 'South Australia',
            'Western Australia', 'ACT', 'Tasmania', 'Northern Territory',
            'Geelong Region', 'Ballarat Region', 'Bendigo Region', 'Gippsland Region',
            'Hunter Valley', 'Central Coast', 'Wollongong', 'Gold Coast',
            'Sunshine Coast', 'Toowoomba', 'Cairns', 'Darwin',
          ].map(r => (
            <div style="padding:0.75rem 1rem;background:var(--color-off-white);border-radius:2px;border-left:3px solid var(--color-amber);font-size:0.875rem;font-weight:600;color:var(--color-navy);">{r}</div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <div class="amber-band">
    <div class="wrap" style="text-align:center;">
      <p style="font-family:var(--font-display);font-size:clamp(1rem,2.5vw,1.375rem);font-weight:900;color:#fff;text-transform:uppercase;margin-bottom:0.5rem;">BRING IICC MISSION TO YOUR CITY</p>
      <p style="font-size:0.9375rem;color:rgba(255,255,255,0.88);margin-bottom:1rem;">Contact us to discuss establishing a mission presence in your community.</p>
      <a href="/contact" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;">CONTACT US ›</a>
    </div>
  </div>

</Layout>
