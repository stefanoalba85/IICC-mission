---
import Layout from '../../layouts/Layout.astro';

const nationalMissions = [
  { flag: '🇻🇦', country: 'Vatican City / Rome', note: 'Head Office' },
  { flag: '🇺🇸', country: 'Washington D.C., USA', note: '' },
  { flag: '🇦🇺', country: 'Canberra, Australia', note: '' },
  { flag: '🇨🇦', country: 'Ottawa, Canada', note: '' },
  { flag: '🇮🇹', country: 'Rome, Italy', note: '' },
  { flag: '🇸🇲', country: 'San Marino', note: '' },
  { flag: '🇲🇨', country: 'Monaco', note: '' },
];

const stateMissions = [
  { flag: '🇺🇸', country: 'United States', cities: 'Dallas, Minneapolis, and more' },
  { flag: '🇦🇺', country: 'Australia', cities: 'Melbourne, Sydney, Perth, Adelaide, Hobart, Brisbane, Darwin, and more' },
  { flag: '🇨🇦', country: 'Canada', cities: 'Vancouver, Montreal, Alberta, and more' },
  { flag: '🇮🇹', country: 'Italy', cities: 'Other cities across Italy' },
];
---
<Layout title="Global Missions" description="One Mission. Many Places. Infinite Hope. IICC Mission serves nationally and globally from Vatican City / Rome.">

  <!-- Hero split -->
  <div class="hero-split" style="min-height:540px;">
    <div class="hero-split__text" style="background:#fff;gap:1.25rem;">
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,6vw,4.5rem);font-weight:900;color:var(--color-navy);text-transform:uppercase;line-height:1.05;">
        GLOBAL<br><span style="color:var(--color-amber);">MISSIONS</span>
      </h1>
      <span class="rule rule--amber"></span>
      <span class="heart">♥</span>
      <p style="font-family:var(--font-heading);font-size:clamp(1.125rem,2.5vw,1.5rem);color:var(--color-navy);line-height:1.4;font-weight:600;">
        One Mission. Many Places.<br>Infinite Hope.
      </p>
      <p class="section-desc" style="max-width:none;">
        Head Office in Vatican City / Rome, serving people worldwide through our National, State, and Regional Missions.
      </p>
      <!-- Stats row -->
      <div style="display:flex;gap:2rem;flex-wrap:wrap;">
        <div>
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <p style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:var(--color-navy);">6</p>
          </div>
          <p style="font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-muted);">National Missions</p>
        </div>
        <div>
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <p style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:var(--color-navy);">20+</p>
          </div>
          <p style="font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-muted);">State Missions</p>
        </div>
        <div>
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <p style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:var(--color-navy);">30+</p>
          </div>
          <p style="font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-muted);">Regional Missions</p>
        </div>
      </div>
    </div>
    <div class="hero-split__photo" style="min-height:380px;">
      <img
        src="https://images.unsplash.com/photo-1542393545-10f5cde2c810?w=900&h=700&fit=crop"
        alt="Earth at night — global mission network"
      />
      <div class="hero-split__quote">
        <span class="hero-split__quote-mark">"</span>
        <p class="hero-split__quote-text">Bringing Christ's love, mercy, and hope to those who need it most.</p>
        <span class="hero-split__quote-ref">— IICC Mission</span>
      </div>
    </div>
  </div>

  <!-- Mission Network Worldwide — navy -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow eyebrow--white">Where We Are</span>
        <span class="heart">♥</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1rem,2vw,1.25rem);letter-spacing:0.15em;text-transform:uppercase;color:#fff;">OUR MISSION NETWORK WORLDWIDE</h2>
        <span class="rule rule--amber rule--center"></span>
        <p class="section-desc section-desc--white" style="text-align:center;margin-top:0.5rem;">Uniting hearts. Transforming lives. Restoring hope.</p>
      </div>

      <div style="display:grid;grid-template-columns:1fr;gap:2rem;" class="map-layout">

        <!-- National Missions list -->
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(224,123,0,0.12);border-radius:2px;padding:1.5rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <h3 style="font-family:var(--font-display);font-size:0.625rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-amber);">NATIONAL MISSIONS</h3>
          </div>
          <div style="display:flex;flex-direction:column;gap:0.625rem;">
            {nationalMissions.map(m => (
              <div style="display:flex;align-items:center;gap:0.75rem;">
                <span style="font-size:1.125rem;">{m.flag}</span>
                <div>
                  <p style="font-size:0.875rem;color:#fff;">{m.country}</p>
                  {m.note && <p style="font-size:0.6875rem;color:var(--color-amber);">{m.note}</p>}
                </div>
              </div>
            ))}
          </div>
          <a href="/global-network/missions" class="btn btn--navy" style="margin-top:1.25rem;font-size:0.75rem;border:1px solid rgba(255,255,255,0.2);">LEARN MORE →</a>
        </div>

        <!-- Map placeholder -->
        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(224,123,0,0.1);border-radius:2px;min-height:280px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;padding:2rem;text-align:center;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(224,123,0,0.5)" stroke-width="1"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <p style="font-size:0.875rem;color:rgba(255,255,255,0.45);">Interactive world map</p>
          <div style="display:flex;gap:1.5rem;flex-wrap:wrap;justify-content:center;">
            <div style="display:flex;align-items:center;gap:0.375rem;"><span style="width:8px;height:8px;border-radius:50%;background:var(--color-amber);display:inline-block;"></span><span style="font-size:0.75rem;color:rgba(255,255,255,0.55);">National Missions</span></div>
            <div style="display:flex;align-items:center;gap:0.375rem;"><span style="width:8px;height:8px;border-radius:50%;background:var(--color-gold);display:inline-block;"></span><span style="font-size:0.75rem;color:rgba(255,255,255,0.55);">State Missions</span></div>
            <div style="display:flex;align-items:center;gap:0.375rem;"><span style="width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,0.4);display:inline-block;"></span><span style="font-size:0.75rem;color:rgba(255,255,255,0.55);">Regional Missions</span></div>
          </div>
        </div>

        <!-- State & Regional Missions -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(224,123,0,0.12);border-radius:2px;padding:1.5rem;">
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <h3 style="font-family:var(--font-display);font-size:0.625rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-amber);">STATE MISSIONS</h3>
            </div>
            {stateMissions.map(m => (
              <div style="display:flex;align-items:flex-start;gap:0.75rem;margin-bottom:0.875rem;">
                <span style="font-size:1.125rem;flex-shrink:0;">{m.flag}</span>
                <div>
                  <p style="font-size:0.875rem;font-weight:600;color:#fff;">{m.country}</p>
                  <p style="font-size:0.75rem;color:rgba(255,255,255,0.55);">{m.cities}</p>
                </div>
              </div>
            ))}
            <a href="/global-network/missions" class="btn btn--amber" style="margin-top:0.75rem;font-size:0.75rem;padding:0.5rem 1rem;">VIEW ALL →</a>
          </div>
          <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(224,123,0,0.12);border-radius:2px;padding:1.5rem;">
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/></svg>
              <h3 style="font-family:var(--font-display);font-size:0.625rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-amber);">REGIONAL MISSIONS</h3>
            </div>
            <div style="display:flex;align-items:flex-start;gap:0.75rem;margin-bottom:0.875rem;">
              <span style="font-size:1.125rem;">🇮🇹</span>
              <div>
                <p style="font-size:0.875rem;font-weight:600;color:#fff;">Italy</p>
                <p style="font-size:0.75rem;color:rgba(255,255,255,0.55);">Milan (Milano), Lamezia Terme</p>
              </div>
            </div>
            <a href="/global-network/missions" class="btn btn--amber" style="margin-top:0.75rem;font-size:0.75rem;padding:0.5rem 1rem;">VIEW ALL →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Our Presence & Purpose -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head section-head--left" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Our Impact</span>
        <h2 class="section-title">OUR PRESENCE. OUR PURPOSE.</h2>
        <span class="rule rule--amber"></span>
      </div>
      <div class="cols-2" style="gap:3rem;align-items:center;">
        <div class="pillars" style="grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:2rem;">
          {[
            { icon: '🏛️', label: 'Head Office', sub: 'Vatican City / Rome', desc: 'Guiding our mission with faith and compassion.' },
            { icon: '🌍', label: 'National Missions', sub: '6 Countries', desc: 'Leading the mission in key capital cities.' },
            { icon: '🏙️', label: 'State Missions', sub: '20+ Locations', desc: 'Reaching communities across states and regions.' },
            { icon: '📍', label: 'Regional Missions', sub: '20+ Cities', desc: 'On the ground, close to those we serve.' },
            { icon: '🌐', label: 'Global Impact', sub: 'One Mission', desc: 'Changing lives and restoring hope worldwide.' },
          ].map(p => (
            <div class="pillar">
              <div class="pillar__icon-wrap" style="font-size:1.125rem;">{p.icon}</div>
              <p class="pillar__label">{p.label}</p>
              <p style="font-size:0.6875rem;font-weight:700;color:var(--color-amber);letter-spacing:0.06em;">{p.sub}</p>
              <p class="pillar__desc">{p.desc}</p>
            </div>
          ))}
        </div>
        <div style="position:relative;border-radius:2px;overflow:hidden;min-height:280px;">
          <img
            src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=700&h=480&fit=crop"
            alt="Together we cross borders to bring hope without limits"
            style="width:100%;height:100%;object-fit:cover;"
          />
          <div style="position:absolute;inset:0;background:rgba(18,26,56,0.6);display:flex;align-items:center;justify-content:center;padding:2rem;text-align:center;">
            <p style="font-family:var(--font-heading);font-style:italic;font-size:clamp(1rem,2vw,1.375rem);color:#fff;line-height:1.5;">Together, we cross borders to bring hope without limits.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Locations -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Where We Serve</span>
        <h2 class="section-title">FEATURED LOCATIONS</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem;margin-bottom:2rem;">
        {[
          { name: 'Vatican City / Rome', role: 'Head Office', img: 'https://images.unsplash.com/photo-1555992336-03a23c7b20ee?w=300&h=200&fit=crop', flag: '🇻🇦' },
          { name: 'Washington D.C., USA', role: 'National Mission', img: 'https://images.unsplash.com/photo-1501466044931-62695aada8e9?w=300&h=200&fit=crop', flag: '🇺🇸' },
          { name: 'Canberra, Australia', role: 'National Mission', img: 'https://images.unsplash.com/photo-1531983412531-1f49a365ffed?w=300&h=200&fit=crop', flag: '🇦🇺' },
          { name: 'Ottawa, Canada', role: 'National Mission', img: 'https://images.unsplash.com/photo-1534430480872-3498386e7856?w=300&h=200&fit=crop', flag: '🇨🇦' },
          { name: 'Rome, Italy', role: 'National Mission', img: 'https://images.unsplash.com/photo-1552832230-c0197dd311b5?w=300&h=200&fit=crop', flag: '🇮🇹' },
          { name: 'San Marino', role: 'National Mission', img: 'https://images.unsplash.com/photo-1583422409516-2895a77efded?w=300&h=200&fit=crop', flag: '🇸🇲' },
          { name: 'Monaco', role: 'National Mission', img: 'https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=300&h=200&fit=crop', flag: '🇲🇨' },
        ].map(l => (
          <div style="background:#fff;border-radius:2px;overflow:hidden;border:1px solid rgba(27,39,81,0.08);">
            <img src={l.img} alt={l.name} style="width:100%;height:110px;object-fit:cover;" />
            <div style="padding:0.75rem;">
              <p style="font-size:0.875rem;font-weight:700;color:var(--color-navy);margin-bottom:0.125rem;">{l.flag} {l.name}</p>
              <p style="font-size:0.6875rem;color:var(--color-amber);font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">{l.role}</p>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;">
        <a href="/global-network/missions" class="btn btn--amber">EXPLORE ALL LOCATIONS →</a>
      </div>
    </div>
  </section>

  <!-- CTA amber band -->
  <div class="amber-band">
    <div class="wrap" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:2rem;">
      <div>
        <p style="font-family:var(--font-heading);font-size:1.25rem;color:#fff;font-weight:700;">Our mission knows no borders. Hope has no limits.</p>
        <p style="font-size:0.875rem;color:rgba(255,255,255,0.85);margin-top:0.25rem;font-style:italic;">Wherever there is hardship, we are there. Wherever there is hope, we stay.</p>
      </div>
      <a href="/donate" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;white-space:nowrap;">SUPPORT OUR GLOBAL MISSION ♥</a>
    </div>
  </div>

</Layout>

<style>
  @media (min-width: 900px) {
    .map-layout { grid-template-columns: 240px 1fr 280px !important; }
  }
</style>
