---
import Layout from '../../layouts/Layout.astro';
import GmHero from '../../components/GmHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GmCta from '../../components/GmCta.astro';
import GmBand from '../../components/GmBand.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/partnerships/${n}.jpg`;
---
<Layout title="Global Mission Network" description="Together across borders. United in faith. Restoring hope.">
  <GmHero kicker="Global Mission Network" title="Together across borders. United in faith. Restoring hope." text="The IICC Mission Global Network connects branches, partners, churches, organisations and communities around the world in a shared commitment to faith, hope, justice and restoration. Wherever we are, we walk together to bring lasting change." cta2="Become a Partner" cta2Href="/partnerships/churches-parish-partners" img={img('net-hero')} alt="IICC Mission volunteers in front of a glowing world map" />
  <section style="background:var(--color-navy-dark); color:#fff; text-align:center; padding-top:1rem;"><h2 style="font-family:var(--font-body); font-weight:400; text-transform:uppercase; font-size:1.125rem;">One Mission. Many Nations. Endless Hope.</h2></section>
  <GiIcons dark items={[{ icon: 'hand-holding-heart', title: 'Global Unity', text: 'One mission shared across nations.' },{ icon: 'cross', title: 'Faith Centered', text: 'Grounded in faith and guided by love.' },{ icon: 'people-group', title: 'Community Collaboration', text: 'Working together for greater impact.' },{ icon: 'globe', title: 'Local Solutions', text: 'Supporting local communities with practical, sustainable solutions.' },{ icon: 'hand-holding-heart', title: 'Lasting Change', text: 'Restoring dignity, hope and new beginnings.' },{ icon: 'seedling', title: 'Growing Network', text: 'Expanding our reach through partnerships and compassion.' }]} />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:0.8fr 1.6fr; gap:1.5rem; padding-block:1.5rem; align-items:center;">
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Our Global Network</h2><span style="display:block; width:2.5rem; height:2px; background:#c9741f; margin-block:0.5rem;"></span><p class="im-p">IICC Mission is active in multiple countries and continually expanding to reach more communities in need.</p><p class="im-p" style="margin-block:0.75rem 1rem;">Our network includes branches, partners, churches, organisations and community groups working together to create hope and transform lives.</p><a href="/partnerships/international-branches" class="btn btn--navy">View All International Branches →</a></div>
    <img src={img('net-map')} alt="World map showing active branches, partner networks and future regions" style="width:100%;" />
  </section>
  <section class="wrap" style="padding-bottom:1.25rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Our Global Pillars</h2><div class="camp-grid" style="display:grid; grid-template-columns:repeat(5,1fr); gap:0.75rem; margin-top:0.75rem;">{[['people-group','Spiritual & Pastoral Care','Providing spiritual guidance, prayer, pastoral care and support for individuals and families.'],['scale-balanced','Justice & Advocacy','Advocating for human dignity, fair treatment and second chances for all.'],['book-open','Education & Empowerment','Equipping individuals with education, skills training and opportunities to thrive.'],['hand-holding-heart','Humanitarian Support','Delivering practical assistance, relief and support to those facing hardship.'],['sunRoad','Healing, Restoration & Reintegration','Supporting the journey from healing to restoration and successful reintegration.']].map(([i,t,d]) => <div style="border:1px solid #e5e1d8; padding:1rem; text-align:center; display:flex; flex-direction:column; align-items:center; gap:0.5rem;"><span style="color:#c9741f;"><Icon name={i} size={52} /></span><strong style="font-size:0.8125rem; text-transform:uppercase; color:var(--color-navy);">{t}</strong><span style="font-size:0.8125rem;">{d}</span></div>)}</div></section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1fr; background:#f4f2ee; margin-bottom:1rem; align-items:center;"><div style="padding:1.25rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Connected. Collaborative. Compassionate.</h2><p class="im-p" style="margin-block:0.5rem 0.9rem;">Our Global Mission Network thrives through strong relationships with churches, organisations, community leaders and volunteers who share our values and vision.</p><div class="camp-trio">{[['globe','5','Countries','Active Branches & Partners'],['people-group','20+','International Partners','Churches, Organisations & Community Groups'],['people-group','5000+','Lives Impacted','Through Programs Each Year'],['seedling','1','Unified Mission','Faith. Hope. Justice. Restoration.']].map(([i,n,t,d]) => <div><Icon name={i} size={24} /><strong style="font-family:var(--font-heading); font-size:1.5rem; text-transform:none;">{n}</strong><strong style="font-size:0.75rem;">{t}</strong><span>{d}</span></div>)}</div></div><img src={img('net-team')} alt="IICC Mission volunteers packing care boxes" style="width:100%; height:100%; object-fit:cover;" /></section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1.1fr; background:#f4f2ee; margin-bottom:1.25rem; align-items:center;"><img src={img('net-hands')} alt="Many hands joined together" style="width:100%; height:100%; object-fit:cover;" /><div style="padding:1.25rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Partner With Our Global Network</h2><p class="im-p" style="margin-block:0.5rem 0.9rem;">Your partnership helps us reach more people, strengthen communities and create lasting change around the world.</p><div class="camp-trio">{[['hands-praying','Pray','for our mission and our global partners'],['handshake','Partner','with us as a church, organisation or business'],['people-group','Volunteer','your skills and time to make a real difference'],['hand-holding-heart','Donate','to support our work and expand our mission globally']].map(([i,t,d]) => <div><Icon name={i} size={30} /><strong>{t}</strong><span>{d}</span></div>)}</div></div></section>
  <GmCta title="Together, we can restore hope worldwide." text="Join the IICC Mission Global Network and be part of something bigger than ourselves. Together, we can build a better future for all." />
</Layout>
