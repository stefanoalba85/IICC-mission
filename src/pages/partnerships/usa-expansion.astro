---
import Layout from '../../layouts/Layout.astro';
import GmHero from '../../components/GmHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GmCta from '../../components/GmCta.astro';
import GmBand from '../../components/GmBand.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/partnerships/${n}.jpg`;
---
<Layout title="USA Mission Expansion" description="Bringing hope across America.">
  <GmHero title="USA Mission<br/><span style='color:#c9741f'>Expansion</span>" kicker="Bringing Hope Across America" text="The IICC Mission USA is expanding to serve individuals, families and communities across the United States through a coordinated network of Area/Zone, State and Regional Missions. Working with churches, chaplains, organisations and community partners, we provide practical support, pastoral care, education and pathways to restoration." cta1="Our USA Mission" img={img('us-hero')} alt="The Statue of Liberty and New York skyline" quote="A nation is stronger when no one is forgotten." />
  <GiIcons dark items={[{ icon: 'people-group', title: 'Four Area/Zone Missions', text: 'Strategic regional leadership across the United States.' },{ icon: 'location-dot', title: 'State Missions', text: 'Operating in each state capital with local teams and partners.' },{ icon: 'house', title: 'Regional Missions', text: 'Active in key cities and communities.' },{ icon: 'heart', title: 'Local Impact', text: 'Supporting individuals and families through practical programs and pastoral care.' },{ icon: 'globe', title: 'A Stronger America', text: 'Building safer, stronger communities through faith, hope, justice and restoration.' }]} />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; padding-block:1.25rem;">
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Our Structure in the USA</h2><p style="font-family:var(--font-heading); color:var(--color-navy);">The IICC Mission USA operates through 4 Area/Zone Missions, each supervising State Missions, with Regional Missions in key cities.</p><img src={img('us-map')} alt="US map of the four zones" style="width:100%; margin-top:0.5rem;" /></div>
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Our Area/Zone Missions</h2><div style="display:grid; grid-template-columns:1fr 1fr; gap:0.6rem; margin-top:0.6rem;">{[['us-z1','West Zone – Los Angeles','Supervises State Missions in Western states (e.g. CA, NV, WA, OR, AZ, etc.)','#c9861a'],['us-z2','North Zone – Minneapolis','Supervises State Missions in Central/Northern states (e.g. MN, IL, MI, OH, IA, etc.)','#2a64b8'],['us-z3','South Zone – Dallas','Supervises State Missions in Southern states (e.g. TX, FL, GA, AL, TN, etc.)','#3f8f2f'],['us-z4','East Zone – Washington','Supervises State Missions in Eastern states (e.g. NY, PA, VA, NC, etc.)','#d23b3b']].map(([p,t,d,c]) => <div style="border:1px solid #e5e1d8;"><img src={img(p)} alt="" style="width:100%; aspect-ratio:221/82; object-fit:cover;" /><p style={`background:${c}; color:#fff; padding:0.35rem 0.6rem; font-size:0.8125rem; text-transform:uppercase;`}>{t} →</p><p style="font-size:0.8125rem; padding:0.5rem 0.6rem;">{d}</p></div>)}</div></div>
  </section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1fr 1.2fr; gap:1.25rem; padding-bottom:1.25rem;">
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Hierarchy &amp; Flow</h2>{[['flag-usa','USA National Mission','(Overall coordination)'],['people-group','Area/Zone Missions','(4 Zones – LA, Minneapolis, Dallas, Washington)'],['landmark','State Missions','(Each State Capital)'],['location-dot','Regional Missions','(Key Cities & Communities)']].map(([i,t,d],k) => <><div style="background:var(--color-navy-dark); color:#fff; padding:0.6rem 1rem; display:grid; grid-template-columns:2.5rem 1fr; gap:0.75rem; align-items:center; margin-top:0.4rem;"><Icon name={i} size={28} /><span style="text-transform:uppercase; font-size:0.8125rem; text-align:center;">{t}<br /><small style="text-transform:none;">{d}</small></span></div>{k < 3 && <p style="text-align:center; color:#c9741f;">↓</p>}</>)}</div>
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Key Goals</h2>{[['bullseye','Establish leadership teams in all 4 zones by 2027'],['people-group','Launch State Missions across all 50 states'],['location-dot','Develop Regional Missions in major cities and communities'],['handshake','Partner with churches, chaplains, NGOs and community organisations'],['chart-column','Deliver measurable impact and long-term sustainable programs']].map(([i,t]) => <div class="im-row" style="grid-template-columns:3rem 1fr; align-items:center;"><i><Icon name={i} size={20} /></i><p style="font-size:0.875rem;">{t}</p></div>)}</div>
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Program Areas in the USA</h2><div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.5rem; margin-top:0.6rem;">{[['us-p1','Prison Ministry','Pastoral care, support and reintegration programs.'],['us-p2','Family Support','Helping families stay connected and access essential services.'],['us-p3','Legal Assistance','Information, referrals and advocacy support.'],['us-p4','Education & Training','Skills, mentoring and pathways to employment.'],['us-p5','Mental Health & Wellbeing','Support and referral services.'],['us-p6','Community Outreach','Building stronger, safer communities.']].map(([p,t,d]) => <div style="text-align:center;"><img src={img(p)} alt="" style="width:100%; aspect-ratio:112/66; object-fit:cover;" /><strong style="display:block; font-size:0.75rem; text-transform:uppercase; color:var(--color-navy); margin-top:0.3rem;">{t}</strong><span style="font-size:0.7rem;">{d}</span></div>)}</div></div>
  </section>
  <GmBand img={img('us-band')} lines="Stronger communities.<br/><span style='color:#d9862a'>Brighter tomorrows.<br/>Across America.</span>" quote="Together we can bring hope, dignity and real change to communities across the United States." cta="Support the USA Mission" />
</Layout>
