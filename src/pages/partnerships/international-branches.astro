---
import Layout from '../../layouts/Layout.astro';
import GmHero from '../../components/GmHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GmCta from '../../components/GmCta.astro';
import GmBand from '../../components/GmBand.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/partnerships/${n}.jpg`;
---
<Layout title="International Branches" description="One mission. Many nations. Restoring hope.">
  <GmHero kicker="International Branches" title="One mission.<br/>Many nations.<br/>Restoring hope." text="IICC Mission is a global movement of faith, compassion and practical support. Through our international branches and partners, we walk alongside individuals and communities to restore dignity, rebuild lives and create lasting change." cta2="Partner With Us" img={img('int-hero')} alt="The Earth at night with glowing connections" />
  <GiIcons dark items={[{ icon: 'globe', title: 'Global Vision', text: 'A worldwide mission to restore hope and transform communities.' },{ icon: 'hand-holding-heart', title: 'Local Presence', text: 'Empowering local leaders to create real, lasting change.' },{ icon: 'people-group', title: 'Shared Values', text: 'Faith, hope, justice and restoration guide our work in every nation.' },{ icon: 'handshake', title: 'Strong Partnerships', text: 'Working with churches, organisations and communities around the world.' },{ icon: 'hand-holding-heart', title: 'Together We Can', text: 'United in compassion to build a better future for all.' }]} />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:0.9fr 2.6fr; gap:1rem; padding-block:1.5rem; align-items:center;">
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Our Global Reach</h2><p class="im-p" style="margin-top:0.75rem;">IICC Mission is growing through international branches, partnerships and local initiatives. Together, we are building a world where everyone has the opportunity to rebuild, belong and thrive.</p></div>
    <div class="camp-grid" style="display:grid; grid-template-columns:repeat(5,1fr); gap:0.6rem;">{[['globe','5','Countries','Active Branches & Partners'],['people-group','20+','International Partners','Churches, Organisations & Community Groups'],['hand-holding-heart','5000+','Lives Impacted','Through Programs Each Year'],['cross','1','Unified Mission','Faith. Hope. Justice. Restoration.'],['location-dot','Expanding','More Regions Coming Soon','New branches in development']].map(([i,n,t,d]) => <div style="border:1px solid #e5e1d8; padding:1rem 0.5rem; text-align:center; display:flex; flex-direction:column; align-items:center; gap:0.3rem;"><span style="color:#c9741f;"><Icon name={i} size={40} /></span><strong style="font-family:var(--font-heading); color:var(--color-navy); font-size:1.5rem;">{n}</strong><span style="color:var(--color-navy); font-size:0.875rem;">{t}</span><span style="font-size:0.75rem;">{d}</span></div>)}</div>
  </section>
  <section class="wrap" style="padding-bottom:1.25rem;"><h2 class="camp-h">Our International Branches</h2><div class="camp-grid" style="display:grid; grid-template-columns:1.1fr 1fr; gap:1rem; margin-top:0.75rem;"><img src={img('int-map')} alt="Map of Italy, South America, Africa and Australia branches" style="width:100%;" /><div style="display:flex; flex-direction:column; gap:0.5rem;">{[['int-b1','Italy','Italian Branch','Restoring lives through community support, social enterprise and partnerships.','/partnerships/italian-branches'],['int-b2','Australia','Australian Branch','Supporting individuals and families with practical support, education and reintegration programs.','/partnerships/australian-branches'],['int-b3','South America','Partner Network','Working with local partners to bring hope, education and support to communities.','/partnerships'],['int-b4','Africa','Partner Network','Building strong local relationships to support dignity, opportunity and transformation.','/partnerships']].map(([p,t,s,d,h]) => <a href={h} style="display:grid; grid-template-columns:8rem 1fr 1.5rem; gap:0.9rem; align-items:center; border:1px solid #e5e1d8; color:var(--color-navy);"><img src={img(p)} alt={t} style="width:100%; height:100%; object-fit:cover;" /><span><strong style="font-family:var(--font-heading); text-transform:uppercase; font-size:1.0625rem; font-weight:400;">{t}</strong><br /><span style="font-size:0.8125rem;">{s}</span><br /><span style="font-size:0.8125rem;">{d}</span></span><span style="color:#c9741f;">→</span></a>)}<div style="display:grid; grid-template-columns:8rem 1fr; gap:0.9rem; align-items:center; border:1px solid #e5e1d8;"><span style="background:var(--color-navy-dark); color:#fff; display:flex; align-items:center; justify-content:center; height:100%; min-height:68px;"><Icon name="globe" size={40} /></span><span style="color:var(--color-navy);"><strong style="font-family:var(--font-heading); text-transform:uppercase; font-weight:400;">More Regions</strong><br /><span style="font-size:0.8125rem;">Coming Soon — new branches and partnerships are being established in more regions.</span></span></div></div></div></section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:0.5fr 1.2fr 0.7fr; background:#f4f2ee; margin-bottom:1.25rem; align-items:center;"><img src={img('int-hands')} alt="Hands joined together" style="width:100%; height:100%; object-fit:cover;" /><div style="padding:1.25rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Be Part of Our Global Mission</h2><p class="im-p" style="margin-block:0.5rem 0.9rem;">Your partnership can help us reach more people and transform more communities across the world. Together, we can restore hope.</p><div class="camp-trio">{[['hands-praying','Pray','Pray for our mission and the regions we serve.'],['handshake','Partner','Partner with us as a church, organisation or business.'],['people-group','Volunteer','Use your skills and time to make a real difference.'],['hand-holding-heart','Donate','Support our work and create lasting change in lives.']].map(([i,t,d]) => <div><Icon name={i} size={30} /><strong>{t}</strong><span>{d}</span></div>)}</div></div><p style="background:var(--color-navy-dark); color:#fff; padding:1.5rem; font-family:var(--font-heading); font-size:1.25rem; line-height:1.4; height:100%;"><span style="color:#d9862a; font-size:2.5rem; line-height:0.5;">&ldquo;</span><br />Go into all the world and proclaim the gospel to the whole creation.<span style="display:block; color:#d9862a; font-size:0.9375rem; margin-top:0.5rem;">MARK 16:15</span></p></section>
  <GmCta title="Together, we can restore hope across the world." text="Join the IICC Mission family and be part of something bigger than ourselves." />
</Layout>
