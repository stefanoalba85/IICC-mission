---
import Layout from '../../layouts/Layout.astro';
import GmHero from '../../components/GmHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GmCta from '../../components/GmCta.astro';
import GmBand from '../../components/GmBand.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/partnerships/${n}.jpg`;
---
<Layout title="Regional Missions Structure" description="Local presence. Real change.">
  <GmHero kicker="Regional Missions Structure" title="Local<br/>presence.<br/><span style='color:#c9741f'>Real change.</span>" text="Regional Missions bring the IICC Mission to local communities, ensuring our programs reach people where they live — in cities, towns and regions. Through local partnerships and dedicated teams, we provide practical support, pastoral care and pathways to restoration." cta1="Our Global Missions" img={img('rg-hero')} alt="An Italian hill town at sunset" quote="Real hope grows when we are present in local communities." />
  <GiIcons dark items={[{ icon: 'location-dot', title: 'Community Focus', text: 'Addressing local needs with local solutions.' },{ icon: 'people-group', title: 'Local Partnerships', text: 'Working with parishes, churches, NGOs and community organisations.' },{ icon: 'hand-holding-heart', title: 'Practical Support', text: 'Delivering programs and services tailored to each region.' },{ icon: 'chart-column', title: 'Measurable Impact', text: 'Stronger communities and brighter futures.' },{ icon: 'globe', title: 'Connected Network', text: 'Part of a national and global mission of faith, hope, justice and restoration.' }]} />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; padding-block:1.25rem;">
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> What Are Regional Missions?</h2><p class="im-p" style="margin-block:0.6rem 1rem;">Regional Missions operate within each state or province, focusing on specific cities and local areas. They identify local needs, build partnerships, coordinate volunteers and deliver IICC Mission programs in the community.</p><div class="camp-trio">{[['bullseye','Local Leadership','Led by regional coordinators and local teams.'],['people-group','Tailored Programs','Designed to meet the needs of each community.'],['handshake','Stronger Communities','Working together for lasting positive change.'],['cross','Faith in Action','Bringing the love of Christ to those in need.']].map(([i,t,d]) => <div><span style="color:#c9741f;"><Icon name={i} size={40} /></span><strong>{t}</strong><span>{d}</span></div>)}</div></div>
    <div><h2 class="camp-h">Regional Missions Within Each State</h2><div style="display:flex; flex-direction:column; align-items:center; gap:0.5rem; margin-top:0.75rem;">{[['globe','National Mission','(e.g. Italy, Australia, USA, Canada)'],['people-group','State / Provincial Mission','(e.g. Lazio, California, New South Wales, Ontario)']].map(([i,t,d]) => <><div style="background:var(--color-navy-dark); color:#fff; padding:0.75rem 1.25rem; display:flex; gap:1rem; align-items:center; width:85%;"><Icon name={i} size={32} /><span style="text-transform:uppercase; font-size:0.875rem;">{t}<br /><small style="text-transform:none;">{d}</small></span></div><span style="color:#c9741f;">↓</span></>)}<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.5rem; width:100%;">{['Rome','Milan','Lamezia Terme'].map(c => <div style="border:1px solid #e6b67a; padding:0.75rem; text-align:center; color:var(--color-navy); font-size:0.8125rem;"><span style="color:#c9741f;"><Icon name="location-dot" size={28} /></span><br />REGIONAL MISSION<br />(e.g. {c})</div>)}</div></div></div>
  </section>
  <section class="wrap" style="padding-bottom:1.25rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.5rem;">Examples of Regional Missions</h2><div class="camp-grid" style="display:grid; grid-template-columns:repeat(4,1fr); gap:0.75rem; margin-top:0.75rem;">{[['rg-1','🇮🇹','Italy','Rome Regional Mission','Supporting individuals and families through local parishes, detention centres and community programs in the Rome area.','Rome'],['rg-2','🇮🇹','Italy','Milan Regional Mission','Working with local churches and organisations to support incarcerated and vulnerable people in the Lombardy region.','Milan'],['rg-3','🇮🇹','Italy','Lamezia Terme Regional Mission','Serving the Calabria region through local partnerships, family support, education and reintegration programs.','Lamezia Terme'],['rg-4','🇦🇺','Australia','Sydney Regional Mission','Working with local parishes, community groups and support services to bring hope and practical assistance.','Sydney']].map(([p,f,c,t,d,n]) => <div style="border:1px solid #e5e1d8; display:flex; flex-direction:column;"><img src={img(p)} alt={t} style="width:100%; aspect-ratio:236/111; object-fit:cover;" /><div style="padding:0.9rem; display:flex; flex-direction:column; gap:0.5rem; flex:1;"><p style="display:flex; gap:0.6rem; align-items:center;"><span style="font-size:2rem;">{f}</span><span style="font-family:var(--font-heading); color:var(--color-navy); line-height:1.15;"><strong style="text-transform:uppercase;">{c}</strong><br />{t}</span></p><p class="im-p" style="font-size:0.875rem; flex:1;">{d}</p><a href="/contact" class="btn btn--navy" style="justify-content:center;">View {n} Mission →</a></div></div>)}</div></section>
  <GmBand img={img('rg-band')} lines="Stronger regions.<br/><span style='color:#d9862a'>Brighter futures.</span>" quote="Hope takes root in our neighbourhoods, and from there it can transform lives." cta="Support a Regional Mission" />
</Layout>
