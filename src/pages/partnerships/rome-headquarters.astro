---
import Layout from '../../layouts/Layout.astro';
import GmHero from '../../components/GmHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GmCta from '../../components/GmCta.astro';
import GmBand from '../../components/GmBand.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/partnerships/${n}.jpg`;
---
<Layout title="Vatican City / Rome Headquarters" description="A global mission. A home in Rome.">
  <GmHero kicker="Rome Headquarters" title="A global<br/>mission.<br/><span style='color:#c9a017'>A home<br/>in Rome.</span>" text="From the heart of the Catholic Church, IICC Mission coordinates and supports our global work, bringing hope, dignity and practical support to individuals, families and communities around the world." cta1="Our Global Mission" img={img('rome-hero')} alt="St Peter’s Basilica and Ponte Sant’Angelo at sunset" quote="A place of hope, service and new beginnings." />
  <section class="camp-grid" style="display:grid; grid-template-columns:1.25fr 0.7fr 0.85fr; background:#fff;">
    <div style="padding:1.5rem 1.5rem 1.5rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem));"><p style="color:#c9741f; text-transform:uppercase; font-weight:700;">Our Headquarters</p><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:2rem; line-height:1.05;">IICC Mission<br />Rome Headquarters</h2><p style="font-family:var(--font-heading); color:var(--color-navy); font-size:1.0625rem; line-height:1.5; margin-block:0.75rem;">The Rome Headquarters serves as the central coordination and support hub for IICC Mission. Located in close proximity to the Vatican, the Headquarters provides strategic leadership, global coordination, partnership development and support for our national, state and regional missions.</p><p style="font-family:var(--font-heading); color:var(--color-navy); font-size:1.0625rem; line-height:1.5;">From this location, we work closely with Church leaders, Catholic dioceses, chaplains, organisations and community partners to advance our mission of faith, hope, justice and restoration.</p></div>
    <div style="padding:1.5rem 0.75rem; border-left:1px solid #e5e1d8;">{[['location-dot','Address','Via delle Milizie 34, 00192 Rome, Italy'],['landmark','Strategic Location','Close to the Vatican and key Church institutions, enabling collaboration, dialogue and greater impact.'],['people-group','Global Coordination','Supporting missions and partners across Italy and worldwide.'],['heart','A Place of Welcome','A home for collaboration, planning and service.']].map(([i,t,d]) => <div style="display:grid; grid-template-columns:2.5rem 1fr; gap:0.6rem; margin-bottom:0.9rem;"><span style="color:var(--color-navy);"><Icon name={i} size={28} /></span><div><strong style="text-transform:uppercase; font-size:0.8125rem; color:var(--color-navy);">{t}</strong><p style="font-size:0.8125rem;">{d}</p></div></div>)}</div>
    <img src={img('rome-bldg')} alt="The IICC Mission Rome headquarters building with flags" style="width:100%; height:100%; object-fit:cover;" />
  </section>
  <section style="background:var(--color-navy-dark); color:#fff;"><div class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; padding-block:1.25rem; align-items:center;"><div><p style="color:#c9a017; text-transform:uppercase; font-weight:700;">Our Purpose</p><h2 style="font-family:var(--font-heading); text-transform:uppercase; font-size:1.625rem; line-height:1.2;">To share Christ’s love, mercy and hope <span style="color:#c9a017;">in practical ways</span></h2></div><p style="font-family:var(--font-heading); font-size:1.0625rem; line-height:1.5; border-left:1px solid rgba(255,255,255,0.3); padding-left:1.5rem;">The Rome Headquarters enables IICC Mission to build strong partnerships, develop programs, support our teams, and amplify our impact for those affected by imprisonment, immigration detention, family hardship and social vulnerability.</p></div></section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:repeat(4,1fr); gap:0.6rem; padding-block:1.25rem;">{[['rome-1','Meetings & Partnerships','A place to welcome Church leaders, partners and supporters.'],['rome-2','Prayer & Spiritual Support','A space for prayer, reflection and pastoral care.'],['rome-3','Global Coordination','Supporting our missions around the world.'],['rome-4','Collaboration & Hospitality','A welcoming environment for partners and guests.']].map(([p,t,d]) => <div style="text-align:center;"><img src={img(p)} alt={t} style="width:100%; aspect-ratio:262/176; object-fit:cover;" /><h3 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:0.9375rem; margin-top:0.5rem;">{t}</h3><p style="font-family:var(--font-heading); color:var(--color-navy); font-size:0.9375rem;">{d}</p></div>)}</section>
  <section class="camp-grid" style="display:grid; grid-template-columns:1fr 1fr 0.6fr; background:#fbf6ec; align-items:center;"><img src={img('rome-band')} alt="St Peter’s Basilica with a statue" style="width:100%; height:100%; object-fit:cover;" /><p style="padding:1.25rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:1.375rem; line-height:1.4;"><span style="color:#c9741f; font-size:2.5rem; line-height:0.5; font-style:normal;">&ldquo;</span> Together, in faith and solidarity, we can build a more just, compassionate and inclusive world.</p><img src="/IICC_Logo_main.png" alt="IICC Mission" style="width:70%; justify-self:center;" /></section>
</Layout>
