---
import Layout from '../../layouts/Layout.astro';
import GmHero from '../../components/GmHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GmCta from '../../components/GmCta.astro';
import GmBand from '../../components/GmBand.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/partnerships/${n}.jpg`;
---
<Layout title="Canada Mission Expansion" description="Stronger communities. Brighter futures.">
  <GmHero kicker="Canada Mission Expansion" title="Stronger<br/>communities.<br/><span style='color:#c9741f'>Brighter<br/>futures.</span>" text="The IICC Mission Canada is expanding to serve individuals, families and communities across Canada through a coordinated network of Provincial and Regional Missions. Working with Catholic dioceses, churches, chaplains, organisations and community partners, we provide practical support, pastoral care, education and pathways to restoration." cta1="Our Canada Mission" img={img('ca-hero')} alt="The Canadian flag and Parliament Hill at sunset" quote="Hope grows stronger when communities stand together." />
  <GiIcons dark items={[{ icon: 'people-group', title: 'National Presence', text: 'A coordinated mission across all provinces and territories.' },{ icon: 'house', title: 'Faith in Action', text: 'Working with Catholic dioceses, parishes and chaplains.' },{ icon: 'heart', title: 'Community Support', text: 'Practical programs for individuals, families and local communities.' },{ icon: 'chart-column', title: 'Lasting Impact', text: 'Restoring lives, strengthening communities and building brighter futures.' },{ icon: 'leaf', title: 'A Stronger Canada', text: 'United in compassion to create safer, more inclusive and hopeful communities.' }]} />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; padding-block:1.25rem;">
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Our Canada Mission</h2><p style="font-family:var(--font-heading); color:var(--color-navy);">IICC Mission Canada operates through Provincial Missions, each supported by Regional Missions in key cities and communities. We work in partnership with local churches, chaplains, organisations and community groups to address the specific needs of each region.</p><img src={img('ca-map')} alt="Map of Canada’s provinces and territories" style="width:100%; margin-top:0.5rem;" /><div class="camp-trio" style="margin-top:0.5rem;">{[['location-dot','10','Provinces & 3 Territories'],['people-group','50+','Key Cities & Regions'],['house','Many','Dioceses & Parishes as Partners'],['people-group','Growing','Team of Volunteers & Supporters']].map(([i,n,t]) => <div><span style="color:#c9741f;"><Icon name={i} size={30} /></span><strong style="font-family:var(--font-heading); font-size:1.25rem; text-transform:none;">{n}</strong><span>{t}</span></div>)}</div></div>
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Provincial Missions</h2><div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.5rem; margin-top:0.6rem;">{[['ca-1','Ontario','Greater Toronto, Ottawa and key regions.'],['ca-2','Quebec','Montreal, Quebec City and key regions.'],['ca-3','British Columbia','Vancouver, Victoria and key regions.'],['ca-4','Alberta','Calgary, Edmonton and key regions.'],['ca-5','Saskatchewan','Saskatoon, Regina and key regions.'],['ca-6','Manitoba','Winnipeg and key regions.'],['ca-7','Atlantic Provinces','New Brunswick, Nova Scotia, Prince Edward Island, Newfoundland & Labrador.'],['ca-8','Northern Territories','Serving remote communities across Yukon, Northwest Territories and Nunavut.']].map(([p,t,d]) => <div style="border:1px solid #e5e1d8;"><img src={img(p)} alt={t} style="width:100%; aspect-ratio:142/82; object-fit:cover;" /><div style="padding:0.4rem 0.5rem;"><strong style="font-size:0.75rem; text-transform:uppercase; color:var(--color-navy);">{t}</strong><p style="font-size:0.7rem; color:#c9741f;">{p === 'ca-7' || p === 'ca-8' ? 'Regional Mission' : 'Provincial Mission'}</p><p style="font-size:0.7rem;">{d}</p></div></div>)}<div style="background:var(--color-navy-dark); color:#fff; padding:0.75rem; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.4rem;"><span style="color:#d9862a;"><Icon name="location-dot" size={34} /></span><strong style="text-transform:uppercase; font-size:0.875rem;">Regional Missions</strong><span style="font-size:0.75rem;">Active in key cities and communities across Canada.</span></div></div></div>
  </section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1.5fr 1fr; gap:1.25rem; padding-bottom:1.25rem;">
    <ResCards center title="Our Program Areas" dir="partnerships" items={[
      { photo: 'ca-p1', icon: 'handshake', title: 'Prison Ministry', text: 'Pastoral care, support and reintegration programs.', cta: '' },
      { photo: 'ca-p2', icon: 'people-roof', title: 'Family Support', text: 'Helping families stay connected and access essential services.', cta: '' },
      { photo: 'ca-p3', icon: 'scale-balanced', title: 'Legal Assistance', text: 'Information, referrals and advocacy support.', cta: '' },
      { photo: 'ca-p4', icon: 'book-open', title: 'Education & Training', text: 'Skills, mentoring and pathways to employment.', cta: '' },
      { photo: 'ca-p5', icon: 'heart', title: 'Community Outreach', text: 'Local initiatives to build stronger, safer and more inclusive communities.', cta: '' },
    ]} />
    <div style="padding-top:1.25rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Key Goals for Canada</h2>{[['bullseye','Establish Provincial Missions in all provinces and territories by 2028'],['people-group','Develop Regional Missions in key cities and communities'],['location-dot','Partner with dioceses, parishes, chaplains, NGOs and community organisations'],['chart-column','Deliver measurable impact through practical programs and local leadership'],['heart','Build a stronger, safer and more compassionate Canada']].map(([i,t]) => <div class="im-row" style="grid-template-columns:2.5rem 1fr; align-items:center;"><i style="width:2.5rem; height:2.5rem;"><Icon name={i} size={18} /></i><p style="font-size:0.875rem;">{t}</p></div>)}</div>
  </section>
  <GmBand img={img('ca-band')} lines="Restoring lives.<br/>Strengthening communities.<br/><span style='color:#d9862a'>A brighter Canada.</span>" quote="When we come together with faith, compassion and practical support, real change is possible." cta="Support the Canada Mission" />
</Layout>
