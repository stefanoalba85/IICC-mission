---
import Layout from '../../layouts/Layout.astro';
import GmHero from '../../components/GmHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GmCta from '../../components/GmCta.astro';
import GmBand from '../../components/GmBand.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/partnerships/${n}.jpg`;
const nats = [['nat-1','Italy','🇮🇹','Working with the Catholic Church, local organisations and communities across Italy to support individuals and families through practical programs and pathways to restoration.',[['20','Regions'],['100+','Partners'],['Growing','Impact']]],['nat-2','Australia','🇦🇺','Supporting individuals, families and communities across Australia through prison and detention ministry, family support, education and reintegration programs.',[['7','States & Territories'],['80+','Partners'],['Growing','Impact']]],['nat-3','USA','🇺🇸','A nationwide mission operating through 4 Area/Zone Missions (Los Angeles, Minneapolis, Dallas and Washington) to oversee State Missions and local programs across the United States.',[['50','States'],['200+','Partners'],['Expanding','Impact']]],['nat-4','Canada','🇨🇦','Working with dioceses, organisations and communities across Canada to support incarcerated and detained persons, and their families, through faith-based and practical programs.',[['13','Provinces & Territories'],['60+','Partners'],['Growing','Impact']]]];
---
<Layout title="National Missions Structure" description="A global mission. Local impact.">
  <GmHero kicker="National Missions Structure" title="A global<br/>mission.<br/><span style='color:#c9741f'>Local impact.</span>" text="IICC Mission operates through National, State and Regional Missions to bring faith, hope, justice and restoration to people who are incarcerated, detained and their families — working in partnership with churches, organisations and communities." img={img('nat-hero')} alt="The Earth at night with glowing connections" quote="Different nations, one mission. Together we can restore lives and build hope across the world." />
  <GiIcons dark items={[{ icon: 'globe', title: 'Global Vision', text: 'A coordinated international network bringing hope and practical support to communities worldwide.' },{ icon: 'people-group', title: 'National Missions', text: 'Established in key countries to lead and coordinate the Mission locally.' },{ icon: 'location-dot', title: 'State / Provincial Missions', text: 'Operate in each state or province, aligned with national priorities and local needs.' },{ icon: 'people-group', title: 'Regional Missions', text: 'Active in cities and regions to deliver programs and build community connections.' },{ icon: 'handshake', title: 'Local Partnerships', text: 'Working with churches, organisations and community groups to maximise impact.' }]} />
  <section class="wrap" style="padding-block:1.25rem;"><h2 class="camp-h">Our National Missions</h2><p class="im-p" style="text-align:center; max-width:820px; margin-inline:auto;">Our National Missions provide leadership, coordination and support for State and Regional Missions within each country, adapting programs to local needs while remaining united in our global mission of faith, hope, justice and restoration.</p><div class="camp-grid" style="display:grid; grid-template-columns:repeat(4,1fr); gap:0.75rem; margin-top:0.9rem;">{nats.map(([p,t,f,d,s]) => <div style="border:1px solid #e5e1d8; display:flex; flex-direction:column;"><img src={img(p)} alt={t} style="width:100%; aspect-ratio:240/121; object-fit:cover;" /><div style="padding:0.9rem; display:flex; flex-direction:column; gap:0.6rem; flex:1;"><p style="display:flex; gap:0.75rem; align-items:center;"><span style="font-size:2.25rem;">{f}</span><span style="font-family:var(--font-heading); color:var(--color-navy); line-height:1.1;"><strong style="font-size:1.375rem; text-transform:uppercase;">{t}</strong><br />National Mission</span></p><p class="im-p" style="font-size:0.875rem; flex:1;">{d}</p><div style="display:grid; grid-template-columns:repeat(3,1fr); text-align:center; border-top:1px solid #e5e1d8; padding-top:0.5rem;">{s.map(([n,l]) => <span style="font-size:0.75rem;"><strong style="display:block; font-family:var(--font-heading); color:var(--color-navy); font-size:1rem;">{n}</strong>{l}</span>)}</div><a href={t === 'USA' ? '/partnerships/usa-expansion' : t === 'Canada' ? '/partnerships/canada-expansion' : t === 'Italy' ? '/partnerships/italian-branches' : '/partnerships/australian-branches'} class="btn btn--navy" style="justify-content:center;">View {t} Mission →</a></div></div>)}</div></section>
  <section class="wrap" style="padding-bottom:1.25rem;"><h2 class="camp-h">Mission Structure</h2><p class="im-p" style="text-align:center;">A coordinated approach from national leadership to local impact.</p><div class="camp-grid" style="display:grid; grid-template-columns:1fr auto 1fr auto 1fr; gap:0.75rem; align-items:center; margin-top:0.75rem;">{[['globe','National Missions','Country leadership, strategy, coordination and national partnerships.'],['people-group','State / Provincial Missions','Operate in each state or province, implementing national programs and local initiatives.'],['location-dot','Regional Missions','Active in cities and regions, delivering services and building community connections.']].map(([i,t,d],k) => <><div style="background:var(--color-navy-dark); color:#fff; padding:1rem; display:grid; grid-template-columns:3.5rem 1fr; gap:0.75rem; align-items:center;"><Icon name={i} size={44} /><div><strong style="text-transform:uppercase; font-size:0.875rem;">{t}</strong><p style="font-size:0.8125rem;">{d}</p></div></div>{k < 2 && <span style="color:#c9741f; font-size:2rem;">→</span>}</>)}</div></section>
  <GmBand img={img('nat-dove')} lines="" quote="From local communities to a global network, we walk together to bring hope, dignity and lasting change to those in need." cta="Support a National Mission" />
</Layout>
