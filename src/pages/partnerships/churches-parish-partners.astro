---
import Layout from '../../layouts/Layout.astro';
import GmHero from '../../components/GmHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GmCta from '../../components/GmCta.astro';
import GmBand from '../../components/GmBand.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/partnerships/${n}.jpg`;
---
<Layout title="Churches & Parish Partners" description="Together in faith. United in mission.">
  <section style="position:relative; background:var(--color-navy-dark); color:#fff; overflow:hidden;"><img src={img('ch-hero')} alt="A priest before a congregation in a cathedral" style="position:absolute; inset:0 0 0 38%; width:62%; height:100%; object-fit:cover; -webkit-mask-image:linear-gradient(90deg,transparent,#000 30%); mask-image:linear-gradient(90deg,transparent,#000 30%);" />
    <div class="wrap" style="position:relative; padding-block:2.5rem; max-width:1200px;"><div style="max-width:440px; display:flex; flex-direction:column; gap:0.9rem;"><p style="color:#d9a540; text-transform:uppercase; letter-spacing:0.08em;">Churches &amp; Parish Partners</p><h1 style="font-family:var(--font-heading); font-size:clamp(2.25rem,4.5vw,3.25rem); line-height:1.1;">Together in Faith.<br /><span style="color:#d9a540;">United in Mission.</span></h1><p style="font-size:1.0625rem; line-height:1.55;">The IICC Mission partners with Catholic parishes, dioceses, religious communities and faith-based organisations to bring hope, justice and restoration to individuals and communities in need.</p><p style="font-family:var(--font-heading); font-size:1.0625rem; line-height:1.5;">Together, we build a stronger, more compassionate Church that walks alongside the most vulnerable.</p><a href="/contact" class="btn btn--amber" style="align-self:flex-start;">Partner With Us →</a></div></div>
  </section>
  <section class="wrap" style="padding-block:1.5rem;"><h2 class="camp-h">Our Commitment to the Church</h2><p class="im-p" style="text-align:center;">We walk in partnership with the Church to advance the Gospel through faith-filled action and service.</p><div class="icol icol--plain" style="margin-top:1rem;">{[['church','Faith in Action','We support parishes and church communities to bring Christ’s love to those most in need.'],['people-group','Community Partnership','We collaborate with dioceses, parishes and ministries to strengthen and serve local communities.'],['hand-holding-heart','Service Together','Through shared mission, we respond to the needs of the vulnerable with compassion and dignity.'],['book-bible','Evangelisation & Outreach','We support the Church in proclaiming the Gospel and reaching those on the margins of society.'],['dove','Justice & Restoration','We work with the Church to promote justice, reconciliation and the restoration of hope in every person.']].map(([i,t,d]) => <div><span style="color:#c9962a;"><Icon name={i} size={64} /></span><h3>{t}</h3><p>{d}</p></div>)}</div></section>
  <section class="camp-grid" style="display:grid; grid-template-columns:1fr 1fr; background:var(--color-navy-dark); color:#fff;"><img src={img('ch-bible')} alt="Hands folded in prayer on a Holy Bible" style="width:100%; height:100%; object-fit:cover;" /><div style="position:relative; padding:2rem 1.5rem; overflow:hidden;"><img src={img('ch-cross')} alt="" style="position:absolute; right:0; top:0; width:50%; height:100%; object-fit:cover; opacity:0.7;" /><p style="position:relative; font-family:var(--font-heading); font-style:italic; font-size:1.5rem; line-height:1.4; max-width:60%;"><span style="color:#d9a540; font-size:3rem; line-height:0.5; font-style:normal;">&ldquo;</span><br />Where two or three are gathered in my name, there am I among them.”</p><p style="position:relative; color:#d9a540; letter-spacing:0.08em; margin-top:1rem;">MATTHEW 18:20</p></div></section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; padding-block:1.5rem;">
    <div><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> How Churches Can Partner With IICC Mission</h2><ul class="check" style="margin-block:0.9rem 1rem;">{['Pray for our mission and those we serve','Promote awareness of our programs and services','Support our initiatives through fundraising and donations','Volunteer your time and skills','Refer individuals and families in need of support','Collaborate on local outreach and community projects'].map(t => <li>{t}</li>)}</ul><a href="/contact" class="btn btn--amber">Learn More →</a></div>
    <div style="border-left:1px solid #e5e1d8; padding-left:1.5rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Together, We Can Make a Difference</h2><p class="im-p" style="margin-block:0.75rem 1rem;">By partnering with IICC Mission, your Church becomes part of a global network of hope, bringing faith, justice and restoration to individuals and communities in need.</p><div class="camp-trio">{[['people-group','Stronger Together','United in faith to serve our communities.'],['globe','Global Impact','Partnering for a mission that transforms lives.'],['heart','Hope & Restoration','Bringing Christ’s hope where it is needed most.']].map(([i,t,d]) => <div><span style="color:#c9962a;"><Icon name={i} size={44} /></span><strong>{t}</strong><span>{d}</span></div>)}</div></div>
  </section>
</Layout>
