---
import Layout from '../../layouts/Layout.astro';
import GmHero from '../../components/GmHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GmCta from '../../components/GmCta.astro';
import GmBand from '../../components/GmBand.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/partnerships/${n}.jpg`;
---
<Layout title="Australian Branches" description="Serving Australia. Restoring lives. Building hope.">
  <GmHero kicker="Australian Branch" title="Serving Australia.<br/>Restoring lives.<br/>Building hope." text="The IICC Mission Australian Branch is committed to reaching individuals and communities across Australia with the love of Christ, practical support and life-changing programs that bring hope, justice and restoration." cta1="Our Programs" cta1Href="#focus" img={img('au-hero')} alt="Sydney Harbour Bridge and Opera House with the Australian flag" />
  <GiIcons dark items={[{ icon: 'location-dot', title: 'All Across Australia', text: 'Working in cities, regional areas and remote communities.' },{ icon: 'people-group', title: 'Local Communities Stronger Together', text: 'Partnering with churches, organisations and community groups nationwide.' },{ icon: 'hand-holding-heart', title: 'Practical Support Real Change', text: 'Programs that meet real needs and help rebuild lives.' },{ icon: 'cross', title: 'Faith. Hope. Justice. Restoration.', text: 'Our foundation. Our calling. Our mission.' },{ icon: 'earth-oceania', title: 'Australia is Our Mission Field', text: 'Every life matters. Every community matters.' }]} />
  <section class="wrap" style="padding-block:1.25rem;" id="focus"><h2 class="camp-h">Our Focus Areas in Australia</h2><div class="camp-grid" style="display:grid; grid-template-columns:repeat(6,1fr); gap:0.6rem; margin-top:0.75rem;">{[['building-lock','Prison Ministry & Reintegration','Supporting inmates and ex-prisoners to rebuild their lives and reintegrate into the community.'],['people-group','Family & Community Support','Strengthening families and providing vital support for those facing challenges.'],['book-open','Youth Programs & Education','Empowering young people through mentoring, education, and positive life opportunities.'],['hand-holding-heart','Homeless & Humanitarian Aid','Providing practical assistance, meals, clothing and support to those experiencing hardship.'],['seedling','Addiction Support & Recovery','Walking alongside individuals on their journey to freedom, healing and restoration.'],['people-group','Community Connection','Building stronger, safer communities through connection, outreach and hope.']].map(([i,t,d],k) => <div style="border:1px solid #e5e1d8; text-align:center; display:flex; flex-direction:column;"><div style="padding:0.9rem 0.6rem; display:flex; flex-direction:column; align-items:center; gap:0.4rem; flex:1;"><span style="color:var(--color-navy);"><Icon name={i} size={38} /></span><strong style="font-size:0.8125rem; text-transform:uppercase; color:var(--color-navy);">{t}</strong><span style="font-size:0.8125rem;">{d}</span></div><img src={img(`au-${k+1}`)} alt="" style="width:100%; aspect-ratio:148/112; object-fit:cover;" /></div>)}</div></section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1fr 0.9fr 0.65fr; background:#f7f3ec; margin-bottom:1rem;"><div style="padding:1.25rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> Our Impact in Australia</h2><p class="im-p" style="margin-block:0.5rem 0.9rem;">Through our programs, partnerships and community outreach, we are seeing lives transformed and communities renewed.</p><div class="camp-trio">{[['people-group','1000+','Lives impacted each year'],['handshake','150+','Community partners across Australia'],['location-dot','20+','Locations & outreach initiatives'],['hand-holding-heart','Countless','Lives restored and renewed']].map(([i,n,t]) => <div><Icon name={i} size={34} /><strong style="font-family:var(--font-heading); font-size:1.375rem; text-transform:none;">{n}</strong><span>{t}</span></div>)}</div></div><img src={img('au-imp')} alt="IICC Mission volunteers in the Australian outback" style="width:100%; height:100%; object-fit:cover;" /><div style="background:var(--color-navy-dark); color:#fff; padding:1.25rem; display:flex; flex-direction:column; gap:0.6rem;"><h3 style="font-family:var(--font-heading); color:#d9862a; text-transform:uppercase; font-weight:400; font-size:1.125rem;">Together, we can make a difference</h3><p style="font-size:0.9375rem;">We are stronger together. Join us in bringing hope, justice and restoration to every corner of Australia.</p><a href="/donate/corporate-giving" class="btn btn--amber">Partner With Us →</a><a href="/donate" class="btn btn--outline-white">Donate Today →</a></div></section>
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:0.6fr 1.4fr; background:#f4f2ee; margin-bottom:1.25rem; align-items:center;"><img src={img('au-flag')} alt="The Australian flag at sunset" style="width:100%; height:100%; object-fit:cover;" /><div style="padding:1.25rem;"><h2 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.375rem;"> A Message from Our Australian Leadership</h2><p style="font-family:var(--font-heading); color:var(--color-navy); font-size:1.125rem; line-height:1.45; margin-top:0.6rem;"><span style="color:#c9741f; font-size:2.5rem; line-height:0.5;">&ldquo;</span> We are honoured to serve across Australia. Every person, every family and every community matters to God — and they matter to us. Together, we can bring hope and change lives.”<span style="display:block; color:#c9741f; font-size:0.9375rem;">– IICC Mission Australian Leadership</span></p></div></section>
  <GmCta title="Be part of what God is doing in Australia." text="Your support helps us continue our mission of faith, hope, justice and restoration across our nation." cta="Get Involved" href="/get-involved" />
</Layout>
