---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Hope Media — IICC Mission" description="Stories of hope, transformation and faith — through video, podcasts, testimonials and news.">

  <!-- Hero split -->
  <div class="hero-split" style="min-height:480px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">Stories That Inspire</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(2rem,5vw,3.5rem);">HOPE</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(2rem,5vw,3.5rem);">MEDIA</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2.5vw,1.25rem);color:rgba(255,255,255,0.85);line-height:1.6;">
        Real stories. Real transformation. Real hope.
      </p>
    </div>
    <div class="hero-split__photo" style="min-height:320px;">
      <img
        src="https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=800&h=600&fit=crop"
        alt="Hope Media — microphone and camera"
      />
    </div>
  </div>

  <!-- Media types -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Our Media</span>
        <span class="heart">♥</span>
        <h2 class="section-title">BRINGING HOPE TO LIFE</h2>
        <span class="rule rule--amber rule--center"></span>
        <p class="section-desc" style="text-align:center;margin-inline:auto;margin-top:0.5rem;">
          We tell stories that matter — from behind prison walls, from detention centres, from soup kitchens and from communities transformed by hope.
        </p>
      </div>
      <div class="grid-4" style="margin-bottom:2rem;">
        {[
          { icon: '🎬', title: 'Videos', desc: 'Watch testimonials, mission highlights and interviews with the people behind the work.' },
          { icon: '🎙️', title: 'Podcasts', desc: 'Listen to conversations on faith, justice, restoration and hope in unexpected places.' },
          { icon: '📖', title: 'Testimonials', desc: 'Read first-hand stories of transformation from inmates, families and volunteers.' },
          { icon: '📰', title: 'News & Articles', desc: 'Stay informed on our latest mission updates, advocacy campaigns and community events.' },
        ].map(c => (
          <div class="card" style="align-items:center;text-align:center;">
            <div class="card__icon card__icon--filled" style="font-size:1.125rem;">{c.icon}</div>
            <p class="card__title">{c.title}</p>
            <p class="card__body">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Stories -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Featured</span>
        <h2 class="section-title">STORIES OF HOPE</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="grid-3">
        {[
          {
            img: 'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=600&h=400&fit=crop',
            cat: 'Testimonial',
            title: '"God Found Me Behind Bars"',
            desc: 'Marco shares how a pastoral visit changed his life and set him on a path of transformation and purpose.',
          },
          {
            img: 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=600&h=400&fit=crop',
            cat: 'Mission Story',
            title: 'Walking With Detainees at Christmas',
            desc: 'Our team brought prayer, gifts and the presence of Christ to immigration detainees far from home.',
          },
          {
            img: 'https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=600&h=400&fit=crop',
            cat: 'Advocacy',
            title: 'Raising Voices for Reform',
            desc: 'Ambassador Dattilo meets with policymakers to advocate for humane treatment in Australia\'s detention system.',
          },
          {
            img: 'https://images.unsplash.com/photo-1509099836639-18ba1795216d?w=600&h=400&fit=crop',
            cat: 'Community',
            title: 'Bread, Soup and Dignity',
            desc: 'Francis Bakery feeds hundreds of homeless people every week — and offers much more than bread.',
          },
          {
            img: 'https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=600&h=400&fit=crop',
            cat: 'Faith',
            title: 'The Power of Prayer in Dark Places',
            desc: 'Our prayer warriors share how intercession is changing lives on both sides of the prison wall.',
          },
          {
            img: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?w=600&h=400&fit=crop',
            cat: 'Global Network',
            title: 'Mission Grows Across Nations',
            desc: 'From Rome to Washington, Ottawa to Canberra — IICC Mission is building a global movement of hope.',
          },
        ].map(s => (
          <div class="photo-card">
            <div class="photo-card__img">
              <img src={s.img} alt={s.title} loading="lazy" />
            </div>
            <div class="photo-card__body">
              <span style="font-size:0.6875rem;letter-spacing:0.12em;text-transform:uppercase;font-weight:700;color:var(--color-amber);">{s.cat}</span>
              <p style="font-family:var(--font-heading);font-size:1rem;font-weight:700;color:var(--color-navy);line-height:1.35;margin-top:0.375rem;margin-bottom:0.5rem;">{s.title}</p>
              <p style="font-size:0.8125rem;color:var(--color-muted);line-height:1.6;">{s.desc}</p>
              <a href="/news" style="display:inline-block;margin-top:0.875rem;font-size:0.75rem;font-weight:700;letter-spacing:0.08em;color:var(--color-navy);text-decoration:none;">READ MORE ›</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stay Connected -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:center;">
        <div>
          <span class="eyebrow eyebrow--white" style="display:block;margin-bottom:0.75rem;">Never Miss a Story</span>
          <h2 style="font-family:var(--font-display);font-size:clamp(1.25rem,3vw,2rem);letter-spacing:0.08em;text-transform:uppercase;color:#fff;margin-bottom:0.75rem;">STAY CONNECTED</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
          <p style="font-size:0.9375rem;color:rgba(255,255,255,0.8);line-height:1.7;margin-bottom:0.5rem;">Subscribe to our newsletter and follow us on social media to receive stories of hope, mission updates and ways you can help.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;gap:0.625rem;flex-wrap:wrap;">
            <input type="email" placeholder="Your email address" class="form-input" style="flex:1;min-width:180px;background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.25);color:#fff;" />
            <button class="btn btn--amber">SUBSCRIBE</button>
          </div>
          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
            {['Facebook', 'Instagram', 'YouTube', 'LinkedIn'].map(s => (
              <a href="#" style="padding:0.5rem 1rem;border:1.5px solid rgba(255,255,255,0.25);border-radius:2px;font-size:0.75rem;font-weight:700;color:rgba(255,255,255,0.85);letter-spacing:0.06em;text-decoration:none;transition:border-color 0.2s;">{s}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
