---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Autism Advocacy — IICC Mission" description="Standing alongside people with autism and their families — advocating for inclusion, understanding and dignity.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/advocacy">Advocacy</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Autism Advocacy</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:460px;">
    <div class="hero-split__text" style="background:#fff;gap:1.25rem;">
      <span class="eyebrow">Every Mind Matters</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:var(--color-navy);font-size:clamp(1.75rem,4vw,2.75rem);">AUTISM</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(1.75rem,4vw,2.75rem);">ADVOCACY</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:1.0625rem;color:var(--color-amber);font-weight:700;">Seeing the person. Not the label.</p>
      <p class="section-desc" style="max-width:none;">IICC Mission stands alongside individuals with autism, their families and carers — advocating for understanding, inclusion and the recognition of the God-given dignity and gifts of every person.</p>
      <a href="/contact" class="btn btn--amber">GET INVOLVED ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img src="https://images.unsplash.com/photo-1588196749597-9ff075ee6b5b?w=800&h=600&fit=crop" alt="Autism advocacy — inclusion and support" />
    </div>
  </div>

  <section class="section section--offwhite">
    <div class="wrap">
      <div class="cols-2" style="gap:3rem;align-items:start;">
        <div>
          <h2 class="section-title" style="margin-bottom:0.75rem;">Why We Advocate for Autism</h2>
          <span class="rule rule--amber" style="display:block;margin-bottom:1.25rem;"></span>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            Many of the people we encounter in our prison ministry and immigration detention ministry are on the autism spectrum — often misunderstood, unsupported and without appropriate accommodations within the systems that hold them.
          </p>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            IICC Mission advocates for greater awareness, understanding and systemic support for people with autism across the criminal justice and immigration systems, as well as in the broader community.
          </p>
          <ul class="checklist">
            <li>Appropriate support and accommodations within detention and prison</li>
            <li>Training for correctional and detention staff on autism awareness</li>
            <li>Diversion programs for autistic individuals in the justice system</li>
            <li>Community inclusion and belonging for people with autism</li>
            <li>Support for families and carers</li>
          </ul>
        </div>
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">God created mankind in his own image — in the image of God he created them.</p>
            <span class="quote-box__ref">— Genesis 1:27</span>
          </div>
          <div class="card" style="background:var(--color-navy-dark);align-items:center;text-align:center;gap:0.75rem;">
            <div class="card__icon" style="font-size:1.25rem;border-color:rgba(224,123,0,0.4);">🧠</div>
            <p class="card__title" style="color:#fff;">We See the Person</p>
            <p class="card__body" style="color:rgba(255,255,255,0.75);">Every person with autism is made in the image of God and carries gifts, dignity and worth that the world too often overlooks.</p>
          </div>
          <a href="/contact" class="btn btn--amber" style="text-align:center;justify-content:center;">CONTACT US ›</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
