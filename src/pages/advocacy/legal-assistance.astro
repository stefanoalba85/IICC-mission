---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Legal Assistance — Advocacy — IICC Mission" description="Advocating for access to justice and connecting vulnerable people with legal support.">

  <div style="background:var(--color-off-white);border-bottom:1px solid rgba(27,39,81,0.07);">
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Home</a><span class="breadcrumb__sep">›</span>
        <a href="/advocacy">Advocacy</a><span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Legal Assistance</span>
      </nav>
    </div>
  </div>

  <div class="hero-split" style="min-height:460px;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.25rem;">
      <span class="eyebrow eyebrow--white">Access to Justice</span>
      <h1 style="font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:1.05;">
        <span style="display:block;color:#fff;font-size:clamp(1.75rem,4vw,2.75rem);">LEGAL</span>
        <span style="display:block;color:var(--color-amber);font-size:clamp(1.75rem,4vw,2.75rem);">ASSISTANCE</span>
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-size:0.9375rem;color:rgba(255,255,255,0.85);line-height:1.7;">Justice is not only a legal concept — it is a biblical mandate. IICC Mission advocates for equal access to justice and connects vulnerable people with the legal support they need.</p>
      <a href="/contact" class="btn btn--amber">REQUEST HELP ›</a>
    </div>
    <div class="hero-split__photo" style="min-height:280px;">
      <img src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=800&h=600&fit=crop" alt="Legal assistance and justice" />
    </div>
  </div>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:2.5rem;">
        <span class="eyebrow">Our Approach</span>
        <h2 class="section-title">HOW WE SUPPORT LEGAL ACCESS</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="grid-3">
        {[
          { icon: '🔗', title: 'Legal Referrals', desc: 'Connecting individuals with pro bono solicitors, legal aid and community legal centres.' },
          { icon: '📋', title: 'Rights Information', desc: 'Plain-language information about legal rights for inmates, detainees and their families.' },
          { icon: '✍️', title: 'Documentation Help', desc: 'Assistance preparing legal correspondence, applications and statutory declarations.' },
          { icon: '⚖️', title: 'Court Accompaniment', desc: 'Providing a compassionate presence and support for individuals attending court hearings.' },
          { icon: '📣', title: 'Systemic Advocacy', desc: 'Advocating for policy and legislative reform to improve access to justice for marginalised people.' },
          { icon: '🤝', title: 'Partnership Network', desc: 'Working with law firms, universities and legal organisations to expand pro bono capacity.' },
        ].map(c => (
          <div class="card" style="align-items:center;text-align:center;">
            <div class="card__icon card__icon--filled">{c.icon}</div>
            <p class="card__title">{c.title}</p>
            <p class="card__body">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap" style="max-width:700px;text-align:center;">
      <span class="heart" style="color:var(--color-gold);font-size:1.25rem;display:block;margin-bottom:1rem;">♥</span>
      <blockquote style="font-family:var(--font-heading);font-size:clamp(1.125rem,2.5vw,1.5rem);color:#fff;font-style:italic;line-height:1.65;margin-bottom:0.75rem;">"Let justice roll on like a river, righteousness like a never-failing stream."</blockquote>
      <p style="font-size:0.875rem;color:var(--color-amber);letter-spacing:0.12em;font-weight:700;margin-bottom:2rem;">— Amos 5:24</p>
      <p style="font-size:0.875rem;color:rgba(255,255,255,0.8);line-height:1.7;margin-bottom:2rem;font-style:italic;padding:0 1rem;">Disclaimer: IICC Mission is not a law firm and does not provide legal advice. We connect individuals with qualified legal professionals and community services.</p>
      <a href="/contact" class="btn btn--amber">GET IN TOUCH ›</a>
    </div>
  </section>

</Layout>
