---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
---
<Layout title="Monthly Giving" description="A brighter tomorrow every month.">
  <GiHero kicker="Monthly Giving Program" title="A Brighter<br/><span style='color:#c9741f'>Tomorrow</span><br/>Every Month" text="Your ongoing support helps us provide faith, hope, justice and practical assistance to people who are incarcerated, detained and their families worldwide." cta="♥ Become a Monthly Donor" href="#amount" img={img('mg-hero')} alt="A priest praying with an inmate" quote="Your monthly gift brings hope to those who are often forgotten and helps restore lives with dignity." />
  <GiIcons items={[{ icon: 'hands-praying', title: 'Continuous Support', text: 'Provide ongoing care for those who are incarcerated and detained.' },{ icon: 'people-group', title: 'Stronger Families', text: 'Help families stay connected and supported.' },{ icon: 'scale-balanced', title: 'Greater Justice', text: 'Enable legal assistance and advocacy.' },{ icon: 'book-open', title: 'Brighter Futures', text: 'Fund education, skills and reintegration programs.' },{ icon: 'heart', title: 'Lasting Change', text: 'Be part of a more compassionate and just society.' }]} />
  <section class="camp-grid" style="display:grid; grid-template-columns:1fr 1fr;">
    <GiPhotoText img={img('mg-candle')} text="A small amount<br/>each month<br/><strong>makes a big<br/>difference.</strong>" />
    <div style="padding:1.25rem 1.5rem;"><h2 class="im-h" style="font-size:1.25rem;">Why Monthly Giving?</h2>{[['calendar-days','Reliable Support','Helps us plan and deliver long-term programs.'],['heart','Greater Impact','Allows us to reach more people and communities.'],['people-group','Cost Effective','Reduces administrative costs so more goes to our mission.'],['seedling','Sustainable Change','Builds lasting hope for the future.']].map(([i,t,d]) => <div class="im-row" style="grid-template-columns:2.5rem 1fr; align-items:center;"><span style="color:var(--color-navy);"><Icon name={i} size={30} /></span><div><h3 style="text-transform:none; font-size:1rem;">{t}</h3><p>{d}</p></div></div>)}</div>
  </section>
  <section class="wrap" style="padding-block:1.25rem;" id="amount"><h2 class="camp-h">Choose Your Monthly Giving Amount</h2><p class="im-p" style="text-align:center;">Every gift, big or small, helps restore hope and change lives.</p><div class="camp-grid" style="display:grid; grid-template-columns:repeat(5,1fr); gap:0.75rem; margin-top:0.75rem;">{[['€10','per month','Provides prayer support, letters and basic pastoral care.','Choose €10'],['€25','per month','Helps provide educational materials and skills training.','Choose €25'],['€50','per month','Supports legal assistance, case preparation and advocacy.','Choose €50'],['€100','per month','Funds humanitarian support such as food, clothing and hygiene items.','Choose €100'],['Other Amount','','Choose a different amount to support the areas of greatest need.','Choose Amount']].map(([a,p,d,c],k) => <div style="background:#fff; box-shadow:0 3px 10px rgba(18,26,56,0.08); text-align:center; display:flex; flex-direction:column;"><img src={img(`mg-${k+1}`)} alt="" style="width:100%; aspect-ratio:182/103; object-fit:cover;" /><div style="padding:0.75rem; display:flex; flex-direction:column; gap:0.3rem; flex:1;"><strong style="font-family:var(--font-heading); color:#c9741f; font-size:1.75rem; font-weight:400; line-height:1;">{a}</strong>{p && <span style="font-family:var(--font-heading); color:#c9741f;">{p}</span>}<p style="font-family:var(--font-heading); color:var(--color-navy); font-size:0.875rem; flex:1;">{d}</p><a href={`/donate?freq=monthly&amount=${a.startsWith('€') ? a.slice(1) : 'other'}#donate`} class="btn btn--amber" style="justify-content:center;">{c}</a></div></div>)}</div>
    <div class="camp-trio" style="margin-top:1rem;">{[['piggy-bank','Secure & Simple','Easy online setup with regular automatic giving.'],['lock','Safe Donations','Your information is secure and protected.'],['heart','Flexible','You can change or cancel your monthly gift at any time.'],['file-lines','Full Transparency','We provide regular updates on the impact of your support.']].map(([i,t,d]) => <div style="flex-direction:row; text-align:left; gap:0.6rem;"><Icon name={i} size={32} /><span><strong style="display:block; text-transform:none;">{t}</strong>{d}</span></div>)}</div>
  </section>
  <section class="camp-grid" style="display:grid; grid-template-columns:0.4fr 0.9fr 1.2fr 0.6fr; background:#fbf6ec; align-items:stretch;">
    <img src={img('mg-dove')} alt="" style="width:100%; height:100%; object-fit:cover;" />
    <p style="padding:1.25rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:1.125rem; align-self:center;"><span style="color:#c9741f; font-size:2.5rem; line-height:0.5;">&ldquo;</span> Together, we can bring hope, dignity and real change to the lives of people who are incarcerated, detained and their families.</p>
    <div style="padding:1.25rem; background:#fff;"><h2 class="im-h" style="font-size:1.125rem;">Frequently Asked Questions</h2>{['How does monthly giving work?','Can I change or cancel my monthly donation?','How is my donation used?','Is my donation secure?'].map(q => <details style="margin-top:0.6rem; color:var(--color-navy);"><summary style="cursor:pointer; font-size:0.9375rem;">⊕ {q}</summary><p style="font-size:0.875rem; padding:0.4rem 0 0 1.25rem;">Please contact info@iiccmission.org and our team will answer your question.</p></details>)}<a href="/faq" style="display:block; color:#c9741f; margin-top:0.75rem;">View all FAQs →</a></div>
    <div style="position:relative; background:var(--color-navy-dark);"><img src={img('mg-bt')} alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.6;" /><p style="position:relative; padding:1.25rem; color:#fff; font-family:var(--font-heading); text-transform:uppercase; font-size:1.25rem; line-height:1.2;">Hope today.<br />A brighter<br /><span style="color:#d9862a;">tomorrow</span></p></div>
  </section>
</Layout>
