---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
---
<Layout title="Corporate Giving" description="Partner for a brighter tomorrow.">
  <GiHero kicker="Corporate Giving" title="Partner<br/><span style='color:#c9741f'>for a Brighter</span><br/>Tomorrow" text="Your company can make a real and lasting difference in the lives of people who are incarcerated, detained and their families. Together, we can build safer, stronger and more compassionate communities." cta="Partner With Us" href="/contact" img={img('cg-hero')} alt="A handshake in front of St Peter’s Basilica" quote="Businesses have a unique ability to create opportunity, restore dignity, and build a more just and inclusive society." />
  <GiIcons items={[{ icon: 'handshake', title: 'Meaningful Impact', text: 'Support real programs that change lives.' },{ icon: 'people-group', title: 'Stronger Communities', text: 'Help reduce reoffending and build safer societies.' },{ icon: 'seedling', title: 'ESG Alignment', text: 'Demonstrate your commitment to social responsibility, inclusion and human dignity.' },{ icon: 'globe', title: 'Global Reach', text: 'Be part of an international mission inspired by faith, hope and justice.' }]} />
  <section class="camp-grid" style="display:grid; grid-template-columns:1fr 1fr;">
    <GiPhotoText img={img('cg-plant')} text="Corporate giving<br/><strong>creates opportunity,<br/>restores hope.</strong>" />
    <div style="padding:1.25rem 1.5rem;"><h2 class="im-h" style="font-size:1.25rem;">Why Partner With IICC Mission?</h2>{[['heart','Social Impact','Direct support to people who are incarcerated, detained and their families.'],['people-group','Positive Brand Alignment','Be associated with a trusted, values-driven, global mission.'],['seedling','Employee Engagement','Inspire your team through purpose and meaningful impact.'],['chart-column','Measurable Outcomes','Transparent reporting on the impact of your support.'],['globe','Global and Local Reach','Opportunities to support programs in different countries and communities.']].map(([i,t,d]) => <div class="im-row" style="grid-template-columns:2.5rem 1fr; align-items:center; margin-top:0.5rem;"><span style="color:var(--color-navy);"><Icon name={i} size={30} /></span><div><h3 style="text-transform:none; font-size:1rem;">{t}</h3><p>{d}</p></div></div>)}</div>
  </section>
  <section class="wrap" style="padding-block:1.25rem;"><h2 class="camp-h">Our Corporate Partnership Opportunities</h2><div class="camp-grid" style="display:grid; grid-template-columns:repeat(4,1fr); gap:0.75rem; margin-top:0.75rem;">{[['Bronze Partner','€5,000+','#a0522d',['Support a specific program','Company recognition on website','Annual impact report','Social media acknowledgement']],['Silver Partner','€15,000+','#8a8f99',['Support multiple programs','Enhanced brand recognition','Employee engagement opportunities','Detailed impact reporting','Invitations to special events']],['Gold Partner','€50,000+','#c9962a',['Strategic partnership','Support national/international programs','Co-branded initiatives','Priority event invitations','Custom impact reporting']],['Platinum Partner','€100,000+','#1b2751',['Transformational impact','Multi-country program support','High-profile brand visibility','Executive engagement opportunities','Tailored initiatives aligned with your company’s goals','Comprehensive impact reporting']]].map(([t,a,c,items],k) => <div style="background:#fff; box-shadow:0 3px 10px rgba(18,26,56,0.08); display:flex; flex-direction:column;"><img src={img(`cg-${k+1}`)} alt="" style="width:100%; aspect-ratio:234/92; object-fit:cover;" /><div style="padding:0.9rem; display:flex; flex-direction:column; gap:0.5rem; flex:1; text-align:center;"><h3 style={`font-family:var(--font-heading); color:${c}; text-transform:uppercase; font-size:1.25rem;`}>{t}</h3><p style="font-family:var(--font-heading); color:#c9741f; font-size:1.25rem;">{a} <small>per year</small></p><ul class="check" style="text-align:left; flex:1;">{items.map(i => <li style="font-size:0.875rem;">{i}</li>)}</ul><a href="/contact" class="btn" style={`background:${c}; color:#fff; justify-content:center;`}>Become a {t} →</a></div></div>)}</div></section>
  <section class="camp-grid" style="display:grid; grid-template-columns:0.8fr 1fr 1.1fr; background:#fbf6ec; align-items:center;">
    <img src={img('cg-pr')} alt="A priest with an inmate" style="width:100%; height:100%; object-fit:cover;" />
    <p style="padding:1.25rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:1.125rem;"><span style="color:#c9741f; font-size:2.5rem; line-height:0.5;">&ldquo;</span> Your partnership helps us bring compassion, hope and opportunity to people who are often forgotten. Together, we can change lives and create a fairer, more compassionate world.</p>
    <div style="position:relative; padding:1.25rem; min-height:200px;"><img src={img('cg-rome')} alt="" style="position:absolute; right:0; bottom:0; width:45%; opacity:0.6;" /><div style="position:relative;"><h2 class="im-h" style="font-size:1.125rem;">Let’s Make a Difference Together</h2><p class="im-p" style="font-size:0.9375rem; margin-block:0.5rem 0.75rem;">We welcome the opportunity to discuss a tailored partnership that aligns with your company’s values, objectives and commitment to social impact.</p><a href="/contact" class="btn btn--amber">Contact Our Partnership Team →</a></div></div>
  </section>
</Layout>
