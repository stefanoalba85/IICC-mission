---
import Layout from '../../layouts/Layout.astro';
import GiHero from '../../components/GiHero.astro';
import GiIcons from '../../components/GiIcons.astro';
import GiPhotoText from '../../components/GiPhotoText.astro';
import GiFoot from '../../components/GiFoot.astro';
import ResCards from '../../components/ResCards.astro';
import Icon from '../../components/Icon.astro';
const img = (n: string) => `/images/get-involved/${n}.jpg`;
const STATS = [['people-group','1000+','People supported every year'],['globe','50+','Programs and initiatives'],['heart','6','Continents reached'],['chart-column','Thousands','of lives touched with hope']];
const BAR = (t1: string, t2: string, q: string, cta: string, href: string) => ({ t1, t2, q, cta, href });
---
<Layout title="Donation Impact" description="Your generosity creates real change.">
  <GiHero kicker="Your Generosity" title="Creates<br/><span style='color:#c9741f'>Real</span><br/>Change" text="Every donation helps us accompany, empower and restore hope to people who are incarcerated, detained and their families worldwide." cta="♥ Donate Now" href="/donate" img={img('di-hero')} alt="Antonio G. Dattilo in front of St Peter’s Basilica" quote="When we support those who are often forgotten, we build a more compassionate world where every person is valued." />
  <section class="wrap camp-grid" style="display:grid; grid-template-columns:1.4fr 1fr; gap:1rem; padding-block:1.25rem; align-items:center;">
    <div><h2 class="camp-h">Our Impact at a Glance</h2><div class="camp-trio" style="margin-top:0.75rem; background:#fbf6ec; padding:1rem;">{STATS.map(([i,n,t]) => <div><span style="color:var(--color-navy);"><Icon name={i} size={40} /></span><strong style="font-family:var(--font-heading); font-size:1.5rem; color:#c9741f; text-transform:none;">{n}</strong><span style="font-size:0.875rem;">{t}</span></div>)}</div></div>
    <div style="display:grid; grid-template-columns:1fr 1fr; background:var(--color-navy-dark); color:#fff; border-radius:4px; overflow:hidden;"><img src={img('di-hand')} alt="Hands reaching towards each other at sunset" style="width:100%; height:100%; object-fit:cover;" /><p style="padding:1.25rem; font-family:var(--font-heading); font-size:1.25rem; line-height:1.35;">Your support turns compassion into <span style="color:#d9862a;">action</span> and <span style="color:#d9862a;">hope</span> into new beginnings.</p></div>
  </section>
  <section class="wrap" style="padding-bottom:1.25rem;"><h2 class="camp-h">How Your Donation Makes an Impact</h2><div class="camp-grid" style="display:grid; grid-template-columns:repeat(5,1fr); gap:0.6rem; margin-top:0.75rem;">{[['hands-praying','Spiritual & Pastoral Care','Provides pastoral visits, spiritual support, prayer and faith-based programs in prisons and detention centres.','Your gift helps provide Bibles, chaplaincy support and spiritual resources.'],['scale-balanced','Legal Assistance & Advocacy','Supports legal advice, case preparation, and advocacy for the rights and dignity of incarcerated and detained individuals.','Your gift helps fund legal resources, expert support and advocacy initiatives.'],['book-open','Education & Awareness','Funds educational programs, life skills training and awareness campaigns to create brighter futures.','Your gift helps provide learning materials, vocational training and reintegration programs.'],['hand-holding-heart','Humanitarian Support','Provides essential items such as food, clothing, hygiene products and emergency support for individuals and their families.','Your gift helps meet immediate needs and restores dignity.'],['sunRoad','Healing, Restoration & Reintegration','Supports reentry programs, counselling, family support and pathways to a positive new beginning.','Your gift helps transform lives and rebuild stronger communities.']].map(([i,t,d,g],k) => <div style="background:#fbf6ec; display:flex; flex-direction:column; text-align:center;"><span style="align-self:center; width:3.5rem; height:3.5rem; border-radius:50%; background:var(--color-navy-dark); color:#d9a540; display:flex; align-items:center; justify-content:center; margin-top:0.75rem;"><Icon name={i} size={24} /></span><h3 style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:0.9375rem; padding:0.5rem;">{t}</h3><img src={img(`di-${k+1}`)} alt="" style="width:100%; aspect-ratio:180/115; object-fit:cover;" /><p style="font-family:var(--font-heading); color:var(--color-navy); font-size:0.875rem; line-height:1.4; padding:0.6rem; flex:1;">{d}</p><p style="font-family:var(--font-heading); color:var(--color-navy); font-size:0.875rem; padding:0.6rem; background:#f5ecd9; margin:0.5rem;">{g}</p></div>)}</div></section>
  <section class="camp-grid" style="display:grid; grid-template-columns:0.6fr 0.6fr 1.1fr; background:#fbf6ec; align-items:center;">
    <img src={img('di-gen')} alt="A man looking out of a barred window at Rome" style="width:100%; height:100%; object-fit:cover;" />
    <p style="padding:1.25rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy); font-size:1.25rem;"><span style="color:#c9741f; font-size:2.5rem; line-height:0.5;">&ldquo;</span> Your generosity gives people a second chance and a reason to hope.</p>
    <div style="padding:1.25rem;"><h2 class="camp-h" style="font-size:1.125rem;">Real Stories. Real Impact.</h2><p class="im-p" style="font-size:0.9375rem; margin-block:0.5rem 0.75rem;">Because of the support of donors like you, men and women have found hope, received legal assistance, reconnected with their families and built new lives. Your generosity changes not only individual lives, but also families and entire communities.</p><a href="/programs/hope-companion/stories" class="btn btn--amber">Read Their Stories →</a></div>
  </section>
  <section class="camp-grid" style="display:grid; grid-template-columns:0.8fr 1.4fr 0.6fr; background:#fff; align-items:center;">
    <img src={img('di-rome')} alt="St Peter’s Basilica and the Tiber at sunset" style="width:100%; height:100%; object-fit:cover;" />
    <div style="padding:1.25rem; text-align:center;"><h2 style="font-family:var(--font-heading); color:#c9741f; text-transform:uppercase; font-size:1.75rem; line-height:1.1;">Together,<br /><span style="color:var(--color-navy);">We Can Create</span></h2><p style="font-family:var(--font-heading); color:var(--color-navy); text-transform:uppercase; font-size:1.125rem;">A fairer, more compassionate world.</p><p class="im-p" style="font-size:0.875rem; margin-block:0.5rem 0.75rem;">Your donation today helps us continue our mission of faith, hope, justice and restoration for those who are incarcerated, detained and their families.</p><a href="/donate" class="btn btn--amber">♥ Donate Now →</a></div>
    <p style="padding:1.25rem; font-family:var(--font-heading); font-style:italic; color:var(--color-navy);">“Small acts of love, when multiplied by millions of people, can transform the world.”</p>
  </section>
</Layout>
