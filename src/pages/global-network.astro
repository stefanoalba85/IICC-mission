---
import Layout from '../layouts/Layout.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Global Network"
  description="IICC Mission Global Network — One Mission. Many Nations. One Love in Christ."
>

  <!-- HERO -->
  <section class="page-hero page-hero--tall">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1200&fit=crop&q=80"
        alt="Earth from space — IICC Mission Global Network"
        loading="eager"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
      <p class="section-label" style="margin-bottom:0.875rem">Global Mission Network</p>
      <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
      <h1 class="page-hero-title">One Mission. Many Nations.<br><span class="hero-gold">One Love in Christ.</span></h1>
      <p class="hero-scripture-line">
        <em>"Go into all the world and proclaim the Gospel to the whole creation."</em> — Mark 16:15
      </p>
      <p class="page-hero-subtitle">
        A Worldwide Family — United in faith, working together to bring Christ's love to prisoners, detainees, families and communities in need.
      </p>
    </div>
  </section>

  <!-- SECTION 1: HEAD MISSION VATICAN CITY -->
  <section class="section-standard">
    <div class="container">
      <div class="two-col">
        <div class="head-mission-img-wrap">
          <img
            src="https://images.unsplash.com/photo-1552832230-c0197dd311b5?w=800&fit=crop&q=80"
            alt="Vatican City — Spiritual Heart of the IICC Mission"
            loading="lazy"
            class="head-mission-img"
          />
          <div class="head-mission-img-badge">
            <span class="section-label">Head Mission</span>
            <strong>Vatican City</strong>
          </div>
        </div>
        <div class="head-mission-text">
          <p class="section-label">HEAD MISSION</p>
          <div class="gold-rule-left" style="margin:0.875rem 0 1.25rem"></div>
          <h2 class="head-mission-heading">Vatican City — The Spiritual Heart of Our Mission</h2>
          <p class="head-mission-italic">
            Rooted in prayer and communion with the Holy See, our Head Mission in Vatican City guides and unites our global mission in faith and fidelity to the Church.
          </p>
          <ul class="head-mission-list">
            <li>
              <span class="check-icon">✓</span>
              In communion with the Holy Father and the Church
            </li>
            <li>
              <span class="check-icon">✓</span>
              Spiritual guidance and pastoral support
            </li>
            <li>
              <span class="check-icon">✓</span>
              Global coordination and mission discernment
            </li>
            <li>
              <span class="check-icon">✓</span>
              Prayer, formation and evangelisation
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: STATE MISSIONS (dark) -->
  <section class="section-standard-dark">
    <div class="container">
      <div class="section-header">
        <p class="section-label">STATE MISSIONS</p>
        <div class="gold-rule"></div>
        <h2 class="section-header-title section-header-title--white" style="margin-top:1rem">
          Bringing the Mission to Every Nation
        </h2>
      </div>

      <div class="card-grid-4">
        <div class="info-card--dark card-hover state-card">
          <span class="state-flag">🇮🇹</span>
          <h3 class="info-card-title">Italy State Mission</h3>
          <p class="state-city">Rome</p>
          <p class="info-card-desc">Coordinating mission activities across Italy and supporting regional communities.</p>
          <a href="/contact" class="learn-more-link" style="margin-top:auto;padding-top:1rem">LEARN MORE →</a>
        </div>

        <div class="info-card--dark card-hover state-card">
          <span class="state-flag">🇦🇺</span>
          <h3 class="info-card-title">Australia State Mission</h3>
          <p class="state-city">Canberra</p>
          <p class="info-card-desc">Supporting communities and advancing outreach across Australia.</p>
          <a href="/contact" class="learn-more-link" style="margin-top:auto;padding-top:1rem">LEARN MORE →</a>
        </div>

        <div class="info-card--dark card-hover state-card">
          <span class="state-flag">🇺🇸</span>
          <h3 class="info-card-title">USA State Mission</h3>
          <p class="state-city">Washington D.C.</p>
          <p class="info-card-desc">Advancing mission initiatives throughout the United States.</p>
          <a href="/contact" class="learn-more-link" style="margin-top:auto;padding-top:1rem">LEARN MORE →</a>
        </div>

        <div class="info-card--dark card-hover state-card">
          <span class="state-flag">🇨🇦</span>
          <h3 class="info-card-title">Canada State Mission</h3>
          <p class="state-city">Ottawa</p>
          <p class="info-card-desc">Building hope and belonging across Canada.</p>
          <a href="/contact" class="learn-more-link" style="margin-top:auto;padding-top:1rem">LEARN MORE →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: GLOBAL PRESENCE (white) -->
  <section class="global-presence-section">
    <div class="global-presence-bg">
      <img
        src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1200&fit=crop&q=60"
        alt="Global presence"
        loading="lazy"
      />
      <div class="global-presence-overlay"></div>
    </div>
    <div class="container global-presence-content">
      <p class="section-label" style="color:var(--color-gold)">OUR GLOBAL PRESENCE</p>
      <div class="gold-rule" style="margin:0.875rem 0 1.5rem"></div>
      <h2 class="global-presence-heading">From Vatican City to Every Continent</h2>
      <div class="global-stats-row">
        <div class="global-stat-item">
          <strong class="global-stat-label">One Mission</strong>
        </div>
        <span class="global-stat-divider">·</span>
        <div class="global-stat-item">
          <strong class="global-stat-label">Many Countries</strong>
        </div>
        <span class="global-stat-divider">·</span>
        <div class="global-stat-item">
          <strong class="global-stat-label">One Faith</strong>
        </div>
        <span class="global-stat-divider">·</span>
        <div class="global-stat-item">
          <strong class="global-stat-label">Many Communities</strong>
        </div>
        <span class="global-stat-divider">·</span>
        <div class="global-stat-item">
          <strong class="global-stat-label">One Love</strong>
        </div>
        <span class="global-stat-divider">·</span>
        <div class="global-stat-item">
          <strong class="global-stat-label">Many Lives Transformed</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: REGIONAL MISSIONS (offwhite) -->
  <section class="section-standard-offwhite">
    <div class="container">
      <div class="section-header">
        <p class="section-label">REGIONAL MISSIONS</p>
        <div class="gold-rule"></div>
        <h2 class="section-header-title" style="margin-top:1rem">A Local Presence in Every Community</h2>
      </div>

      <div class="regions-grid">
        <div class="region-col">
          <div class="region-col-header">
            <span class="region-flag">🇮🇹</span>
            <strong class="region-country">Italy</strong>
          </div>
          <ul class="region-cities">
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Milan
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Lamezia Terme
            </li>
            <li class="region-coming">
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              More regions coming soon
            </li>
          </ul>
        </div>

        <div class="region-col">
          <div class="region-col-header">
            <span class="region-flag">🇦🇺</span>
            <strong class="region-country">Australia</strong>
          </div>
          <ul class="region-cities">
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Melbourne
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Sydney
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Brisbane
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Adelaide
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Perth
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Hobart
            </li>
          </ul>
        </div>

        <div class="region-col">
          <div class="region-col-header">
            <span class="region-flag">🇺🇸</span>
            <strong class="region-country">USA</strong>
          </div>
          <ul class="region-cities">
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              New York
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Dallas
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Minneapolis
            </li>
            <li class="region-coming">
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              More regions coming soon
            </li>
          </ul>
        </div>

        <div class="region-col">
          <div class="region-col-header">
            <span class="region-flag">🇨🇦</span>
            <strong class="region-country">Canada</strong>
          </div>
          <ul class="region-cities">
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Toronto
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Vancouver
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Montreal
            </li>
            <li>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Alberta
            </li>
            <li class="region-coming">
              <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              More regions coming soon
            </li>
          </ul>
        </div>
      </div>

      <div style="text-align:center; margin-top:3rem">
        <a href="/contact" class="btn-primary">GET IN TOUCH →</a>
      </div>
    </div>
  </section>

  <!-- SECTION 5: THE MISSION CONTINUES -->
  <section class="section-standard">
    <div class="container">
      <div class="mission-continues-card">
        <div class="mission-continues-text">
          <p class="section-label" style="margin-bottom:0.75rem">THE MISSION CONTINUES</p>
          <h2 class="mission-continues-heading">We Are Always Discerning Where God Is Calling Us Next</h2>
          <p class="mission-continues-body">
            If you feel called to start an IICC Mission in your city or country, we welcome you. Together, we can bring hope and Christ's love to every corner of the world.
          </p>
        </div>
        <div class="mission-continues-cta">
          <a href="/contact" class="btn-primary">GET IN TOUCH →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <QuoteBand
    quote="Where there is pain, we bring hope. Where there is darkness, we bring light. Where there are people, we bring Christ."
    dark={true}
  />

  <!-- CTA -->
  <CTASection
    headline="Be Part of Our Global Mission"
    dark={true}
    buttons={[
      { label: 'Pray With Us', href: '/faith-hope#prayer', primary: true },
      { label: 'Volunteer', href: '/get-involved#volunteer', primary: false },
      { label: 'Donate', href: '/donate', primary: false },
      { label: 'Partner', href: '/sponsors-supporters', primary: false },
    ]}
  />

</Layout>

<style>
  /* HERO EXTRAS */
  .page-hero--tall {
    min-height: 60vh;
  }
  .hero-gold {
    color: var(--color-gold);
  }
  .hero-scripture-line {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1rem;
    max-width: 600px;
  }

  /* HEAD MISSION */
  .head-mission-img-wrap {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
  }
  .head-mission-img {
    width: 100%;
    display: block;
    object-fit: cover;
    min-height: 360px;
  }
  .head-mission-img-badge {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    background: rgba(18,26,56,0.92);
    border-left: 3px solid var(--color-gold);
    padding: 0.75rem 1.25rem;
    color: white;
  }
  .head-mission-img-badge .section-label {
    display: block;
    margin-bottom: 0.25rem;
  }
  .head-mission-img-badge strong {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: white;
  }
  .head-mission-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--color-navy);
    margin-bottom: 1.25rem;
  }
  .head-mission-italic {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.0625rem;
    color: #4a4a6a;
    line-height: 1.7;
    margin-bottom: 1.75rem;
    border-left: 3px solid var(--color-gold);
    padding-left: 1.25rem;
  }
  .head-mission-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .head-mission-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    color: #3a3a4a;
    line-height: 1.5;
  }
  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    min-width: 20px;
    background: var(--color-gold);
    color: white;
    border-radius: 50%;
    font-size: 0.625rem;
    font-weight: 700;
    margin-top: 0.1rem;
  }

  /* STATE MISSIONS */
  .state-card {
    display: flex;
    flex-direction: column;
  }
  .state-flag {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.75rem;
  }
  .state-city {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.625rem;
  }

  /* GLOBAL PRESENCE */
  .global-presence-section {
    position: relative;
    padding: 5rem 0;
    overflow: hidden;
  }
  .global-presence-bg {
    position: absolute;
    inset: 0;
  }
  .global-presence-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .global-presence-overlay {
    position: absolute;
    inset: 0;
    background: rgba(18,26,56,0.85);
  }
  .global-presence-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  .global-presence-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: white;
    margin-bottom: 2.5rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }
  .global-stats-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
  }
  .global-stat-label {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.8);
    font-weight: 400;
  }
  .global-stat-divider {
    color: var(--color-gold);
    font-size: 1.25rem;
    opacity: 0.6;
  }

  /* REGIONAL MISSIONS */
  .regions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .regions-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .region-col {
    background: white;
    border: 1px solid rgba(27,39,81,0.08);
    border-top: 3px solid var(--color-gold);
    padding: 1.5rem;
    border-radius: 2px;
  }
  .region-col-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid rgba(27,39,81,0.08);
  }
  .region-flag { font-size: 1.5rem; }
  .region-country {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy);
  }
  .region-cities {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .region-cities li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #4a4a5a;
    line-height: 1.4;
  }
  .region-cities li svg { color: var(--color-gold); flex-shrink: 0; }
  .region-coming {
    color: #9a9aa8 !important;
    font-style: italic;
  }
  .region-coming svg { color: rgba(201,160,23,0.4) !important; }

  /* MISSION CONTINUES */
  .mission-continues-card {
    background: var(--color-navy);
    border-top: 3px solid var(--color-gold);
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .mission-continues-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .mission-continues-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: white;
    margin-bottom: 0.875rem;
    max-width: 600px;
  }
  .mission-continues-body {
    color: rgba(255,255,255,0.75);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 560px;
  }
  .mission-continues-cta {
    flex-shrink: 0;
  }
</style>
