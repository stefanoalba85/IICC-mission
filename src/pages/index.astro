---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home" description="IICC Mission — Accompanying individuals and families in their journey toward healing, empowerment and a restored future. Faith. Hope. Justice. Restoration.">

  <!-- Hero: split left navy / right globe photo -->
  <div class="hero-split" style="min-height:88vh;">
    <div class="hero-split__text" style="background:var(--color-navy-dark);gap:1.5rem;">
      <img src="/IICC_Logo.png" alt="IICC Mission" style="height:90px;width:auto;object-fit:contain;" />
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,4.5vw,3.5rem);font-weight:900;color:#fff;text-transform:uppercase;line-height:1.1;">
        ACCOMPANYING<br>
        <span style="color:var(--color-amber);">THOSE WHO ARE</span><br>
        FORGOTTEN
      </h1>
      <span class="rule rule--amber"></span>
      <p style="font-family:var(--font-heading);font-size:clamp(1rem,2vw,1.25rem);color:rgba(255,255,255,0.85);line-height:1.6;max-width:400px;">
        Walking alongside inmates, detainees, and families — offering hope, justice, and a path to restoration.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:0.5rem;">
        <a href="/our-services" class="btn btn--amber">EXPLORE OUR PROGRAMS</a>
        <a href="/donate" class="btn btn--outline-white">♥ DONATE NOW</a>
      </div>
      <!-- Stats row -->
      <div style="display:flex;gap:2rem;flex-wrap:wrap;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,0.1);">
        <div style="text-align:center;">
          <p style="font-family:var(--font-heading);font-size:1.75rem;font-weight:700;color:var(--color-amber);line-height:1;">6</p>
          <p style="font-size:0.625rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-top:0.125rem;">National Missions</p>
        </div>
        <div style="text-align:center;">
          <p style="font-family:var(--font-heading);font-size:1.75rem;font-weight:700;color:var(--color-amber);line-height:1;">20+</p>
          <p style="font-size:0.625rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-top:0.125rem;">State Missions</p>
        </div>
        <div style="text-align:center;">
          <p style="font-family:var(--font-heading);font-size:1.75rem;font-weight:700;color:var(--color-amber);line-height:1;">30+</p>
          <p style="font-size:0.625rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-top:0.125rem;">Regional Missions</p>
        </div>
      </div>
    </div>
    <div class="hero-split__photo" style="min-height:400px;">
      <img
        src="https://images.unsplash.com/photo-1542393545-10f5cde2c810?w=1200&h=900&fit=crop"
        alt="Earth at night — global mission network"
      />
      <div class="hero-split__quote">
        <span class="hero-split__quote-mark">"</span>
        <p class="hero-split__quote-text">Bringing Christ's love, mercy, and hope to those who need it most.</p>
        <span class="hero-split__quote-ref">— IICC Mission</span>
      </div>
    </div>
  </div>

  <!-- Mission statement band -->
  <section class="section section--white">
    <div class="wrap" style="text-align:center;max-width:760px;margin-inline:auto;">
      <span class="eyebrow" style="margin-bottom:0.75rem;display:block;">Our Purpose</span>
      <h2 style="font-family:var(--font-heading);font-size:clamp(1.5rem,3.5vw,2.5rem);color:var(--color-navy);font-weight:700;line-height:1.3;margin-bottom:1rem;">
        To accompany, empower<br>and restore <span style="color:var(--color-amber);">hope.</span>
      </h2>
      <span class="rule rule--amber rule--center" style="margin-bottom:1.25rem;display:block;"></span>
      <p class="section-desc" style="text-align:center;margin-inline:auto;max-width:600px;">
        IICC Mission is a Catholic non-profit organisation serving inmates, detainees and their families worldwide. We believe that every person — no matter their past — deserves dignity, compassion and a chance to rebuild.
      </p>
    </div>
  </section>

  <!-- Programs grid -->
  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow eyebrow--white">What We Do</span>
        <span class="heart">♥</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1.125rem,2.5vw,1.625rem);letter-spacing:0.1em;text-transform:uppercase;color:#fff;">OUR PROGRAMS &amp; SERVICES</h2>
        <span class="rule rule--amber rule--center"></span>
      </div>
      <div class="grid-3">
        {[
          { title: 'Prison Ministry', desc: 'Spiritual care, rehabilitation support, and pathways to reintegration for inmates and their families.', href: '/our-services/prison-ministry', icon: 'M8 11V7a4 4 0 0 1 8 0m-4 8v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2z' },
          { title: 'Immigration Detention Ministry', desc: 'Walking alongside people in immigration detention — offering care, advocacy and legal referrals.', href: '/our-services/immigration-detention', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' },
          { title: 'Spiritual & Pastoral Care', desc: 'Faith support, prayer and the sacraments for those who need God\'s presence most.', href: '/our-services/spiritual-pastoral-care', icon: 'M18 8h1a4 4 0 0 1 0 8h-1 M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z' },
          { title: 'Legal Assistance & Advocacy', desc: 'Advocating for justice, human rights, and fair treatment for the vulnerable.', href: '/advocacy', icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z' },
          { title: 'Humanitarian Support', desc: 'Meeting urgent practical needs — food, clothing, and essential services — with dignity.', href: '/our-services/humanitarian-support', icon: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z' },
          { title: 'Hope Media Channel', desc: 'Inspiring stories, faith content and news from our mission worldwide.', href: '/hope-media', icon: 'M23 7l-7 5 7 5V7z M1 5h15a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H1a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z' },
        ].map(p => (
          <a href={p.href} class="card--dark" style="text-decoration:none;cursor:pointer;">
            <div class="card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d={p.icon}/></svg>
            </div>
            <p class="card__title">{p.title}</p>
            <p class="card__body">{p.desc}</p>
            <span style="font-size:0.75rem;font-weight:700;color:var(--color-amber);letter-spacing:0.1em;text-transform:uppercase;margin-top:auto;">LEARN MORE →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Story split -->
  <section class="section section--white">
    <div class="wrap">
      <div class="cols-2" style="gap:4rem;align-items:center;">
        <div>
          <img
            src="/IICC_Logo.png"
            alt="IICC Mission"
            style="height:100px;width:auto;object-fit:contain;margin-bottom:1.5rem;"
          />
          <span class="eyebrow" style="margin-bottom:0.5rem;display:block;">Our Story</span>
          <h2 class="section-title" style="margin-bottom:1rem;">Born from Lived Experience</h2>
          <span class="rule rule--amber" style="margin-bottom:1.5rem;display:block;"></span>
          <p class="section-desc" style="max-width:none;margin-bottom:1rem;">
            IICC Mission was founded by Antonio G. Dattilo — a man who spent time in prison and experienced first-hand the need for hope, dignity and accompaniment. His journey became a mission: to ensure that no inmate, detainee or family is ever left behind.
          </p>
          <p class="section-desc" style="max-width:none;margin-bottom:2rem;">
            Guided by Catholic social teaching and the power of the Gospel, we walk alongside those society often forgets — not with judgement, but with compassion.
          </p>
          <div style="display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="/our-story" class="btn btn--amber">OUR STORY →</a>
            <a href="/our-mission" class="btn btn--outline">OUR MISSION</a>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <img
            src="https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=600&h=380&fit=crop"
            alt="People walking together toward the light"
            style="width:100%;height:280px;object-fit:cover;border-radius:2px;"
          />
          <div class="quote-box">
            <span class="quote-box__mark">"</span>
            <p class="quote-box__text">Prison didn't break me. It changed me. Now I'm here to change lives.</p>
            <span class="quote-box__ref">— Antonio G. Dattilo, Founder</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Global Presence stat band -->
  <div class="stat-band">
    <div class="wrap">
      <div class="stat-band__inner">
        <div class="stat-band__item">
          <span class="stat-band__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </span>
          <p class="stat-band__num">6</p>
          <p class="stat-band__label">National Missions</p>
        </div>
        <div class="stat-band__item">
          <span class="stat-band__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <p class="stat-band__num">20+</p>
          <p class="stat-band__label">State Missions</p>
        </div>
        <div class="stat-band__item">
          <span class="stat-band__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <p class="stat-band__num">30+</p>
          <p class="stat-band__label">Regional Missions</p>
        </div>
        <div class="stat-band__item">
          <span class="stat-band__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </span>
          <p class="stat-band__num">∞</p>
          <p class="stat-band__label">Lives Touched</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Become a Hope Partner -->
  <section class="section section--offwhite">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:3rem;">
        <span class="eyebrow">Support Us</span>
        <span class="heart">♥</span>
        <h2 class="section-title">BECOME A HOPE PARTNER</h2>
        <span class="rule rule--amber rule--center"></span>
        <p class="section-desc" style="text-align:center;margin-top:0.5rem;margin-inline:auto;">
          Your support helps bring dignity, compassion and hope to people who need it most.
        </p>
      </div>
      <div class="grid-4" style="margin-bottom:2.5rem;">
        {[
          { label: 'Monthly Support', desc: 'Provide ongoing hope through a regular monthly gift.', btn: 'GIVE MONTHLY' },
          { label: 'One-Time Donation', desc: 'Make a one-time gift and help change lives today.', btn: 'DONATE NOW' },
          { label: 'Community Partnership', desc: 'Partner with us to create a stronger, more compassionate community.', btn: 'PARTNER WITH US' },
          { label: 'Volunteer Support', desc: 'Give your time and talents to make a real difference.', btn: 'GET INVOLVED' },
        ].map(c => (
          <div class="card" style="text-align:center;align-items:center;">
            <div class="card__icon card__icon--filled">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402C1 3.499 3.8 2 6 2c1.2 0 4.5.5 6 4.5C13.5 2.5 16.8 2 18 2c2.2 0 5 1.5 5 5.19 0 4.069-5.373 8.863-11 14.403z"/></svg>
            </div>
            <p class="card__title">{c.label}</p>
            <p class="card__body">{c.desc}</p>
            <a href="/donate" class="btn btn--amber" style="margin-top:0.5rem;font-size:0.75rem;padding:0.5rem 1.25rem;">{c.btn}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Donate Today amber band -->
  <div class="amber-band">
    <div class="wrap" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem;">
      <div>
        <p style="font-family:var(--font-display);font-size:1.625rem;font-weight:700;color:#fff;letter-spacing:0.04em;">
          ♥ DONATE TODAY
        </p>
        <p style="color:rgba(255,255,255,0.9);font-size:0.9375rem;margin-top:0.25rem;">
          Together we build a world of dignity, justice and hope.
        </p>
      </div>
      <a href="/donate" class="btn" style="background:#fff;color:var(--color-amber);font-weight:800;font-size:0.875rem;">
        DONATE NOW →
      </a>
    </div>
  </div>

  <!-- Value strip -->
  <div class="value-strip">
    <div class="wrap">
      <div class="value-strip__inner">
        <div class="value-strip__item">
          <span class="value-strip__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>
          <p class="value-strip__title">You Are Not Alone</p>
          <p class="value-strip__desc">We stand with you and your family.</p>
        </div>
        <div class="value-strip__item">
          <span class="value-strip__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg></span>
          <p class="value-strip__title">We Listen</p>
          <p class="value-strip__desc">Your story matters. We are here to listen.</p>
        </div>
        <div class="value-strip__item">
          <span class="value-strip__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
          <p class="value-strip__title">We Guide</p>
          <p class="value-strip__desc">We help you understand your rights and options.</p>
        </div>
        <div class="value-strip__item">
          <span class="value-strip__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span>
          <p class="value-strip__title">We Connect</p>
          <p class="value-strip__desc">We refer you to trusted services and professionals.</p>
        </div>
        <div class="value-strip__item">
          <span class="value-strip__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402C1 3.499 3.8 2 6 2c1.2 0 4.5.5 6 4.5C13.5 2.5 16.8 2 18 2c2.2 0 5 1.5 5 5.19 0 4.069-5.373 8.863-11 14.403z"/></svg></span>
          <p class="value-strip__title">We Hope</p>
          <p class="value-strip__desc">We believe in healing, justice, and new beginnings.</p>
        </div>
      </div>
    </div>
  </div>

</Layout>
