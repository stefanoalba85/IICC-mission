---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';

const values: { title: string; text: string; icon: IconName }[] = [
  { title: 'Faith', text: 'Guided by the Gospel and Catholic values.', icon: 'cross' },
  { title: 'Compassion', text: 'Serving every person with love and respect.', icon: 'heart' },
  { title: 'Dignity', text: 'Recognising the value of every human being.', icon: 'people' },
  { title: 'Justice', text: 'Working for fairness, reconciliation and mercy.', icon: 'scales' },
  { title: 'Hope', text: 'Believing in new beginnings and brighter futures.', icon: 'dove' },
];
const stats: { title: string; text: string; icon: IconName; color?: string }[] = [
  { title: '8+ Years', text: 'Prison & Immigration Detention Experience', icon: 'calendar' },
  { title: 'People & Purpose', text: 'Skills, Hope & Reintegration', icon: 'people' },
  { title: 'Faith & Hope', text: 'Christ’s Love Never Gives Up', icon: 'cross', color: 'var(--color-navy)' },
  { title: 'Global Mission', text: 'Bringing Hope Worldwide', icon: 'globe', color: 'var(--color-navy)' },
];
const services: { title: string; text: string; href: string; icon: IconName; bg: string }[] = [
  { title: 'Prison Ministry', text: 'Bringing hope, support and human connection behind the walls.', href: '/our-services/prison-ministry', icon: 'bars', bg: '#1b2751' },
  { title: 'Immigration Detention Ministry', text: 'Compassionate support for people in immigration detention.', href: '/our-services/immigration-detention', icon: 'globe', bg: '#1d5fa5' },
  { title: 'Abuse & Domestic Violence Support', text: 'Helping those who suffer in silence find safety, healing and hope.', href: '/our-services/who-we-serve', icon: 'heartHand', bg: '#7a3fa8' },
  { title: 'Mental Health & Wellbeing', text: 'Supporting the mind, heart and spirit through care and referrals.', href: '/our-services/mental-health', icon: 'heart', bg: '#3c8f4a' },
  { title: 'Advocacy', text: 'Giving a voice to the voiceless and raising awareness for change.', href: '/our-services/advocacy', icon: 'megaphone', bg: '#e2621b' },
];
const mission: { title: string; text: string }[] = [
  { title: 'Head Office', text: 'Via delle Milizie 34<br/>Rome, Italy' },
  { title: 'National Missions', text: 'Italy - Australia - USA - Canada<br/>San Marino - Monaco' },
  { title: 'State Missions', text: 'Serving states and provinces' },
  { title: 'Regional Missions', text: 'Bringing the mission closer<br/>to local communities' },
];
const locations: { flag: string; country: string; cities: string }[] = [
  { flag: '🇮🇹', country: 'Italy', cities: 'Rome - Milan - Lamezia Terme' },
  { flag: '🇦🇺', country: 'Australia', cities: 'Melbourne - Sydney - Perth - Adelaide<br/>Brisbane - Hobart - Darwin' },
  { flag: '🇺🇸', country: 'United States', cities: 'Dallas - Minneapolis' },
  { flag: '🇨🇦', country: 'Canada', cities: 'Vancouver - Montreal - Alberta' },
  { flag: '🇸🇲', country: 'San Marino', cities: 'National Mission' },
  { flag: '🇲🇨', country: 'Monaco', cities: 'National Mission' },
];
---
<Layout title="Bringing Hope Worldwide" description="A Catholic global mission sharing Christ's love, mercy and hope with incarcerated individuals, people in Immigration Detention, their families and all who are experiencing hardship.">
  <style>
    .hp-hero { position: relative; background: var(--color-navy-dark); color: #fff; overflow: hidden; }
    .hp-hero__bg { position: absolute; inset: 0 0 0 36%; }
    .hp-hero__bg img { width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%); mask-image: linear-gradient(90deg, transparent, #000 22%); }
    .hp-hero__inner { position: relative; min-height: 400px; padding-block: 2.25rem 6.5rem; display: flex; flex-direction: column; gap: 1.1rem; }
    .hp-hero h1 { font-family: var(--font-heading); font-size: clamp(2.25rem, 4.6vw, 3.4rem); line-height: 1.12; max-width: 560px; }
    .hp-hero p { font-size: 1.0625rem; line-height: 1.5; max-width: 520px; }
    .hp-hero__btns { display: flex; flex-wrap: wrap; gap: 1rem; }
    .hp-office { position: absolute; right: 1.5rem; bottom: 6rem; width: 230px; background: rgba(18,26,56,0.92); border-radius: 6px; padding: 1rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.25rem; font-size: 0.875rem; }
    .hp-office :global(svg) { color: var(--color-amber); }
    .hp-office strong { font-size: 0.875rem; text-transform: uppercase; }
    .hp-office b { font-size: 1rem; }
    .hp-values { position: relative; margin-top: -4.5rem; z-index: 2; }
    .hp-values__box { background: var(--color-navy-dark); border-radius: 6px; display: grid; grid-template-columns: repeat(5, 1fr); padding-block: 1.1rem; color: #fff; text-align: center; box-shadow: 0 10px 24px rgba(18,26,56,0.25); }
    .hp-values__box > div { padding-inline: 0.75rem; border-right: 1px solid rgba(255,255,255,0.12); display: flex; flex-direction: column; align-items: center; gap: 0.35rem; }
    .hp-values__box > div:last-child { border-right: none; }
    .hp-values__box :global(svg) { color: var(--color-amber); }
    .hp-values__box strong { font-size: 0.9375rem; text-transform: uppercase; }
    .hp-values__box span { font-size: 0.8125rem; color: rgba(255,255,255,0.85); line-height: 1.35; }
    .hp-founder { display: grid; grid-template-columns: 0.95fr 1.85fr; gap: 1.75rem; padding-block: 1.25rem 1rem; }
    .hp-founder > img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
    .hp-founder h2 { font-family: var(--font-body); color: var(--color-navy); font-size: 1.5rem; }
    .hp-founder .q { font-style: italic; font-weight: 700; color: var(--color-amber); font-size: 1.375rem; }
    .hp-founder p { font-size: 0.9375rem; line-height: 1.45; color: var(--color-text); margin-top: 0.6rem; }
    .hp-stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 1.25rem; text-align: center; }
    .hp-stats > div { border-right: 1px solid rgba(27,39,81,0.12); display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding-inline: 0.5rem; }
    .hp-stats > div:last-child { border-right: none; }
    .hp-stats strong { font-size: 0.8125rem; text-transform: uppercase; color: var(--color-navy); }
    .hp-stats span { font-size: 0.75rem; color: var(--color-text); line-height: 1.35; }
    .hp-h { text-align: center; font-family: var(--font-body); font-weight: 700; color: var(--color-amber); font-size: 1.5rem; text-transform: uppercase; border-top: 1px solid rgba(27,39,81,0.08); padding-top: 0.75rem; }
    .hp-services { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.6rem; margin-top: 0.75rem; }
    .hp-svc { border: 1px solid rgba(27,39,81,0.1); border-radius: 4px; padding: 0.9rem 0.75rem; display: grid; grid-template-columns: 2.75rem 1fr; gap: 0.6rem; box-shadow: 0 2px 6px rgba(18,26,56,0.05); }
    .hp-svc i { width: 2.75rem; height: 2.75rem; border-radius: 50%; color: #fff; display: flex; align-items: center; justify-content: center; }
    .hp-svc h3 { font-family: var(--font-body); color: var(--color-navy); font-size: 0.8125rem; text-transform: uppercase; line-height: 1.2; }
    .hp-svc p { font-size: 0.78rem; line-height: 1.35; color: var(--color-text); margin-block: 0.25rem 0.5rem; }
    .hp-svc a { font-size: 0.75rem; font-weight: 700; color: var(--color-navy); text-transform: uppercase; }
    .hp-svc a span { color: var(--color-amber); }
    .hp-global { display: grid; grid-template-columns: 0.85fr 2fr 0.95fr; gap: 0.6rem; margin-top: 1.25rem; }
    .hp-panel { background: #f4f4f2; border-radius: 4px; padding: 0.9rem; display: flex; flex-direction: column; gap: 0.75rem; }
    .hp-panel h3 { font-family: var(--font-body); font-size: 0.8125rem; text-transform: uppercase; color: var(--color-navy); }
    .hp-panel__row { display: grid; grid-template-columns: 1.75rem 1fr; gap: 0.6rem; align-items: start; font-size: 0.75rem; line-height: 1.35; color: var(--color-text); }
    .hp-panel__row strong { display: block; color: var(--color-navy); text-transform: uppercase; font-size: 0.75rem; }
    .hp-panel__row :global(svg) { color: var(--color-amber); }
    .hp-flag { font-size: 1.25rem; line-height: 1; }
    .hp-map { display: flex; align-items: center; }
    .hp-map img { width: 100%; }
    .hp-media { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; margin-top: 0.5rem; }
    .hp-mcard { background: var(--color-navy-dark); color: #fff; border-radius: 4px; overflow: hidden; display: grid; grid-template-columns: 0.85fr 1.15fr; min-height: 112px; }
    .hp-mcard img { width: 100%; height: 100%; object-fit: cover; }
    .hp-mcard > div { padding: 0.9rem 0.9rem 0.9rem 0.75rem; display: flex; flex-direction: column; gap: 0.35rem; }
    .hp-mcard h3 { font-family: var(--font-body); color: var(--color-amber); font-size: 0.875rem; text-transform: uppercase; }
    .hp-mcard p { font-size: 0.78rem; line-height: 1.35; }
    .hp-mcard a { font-size: 0.78rem; font-weight: 700; color: var(--color-amber); text-transform: uppercase; margin-top: auto; }
    .hp-cta { background: var(--color-navy-dark); color: #fff; margin-top: 0; }
    .hp-cta .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; padding-block: 1.1rem; }
    .hp-cta h2 { font-family: var(--font-body); text-transform: uppercase; font-size: 1.375rem; }
    .hp-cta p { font-size: 0.9375rem; font-weight: 600; }
    @media (max-width: 960px) {
      .hp-hero__bg { inset: 0; opacity: 0.35; } .hp-office { display: none; }
      .hp-values__box { grid-template-columns: repeat(3, 1fr); row-gap: 1rem; }
      .hp-founder, .hp-global, .hp-media { grid-template-columns: 1fr; }
      .hp-services { grid-template-columns: 1fr 1fr; }
      .hp-stats { grid-template-columns: 1fr 1fr; row-gap: 1rem; }
    }
    @media (max-width: 520px) {
      .hp-services { grid-template-columns: 1fr; }
      .hp-svc h3 { font-size: 0.875rem; }
      .hp-svc p { font-size: 0.875rem; }
    }
  </style>

  <section class="hp-hero">
    <div class="hp-hero__bg"><img src="/images/home/hero.jpg" alt="St Peter's Basilica and the Tiber at dusk" /></div>
    <div class="wrap hp-hero__inner">
      <h1>IICC MISSION<br /><span class="text-amber">Bringing Hope</span><br />to those in need.</h1>
      <p>A Catholic global mission sharing Christ’s love, mercy and hope with incarcerated individuals, people in Immigration Detention, their families and all who are experiencing hardship.</p>
      <div class="hp-hero__btns">
        <a href="/donate" class="btn btn--amber"><Icon name="heart" size={16} /> Support the Mission</a>
        <a href="/get-involved/ambassador-program" class="btn btn--outline-white"><Icon name="star" size={16} /> Become an Ambassador</a>
      </div>
      <div class="hp-office">
        <Icon name="pin" size={26} />
        <strong>Head Office</strong>
        <b>Via delle Milizie 34<br />Rome, Italy</b>
        <span>The global mission centre coordinating our work worldwide.</span>
      </div>
    </div>
  </section>

  <section class="wrap hp-values">
    <div class="hp-values__box">
      {values.map(v => <div><Icon name={v.icon} size={36} fill={v.icon !== 'scales'} /><strong>{v.title}</strong><span>{v.text}</span></div>)}
    </div>
  </section>

  <section class="wrap hp-founder">
    <img src="/images/home/founder.jpg" alt="Antonio G. Dattilo, Ambassador & Founder" />
    <div>
      <span class="eyebrow" style="font-size:1.125rem;">Our Founder</span>
      <h2>Ambassador &amp; Founder – IICC Mission</h2>
      <p class="q">“Prison didn’t break me.”</p>
      <p>My name is Antonio G. Dattilo, Ambassador and Founder of IICC Mission.</p>
      <p>My journey has taken me through more than eight years between prison and Immigration Detention Centre. During this time, I experienced hardship, isolation and uncertainty, but I also discovered faith, resilience and the power of hope.</p>
      <p>While incarcerated, I worked in the prison bakery, where I discovered purpose through discipline, learning new skills and supporting others around me.</p>
      <p>These experiences inspired the creation of IICC Mission – a global Catholic mission dedicated to bringing Christ’s love, mercy and hope to incarcerated individuals, people in Immigration Detention, their families and those experiencing hardship.</p>
      <div class="hp-stats">
        {stats.map(s => <div><span style={`color:${s.color ?? 'var(--color-amber)'}`}><Icon name={s.icon} size={34} /></span><strong>{s.title}</strong><span>{s.text}</span></div>)}
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:1rem;">
    <h2 class="hp-h">Our Services</h2>
    <div class="hp-services">
      {services.map(s => (
        <article class="hp-svc">
          <i style={`background:${s.bg}`}><Icon name={s.icon} size={22} /></i>
          <div><h3>{s.title}</h3><p>{s.text}</p><a href={s.href}>Learn More <span>→</span></a></div>
        </article>
      ))}
    </div>

    <div class="hp-global">
      <div class="hp-panel">
        <h3>Our Global Mission</h3>
        {mission.map((m, i) => <div class="hp-panel__row"><Icon name={i === 0 ? 'pin' : 'people'} size={24} /><div><strong>{m.title}</strong><span set:html={m.text} /></div></div>)}
      </div>
      <div class="hp-map"><img src="/images/home/map.jpg" alt="World map of IICC Mission locations: Italy, Australia, USA and Canada" /></div>
      <div class="hp-panel">
        <h3>Our Locations</h3>
        {locations.map(l => <div class="hp-panel__row"><span class="hp-flag">{l.flag}</span><div><strong>{l.country}</strong><span set:html={l.cities} /></div></div>)}
      </div>
    </div>

    <h2 style="text-align:center; font-family:var(--font-body); color:var(--color-navy); font-size:1.125rem; text-transform:uppercase; margin-top:1rem;">Hope Media Channel &amp; Mission Projects</h2>
    <div class="hp-media">
      <article class="hp-mcard" style="grid-template-columns:3.5rem 1fr; padding-left:0.9rem; align-items:start;">
        <span class="text-amber" style="padding-top:1rem;"><Icon name="video" size={48} /></span>
        <div><h3>Hope Media Channel</h3><p>Daily messages of faith, encouragement and hope for inmates, detainees, families and our global community.</p><a href="/resources">Watch Now →</a></div>
      </article>
      <article class="hp-mcard">
        <img src="/images/home/stories.jpg" alt="Hands raised towards a cross at sunset" />
        <div><h3>Stories of Hope</h3><p>Real stories of faith, resilience and new beginnings from around the world.</p><a href="/programs/hope-companion/stories">Discover More →</a></div>
      </article>
      <article class="hp-mcard">
        <img src="/images/home/ambassadors.jpg" alt="A family silhouetted against the sunset" />
        <div><h3>Mission Ambassadors</h3><p>People bringing awareness, support and hope to communities around the world.</p><a href="/get-involved/ambassador-program">Join the Mission →</a></div>
      </article>
    </div>
  </section>

  <section class="hp-cta">
    <div class="wrap">
      <div><h2>Together We Can Bring Hope to Those in Need</h2><p>Every prayer, every act of kindness and every person can make a difference.</p></div>
      <div style="display:flex; gap:1rem; flex-wrap:wrap;">
        <a href="/donate" class="btn btn--amber"><Icon name="heart" size={16} /> Support the Mission</a>
        <a href="/get-involved/ambassador-program" class="btn btn--outline-white"><Icon name="star" size={16} /> Become an Ambassador</a>
      </div>
    </div>
  </section>
</Layout>
