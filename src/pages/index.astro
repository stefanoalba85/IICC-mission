---
import Layout from '../layouts/Layout.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Home"
  description="IICC Mission — Bringing Christ's Love to the Forgotten. Restoring Dignity. Building New Lives. A Catholic international mission serving prisoners, detainees, families and communities worldwide."
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <img
        src="https://images.unsplash.com/photo-1552832230-c0197dd311b5?w=1920&fit=crop&q=80"
        alt="St. Peter's Square, Vatican City"
        class="hero-img"
        loading="eager"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">Global Mission Network</p>
      <h1 class="hero-title">
        Bringing Christ's Love<br>to the Forgotten.<br>
        <span class="hero-title-accent">Restoring Dignity.<br>Building New Lives.</span>
      </h1>
      <p class="hero-desc">
        The IICC Mission is a Catholic international mission bringing hope, healing and transformation to prisoners, detainees, families and communities in need around the world.
      </p>
      <div class="hero-actions">
        <a href="/mission" class="btn-primary">Our Mission →</a>
        <a href="/get-involved" class="btn-outline-white">Get Involved →</a>
      </div>
    </div>

    <!-- Pope portraits overlay card -->
    <div class="pope-card">
      <div class="pope-item">
        <img src="https://images.unsplash.com/photo-1578496479914-7ef3b0193be3?w=400&fit=crop&q=80" alt="Pope Leo XIV" class="pope-img"/>
        <div>
          <p class="pope-name">Pope Leo XIV</p>
          <p class="pope-title">A Shepherd of Hope</p>
        </div>
      </div>
      <div class="pope-divider"></div>
      <div class="pope-item">
        <img src="https://images.unsplash.com/photo-1489824904134-891ab64532f1?w=400&fit=crop&q=80" alt="Pope Francis" class="pope-img"/>
        <div>
          <p class="pope-name">Pope Francis</p>
          <p class="pope-title">A Voice for the Marginalised</p>
        </div>
      </div>
    </div>

    <!-- Scripture overlay -->
    <div class="hero-scripture">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.6"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
      <em>"I was in prison and you came to visit me."</em>
      <span>Matthew 25:36</span>
    </div>
  </section>

  <!-- 5 PILLARS BAND -->
  <section class="pillars-band">
    <div class="pillars-inner">
      {[
        { icon: '✝', label: 'Faith Driven', desc: 'Rooted in the Gospel and Catholic Social Teaching' },
        { icon: '🌍', label: 'Global Mission', desc: 'Walking with dignity towards a brighter future' },
        { icon: '🤝', label: 'Compassion in Action', desc: 'Walking with people in their darkest hours' },
        { icon: '✨', label: 'Hope & Renewal', desc: 'Restoring lives, rebuilding communities' },
        { icon: '❤', label: 'Together for Good', desc: 'Communities, partners making a lasting impact' },
      ].map((p) => (
        <div class="pillar-item">
          <span class="pillar-icon">{p.icon}</span>
          <strong class="pillar-label">{p.label}</strong>
          <p class="pillar-desc">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="who-section">
    <div class="container">
      <div class="who-grid">
        <div class="who-text">
          <p class="section-label">Who We Are</p>
          <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
          <h2 class="who-heading">A Mission of Hope,<br>Rooted in Christ's Love</h2>
          <p class="who-body">
            We serve prisoners, detainees, families and communities through pastoral care, support programs, mental health assistance and community outreach.
          </p>
          <p class="who-body">
            We believe every person has dignity, a future and a place in God's love.
          </p>
          <a href="/mission" class="learn-more-link" style="margin-top:1.5rem;display:inline-flex">LEARN MORE ABOUT US →</a>
        </div>
        <div class="who-stats">
          {[
            { num: 'Thousands', label: 'of people supported each year' },
            { num: 'Prison Ministry', label: 'across multiple countries', icon: '⛪' },
            { num: 'Volunteers', label: 'committed to serving with faith and love', icon: '🤝' },
          ].map((s) => (
            <div class="who-stat">
              <strong class="who-stat-num">{s.num}</strong>
              <span class="who-stat-label">{s.label}</span>
            </div>
          ))}
          <div class="who-quote-card">
            <p class="who-quote-text">"A little hope changes everything."</p>
            <a href="/get-involved" class="learn-more-link">BE A SIGN OF HOPE TODAY →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR PROGRAMS -->
  <section class="programs-section">
    <div class="container">
      <div class="programs-header">
        <p class="section-label">Our Programs</p>
        <div class="gold-rule"></div>
        <h2 class="programs-heading">Serving Every Person<br>with Dignity and Hope</h2>
      </div>
      <div class="programs-grid">
        {[
          {
            title: 'Prison Ministry',
            desc: 'Visiting prisoners, spiritual support, rehabilitation programs and the Walk With a Prisoner program.',
            href: '/our-services#prison',
            img: 'https://images.unsplash.com/photo-1589994965851-a8f479c573a9?w=600&fit=crop&q=80',
          },
          {
            title: 'Immigration Detention Ministry',
            desc: 'Supporting detainees with pastoral care, advocacy and dignity.',
            href: '/our-services/immigration-detention',
            img: 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=600&fit=crop&q=80',
          },
          {
            title: 'Abuse & Domestic Violence Support',
            desc: 'Safe space, counselling, advocacy and healing for individuals and families.',
            href: '/our-services#abuse',
            img: 'https://images.unsplash.com/photo-1511895426328-dc8714191011?w=600&fit=crop&q=80',
          },
          {
            title: 'Mental Health & Wellbeing',
            desc: 'Compassionate care, counselling and mental health support for individuals and families.',
            href: '/our-services#mental-health',
            img: 'https://images.unsplash.com/photo-1444703686981-a3abbc4d4fe3?w=600&fit=crop&q=80',
          },
          {
            title: 'Family Support & Community Outreach',
            desc: 'Strengthening families and communities with practical support and hope.',
            href: '/our-services#family',
            img: 'https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=600&fit=crop&q=80',
          },
        ].map((prog) => (
          <article class="program-card card-hover">
            <div class="program-card-img">
              <img src={prog.img} alt={prog.title} loading="lazy" />
              <div class="program-card-overlay"></div>
            </div>
            <div class="program-card-body">
              <h3 class="program-card-title">{prog.title}</h3>
              <p class="program-card-desc">{prog.desc}</p>
              <a href={prog.href} class="learn-more-link">LEARN MORE →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- GLOBAL NETWORK -->
  <section class="network-section">
    <div class="network-bg">
      <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&fit=crop&q=60" alt="Global mission" loading="lazy" />
      <div class="network-overlay"></div>
    </div>
    <div class="container network-content">
      <div class="network-intro">
        <p class="section-label" style="color:var(--color-gold)">Our Global Presence</p>
        <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
        <h2 class="network-heading">One Mission.<br>Many Nations.<br><span style="color:var(--color-gold)">One Love in Christ.</span></h2>
        <p class="network-desc">
          United in faith, working together to bring Christ's love to prisoners, detainees, families and communities in need.
        </p>
        <a href="/global-network" class="btn-outline" style="margin-top:1.5rem">VIEW OUR NETWORK →</a>
      </div>
      <div class="network-locations">
        {[
          { flag: '🇮🇹', country: 'Italy', cities: ['Milan', 'Lamezia Terme', '(More regions coming soon)'] },
          { flag: '🇦🇺', country: 'Australia', cities: ['Melbourne', 'Sydney', 'Brisbane', 'Adelaide', 'Perth', 'Hobart'] },
          { flag: '🇺🇸', country: 'USA', cities: ['New York', 'Dallas', 'Minneapolis', '(More regions coming soon)'] },
          { flag: '🇨🇦', country: 'Canada', cities: ['Toronto', 'Vancouver', 'Montreal', 'Alberta', '(More regions coming soon)'] },
        ].map((loc) => (
          <div class="network-loc">
            <div class="network-loc-header">
              <span class="network-flag">{loc.flag}</span>
              <strong class="network-country">{loc.country}</strong>
            </div>
            <ul class="network-cities">
              {loc.cities.map((c) => (
                <li>
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  {c}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DAILY HOPE MESSAGES + WALK WITH A PRISONER -->
  <section class="two-col-section">
    <div class="container">
      <div class="two-col-grid">
        <div class="two-col-card two-col-card--dark">
          <p class="section-label">Daily Hope Messages</p>
          <h2 class="two-col-heading">Daily videos of faith, encouragement and hope for families and communities.</h2>
          <a href="/hope-media" class="btn-primary" style="margin-top:1.5rem">WATCH TODAY'S MESSAGE →</a>
        </div>
        <div class="two-col-card two-col-card--light">
          <p class="section-label">Walk With a Prisoner</p>
          <h2 class="two-col-heading">Be a Chaplain. Bring hope. Change a life. Be the presence of Christ behind the walls.</h2>
          <p class="two-col-desc">Your partnership helps bring hope and restoration to individuals and families.</p>
          <a href="/get-involved" class="btn-primary" style="margin-top:1.5rem">GET INVOLVED →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- MAKE A DIFFERENCE -->
  <section class="diff-section">
    <div class="container">
      <div class="diff-grid">
        <div class="diff-text">
          <p class="section-label">Make A Difference</p>
          <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
          <h2>Your support helps bring dignity, hope and restoration to lives.</h2>
          <p style="margin:1rem 0 1.5rem;opacity:0.75">Every contribution, big or small, brings hope to life and changes lives forever.</p>
          <a href="/donate" class="btn-primary">DONATE NOW →</a>
        </div>
        <div class="diff-actions">
          {[
            { label: 'Pray', desc: 'Lift up our mission and those we serve in your prayers.', href: '/faith-hope#prayer', icon: '🙏' },
            { label: 'Volunteer', desc: 'Share your time and talents with those in need.', href: '/get-involved#volunteer', icon: '🤝' },
            { label: 'Donate', desc: 'Your support makes hope possible.', href: '/donate', icon: '❤' },
            { label: 'Partner', desc: 'Together we can change the future.', href: '/sponsors-supporters', icon: '🌟' },
          ].map((a) => (
            <a href={a.href} class="diff-action card-hover">
              <span class="diff-action-icon">{a.icon}</span>
              <div>
                <strong class="diff-action-label">{a.label}</strong>
                <p class="diff-action-desc">{a.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- NEOCATECHUMENAL WAY -->
  <section class="neo-section">
    <div class="container neo-inner">
      <div class="neo-text">
        <p class="section-label">The Neocatechumenal Way</p>
        <div class="gold-rule-left" style="margin-bottom:1.25rem"></div>
        <p class="neo-body">
          We walk together with the Neocatechumenal Way, a path of faith, formation and evangelization close to those on the margins. A precious instrument of the Church for our time.
        </p>
        <a href="/neocatechumenal-way" class="learn-more-link" style="margin-top:1.25rem;display:inline-flex">LEARN MORE →</a>
      </div>
      <div class="neo-quote">
        <div class="neo-quote-mark">&ldquo;</div>
        <blockquote class="neo-quote-text">
          The Neocatechumenal Way is a precious instrument of the Church for our time.
        </blockquote>
        <cite class="neo-quote-ref">— Pope Francis</cite>
      </div>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <QuoteBand
    quote="Together, we can bring hope to those who need it most. Pray. Volunteer. Donate. Partner."
    dark={true}
  />

  <!-- FINAL CTA -->
  <CTASection
    eyebrow="Join the Mission"
    headline="Be Part of Something Greater"
    subtext="Your involvement today can change a life forever."
    buttons={[
      { label: 'Become an Ambassador', href: '/get-involved', primary: true },
      { label: 'Volunteer With Us', href: '/get-involved#volunteer', primary: false },
      { label: 'Support the Mission', href: '/donate', primary: false },
    ]}
    dark={true}
  />

</Layout>

<style>
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* HERO */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      130deg,
      rgba(18,26,56,0.88) 0%,
      rgba(27,39,81,0.75) 50%,
      rgba(18,26,56,0.6) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    padding: 6rem 1.5rem 3rem;
    width: 100%;
  }
  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 700;
    color: white;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    max-width: 700px;
  }
  .hero-title-accent {
    color: var(--color-gold);
  }
  .hero-desc {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: rgba(255,255,255,0.85);
    line-height: 1.7;
    max-width: 540px;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Pope card */
  .pope-card {
    position: absolute;
    bottom: 2rem;
    right: 1.5rem;
    z-index: 3;
    background: rgba(18,26,56,0.88);
    border: 1px solid rgba(201,160,23,0.3);
    border-top: 2px solid var(--color-gold);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    backdrop-filter: blur(8px);
    max-width: 320px;
  }
  @media (max-width: 640px) { .pope-card { display: none; } }
  .pope-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .pope-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--color-gold);
  }
  .pope-name {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    color: white;
    line-height: 1.3;
  }
  .pope-title {
    font-size: 0.625rem;
    color: var(--color-gold);
    letter-spacing: 0.06em;
  }
  .pope-divider {
    width: 1px;
    height: 40px;
    background: rgba(201,160,23,0.3);
  }

  /* Scripture overlay */
  .hero-scripture {
    position: absolute;
    bottom: 2rem;
    left: 1.5rem;
    z-index: 3;
    color: rgba(255,255,255,0.7);
    font-size: 0.8125rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .hero-scripture em {
    font-family: var(--font-heading);
    font-style: italic;
    color: rgba(255,255,255,0.85);
  }
  .hero-scripture span {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    text-transform: uppercase;
  }
  @media (max-width: 640px) { .hero-scripture { display: none; } }

  /* PILLARS */
  .pillars-band {
    background-color: var(--color-navy);
    border-bottom: 1px solid rgba(201,160,23,0.2);
  }
  .pillars-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  @media (min-width: 768px) { .pillars-inner { grid-template-columns: repeat(5, 1fr); } }
  .pillar-item {
    padding: 1.75rem 1.25rem;
    text-align: center;
    border-right: 1px solid rgba(201,160,23,0.12);
    border-bottom: 1px solid rgba(201,160,23,0.12);
  }
  .pillar-item:last-child { border-right: none; }
  .pillar-icon {
    display: block;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .pillar-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.375rem;
  }
  .pillar-desc {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.5;
    margin: 0;
  }

  /* WHO WE ARE */
  .who-section {
    padding: 5rem 0;
    background-color: var(--color-offwhite);
  }
  .who-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) { .who-grid { grid-template-columns: 1fr 1fr; align-items: start; } }
  .who-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-navy);
    margin-bottom: 1.25rem;
  }
  .who-body {
    color: #4a4a4a;
    line-height: 1.75;
    margin-bottom: 0.875rem;
    font-size: 1.0625rem;
  }
  .who-stats {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .who-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-gold);
  }
  .who-stat-num {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-navy);
    font-weight: 700;
  }
  .who-stat-label {
    font-size: 0.875rem;
    color: #5a5a6a;
  }
  .who-quote-card {
    background-color: var(--color-navy);
    color: white;
    padding: 1.5rem;
    border-left: 3px solid var(--color-gold);
  }
  .who-quote-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.0625rem;
    color: white;
    margin-bottom: 1rem;
  }

  /* PROGRAMS */
  .programs-section {
    padding: 5rem 0;
    background-color: white;
  }
  .programs-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .programs-header .section-label {
    display: block;
    margin-bottom: 0.625rem;
  }
  .programs-header .gold-rule {
    margin: 0.75rem auto 1.25rem;
  }
  .programs-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--color-navy);
  }
  .programs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .programs-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .programs-grid { grid-template-columns: repeat(5, 1fr); } }

  .program-card {
    background: white;
    border: 1px solid rgba(27,39,81,0.08);
    border-radius: 2px;
    overflow: hidden;
  }
  .program-card-img {
    position: relative;
    height: 160px;
    overflow: hidden;
  }
  .program-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .program-card:hover .program-card-img img {
    transform: scale(1.04);
  }
  .program-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18,26,56,0.5), transparent 60%);
  }
  .program-card-body {
    padding: 1.25rem;
  }
  .program-card-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }
  .program-card-desc {
    font-size: 0.8125rem;
    color: #5a5a6a;
    line-height: 1.6;
    margin-bottom: 0.875rem;
  }

  /* GLOBAL NETWORK */
  .network-section {
    position: relative;
    padding: 5rem 0;
    overflow: hidden;
  }
  .network-bg {
    position: absolute;
    inset: 0;
  }
  .network-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .network-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(18,26,56,0.82);
  }
  .network-overlay {
    position: absolute;
    inset: 0;
    background: rgba(18,26,56,0.82);
  }
  .network-content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) { .network-content { grid-template-columns: 1fr 1fr; align-items: center; } }
  .network-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    color: white;
    margin-bottom: 1.25rem;
